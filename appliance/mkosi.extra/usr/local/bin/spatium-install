#!/bin/bash
# spatium-install — Proxmox-style installer wizard for the
# SpatiumDDI appliance.
#
# Asks the operator for target disk, hostname, admin user/password,
# network (DHCP or static), and timezone; then partitions the disk
# (GPT: 512 MiB ESP + rest root), rsyncs the live rootfs onto it,
# regenerates the initrd for disk boot, installs grub for both BIOS
# and UEFI, injects the answers, and reboots.
#
# Runs automatically on boot when `spatium-mode=install` is in the
# kernel cmdline (set by the "Install SpatiumDDI to disk" GRUB
# entry). Also available as a CLI tool from the live shell.

# Bulletproof launch log — first thing we do, BEFORE any set/trap/
# redirect setup or even nounset. If /var/log/spatium-install-launch.log
# is empty after a failure, bash did not parse the script at all
# (interpreter issue, shebang corruption, etc.). If it has at least
# one LAUNCH entry, we know the script body started executing and
# can compare timestamps against journalctl + the install / trace
# logs to pinpoint the bail.
#
# Uses only shell builtins + utilities present in every Debian
# rootfs (date, tty, id, cat, command, ls) so the logger itself
# can't fail in a way the diagnostic forgets to record.
#
# Skipped entirely in the host-portable `--check-preseed` / `--help`
# modes (issue #581) so the offline lint truly touches nothing — no
# /var/log write — and can run unprivileged on any dev / CI box. The
# nested brace + `2>/dev/null` on the real-install path also silences the
# redirect-open error itself if /var/log is not writable.
case "${1:-}" in
    --check-preseed|--help|-h) : ;;
    *)
    { {
        printf '[%s] LAUNCH\n'      "$(date -Iseconds 2>/dev/null || echo '?')"
        printf '  pid=%s ppid=%s\n' "$$" "$PPID"
        printf '  tty=%s\n'         "$(tty 2>/dev/null || echo '?')"
        printf '  uid=%s\n'         "$(id -u 2>/dev/null || echo '?')"
        printf '  bash=%s\n'        "${BASH_VERSION:-?}"
        printf '  pwd=%s\n'         "$(pwd 2>/dev/null || echo '?')"
        printf '  cmdline=%s\n'     "$(tr '\n' ' ' </proc/cmdline 2>/dev/null)"
        printf '  whiptail=%s\n'    "$(command -v whiptail 2>/dev/null || echo MISSING)"
        printf '  sgdisk=%s\n'      "$(command -v sgdisk 2>/dev/null || echo MISSING)"
        printf '  rsync=%s\n'       "$(command -v rsync 2>/dev/null || echo MISSING)"
        printf '  varlog=%s\n'      "$(ls -ld /var/log 2>&1)"
        printf -- '----\n'
    } >> /var/log/spatium-install-launch.log 2>&1
    } 2>/dev/null || true
    ;;
esac

# pipefail + nounset for the wizard, but NOT -e: whiptail returns
# non-zero on Cancel/Esc and we want to handle that explicitly with
# on_cancel rather than crashing the script. -e is re-enabled inside
# do_install where we DO want any partition / rsync / chroot failure
# to abort.
set -uo pipefail

# #995 item 8 — the ISO version is the first thing asked when an install
# misbehaves, and this line said "0.1.0" on every ISO ever built. Read
# APPLIANCE_VERSION off the release stamp instead.
#
# Takes the file as an argument because do_install reads the SAME value
# back out of the freshly-rsynced $MOUNT copy to label the grub
# menuentries; one parser so the backtitle and the boot menu can never
# disagree about which build this is.
#
# _release_field is that parser, for any KEY="value" line of the stamp;
# the clock check reads BUILD_TIME through it too (#1182).
_release_field() {
    local f="$1" key="$2" v=""
    if [ -r "$f" ]; then
        v=$(awk -F= -v key="$key" '$1 == key {
            gsub(/^"|"$|^'"'"'|'"'"'$/, "", $2); print $2; exit
        }' "$f" 2>/dev/null || true)
    fi
    printf '%s' "$v"
}
_appliance_version_from() {
    _release_field "$1" APPLIANCE_VERSION
}
_INSTALLER_VERSION="$(_appliance_version_from /etc/spatiumddi/appliance-release)"
BACKTITLE="SpatiumDDI Appliance Installer ${_INSTALLER_VERSION:-unknown}"

# #995 item 2 — how the LIVE ISO booted, which decides which of the two
# grub-install calls in do_install is allowed to fail. /sys/firmware/efi
# exists if and only if the kernel was handed an EFI system table, so it
# is the firmware mode, not a guess from the partition table.
if [ -d /sys/firmware/efi ]; then
    FIRMWARE_MODE="uefi"
else
    FIRMWARE_MODE="bios"
fi

# #1026 — the architecture this installer is running on, which decides
# the GPT root type code, whether a BIOS-boot partition is laid down at
# all, and which grub target is installed.
#
# From ``uname -m`` and not from the build: the installer ships INSIDE
# the image it installs, so the machine it is running on is by
# construction the architecture of the rootfs it is about to copy. A
# build-time stamp would be a second source that can only ever agree or
# be wrong.
case "$(uname -m)" in
    x86_64|amd64)  TARGET_ARCH="amd64" ;;
    aarch64|arm64) TARGET_ARCH="arm64" ;;
    *)             TARGET_ARCH="unsupported" ;;
esac

# The two things the layout varies by, resolved once.
#
# An ARRAY rather than a word-split string: expanding an empty array as
# "${_BIOS_BOOT_ARGS[@]}" contributes no arguments at all, which is
# exactly what arm64 needs, and it does so without a shellcheck
# suppression for splitting we would then have to keep correct forever.
if [ "$TARGET_ARCH" = "arm64" ]; then
    _ROOT_TYPE="8305"                        # Linux root (ARM-64)
    _BIOS_BOOT_ARGS=()                       # no BIOS to chain-load from
    _GRUB_EFI_TARGET="arm64-efi"
    _EFI_REMOVABLE="BOOTAA64.EFI"
else
    _ROOT_TYPE="8304"                        # Linux root (x86-64)
    _BIOS_BOOT_ARGS=(-n1:0:+1M -t1:ef02 -c1:bios_boot)
    _GRUB_EFI_TARGET="x86_64-efi"
    _EFI_REMOVABLE="BOOTX64.EFI"
fi

# **On arm64 the firmware question collapses to "UEFI, or refuse."**
# There is no i386-pc GRUB target for AArch64 and no BIOS to chain-load
# from — Apple Virtualization, UTM and AWS Graviton are all UEFI. So a
# BIOS-booted arm64 machine is not a degraded install to warn about, it
# is an install that cannot be made to boot.
#
# A FUNCTION called from the install path, NOT a check at load time.
# ``--help`` and ``--check-preseed`` are host-portable entry points that
# run this script unprivileged on an operator's own machine (#581), and
# a load-time refusal made both of them exit 1 on any non-EFI arm64 host
# — including the macOS laptop the preseed linter is written to run on.
# Its own test suite caught that within a minute of the first draft.
_assert_arch_bootable() {
    [ "$TARGET_ARCH" = "arm64" ] || return 0
    [ "$FIRMWARE_MODE" != "uefi" ] || return 0
    log "FATAL: arm64 appliance on a machine that did not boot via EFI"
    echo "ERROR: this machine booted without EFI, and the arm64 appliance is" >&2
    echo "       UEFI-only (there is no BIOS boot path on AArch64). Enable UEFI" >&2
    echo "       firmware for this machine and boot the installer again." >&2
    exit 1
}
# The SPATIUM_INSTALL_LOG override + the /dev/null fallback below exist
# for the host-portable `--check-preseed` linter (issue #581) and its
# pytest suite, which run this script unprivileged on machines where
# /var/log isn't writable by the caller.
INSTALL_LOG="${SPATIUM_INSTALL_LOG:-/var/log/spatium-install.log}"
MOUNT=/mnt/target
# Test-only seams (issue #581), same idea as spatium-preseed-parse's
# SPATIUM_FAKE_DISK_BYTES: the preseed-URL integrity gate and the
# live-boot-disk exclusion are pure text processing over two kernel
# files, but a pytest host cannot write either one. Never set on a real
# install, where both resolve to the real /proc paths.
PROC_CMDLINE="${SPATIUM_CMDLINE_FILE:-/proc/cmdline}"
PROC_MOUNTS="${SPATIUM_MOUNTS_FILE:-/proc/mounts}"

mkdir -p /var/log 2>/dev/null || true
if ! : 2>/dev/null > "$INSTALL_LOG"; then
    INSTALL_LOG=/dev/null
fi
# Log to file only — NOT stdout. The do_install brace group below
# pipes stdout to whiptail's --gauge protocol parser, which expects
# only "XXX" / percentage / prompt-text lines. If log() tee'd to
# stdout it would inject timestamped lines into the gauge stream
# between XXX blocks and break the prompt update protocol — that's
# exactly the "progress text never changes" symptom we hit.
log() { echo "[$(date -Iseconds)] $*" >> "$INSTALL_LOG"; }

# Full bash trace to a separate file — when the wizard bails
# unexpectedly, this captures every command + variable expansion so
# we can pinpoint the exact line. Doesn't pollute the user-facing
# install log.
TRACE_LOG="${SPATIUM_INSTALL_TRACE_LOG:-/var/log/spatium-install-trace.log}"
if ! : 2>/dev/null > "$TRACE_LOG"; then
    # Same host-portable fallback as INSTALL_LOG above (issue #581) — a
    # failed `exec 19>` would kill a non-interactive bash outright.
    TRACE_LOG=/dev/null
fi
exec 19> "$TRACE_LOG"
# Export so the gauge subshell pipeline below inherits the same
# trace fd. Without export, the subshell's BASH_XTRACEFD defaults
# to stderr — and the install pipeline pipes stdout to whiptail
# while stderr is the terminal, so every traced command writes
# garbage to the same TTY whiptail is trying to redraw. Result:
# whiptail's progress dialog never updates because its display
# fights with set -x output.
export BASH_XTRACEFD=19
PS4='+ ${BASH_SOURCE##*/}:${LINENO}: ${FUNCNAME[0]:-main}() '
# No bash trace in the host-portable `--check-preseed` / `--help` modes
# (issue #581): the lint runs unprivileged and its machine-readable
# output must not be polluted by set -x spew, and on bash < 4.1
# BASH_XTRACEFD isn't honoured so the trace would go to stderr.
case "${1:-}" in
    --check-preseed|--help|-h) ;;
    *) set -x ;;
esac

log "===== spatium-install wizard started at $(date -Iseconds) ====="

on_cancel() {
    # ${1:-} — this runs on the way OUT, so it must not itself die. A bare
    # `on_cancel` call read $1 under `set -u`, printed "$1: unbound variable"
    # and exited 127 without the message OR the login shell.
    local where="${1:-unknown step}"
    set +x
    clear
    cat <<EOF

Installation cancelled at: $where

Run 'spatium-install' to start the wizard again,
or 'reboot' to leave the live ISO and try a different boot path.

EOF
    log "Wizard cancelled at: $where"
    exec /bin/bash --login
}

# Wizard state — all set by the prompt functions below.
TARGET_DISK=""
HOSTNAME=""
ADMIN_USER="admin"
ADMIN_PASSWORD=""
# Optional crypt(3) admin password hash (headless preseed, issue #549).
# When set, do_install feeds it through `chpasswd -e` instead of the
# plaintext ADMIN_PASSWORD. Mutually exclusive with ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=""
# #995 item 12 — whether root gets the admin password as well. Default no:
# root is locked (`passwd -l`) and the operator uses sudo. This CHANGES
# the previous behaviour, where root always got it.
SET_ROOT_PASSWORD="no"
NET_MODE="dhcp"
NET_INTERFACE=""
NET_IP=""
NET_PREFIX="24"
NET_GATEWAY=""
NET_DNS="1.1.1.1 1.0.0.1"
# #995 item 21 — optional static IPv6, alongside (not instead of) v4.
# `auto` means RA / SLAAC, which is what every install has had until now
# and stays the default; `static` adds an address the operator gives.
# _validate_static_net checks these with the same ``ipaddress`` rules it
# applies to v4, and spatium-etc-render writes them into the same
# NetworkManager keyfile's [ipv6] section.
NET6_MODE="auto"
NET6_IP=""
NET6_PREFIX="64"
NET6_GATEWAY=""
# #1017 — optional interface MTU. Empty means "NetworkManager's default",
# which is every install to date. This exists for links that need a MTU
# BELOW 1500 — a WireGuard / IPsec / GRE tunnel, PPPoE, a provider
# underlay — where the failure mode is that ping and small requests work
# while large TCP hangs, so it reads as an application fault rather than
# a network one. Deliberately NOT a performance knob: SpatiumDDI's own
# traffic is small UDP and small JSON, and raising the MTU on a
# DHCP-served segment is actively hazardous because PXE ROMs are 1500.
NET_MTU=""
TIMEZONE="UTC"
# #995 item 16 — a time source, which the wizard never asked for although
# it asked for a timezone. A wrong clock breaks TLS to the control plane
# and the supervisor's pairing on first boot, and both fail in ways that
# read as a networking fault.
NTP_SERVERS="pool.ntp.org"
# #995 item 17 — console keymap. The live ISO assumes US, so a password
# with symbols typed on any other layout is mangled at install and again
# at the login prompt that then rejects it.
KEYMAP="us"
# #995 item 18 — SSH public keys for the admin account, newline-separated.
SSH_AUTHORIZED_KEYS=""
# #995 item 25 — reinstall onto an existing SpatiumDDI layout, keeping
# /var and STATE. The partition table's own comment has promised this
# since #276 ("the partition layout permits keeping /var across
# reinstalls") and nothing implemented it.
KEEP_VAR="no"
# #995 item 26 — the stable name of the target, recorded so the log and
# STATE say which physical disk was written to. sdX is assigned in
# discovery order and #581 already notes it can move.
TARGET_DISK_BY_ID=""
# #999 Part C2 — install onto a two-disk RAID1 mirror. "yes" makes
# state / root_A / root_B / var md members across TARGET_DISK and
# TARGET_DISK2; the ESP and the BIOS boot partition stay per-disk
# (firmware reads the ESP before any md driver exists).
MIRROR_MODE="no"
TARGET_DISK2=""
TARGET_DISK2_BY_ID=""
# Whether to turn off password SSH once a key is installed. Only offered
# when at least one key is present, or it locks the operator out.
SSH_DISABLE_PASSWORD="no"
# Issue #302 — k3s pod + service CIDRs. Defaults match k3s upstream
# defaults exactly so operators on a clean LAN don't have to touch
# them. Customisable in ``ask_k3s_cidrs`` for installs where the LAN
# already uses one of these ranges (Flannel ``host-gw`` writes routes
# directly; an overlapping pod CIDR masks the LAN). The cluster-dns
# IP is derived as ``<service_cidr_base>.0.10`` — k3s/kube-dns
# convention.
K3S_POD_CIDR="10.42.0.0/16"
K3S_SERVICE_CIDR="10.43.0.0/16"
# Disk / RAM sizing (#312).
#   MIN_DISK_GIB     — absolute hard floor for the A/B partition layout;
#                      pick_disk refuses below it for ANY role. Raised
#                      24 → 32 because the 24 GiB floor left /var only
#                      ~7 GiB, and the Control plane's first boot (k3s
#                      image import + CNPG/Redis PVCs all on /var) tipped
#                      the kubelet DiskPressure threshold into an
#                      eviction / image-GC thrash loop that never
#                      converges. 32 GiB leaves ~14 GiB usable /var.
#   REC_CP_DISK_GIB /
#   REC_CP_RAM_GIB   — RECOMMENDED Control-plane figures. Between the
#                      floor and these, pick_disk soft-warns (install
#                      proceeds) because the box still risks DiskPressure
#                      under load. The Appliance/agent role is light and
#                      gets no soft warning. Keep in sync with the
#                      "Recommended sizing" table in README +
#                      docs/deployment/APPLIANCE.md.
MIN_DISK_GIB=32
REC_CP_DISK_GIB=40
REC_CP_RAM_GIB=8
# Default ROLE = appliance (the role screen frames it as "Additional
# node"). #272 UX fix: operators don't read the body text, and a
# misclick / blind Enter on "control plane" silently spins up a SECOND
# standalone control plane (its own DB + cluster) instead of joining the
# existing one. Defaulting to the additive, non-destructive role — plus
# a confirm guard on the control-plane choice in ask_role() — makes that
# accident hard. The very first install actively picks "First node".
ROLE="appliance"
# Installer roles (#272 — collapsed from the old three to two; the
# old full-stack / frontend-core distinction is now a runtime DNS/DHCP
# role toggle, not an install choice):
#   control-plane — Runs the SpatiumDDI control plane (api + worker +
#                   beat + db + redis + frontend) and is the k3s etcd
#                   seed. DNS (BIND9) + DHCP (Kea) are OFF at install —
#                   the operator enables them per node via the Fleet
#                   role toggle (so the data plane is a deliberate
#                   fleet decision, not a silent install default). The
#                   required FIRST install; extra control-plane nodes
#                   are made by promoting Appliances in the Fleet UI,
#                   not installed as this role.
#   appliance     — Supervisor only. Pairs with a remote control plane
#                   via an 8-digit pairing code and sits in
#                   pending_approval until an admin clicks Approve in
#                   the Fleet UI. The control plane assigns the role(s)
#                   + group(s) after approval (DNS / DHCP). Can later
#                   be promoted to join the control-plane cluster.
# Every role still creates an OS admin account so the operator can
# SSH in and manage the appliance, irrespective of which web UI runs.
CONTROL_PLANE_URL=""
# Pairing code claimed by the supervisor on first boot. 8 decimal
# digits — single-use ephemeral or persistent depending on what the
# control-plane admin minted. Only meaningful when ROLE=appliance.
BOOTSTRAP_PAIRING_CODE=""
# #995 item 2 — records that the grub-install for the OTHER firmware mode
# failed. Confirm has by then already told the operator that leg was being
# installed too, so the Done screen has to retract it; without this the
# only record is a log line, and a disk moved to the other kind of machine
# later fails with no prior warning.
#
# A FILE, not a variable, and that is not a style choice: the whole
# install runs inside `{ … } | whiptail --gauge`, and the left side of a
# pipeline is a subshell — an assignment there is discarded when the
# pipeline ends, so the Done screen (which runs after it) would never see
# it. shellcheck says so as SC2030/SC2031, and said so about the first
# version of this.
# #995 item 28 — the step the operator picked on the Confirm menu, read
# by the wizard loop. Set only by confirm(), which runs in main's own
# shell rather than in the gauge subshell, so a variable is fine here.
CONFIRM_JUMP=""
BOOT_LEG_MISSING_FILE=/run/spatium-boot-leg-missing
# #995 item 30 — post-install check failures, for the same subshell reason
# as the line above.
VERIFY_FAIL_FILE=/run/spatium-install-verify-failed
BOOT_LEG_WARNING=""

# ── Headless preseed state (issue #549) ────────────────────────────────
# When a preseed answer file is discovered + parsed, load_preseed sets
# PRESEED_ACTIVE=1, sources the resolved wizard variables + per-field
# PRESEED_HAS_* markers, and computes FULLY_UNATTENDED. Each ask_*
# prompt short-circuits when its field is preseeded; welcome + the final
# confirm are skipped entirely on a fully-unattended run. Partial
# preseeds fall through to the interactive prompt for missing fields.
PRESEED_ACTIVE=0
FULLY_UNATTENDED=0
PRESEED_SOURCE=""
PRESEED_ENV=/run/spatium-preseed.env
PRESEED_SECRET_ENV=/run/spatium-preseed-secret.env
# Candidate answer files discovered by discover_preseed, in priority
# order (parallel arrays). KIND is "explicit" (kernel cmdline value or a
# file literally named spatium-preseed.*) or "opportunistic" (a
# cloud-init user-data that may or may not carry a spatium_preseed
# block). load_preseed tries them in order, skipping ones with no
# preseed content so a plain user-data doesn't shadow a real preseed on
# a lower-priority source.
PRESEED_CAND_FILE=()
PRESEED_CAND_SRC=()
PRESEED_CAND_KIND=()

# ── Prompts ───────────────────────────────────────────────────────────────────

welcome() {
    log "Step: welcome"
    # #995 item 9 — the list has to match the screens the wizard actually
    # shows, or an operator sizes up the install from a list that is
    # missing two of its questions. #995 item 7 — and it names the roles
    # the way ask_role names them ("First node" / "Additional node"), not
    # the internal control-plane / appliance pair.
    #
    # The role is not known yet (this screen runs before ask_role), so the
    # two role-specific questions are listed with the role that asks them.
    #
    # --yesno, NOT --msgbox. The text has always ended "or Cancel to drop
    # to a shell" and --msgbox draws ONE button, so the only way to reach
    # on_cancel was ESC — undocumented, undiscoverable, and awkward on a
    # serial console. The screen promised an exit it did not offer.
    #
    # Sized from the body rather than the hardcoded 21 rows: #995 item 9
    # added two bullets to this list, and 80x24 is a first-class install
    # path here (_whiptail_height clamps to the terminal).
    local body
    body="Welcome to the SpatiumDDI Appliance Installer.\n\n\
This installer will ERASE a target disk and install SpatiumDDI to it.\n\n\
You'll be asked for:\n\
  - Role (First node / Additional node)\n\
  - Target disk\n\
  - Hostname\n\
  - Admin OS user + password (for SSH access)\n\
  - Network (DHCP or static)\n\
  - Timezone\n\
  - k3s pod + service CIDRs (defaults are fine on most LANs)\n\
  - Control-plane URL + 8-digit pairing code (Additional node only)\n\n\
Press OK to begin, or Cancel to drop to a shell."
    whiptail --backtitle "$BACKTITLE" --title "Welcome" \
        --yes-button "OK" --no-button "Cancel" \
        --yesno "$body" "$(_whiptail_height "$body" 74)" 74 \
        || on_cancel "welcome"
}

# ── Pre-flight (issue #995 item 15) ───────────────────────────────────
#
# Everything the installer can learn about this machine, before it asks
# the operator anything. Proxmox does this and it earns its place: the
# facts that decide whether an install is going to work — is there enough
# RAM, is a cable actually plugged in, did the machine boot the way you
# think it did, is the clock sane — were previously discovered one at a
# time, mid-wizard (the disk/RAM gate fires at the picker) or after the
# reboot.
#
# Informational, not a gate. The one hard refusal in the wizard is the
# disk size floor, which pick_disk owns and which stays there; a screen
# that refuses on RAM would stop an operator who knows their VM is about
# to be resized.

# ISO build date as YYYY-MM-DD, or "" when it cannot be derived. Used
# only for the clock check. Takes the release stamp's path (tests).
#
# Read from BUILD_TIME, which the build writes beside APPLIANCE_VERSION,
# and not from the version: that stopped being a date at 1.0.0 (#1182), and
# was never one on a dev build. Both CI and ``make appliance-stamp-dev``
# write BUILD_TIME; a stamp without it (one written by hand, or by an older
# build) falls back to the file's own mtime, which mkosi sets at build time
# and nothing on the live ISO rewrites.
_iso_build_date() {
    local t
    t="$(_release_field "${1:-/etc/spatiumddi/appliance-release}" BUILD_TIME)"
    case "$t" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*)
            printf '%s' "${t:0:10}"
            return 0
            ;;
    esac
    date -r "${1:-/etc/spatiumddi/appliance-release}" +%Y-%m-%d 2>/dev/null || true
}

preflight() {
    log "Step: preflight"
    if [ "$FULLY_UNATTENDED" = "1" ]; then
        return 2
    fi
    local body="" warn_count=0

    # ── CPU + RAM ────────────────────────────────────────────────────
    local cpus ram_kb ram_gb
    # NOT `grep -c … || echo "?"`: grep -c prints 0 AND exits 1 when it
    # matches nothing, so both branches run and the value becomes "0\n?".
    cpus=$(nproc 2>/dev/null || true)
    if [ -z "$cpus" ]; then
        cpus=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || true)
    fi
    [ -n "$cpus" ] && [ "$cpus" != "0" ] || cpus="?"
    ram_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
    # #1003 item 6 — round to NEAREST, matching pick_disk's sizing gate.
    # This floored while that one rounded, so on a 4 GiB VM pre-flight said
    # "Memory: 3 GiB" and the gate thirty seconds later said "ram=4G" — the
    # installer disagreeing with itself about the machine it is standing on,
    # which is exactly the kind of thing that makes an operator distrust the
    # rest of the screen.
    ram_gb=$(( (ram_kb + 524288) / 1024 / 1024 ))
    body+="CPU:       $cpus core(s)\n"
    # -1 for the same reason pick_disk's sizing gate does it: MemTotal
    # excludes what the kernel reserves, so an 8 GiB box reports 7 and a
    # bare `< REC_CP_RAM_GIB` warns on hardware that meets the published
    # recommendation exactly. A screen that cries wolf is one operators
    # learn to skim.
    if [ "$ram_gb" -gt 0 ] && [ "$ram_gb" -lt "$((REC_CP_RAM_GIB - 1))" ]; then
        body+="Memory:    ${ram_gb} GiB  (control plane wants ${REC_CP_RAM_GIB} GiB)\n"
        warn_count=$((warn_count + 1))
    else
        body+="Memory:    ${ram_gb} GiB\n"
    fi

    # ── Firmware ─────────────────────────────────────────────────────
    # Absorbed from item 2 — this is where an operator should learn it,
    # not on the Confirm screen after they have answered everything.
    if [ "$FIRMWARE_MODE" = "uefi" ]; then
        body+="Firmware:  UEFI\n"
    else
        body+="Firmware:  BIOS / CSM\n"
    fi

    # ── Disks ────────────────────────────────────────────────────────
    local disk_count disk_line big_enough=0
    disk_count=0
    disk_line=""
    local d name sz szg
    while read -r name sz; do
        [ -n "$name" ] || continue
        # Zero-size entries are unpopulated kernel placeholders — an
        # unbound nbd, an empty card reader. Listing eighteen of them
        # buries the one real disk.
        [ "${sz:-0}" -gt 0 ] 2>/dev/null || continue
        disk_count=$((disk_count + 1))
        szg=$(( sz / 1024 / 1024 / 1024 ))
        [ "$szg" -ge "$MIN_DISK_GIB" ] && big_enough=$((big_enough + 1))
        [ -n "$disk_line" ] && disk_line+=", "
        disk_line+="$name ${szg}G"
    done < <(lsblk -dnbo NAME,SIZE 2>/dev/null | grep -vE '^(sr|loop|fd|ram|zram|nbd)' || true)
    if [ "$disk_count" -eq 0 ]; then
        body+="Disks:     NONE FOUND — the installer has nothing to install to\n"
        warn_count=$((warn_count + 1))
    else
        body+="Disks:     $disk_line\n"
        if [ "$big_enough" -eq 0 ]; then
            body+="           none clears the ${MIN_DISK_GIB} GiB minimum\n"
            warn_count=$((warn_count + 1))
        fi
    fi

    # ── NICs ─────────────────────────────────────────────────────────
    local nic_lines="" nic_up=0 iface
    while read -r iface; do
        [ -n "$iface" ] || continue
        nic_lines+="           $iface  $(_iface_summary "$iface")\n"
        [ "$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)" = "up" ] && nic_up=$((nic_up + 1))
    done < <(_net_interfaces)
    if [ -z "$nic_lines" ]; then
        body+="Network:   no ethernet interfaces found\n"
        warn_count=$((warn_count + 1))
    else
        body+="Network:\n$nic_lines"
        if [ "$nic_up" -eq 0 ]; then
            body+="           no port has a live link — check the cable\n"
            warn_count=$((warn_count + 1))
        fi
    fi

    # ── Gateway + resolver ───────────────────────────────────────────
    #
    # Deliberately NOT an internet-reachability probe. SpatiumDDI makes no
    # outbound connection the operator did not ask for (see the project's
    # non-negotiable #17 and docs/PRIVACY.md), and an installer that
    # pings a well-known host to draw a green tick would be exactly that.
    # The LAN facts below are what actually decide whether the install
    # works, and an air-gapped install is a supported, normal case rather
    # than a red line on a screen.
    local gw resolver
    gw=$(ip -4 route show default 2>/dev/null | awk '{for (n=1;n<NF;n++) if ($n=="via") print $(n+1)}' | head -1)
    if [ -n "$gw" ]; then
        if ping -c1 -W1 "$gw" >/dev/null 2>&1; then
            body+="Gateway:   $gw (responds)\n"
        else
            body+="Gateway:   $gw (no ping reply — may be filtered, not fatal)\n"
        fi
    else
        body+="Gateway:   none configured\n"
    fi
    resolver=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
    body+="Resolver:  ${resolver:-none configured}\n"

    # ── Clock ────────────────────────────────────────────────────────
    #
    # A clock behind the ISO's own build date means the RTC is wrong —
    # usually a dead CMOS battery on reused hardware. It is worth a line
    # because of what it breaks LATER and silently: TLS to the control
    # plane fails "certificate not yet valid", and the supervisor's
    # pairing is rejected, both of which read as a networking fault.
    local now build
    now=$(date -u +%Y-%m-%d)
    build="$(_iso_build_date)"
    if [ -n "$build" ] && [ "$now" \< "$build" ]; then
        body+="Clock:     $(date -u '+%Y-%m-%d %H:%M UTC')  ← BEFORE this image was built ($build)\n"
        body+="           Fix the RTC or TLS and pairing will fail after the reboot.\n"
        warn_count=$((warn_count + 1))
    else
        body+="Clock:     $(date -u '+%Y-%m-%d %H:%M UTC')\n"
    fi

    local title="Pre-flight check"
    [ "$warn_count" -gt 0 ] && title="Pre-flight check — $warn_count thing(s) to look at"
    whiptail --backtitle "$BACKTITLE" --title "$title" \
        --cancel-button "Back" \
        --yesno "$body\nContinue?" \
        --scrolltext \
        "$(_whiptail_height "$body\nContinue?" 76)" 76 \
        || return 1
    log "Pre-flight: cpus=$cpus ram=${ram_gb}G disks=$disk_count nics_up=$nic_up warnings=$warn_count"
}

# ── Keyboard (issue #995 item 17) ─────────────────────────────────────
#
# Runs before every screen that takes typed input, and applies the layout
# IMMEDIATELY with loadkeys, so the hostname and — the one that actually
# hurts — the password are entered on the layout in front of the
# operator.
#
# The failure it removes: on AZERTY or QWERTZ the symbols in a good
# password land somewhere else entirely. The installer stores what the US
# layout produced, the operator later types what they meant, and the
# login fails with no explanation. Twice, because the installed system's
# console defaulted the same way.
#
# Distinct from #168 (UI language). This is the physical keyboard.
ask_keyboard() {
    log "Step: ask_keyboard"
    # An unattended run has nobody to answer this. The default is
    # safe, and adding PRESEED_HAS_KEYMAP to compute_unattended would
    # instead make every answer file that predates #995 stop being
    # unattended — breaking the same installs a second way.
    if [ "$FULLY_UNATTENDED" = "1" ] && [ -z "${PRESEED_HAS_KEYMAP:-}" ]; then
        log "Unattended: no keymap preseeded, keeping the default"
        return 2
    fi
    if [ -n "${PRESEED_HAS_KEYMAP:-}" ]; then
        log "Preseed: keymap=$KEYMAP (skipping prompt)"
        _apply_keymap "$KEYMAP" || \
            log "WARN: could not apply keymap $KEYMAP on the live system"
        return 2
    fi
    # Ordered by how likely they are rather than alphabetically — a menu
    # is scanned, not searched — plus an escape hatch for the rest.
    #
    # Outer loop so Back out of "Something else" returns to THIS menu rather
    # than leaving the screen: picking the escape hatch and changing your
    # mind is not the same gesture as going back a wizard step. (`return 2`
    # would be the wrong way to express that — the screen has drawn, and
    # claiming otherwise is the inverted-#554 bug just fixed in
    # ask_application_config.)
    local pick
    while true; do
    pick=$(whiptail --backtitle "$BACKTITLE" --title "Keyboard layout" \
        --cancel-button "Back" \
        --default-item "$KEYMAP" \
        --menu "Applied straight away, so the password screen uses it.\n\nGet this wrong and a password with symbols is mangled now AND at every login afterwards." \
        22 70 12 \
        "us"       "English (US)" \
        "uk"       "English (UK)" \
        "de"       "German (QWERTZ)" \
        "fr"       "French (AZERTY)" \
        "es"       "Spanish" \
        "it"       "Italian" \
        "pt"       "Portuguese" \
        "br-abnt2" "Portuguese (Brazil, ABNT2)" \
        "ca"       "Canadian (multilingual)" \
        "dk"       "Danish" \
        "fi"       "Finnish" \
        "no"       "Norwegian" \
        "se"       "Swedish" \
        "nl"       "Dutch" \
        "pl"       "Polish" \
        "cz"       "Czech" \
        "ru"       "Russian" \
        "jp106"    "Japanese (106)" \
        "other"    "Something else - type the keymap name" \
        3>&1 1>&2 2>&3) \
        || return 1
    if [ "$pick" = "other" ]; then
        while true; do
            pick=$(whiptail --backtitle "$BACKTITLE" --title "Keyboard layout" \
                --cancel-button "Back" \
                --inputbox "Keyboard layout code (e.g. 'be', 'hu', 'tr', 'gr').\n\nThese are XKB layout names - the two-letter code for the country in most cases. From a shell: localectl list-x11-keymap-layouts" \
                14 70 -- "$KEYMAP" 3>&1 1>&2 2>&3) \
                || continue 2
            # Refuse a layout that cannot be applied, rather than
            # silently leaving the operator on US — the same bug one
            # screen later in a different disguise. #1003 item 1a: this
            # loop used to be unescapable, because the mechanism it
            # validated against could not load ANY name.
            if [ -n "$pick" ] && _apply_keymap "$pick"; then
                break
            fi
            whiptail --backtitle "$BACKTITLE" --title "Unknown keymap" \
                --msgbox "'$pick' is not a layout this system can compile.\n\nRun 'localectl list-x11-keymap-layouts' from a shell to see the names." 11 68 || true
        done
    else
        _apply_keymap "$pick" || \
            log "WARN: could not apply keymap $pick; the console stays on the previous layout"
    fi
    break
    done
    KEYMAP="$pick"
    log "Keymap: $KEYMAP"
}

# loadkeys the given map. Non-zero when it does not exist, which is what
# lets the "other" prompt above re-ask instead of accepting a typo.
#
# Returns 0 when loadkeys is absent: on a machine without it there is no
# layout to get wrong, and refusing every name would make the prompt
# impossible to satisfy.
_apply_keymap() {
    # #1003 item 1a — this used to be `loadkeys -- "$1"`, and it could
    # NEVER succeed. The image has no keymaps at all: Debian ships them in
    # `console-data`, which mkosi.conf does not install, so
    # /usr/share/keymaps and /usr/lib/kbd/keymaps are both absent and
    # loadkeys fails for every name including the `us` default. Verified
    # against a trixie image with exactly our package set.
    #
    # Worse than a no-op, because the "Something else" loop refuses any
    # name _apply_keymap cannot load: every name failed, so an operator
    # with a non-listed layout was stuck at that prompt with no way
    # forward and a hint (`localectl list-keymaps`) that would also have
    # come back empty.
    #
    # ckbcomp compiles an XKB layout into a console keymap on stdout, and
    # it IS present — console-setup ships it and pulls in xkb-data. That
    # is also the mechanism console-setup itself uses on the installed
    # system, so the live console and the installed console now agree
    # rather than being configured two different ways.
    command -v ckbcomp >/dev/null 2>&1 || return 0
    command -v loadkeys >/dev/null 2>&1 || return 0
    local xkb_layout xkb_variant xkb_model
    _keymap_to_xkb "$1"
    # Array, not `${v:+-variant $v}`: an empty variant must contribute NO
    # argument, and unquoted expansion to build one would word-split a
    # value like "Canadian Multilingual".
    local -a args=(-model "$xkb_model" -layout "$xkb_layout")
    [ -n "$xkb_variant" ] && args+=(-variant "$xkb_variant")
    # ckbcomp exits non-zero on an unknown layout, which is what makes the
    # retry loop a real validator instead of a formality. `loadkeys -`
    # reads the compiled map from stdin. pipefail is on, so either half
    # failing fails the function.
    ckbcomp "${args[@]}" 2>>"$INSTALL_LOG" | loadkeys - >>"$INSTALL_LOG" 2>&1
}

# Console keymap -> XKB layout/variant/model, into the caller's
# xkb_layout / xkb_variant / xkb_model.
#
# These are two different namespaces and the first cut wrote the console
# name into both files. console-setup feeds XKBLAYOUT to ckbcomp, which
# knows `gb` and not `uk`, `br`+variant `abnt2` and not `br-abnt2`, `jp`
# and not `jp106` — so on exactly the layouts item 17 was filed for,
# ckbcomp fails, console-setup falls back to US, and the operator meets
# the mangled password at the login prompt one boot later. Since #1003
# item 1a this map is on the LIVE path too — _apply_keymap compiles
# through ckbcomp rather than calling loadkeys with a console name that
# the image has no file for.
#
# Only the names that actually differ are listed; anything else passes
# through, which is right for the great majority (de, fr, es, it, …) and
# is the safe answer for an operator-typed "other" value.
_keymap_to_xkb() {
    xkb_model="pc105"
    xkb_variant=""
    case "$1" in
        uk)         xkb_layout="gb" ;;
        br-abnt2)   xkb_layout="br"; xkb_variant="abnt2" ;;
        jp106)      xkb_layout="jp"; xkb_model="jp106" ;;
        dvorak)     xkb_layout="us"; xkb_variant="dvorak" ;;
        us-acentos) xkb_layout="us"; xkb_variant="intl" ;;
        *)          xkb_layout="$1" ;;
    esac
}

# ── NTP (issue #995 item 16) ──────────────────────────────────────────
#
# The wizard asked for a timezone and never for a time source, so a lab
# with no route to the default pool came up with a clock nothing
# corrects. That is not cosmetic: the supervisor's first TLS handshake
# against the control plane fails "certificate not yet valid" and the
# pairing is rejected, both of which read as a networking fault.
ask_ntp() {
    log "Step: ask_ntp"
    local _ntp_loop=0
    # An unattended run has nobody to answer this. The default is
    # safe, and adding PRESEED_HAS_NTP to compute_unattended would
    # instead make every answer file that predates #995 stop being
    # unattended — breaking the same installs a second way.
    if [ "$FULLY_UNATTENDED" = "1" ] && [ -z "${PRESEED_HAS_NTP:-}" ]; then
        log "Unattended: no NTP preseeded, keeping the default"
        return 2
    fi
    if [ -n "${PRESEED_HAS_NTP:-}" ]; then
        log "Preseed: ntp_servers=$NTP_SERVERS (skipping prompt)"
        return 2
    fi
    # Pre-fill from DHCP option 42 when the lease carried one: a site with
    # its own time servers usually hands them out, and typing them again
    # is both work and a chance to get one wrong.
    local dhcp_ntp
    dhcp_ntp="$(_dhcp_ntp_servers)"
    if [ -n "$dhcp_ntp" ] && [ "$NTP_SERVERS" = "pool.ntp.org" ]; then
        NTP_SERVERS="$dhcp_ntp"
        log "NTP servers pre-filled from the DHCP lease: $NTP_SERVERS"
    fi
    local hint=""
    [ -n "$dhcp_ntp" ] && hint="\n\nDHCP offered: $dhcp_ntp"
    while : ; do
    _ntp_loop=$((_ntp_loop + 1))
    # Assign to a temp and commit after the cancel check. `VAR=$(whiptail
    # …) || return 1` lands the empty string FIRST, and because empty is a
    # legitimate answer here ("air-gapped, trusted RTC") a pure Back press
    # silently turned a configured time source into none at all.
    local ntp_pick
    ntp_pick=$(whiptail --backtitle "$BACKTITLE" --title "Time source" \
        --cancel-button "Back" \
        --inputbox "NTP servers, space-separated. Names or addresses.\n\nThis clock is now: $(date -u '+%Y-%m-%d %H:%M UTC')\n\nOn a network with no route to the public pool, put your own server here — a clock nothing corrects breaks TLS and pairing on first boot.$hint" \
        17 74 -- "$NTP_SERVERS" 3>&1 1>&2 2>&3) \
        || return 1
    # Validate the same way the preseed door does. Without this the two
    # doors disagreed: an operator typing the very natural comma-separated
    # "ntp1.corp,ntp2.corp" produced `server ntp1.corp,ntp2.corp iburst`,
    # which chronyd refuses — the "clock nothing corrects" outcome this
    # screen exists to prevent, arrived at by a different route.
    local bad_ntp="" _tok
    for _tok in $ntp_pick; do
        case "$_tok" in
            *[!A-Za-z0-9._:-]*|"") bad_ntp="$bad_ntp $_tok" ;;
        esac
    done
    if [ -n "$bad_ntp" ]; then
        whiptail --backtitle "$BACKTITLE" --title "Not a server name" \
            --msgbox "These are not hostnames or IP addresses:$bad_ntp"$'\n\n'"Separate several servers with SPACES, not commas." 12 70 || true
        continue
    fi
    NTP_SERVERS="$ntp_pick"
    # Empty is a legitimate answer: an air-gapped site with a hardware
    # clock it trusts, or one that will push NTP from the control plane
    # later. Since #1002 it means exactly that — no sources file, Debian's
    # own `pool` line and the DHCP sourcedir commented out, and
    # platform_settings.ntp_pool_servers seeded EMPTY so the #154 plane does
    # not push the public pool back a few minutes into the first boot.
    break
    done
    if [ -z "$NTP_SERVERS" ]; then
        log "NTP: no servers configured (operator left it blank)"
    else
        log "NTP servers: $NTP_SERVERS"
    fi
}

# #1002 — make a blank Time source answer mean what it says.
#
# Removing our sources.d file does NOT stop chrony. Debian's own
# /etc/chrony/chrony.conf carries `pool 2.debian.pool.ntp.org iburst`, and
# `sourcedir` is additive — so an operator who cleared the field kept
# synchronising against the public Debian pool while four surfaces told them
# there was no time source. Non-negotiable #17: that is an outbound
# connection they explicitly declined.
#
# The DHCP sourcedir goes too, and deliberately. The prompt PRE-FILLS the
# field with the servers the lease offered and shows them as a hint, so
# clearing it is an explicit rejection of exactly those. Leaving
# /run/chrony-dhcp live would also make "none" false again the moment
# NetworkManager renewed a lease carrying option 42.
#
# `sourcedir /etc/chrony/sources.d` and `confdir /etc/chrony/conf.d` are
# left alone: both are empty here (our own file is removed just above) and
# they are the way back for an operator who changes their mind without
# hand-editing a conffile.
#
# chrony DOES have a confdir on Debian stable — contrary to the issue text —
# but it is additive like sourcedir, so nothing dropped into it can retract
# a `pool` line. Suppression has to happen in chrony.conf, which is a dpkg
# conffile; the edit is therefore marked, line-preserving and reversible by
# deleting the marker prefix, and dpkg's default (--force-confold) keeps it
# across a chrony package upgrade.
#
# It composes with #154 because that runner REPLACES chrony.conf wholesale:
# central config simply wins. The platform renderer emits no `sourcedir` at
# all, which is why the same answer must ALSO reach
# platform_settings.ntp_pool_servers as [] — see INITIAL_NTP_SERVERS below
# and models.settings.NTP_EXPLICITLY_NONE. Verified against chrony 4.6.1:
# `chronyd -p -f` still passes, the daemon starts with zero sources, and
# `chronyc tracking` reports "Not synchronised", which is the truth.
NTP_DECLINED_MARK="# spatium-install (#1002): time source declined by the operator — "
_suppress_default_ntp_sources() {
    local conf="$1" before after
    if [ ! -f "$conf" ]; then
        log "NTP: $conf absent, nothing to suppress"
        return 0
    fi
    before=$(grep -cE '^[[:space:]]*(pool|server|peer)[[:space:]]+|^[[:space:]]*sourcedir[[:space:]]+/run/chrony-dhcp' "$conf" || true)
    sed -i -E \
        -e "s%^([[:space:]]*(pool|server|peer)[[:space:]]+.*)\$%${NTP_DECLINED_MARK}\1%" \
        -e "s%^([[:space:]]*sourcedir[[:space:]]+/run/chrony-dhcp.*)\$%${NTP_DECLINED_MARK}\1%" \
        "$conf"
    after=$(grep -cE '^[[:space:]]*(pool|server|peer)[[:space:]]+|^[[:space:]]*sourcedir[[:space:]]+/run/chrony-dhcp' "$conf" || true)
    if [ "$after" -ne 0 ]; then
        # Not fatal — a clock that keeps syncing is not a broken install —
        # but it must not be silent, because every surface now says "none".
        log "WARN: NTP: $after source line(s) still active in $conf after suppression"
    else
        log "NTP: suppressed $before default source line(s) in chrony.conf (operator declined)"
    fi
}

# NTP servers from the live DHCP lease (option 42), space-separated.
#
# NetworkManager drops them into /run/chrony-dhcp/*.sources — which is a
# chrony sourcedir, so the LIVE system is already using them; reading
# that back is both the least code and the most faithful answer. The
# lease files under /var/lib/NetworkManager are the fallback for a
# systemd-networkd or dhclient live environment.
_dhcp_ntp_servers() {
    local out="" f srv
    for f in /run/chrony-dhcp/*.sources; do
        [ -f "$f" ] || continue
        while read -r _kw srv _rest; do
            case "$_kw" in server|pool) [ -n "$srv" ] && out+="$srv " ;; esac
        done < "$f"
    done
    if [ -z "$out" ]; then
        for f in /var/lib/NetworkManager/*.lease /var/lib/dhcp/*.leases; do
            [ -f "$f" ] || continue
            srv=$(sed -n 's/.*option ntp-servers \([^;]*\);.*/\1/p' "$f" | tail -1 | tr -d ',')
            [ -n "$srv" ] && out+="$srv "
        done
    fi
    # Deduplicate, preserve order.
    printf '%s' "$out" | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//'
}

# ── SSH authorized_keys (issue #995 item 18) ──────────────────────────
#
# Optional, and skipped by default. The value is that the very first SSH
# into a fresh appliance can be key-based, on a box whose whole point is
# that nobody sits at its console.
#
# Interaction worth knowing, and stated on the screen: once the control
# plane manages SSH keys centrally (#157), its list REPLACES this file.
# A key added here is a bootstrap, not a permanent grant.
ask_ssh_keys() {
    log "Step: ask_ssh_keys"
    # An unattended run has nobody to answer this. The default is
    # safe, and adding PRESEED_HAS_SSH_KEYS to compute_unattended would
    # instead make every answer file that predates #995 stop being
    # unattended — breaking the same installs a second way.
    if [ "$FULLY_UNATTENDED" = "1" ] && [ -z "${PRESEED_HAS_SSH_KEYS:-}" ]; then
        log "Unattended: no SSH keys preseeded, keeping the default"
        return 2
    fi
    if [ -n "${PRESEED_HAS_SSH_KEYS:-}" ]; then
        log "Preseed: $(_ssh_key_count) SSH key(s) supplied (skipping prompt)"
        return 2
    fi
    local choice
    while true; do
        choice=$(whiptail --backtitle "$BACKTITLE" --title "SSH public key" \
            --cancel-button "Back" \
            --menu "Authorise an SSH key for '$ADMIN_USER'?\n\nOptional — password SSH works either way. Currently held: $(_ssh_key_count) key(s)." \
            17 74 4 \
            "skip"   "No key — password SSH only" \
            "paste"  "Paste a public key" \
            "url"    "Fetch from a URL (or a GitHub username)" \
            "done"   "Finished — continue with the keys above" \
            3>&1 1>&2 2>&3) \
            || return 1
        case "$choice" in
            skip)
                SSH_AUTHORIZED_KEYS=""
                SSH_DISABLE_PASSWORD="no"
                log "SSH: no authorized key"
                return 0
                ;;
            paste)
                local key
                key=$(whiptail --backtitle "$BACKTITLE" --title "Paste public key" \
                    --inputbox "One public key, the whole line:\n\nssh-ed25519 AAAAC3Nza... you@host" \
                    13 74 3>&1 1>&2 2>&3) || continue
                _add_ssh_key "$key" || true
                ;;
            url)
                local src fetched
                src=$(whiptail --backtitle "$BACKTITLE" --title "Fetch public keys" \
                    --inputbox "A URL serving public keys, or a bare GitHub username.\n\n  alice                  -> https://github.com/alice.keys\n  https://example/id.pub\n\nThe installer fetches this only because you asked it to. See docs/PRIVACY.md for every outbound request it can make." \
                    16 74 3>&1 1>&2 2>&3) || continue
                [ -n "$src" ] || continue
                case "$src" in
                    http://*|https://*) : ;;
                    # A bare word is a GitHub username. Anything with a
                    # slash or a dot is not, and guessing would turn a
                    # typo'd URL into a request to github.com.
                    *[!A-Za-z0-9-]*)
                        whiptail --msgbox "That is neither a URL nor a GitHub username." 8 60 || true
                        continue
                        ;;
                    *) src="https://github.com/$src.keys" ;;
                esac
                if ! fetched=$(curl -fsS --max-time 10 "$src" 2>&1); then
                    whiptail --backtitle "$BACKTITLE" --title "Fetch failed" \
                        --msgbox "$src"$'\n\n'"$fetched" 12 72 || true
                    continue
                fi
                # _add_ssh_key's own modal is for the single-line PASTE
                # path. Here the loop reports a total afterwards, and a
                # server that answers 200 with an HTML page would
                # otherwise draw one blocking dialog per line — hundreds,
                # over IPMI, with no way to abort. SPATIUM_QUIET_KEY_ADD
                # suppresses it; the count below is the report.
                local added=0 line
                while IFS= read -r line; do
                    SPATIUM_QUIET_KEY_ADD=1 _add_ssh_key "$line" && added=$((added + 1))
                done <<EOF
$fetched
EOF
                if [ "$added" -eq 0 ]; then
                    whiptail --msgbox "Nothing at $src looked like a public key." 8 66 || true
                else
                    whiptail --msgbox "Added $added key(s) from $src." 8 66 || true
                fi
                ;;
            done)
                break
                ;;
        esac
    done

    if [ "$(_ssh_key_count)" -gt 0 ]; then
        # Only ever offered WITH a key present. Offering it without one
        # would let an operator lock themselves out of a headless box in
        # two keystrokes.
        if whiptail --backtitle "$BACKTITLE" --title "Disable password SSH?" \
            --defaultno --yes-button "Key only" --no-button "Keep passwords" \
            --yesno "$(_ssh_key_count) key(s) will be authorised for '$ADMIN_USER'.\n\nAlso refuse SSH password logins?\n\nThe console still takes a password, so this is recoverable — but test the key before you rely on it." \
            15 72; then
            SSH_DISABLE_PASSWORD="yes"
        else
            SSH_DISABLE_PASSWORD="no"
        fi
    fi
    log "SSH: $(_ssh_key_count) authorized key(s), password auth $([ "$SSH_DISABLE_PASSWORD" = yes ] && echo disabled || echo enabled)"
}

_ssh_key_count() {
    printf '%s' "$SSH_AUTHORIZED_KEYS" | grep -c '[^[:space:]]' || true
}

# Append one key after checking it IS one.
#
# ssh-keygen is the right validator rather than a regex: it is on the
# appliance (a hard dependency of openssh-server), it is what sshd itself
# parses with, and it rejects the truncated paste — the commonest failure
# — that a regex on the leading "ssh-" would wave through. A key sshd
# will not load is worse than no key: the operator believes they have
# access and discovers otherwise after the reboot.
_add_ssh_key() {
    local key="$1" tmp
    key="${key#"${key%%[![:space:]]*}"}"
    case "$key" in ''|'#'*) return 1 ;; esac
    if command -v ssh-keygen >/dev/null 2>&1; then
        tmp=$(mktemp) || return 1
        printf '%s\n' "$key" > "$tmp"
        if ! ssh-keygen -l -f "$tmp" >/dev/null 2>&1; then
            rm -f "$tmp"
            if [ -z "${SPATIUM_QUIET_KEY_ADD:-}" ]; then
                whiptail --backtitle "$BACKTITLE" --title "Not a public key" \
                    --msgbox "That line is not a public key ssh could load.\n\nA truncated paste is the usual cause — the line must be complete, on ONE line." 12 70 || true
            fi
            return 1
        fi
        rm -f "$tmp"
    fi
    if [ -n "$SSH_AUTHORIZED_KEYS" ]; then
        SSH_AUTHORIZED_KEYS="$SSH_AUTHORIZED_KEYS
$key"
    else
        SSH_AUTHORIZED_KEYS="$key"
    fi
    return 0
}

ask_role() {
    log "Step: ask_role"
    if [ -n "${PRESEED_HAS_ROLE:-}" ]; then
        log "Preseed: role=$ROLE (skipping prompt)"
        return 2
    fi
    # #272 UX — reframe the install role around the decision operators
    # actually make ("is this my FIRST SpatiumDDI node, or am I adding
    # one to an existing install?") instead of the jargon control-plane
    # vs appliance, which most people don't read past. The radio TAGS
    # are operator-facing (``add-node`` / ``first-node``) and map back to
    # the internal ROLE values (``appliance`` / ``control-plane``) that
    # firstboot + the supervisor consume — so downstream is unchanged.
    #
    # ``add-node`` (appliance) is listed first + default: it's the common
    # case once a control plane exists, and it's the non-destructive
    # choice. ``first-node`` (control-plane) creates a NEW, standalone
    # SpatiumDDI (its own DB + cluster), so a wrong pick there is the
    # real footgun — it's guarded by an explicit confirm below. The
    # per-row ON flag reflects $ROLE so backing in preserves the pick.
    local first_flag=OFF add_flag=OFF
    case "$ROLE" in
        control-plane) first_flag=ON ;;
        *) add_flag=ON ;;  # appliance (or unset) → default
    esac
    local pick
    while true; do
        pick=$(whiptail --backtitle "$BACKTITLE" --title "What is this node?" \
            --cancel-button "Back" \
            --radiolist "Is this your FIRST SpatiumDDI node, or are you adding one to an existing install?\n\n  Additional node  (default)\n    Pairs with an EXISTING SpatiumDDI over an 8-digit code; an\n    admin then approves it and assigns DNS / DHCP roles in the\n    Fleet UI. Can be PROMOTED into the control-plane cluster later\n    — this is how you add control-plane nodes for HA (NOT by\n    installing 'First node' again).\n\n  First node\n    Creates a NEW SpatiumDDI: the control plane (api + database +\n    web UI) + k3s seed. DNS + DHCP stay OFF — enable them per node\n    from the Fleet UI. Pick this for a homelab, a single box, or\n    the seed of a brand-new HA cluster." \
            27 84 2 \
            "add-node"   "Additional node — DNS/DHCP agent (promotable)" "$add_flag" \
            "first-node" "First node — new control plane (api+db+UI)" "$first_flag" \
            3>&1 1>&2 2>&3) || return 1
        if [ -z "$pick" ]; then
            whiptail --msgbox "Please pick an option to continue." 9 60 || true
            continue
        fi
        case "$pick" in
            add-node)
                ROLE="appliance"
                break
                ;;
            first-node)
                # Confirm guard — the accidental-footgun direction. A new
                # control plane is a separate database + cluster; adding
                # to an existing SpatiumDDI must use "Additional node"
                # then promote. --defaultno so a blind Enter says No.
                if whiptail --backtitle "$BACKTITLE" \
                    --title "Create a NEW control plane?" \
                    --defaultno --yes-button "Yes, new" --no-button "Go back" \
                    --yesno "This creates a NEW, standalone SpatiumDDI — its own database and cluster.\n\nIf you are ADDING a node to an existing SpatiumDDI (for HA, or as a DNS / DHCP agent), choose \"Additional node\" instead, then promote it from the Fleet UI.\n\nCreate a new control plane on this box?" \
                    16 76; then
                    ROLE="control-plane"
                    break
                fi
                # No → re-show the radio with the safe default pre-selected.
                first_flag=OFF
                add_flag=ON
                continue
                ;;
        esac
    done
    log "Selected role: $ROLE"
}

# #995 item 13 — is that URL a SpatiumDDI control plane, and can this box
# reach it? Asked while the live system still has its network and the
# target disk is still intact.
#
# ``GET <url>/api/v1/version`` is the right probe: unauthenticated (#903
# made it the version handshake), cheap, and it answers the question the
# operator actually has, which is not "does something listen there" but
# "is that MY control plane". A typo landing on some other host's web
# server fails the JSON check rather than passing a reachability ping.
#
# The pairing code deliberately is NOT probed. It can only be validated
# by claiming it, and an unauthenticated "is this code valid" endpoint
# would be an oracle for guessing eight digits. A reachable control plane
# is the check worth having.
#
# Echoes a one-line verdict; returns 0 reachable, 1 not.
_probe_control_plane() {
    local url="$1" body rc insecure=""
    # Tolerate a trailing slash either way.
    url="${url%/}"
    # -L because the appliance frontend 301s http -> https, and the
    # supervisor this probe predicts sets follow_redirects=True for
    # exactly that reason. Without it a lab operator's http:// URL comes
    # back rc 0 with an EMPTY body and is reported as the wrong host.
    #
    # --connect-timeout so an unroutable host fails in 3 s rather than
    # freezing the TUI for the full budget.
    body=$(curl -fsSL --max-time 8 --connect-timeout 3 \
        -H 'Accept: application/json' \
        "$url/api/v1/version" 2>&1)
    rc=$?
    # A SpatiumDDI control plane serves a self-signed cert until an ACME
    # or operator cert is installed (firstboot generates one), and the
    # supervisor skips verification for that reason. Refusing here would
    # red-screen the DEFAULT topology and train operators to click
    # through the one dialog that catches a real typo. So retry
    # unverified and say so, rather than either failing or hiding it.
    if [ "$rc" -eq 60 ]; then
        body=$(curl -fsSLk --max-time 8 --connect-timeout 3 \
            -H 'Accept: application/json' \
            "$url/api/v1/version" 2>&1)
        rc=$?
        [ "$rc" -eq 0 ] && insecure=" (self-signed cert, not verified)"
    fi
    if [ "$rc" -ne 0 ]; then
        # curl's own message is more useful than any paraphrase: it
        # distinguishes DNS failure from refused from TLS from timeout,
        # which is exactly what the operator needs to fix it.
        printf '%s' "${body:-curl exited $rc}"
        return 1
    fi
    # One pass: an empty result IS the "not a version document" verdict,
    # so the two matchers cannot disagree about what one is.
    local ver
    ver=$(printf '%s' "$body" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ -z "$ver" ]; then
        printf '%s' "Reachable, but the reply carries no version string. Is this the right host?"
        return 1
    fi
    printf 'SpatiumDDI %s%s' "$ver" "$insecure"
    return 0
}

ask_application_config() {
    local _drew_something=0
    # Only fires for the Appliance role. The control-plane role IS a
    # control plane — it doesn't need to be told where one is.
    # (Function/step name kept historical to avoid churning the wizard
    # state machine; it gates on the appliance role now.)
    if [ "$ROLE" != "appliance" ]; then
        return 2
    fi
    log "Step: ask_application_config"

    if [ -n "${PRESEED_HAS_CONTROL_URL:-}" ]; then
        log "Preseed: control_plane_url=$CONTROL_PLANE_URL (skipping prompt)"
    else
        _drew_something=1
        local default_url="${CONTROL_PLANE_URL:-https://}"
        while true; do
            # Re-prefill whatever was last typed, so Retry / Edit do not
            # make the operator start over.
            [ -n "$CONTROL_PLANE_URL" ] && default_url="$CONTROL_PLANE_URL"
            CONTROL_PLANE_URL=$(whiptail --backtitle "$BACKTITLE" \
                --title "Control plane URL" \
                --cancel-button "Back" \
                --inputbox "Where does this Additional node register?\n\nFormat: https://<control-plane-host>/  — the URL of the SpatiumDDI control plane this supervisor pairs against. The supervisor submits its Ed25519 pubkey here, sits in pending until an admin clicks Approve, then receives a control-plane-CA-signed identity cert.\n\nHA TIP: if the control plane is a multi-node cluster, point this at the MetalLB virtual IP (VIP), NOT a single node's IP — otherwise this appliance loses its control plane whenever that one node is down. Configure the VIP under Appliance -> Network & Host on the control plane.\n\nUse https:// in production; http:// is acceptable for lab installs." \
                21 78 -- "$default_url" 3>&1 1>&2 2>&3) \
                || return 1
            if [ -z "$CONTROL_PLANE_URL" ] || [ "$CONTROL_PLANE_URL" = "https://" ]; then
                whiptail --msgbox "Control-plane URL is required for an Additional node." 8 62 || true
                continue
            fi
            # #995 item 13 — probe before the disk is touched. A typo here
            # is otherwise discovered on the first boot of the installed
            # system, when the supervisor cannot register and the only
            # symptom is an appliance that never appears in Fleet.
            local probe
            if probe=$(_probe_control_plane "$CONTROL_PLANE_URL"); then
                whiptail --backtitle "$BACKTITLE" --title "Control plane reachable" \
                    --msgbox "$CONTROL_PLANE_URL"$'\n\n'"Answered: $probe" 11 72 || true
                break
            fi
            # Continue-anyway is a real option, not politeness: the
            # control plane may legitimately not be up yet (staging both
            # ends at once), and this box may be on an install VLAN that
            # cannot see it. Refusing would make the installer unusable
            # for those, so the choice is the operator's — but they make
            # it having seen curl's actual error.
            local choice
            choice=$(whiptail --backtitle "$BACKTITLE" \
                --title "Control plane NOT reachable" \
                --cancel-button "Back" \
                --menu "$CONTROL_PLANE_URL"$'\n\n'"$probe"$'\n\nNothing has been written to disk yet.' \
                18 74 3 \
                "retry"    "Try again (the control plane may still be starting)" \
                "edit"     "Edit the URL" \
                "continue" "Continue anyway — I know it is not up yet" \
                3>&1 1>&2 2>&3) || return 1
            case "$choice" in
                retry)    continue ;;
                edit)     default_url="$CONTROL_PLANE_URL"; continue ;;
                continue)
                    log "Operator continued past an unreachable control plane: $CONTROL_PLANE_URL ($probe)"
                    break
                    ;;
            esac
        done
    fi

    # Pairing code only — an Additional node never pastes a long
    # bootstrap key. The supervisor generates its own Ed25519 keypair
    # on first boot and submits the pubkey against the code; the
    # control plane stores it and waits for admin approval. The 8-digit
    # code is the only thing the operator types over an IPMI / serial
    # console.
    if [ -n "${PRESEED_HAS_PAIRING_CODE:-}" ]; then
        log "Preseed: pairing code supplied (skipping prompt)"
        # ...but only "drew nothing" if the URL half drew nothing either.
        # The two preseed keys are INDEPENDENT — the parser accepts a
        # pairing code with no control_plane_url and only note()s it — so
        # this path could draw the URL inputbox plus the reachability
        # msgbox and then return 2. The state machine reads 2 as "keep
        # going the way you were going", so a Back press from `confirm`
        # landed here, took an answer, and then continued BACKWARDS to
        # ask_k3s_cidrs instead of forward to confirm. The #554 class,
        # inverted.
        [ "$_drew_something" = "1" ] && return 0
        return 2
    fi
    # #995 item 1 (prerequisite) — tracing OFF for the whole loop, exactly
    # as ask_user_password does for the password. Without it `set -x`
    # writes `code_val=12345678` and `BOOTSTRAP_PAIRING_CODE=12345678`
    # into the trace log — which on_failure tails 30 lines of TO THE
    # CONSOLE on any non-zero exit, and which item 1 now copies onto the
    # installed system. #581 closed this hole for the admin password and
    # missed the pairing code beside it; a persistent multi-claim code is
    # a fleet-join credential, not a spent nonce.
    local code_val
    { set +x; } 2>/dev/null
    while true; do
        code_val=$(whiptail --backtitle "$BACKTITLE" --title "Pairing code" \
            --cancel-button "Back" \
            --inputbox "Enter the 8-digit pairing code from the control plane.\n\nMint one at https://<control-plane>/appliance → Pairing → 'New pairing code'. Single-use ephemeral codes expire after 15 min by default; persistent codes (multi-claim) stay valid until disabled or revoked.\n\nAfter the supervisor claims the code, the appliance sits in pending — ask the control plane admin to click Approve in the fleet UI to issue the identity cert and assign a role." \
            18 78 -- "$BOOTSTRAP_PAIRING_CODE" 3>&1 1>&2 2>&3) \
            || { set -x; return 1; }
        # The frontend displays codes as ``1234-5678`` for
        # readability; an operator typing in dashes or spaces from
        # what they see on screen should validate cleanly. Strip
        # every non-digit before checking the length.
        code_val=$(echo "$code_val" | tr -cd '0-9')
        if [ -z "$code_val" ]; then
            whiptail --msgbox "Pairing code is required for an Additional node." 8 62 || true
            continue
        fi
        # Validate: exactly 8 decimal digits after stripping. Catch
        # typos before firstboot tries to redeem the code and fails
        # with a generic 403 (which we'd then surface on the console).
        if ! [[ "$code_val" =~ ^[0-9]{8}$ ]]; then
            whiptail --msgbox "Pairing code must be 8 decimal digits (dashes / spaces accepted as separators).\n\nGot after strip: $code_val" 10 60 || true
            continue
        fi
        break
    done
    BOOTSTRAP_PAIRING_CODE="$code_val"
    set -x
    log "Additional node paired against $CONTROL_PLANE_URL with an 8-digit pairing code"
}

# #554 — every disk backing the live boot medium, one /dev/<disk> per
# line. The old inline code checked only ``findmnt -no SOURCE
# /run/live/medium``; with ``boot=live toram`` (or a layout that unmounts
# the medium) that returns empty, so the boot USB — an ``sd*`` device the
# ``grep -vE "^(sr|loop|fd|ram|zram)"`` filter does NOT exclude —
# appeared as a wipe target and picking it destroyed the running install
# media mid-install. Scan /proc/mounts for every /run/live // /lib/live
# mount and map each source back to its parent disk, keeping the
# findmnt-derived one too as belt-and-braces.
#
# Split out of pick_disk (issue #581) so the pre-wipe guard in do_install
# applies the SAME exclusion to a preseeded target_disk, which never goes
# through the picker. One implementation, so the two can't drift.
_live_boot_disks() {
    local _src _mnt _rest _pk
    while read -r _src _mnt _rest; do
        case "$_mnt" in
            /run/live|/run/live/*|/lib/live/mount|/lib/live/mount/*)
                case "$_src" in
                    /dev/*)
                        _pk=$(lsblk -no PKNAME "$_src" 2>/dev/null | head -n1)
                        [ -z "$_pk" ] && _pk=$(basename "$_src")
                        [ -n "$_pk" ] && echo "/dev/$_pk"
                        ;;
                esac
                ;;
        esac
    done < "$PROC_MOUNTS"
    local live_src live_disk
    live_src=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || \
               findmnt -no SOURCE /lib/live/mount/medium 2>/dev/null || true)
    if [ -n "$live_src" ]; then
        live_disk=$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -n1 || true)
        [ -n "$live_disk" ] && echo "/dev/$live_disk"
    fi
}

# ── Disk identity + hazards (issue #995 items 24-26; #999) ───────────

# The stable /dev/disk/by-id name for a disk, or "" when there is none.
#
# #995 item 26 — `sdX` is assigned in discovery order and can land on a
# different physical disk between the picker and the wipe, which #581's
# own comments already note. The by-id name is what an operator can check
# against a label on the drive, and it is what belongs in the log and in
# STATE. `wwn-` is preferred where present because it survives a
# controller change; usb- is skipped because it is the least stable of
# the lot.
_disk_by_id() {
    local dev="$1" real link best=""
    real=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
    for link in /dev/disk/by-id/*; do
        [ -e "$link" ] || continue
        case "${link##*/}" in *-part[0-9]*|usb-*) continue ;; esac
        [ "$(readlink -f "$link" 2>/dev/null)" = "$real" ] || continue
        case "${link##*/}" in
            wwn-*) printf '%s' "${link##*/}"; return 0 ;;
            *) [ -z "$best" ] && best="${link##*/}" ;;
        esac
    done
    printf '%s' "$best"
}

# #999 Part C3 — (re)create the kpartx partition maps for a multipath
# target after its GPT is written. A no-op on anything else.
#
# Verified as a real failure mode, not a theoretical one: without this,
# partition_node returns /dev/mapper/<name>-part4 and nothing has created
# it, so the mkfs that follows creates a regular FILE at that path on the
# installer's tmpfs — and reports success. The install then completes and
# produces a LUN with a partition table and no filesystems.
_kpartx_add() {
    local disk="$1"
    case "$disk" in
        /dev/mapper/*|*/dm-*) ;;
        *) return 0 ;;
    esac
    if ! command -v kpartx >/dev/null 2>&1; then
        log "FATAL: $disk is a device-mapper target but kpartx is not installed."
        exit 1
    fi
    kpartx -u -a -s "$disk" >> "$INSTALL_LOG" 2>&1 || \
        kpartx -a -s "$disk" >> "$INSTALL_LOG" 2>&1 || true
    udevadm settle >> "$INSTALL_LOG" 2>&1 || true
    log "kpartx partition maps for $disk: $(ls -1 "${disk}"-part* 2>/dev/null | tr '\n' ' ')"
}

# #999 Part C3 — the multipath maps present on this machine, as
# "<mapname> <size>" lines. Empty when multipath-tools is not installed
# or no LUN is multipathed, which is every ordinary appliance.
#
# Read from lsblk rather than from `multipath -ll` because lsblk needs no
# daemon: on the live ISO multipathd may not have started, while the dm
# devices udev created are already there.
_multipath_maps() {
    command -v multipath >/dev/null 2>&1 || return 0
    lsblk -dn -o NAME,SIZE,TYPE -r 2>/dev/null | awk '$3 == "mpath" {print $1, $2}'
}

# How many paths back a multipath map. Counts the kernel's own slave
# links, so it needs no daemon and cannot disagree with what the map is
# actually built from.
_mpath_path_count() {
    local name="$1" dm
    dm=$(readlink -f "/dev/mapper/$name" 2>/dev/null || true)
    [ -n "$dm" ] || { echo 0; return 0; }
    ls "/sys/block/$(basename "$dm")/slaves" 2>/dev/null | wc -l | tr -d ' '
}

# The WWN a disk reports, or "". Two paths to the same SAN LUN report the
# same WWN, which is how the picker collapses them (#995 item 24, now #999).
_disk_wwn() {
    local dev="$1" w
    w=$(lsblk -dno WWN "$dev" 2>/dev/null | head -1 | tr -d ' ')
    printf '%s' "$w"
}

# Why this disk must not be installed to, or "" when it is fine.
#
# #995 items 23 + 24 in their honest, shippable form; the capability
# they asked for moved to #999. RAID1 and multipath INSTALL support
# needs mdadm / multipath-tools in the image and initramfs work that is
# not here (see APPLIANCE.md). What IS here is the refusal, because the
# pre-existing behaviour was not "unsupported" but a trap: a SAN LUN
# appears once per path, the picker offered each path as a separate
# disk, and installing to one of them wrote through a single path with
# no failover — an install that looks like it worked. Likewise wiping
# one member of a live md array degrades it silently.
_disk_hazard() {
    local dev="$1" real base holder
    real=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
    base=$(basename "$real")
    # A member of an assembled md array.
    #
    # #999 Part C2 — EXCEPT one that is a member of a SpatiumDDI mirror.
    # Refusing those meant a mirrored appliance could never be
    # reinstalled: both disks are md members, so both were refused, and
    # the "keep /var" path is refused too — the box was a dead end, and
    # the message even told the operator to do the full install that was
    # also impossible. Our own array is a thing the installer knows how
    # to take apart (``_stop_arrays_on`` runs before the wipe), so it is
    # offered with its own tag rather than blocked. Somebody ELSE's array
    # is still refused: wiping one member of it degrades it silently,
    # which is what #995 filed this for.
    for holder in "/sys/block/$base"/holders/md* "/sys/block/$base"/*/holders/md*; do
        [ -e "$holder" ] || continue
        _md_array_is_ours "/dev/$(basename "$holder")" && return 0
        printf '%s' "part of the software RAID array ${holder##*/}, which installing here would degrade"
        return 0
    done
    # One path of a multipath device: dm-multipath has claimed it.
    for holder in "/sys/block/$base"/holders/dm-*; do
        [ -e "$holder" ] || continue
        if [ "$(cat "$holder/dm/uuid" 2>/dev/null | cut -d- -f1)" = "mpath" ]; then
            printf '%s' "one path of a multipath device — installing to a single path gives the installed system no failover"
            return 0
        fi
    done
    printf ''
}

# #999 Part C2 — is this md array one WE built?
#
# Identified by the filesystem label on the array itself: the installer
# mkfs's the mirrored arrays with the same five labels a single-disk
# install uses. An array carrying one of them is a SpatiumDDI layout the
# installer knows how to stop and re-create; anything else belongs to
# the operator and stays refused.
_md_array_is_ours() {
    local md="$1" label
    label=$(lsblk -nro LABEL "$md" 2>/dev/null | head -1)
    case "$label" in
        root_a|root_b|var|state) return 0 ;;
        *) return 1 ;;
    esac
}

# #1045 — resolve a partition of THIS disk by its ext4 filesystem label.
#
# Deliberately not `blkid -L`, which searches every disk on the machine: with
# a second SpatiumDDI disk attached it answers with the OTHER disk's
# partition, and on the KEEP_VAR path that is a `mkfs` on a /var the operator
# never chose. Every caller here has already settled which disk it means.
_labelled_device_on() {
    local dev="$1" want="$2" part label
    for part in $(lsblk -nro NAME "$dev" 2>/dev/null | tail -n +2); do
        label=$(lsblk -nro LABEL "/dev/$part" 2>/dev/null | head -1)
        [ "$label" = "$want" ] && { printf '/dev/%s' "$part"; return 0; }
    done
    return 1
}

# #1045 — every device on this disk that could be one of the two OS slots,
# GPT-name matches first.
#
# The two slots are identified by their GPT PARTLABEL (`root_A` / `root_B`,
# written by `sgdisk -c4:` / `-c5:` below), NOT by the ext4 filesystem label
# the rest of the layout uses. build-slot-image.sh bakes `root_a` into the
# one image both slots are dd'd from, so an upgraded slot B carries `root_a`
# too and NO partition on the disk is labelled `root_b` any more. The GPT
# name survives, because a slot upgrade writes a filesystem, not a table.
# (spatium-upgrade-slot now relabels the filesystem as well, so a disk
# upgraded by a current appliance is consistent — this keeps the installer
# working on every disk written before that.)
#
# The filesystem label is still checked as a fallback, for the #999 mirror:
# the md devices carry the labels and are not partitions, so they have no
# GPT name to match at all.
_slot_candidates_on() {
    local dev="$1" want="$2" part partlabel label
    for part in $(lsblk -nro NAME "$dev" 2>/dev/null | tail -n +2); do
        partlabel=$(lsblk -nro PARTLABEL "/dev/$part" 2>/dev/null | head -1 \
                      | tr '[:upper:]' '[:lower:]')
        [ "$partlabel" = "$want" ] && printf '/dev/%s\n' "$part"
    done
    for part in $(lsblk -nro NAME "$dev" 2>/dev/null | tail -n +2); do
        partlabel=$(lsblk -nro PARTLABEL "/dev/$part" 2>/dev/null | head -1 \
                      | tr '[:upper:]' '[:lower:]')
        # Already printed above; listing it twice would make a caller that
        # stops at the first hit look like it tried two.
        [ "$partlabel" = "$want" ] && continue
        label=$(lsblk -nro LABEL "/dev/$part" 2>/dev/null | head -1)
        [ "$label" = "$want" ] && printf '/dev/%s\n' "$part"
    done
}

# The single best device for one slot, or nothing. `head -1` and not a
# `return` inside the loop: _slot_candidates_on is a pipeline source.
_slot_device_on() {
    local first
    first=$(_slot_candidates_on "$1" "$2" | head -1)
    [ -n "$first" ] || return 1
    printf '%s' "$first"
}

# Is there already a SpatiumDDI install on this disk? Prints its version
# when there is (#995 item 25).
_existing_install_version() {
    # ver="" because it is only assigned inside the `if mount` branch and
    # read unconditionally after it — under `set -u` a failed mount killed
    # the command-substitution subshell, so the caller silently got "" and
    # the whole "Keep /var" offer disappeared. A dirty ext4 that will not
    # mount read-only is exactly when someone reinstalls.
    local dev="$1" slot cand ver="" mnt found=0 tried=""
    # #1045 — both slots, and by GPT name as well as by filesystem label.
    # Slot A alone was not enough on two counts: an upgraded disk carries
    # `root_a` on BOTH slots (so the label says nothing about which is
    # which), and a slot that mounts but carries no release file used to
    # short-circuit the whole function to "unknown version" without ever
    # looking at the other one — which is the state slot B is in on every
    # freshly installed appliance that has not upgraded yet.
    #
    # Slot A is still tried first, so the common answer does not change.
    # When both slots hold a release this reports A's, which on a node
    # booted from B is the older, inactive one. Left as it is: determining
    # the active slot from the ISO means reading grubenv off the ESP, and
    # this string only decides how a "there is an install here" prompt is
    # WORDED — the prompt itself is gated on the layout, not the version.
    for slot in root_a root_b; do
        for cand in $(_slot_candidates_on "$dev" "$slot"); do
            # On a disk carrying the #1045 duplicate, slot B answers to BOTH
            # names — so without this it is mounted twice and the 10 s stall
            # this loop is bounded by is paid three times per disk, in the
            # enumeration that runs before the operator has picked anything.
            case " $tried " in *" $cand "*) continue ;; esac
            tried="$tried $cand"
            found=1
            mnt=$(mktemp -d) || return 1
            # noload: a plain `mount -o ro` on ext4 REPLAYS THE JOURNAL, so
            # merely enumerating disks would write to one the operator has not
            # chosen. Timeout because an unresponsive LUN or USB stick blocks
            # in uninterruptible D state for the SCSI timeout with the console
            # showing nothing.
            if timeout 10 mount -o ro,noload -t ext4 "$cand" "$mnt" 2>/dev/null; then
                ver=$(_appliance_version_from "$mnt/etc/spatiumddi/appliance-release")
                umount "$mnt" 2>/dev/null || true
            fi
            rmdir "$mnt" 2>/dev/null || true
            [ -n "$ver" ] && { printf '%s' "$ver"; return 0; }
        done
    done
    # A slot is there but nothing in it says what it is — still an install,
    # and still worth marking the disk.
    [ "$found" = 1 ] && { printf '%s' "unknown version"; return 0; }
    printf ''
}

# Does this disk already carry the six-partition layout do_install
# creates, with a /var big enough to be worth keeping (#995 item 25)?
#
# Checked by IDENTITY rather than by partition number, so a disk carrying
# the layout at other indices is still reusable — but the identity is not
# one thing (#1045). ESP / state / var go by filesystem label, which is
# what the image-baseline fstab addresses them by. The two OS slots go by
# GPT name, because a slot upgrade overwrites the filesystem and with it
# the label: the header this replaced claimed the labels were "what fstab
# and spatium-upgrade-slot address", and for the slots neither was ever
# true — fstab has no root entry at all, and spatium-upgrade-slot matches
# on PARTLABEL. Believing it cost every upgraded appliance the offer
# below.
_layout_is_reusable() {
    local dev="$1" want
    # #999 Part C2 — NOT reusable when the labels live on an md array.
    #
    # lsblk walks holders, so on a mirrored install the md devices show
    # up here carrying the labels and the layout looks reusable. It is
    # not, and what breaks is downstream: KEEP_VAR forces MIRROR_MODE
    # off, so the reinstalled slot gets an initrd with no md_mod, no
    # raid1 and no mdadm.conf, and the box does not come back.
    #
    # The hazard on the way there INVERTED with #1045, which matters to
    # whoever implements the mirror-preserving reinstall below. This used
    # to say the KEEP_VAR branch resolved by LABEL and so would mkfs the
    # ARRAY instead of a member. It no longer resolves by label at all,
    # and on a mirror only the live raid MEMBERS carry a GPT name — so
    # without this gate the slots would resolve to the members and the
    # mkfs would land on a disk the array is still using, destroying the
    # mirror rather than merely writing to the wrong level of it.
    #
    # Carrying the mirror through a reinstall is a real capability and a
    # bigger change than this: it has to rediscover the second member
    # from the array, re-run the bootloader on it and re-sync its ESP.
    # Until that exists, refusing is the honest answer — the operator
    # gets a full mirror install instead, which works.
    if _layout_is_on_md "$dev"; then
        log "Layout on $dev sits on an md array — 'keep /var' is not offered (#999)"
        return 1
    fi
    # ESP / state / var keep the filesystem label as their identity, because
    # that is what the image-baseline fstab resolves them by. The two OS
    # slots do NOT (#1045): a slot upgrade rewrites the filesystem and with
    # it the label, so `root_b` is absent on every disk that has ever
    # upgraded, and gating on it here silently withdrew the whole "Keep
    # /var" offer from exactly the long-lived appliances most likely to
    # want it. The GPT name is the thing a slot upgrade cannot touch.
    for want in ESP state var; do
        if ! _labelled_device_on "$dev" "$want" >/dev/null; then
            # Every return below used to be bare, so a missing label was
            # indistinguishable from "this disk is not ours" — which is how
            # #1045 went unnoticed through a release. Name it.
            log "Layout on $dev is not reusable — no partition labelled '$want'"
            return 1
        fi
    done
    local _a _b
    for want in root_a root_b; do
        if ! _slot_device_on "$dev" "$want" >/dev/null; then
            log "Layout on $dev is not reusable — no OS slot '$want' (no GPT name, no filesystem label)"
            return 1
        fi
    done
    # Both slots resolved, but to the same device? Only a disk with one GPT
    # name and the other slot identified by a filesystem label can do that,
    # and do_install refuses it outright. Refuse HERE too: the alternative
    # is offering "Keep /var", letting the operator answer hostname, admin
    # account, network and timezone, and then aborting at the wipe — the
    # refusal has to be where the offer is made.
    _a=$(_slot_device_on "$dev" root_a) || return 1
    _b=$(_slot_device_on "$dev" root_b) || return 1
    if [ "$_a" = "$_b" ]; then
        log "Layout on $dev is not reusable — both OS slots resolve to $_a"
        return 1
    fi
    return 0
}

# Does this disk carry a partition that is a member of an assembled md
# array? Distinct from _disk_hazard, which answers "must not install
# here": a SpatiumDDI mirror IS ours and is a legitimate target for a
# full reinstall — just not for a table-preserving one.
_layout_is_on_md() {
    local dev="$1" base holder
    base=$(basename "$(readlink -f "$dev" 2>/dev/null || echo "$dev")")
    for holder in "/sys/block/$base"/holders/md* "/sys/block/$base"/*/holders/md*; do
        [ -e "$holder" ] && return 0
    done
    return 1
}

# #999 Part C2 — offer a RAID1 mirror onto a second disk.
#
# Returns 0 to continue (mirrored or not), 1 to send the operator back to
# the target-disk menu. Sets MIRROR_MODE / TARGET_DISK2 /
# TARGET_DISK2_BY_ID.
#
# The candidate list is built with the SAME rules the target picker uses,
# because a mirror member is every bit as much an install target as the
# first disk:
#   * the live boot medium is excluded,
#   * SAN LUN paths are collapsed by WWN so one LUN is one row,
#   * _disk_hazard refuses an md member or a multipath path,
#   * the member must be at least as large as the target.
#
# That last one is the one that is easy to get backwards. raid1 sizes the
# array to the SMALLEST member, so a smaller second disk does not fail —
# it silently shrinks /var, on a layout whose sizes the operator just
# confirmed. Refusing is the only honest answer.
_ask_mirror_disk() {
    local target_bytes="$1"

    # The preseed short-circuit comes FIRST, before the reset. The other
    # order clears the very values the answer file just supplied — latent
    # today because pick_disk returns early on PRESEED_HAS_DISK and never
    # reaches here, but it would silently drop a preseeded mirror the
    # moment that changed, and "silently single-disk" is the outcome the
    # parser refuses so hard to avoid.
    if [ -n "${PRESEED_HAS_MIRROR_DISK:-}" ]; then
        log "Preseed: mirror member $TARGET_DISK2 (RAID1)"
        return 0
    fi

    MIRROR_MODE="no"
    TARGET_DISK2=""
    TARGET_DISK2_BY_ID=""
    # A preseeded target with no mirror key means a single-disk install
    # was asked for explicitly; do not stop an unattended run to ask.
    if [ -n "${PRESEED_HAS_DISK:-}" ]; then
        return 0
    fi

    local options=() line name size model wwn hazard bytes _d
    declare -A seen_wwn=()
    # Rebuild the live-medium set locally rather than leaning on
    # pick_disk's local of the same name. Bash's dynamic scoping WOULD
    # make the caller's visible, and that is exactly the kind of
    # invisible coupling that breaks the day this is called from
    # anywhere else — with the failure being "the installer offers you
    # the USB stick it is running from" as a mirror member.
    declare -A live_disks=()
    while IFS= read -r _d; do
        [ -n "$_d" ] && live_disks["$_d"]=1
    done < <(_live_boot_disks)
    # The target's own WWN, so its other paths are never offered as a
    # "second" disk — mirroring a LUN onto itself is not redundancy.
    wwn=$(_disk_wwn "$TARGET_DISK")
    [ -n "$wwn" ] && seen_wwn["$wwn"]="$TARGET_DISK"
    while IFS= read -r line; do
        name=$(echo "$line" | awk '{print $1}')
        size=$(echo "$line" | awk '{print $2}')
        model=$(echo "$line" | cut -d' ' -f3- | sed -e 's/\\x20/ /g' -e 's/  */ /g')
        [ -z "$model" ] && model="(no model)"
        [ "/dev/$name" = "$TARGET_DISK" ] && continue
        [ -n "${live_disks[/dev/$name]:-}" ] && continue
        wwn=$(_disk_wwn "/dev/$name")
        if [ -n "$wwn" ]; then
            [ -n "${seen_wwn[$wwn]:-}" ] && continue
            seen_wwn["$wwn"]="/dev/$name"
        fi
        hazard=$(_disk_hazard "/dev/$name")
        [ -n "$hazard" ] && continue
        bytes=$(blockdev --getsize64 "/dev/$name" 2>/dev/null || echo 0)
        [ "$bytes" -lt "$target_bytes" ] && continue
        options+=("/dev/$name" "$size - $(_ellipsis "$model" 40)")
    done < <(lsblk -dn -o NAME,SIZE,MODEL -r 2>/dev/null | grep -vE "^(sr|loop|fd|ram|zram)")

    if [ ${#options[@]} -eq 0 ]; then
        log "Mirror not offered: no eligible second disk (>= target size, not a hazard)"
        return 0
    fi

    if ! whiptail --backtitle "$BACKTITLE" --title "Mirror the OS across two disks?" \
        --defaultno --yesno \
        "SpatiumDDI can install onto a software RAID1 mirror, so the appliance keeps running and keeps BOOTING when one disk dies.\n\nThe OS slots, STATE and /var are mirrored. The EFI system partition cannot be (firmware reads it before the RAID driver exists), so each disk gets its own and SpatiumDDI keeps them in step on every upgrade.\n\nALL DATA on the second disk will be DESTROYED too.\n\nMirror onto a second disk?" \
        20 74; then
        log "Operator declined the RAID1 mirror; single-disk install"
        return 0
    fi

    local pick
    pick=$(whiptail --backtitle "$BACKTITLE" --title "Mirror member" \
        --cancel-button "Back" \
        --menu "Select the second disk.\nALL DATA on it will be DESTROYED.\n\nOnly disks at least as large as $TARGET_DISK are listed: a RAID1 is the size of its smallest member, so a smaller disk would silently shrink /var." \
        20 "$_DISK_MENU_W" 8 "${options[@]}" 3>&1 1>&2 2>&3) || return 1

    MIRROR_MODE="yes"
    TARGET_DISK2="$pick"
    TARGET_DISK2_BY_ID=$(_disk_by_id "$TARGET_DISK2")
    log "Mirror member: $TARGET_DISK2 (${TARGET_DISK2_BY_ID:-no by-id name})"
    return 0
}

pick_disk() {
    log "Step: pick_disk"
    if [ -n "${PRESEED_HAS_DISK:-}" ]; then
        # Skipping the picker also skips its live-medium exclusion and
        # size floor — _assert_safe_wipe_target re-applies both (plus the
        # whole-disk check) immediately before the wipe (#581).
        log "Preseed: target_disk=$TARGET_DISK (confirm_wipe authorised; skipping picker — pre-wipe guard still applies)"
        # #995 item 26 — resolve the stable name here too. It was only set
        # in the interactive branch below, so every headless install wrote
        # target_disk_by_id: "" and exported the unstable /dev/sdX into the
        # answer file whose whole purpose is fleet cloning.
        TARGET_DISK_BY_ID=$(_disk_by_id "$TARGET_DISK")
        return 2
    fi
    # Box width first: every item is then budgeted to fit inside it.
    # 70 was hardcoded and the items were not checked against it at all.
    local _DISK_MENU_W _DISK_ITEM_COLS
    _DISK_MENU_W=$(_whiptail_width 88)
    # newt spends the rest of the row on the tag column and the frame:
    # 2 border + 2 padding each side + the gap between tag and item. The
    # longest tag we can emit is a device node ("/dev/nvme0n1" = 12; 16
    # covers anything lsblk hands us), so reserve that plus 7 of chrome.
    _DISK_ITEM_COLS=$((_DISK_MENU_W - 16 - 7))
    [ "$_DISK_ITEM_COLS" -lt 24 ] && _DISK_ITEM_COLS=24

    local options=()
    local -A live_disks=()
    local _d
    while IFS= read -r _d; do
        [ -n "$_d" ] && live_disks["$_d"]=1
    done < <(_live_boot_disks)

    local -A seen_wwn=()
    while IFS= read -r line; do
        local name size model wwn hazard existing
        name=$(echo "$line" | awk '{print $1}')
        size=$(echo "$line" | awk '{print $2}')
        # `lsblk -r` hex-escapes unsafe characters, so a model reads
        # "Samsung\\x20SSD\\x20860" — ugly, and three columns per space
        # wider than it needs to be in a box that has to fit.
        model=$(echo "$line" | cut -d' ' -f3- | sed -e 's/\\x20/ /g' -e 's/  */ /g')
        [ -z "$model" ] && model="(no model)"
        # Skip any disk that backs the live boot medium.
        [ -n "${live_disks[/dev/$name]:-}" ] && continue
        # #995 item 24 / #999 — collapse the paths of one SAN LUN. Without this
        # the same LUN is offered three or four times and picking any of
        # them installs through a single path.
        wwn=$(_disk_wwn "/dev/$name")
        if [ -n "$wwn" ]; then
            if [ -n "${seen_wwn[$wwn]:-}" ]; then
                log "Disk /dev/$name is another path to $wwn (already listed as ${seen_wwn[$wwn]}) — not offered twice"
                continue
            fi
            seen_wwn["$wwn"]="/dev/$name"
        fi
        # #995 item 25 — say when a disk already carries an install, so
        # the operator can tell the target from the one they meant.
        existing=$(_existing_install_version "/dev/$name")
        # #995 items 23 + 24 / #999 — mark, do not hide. A hidden disk reads as
        # a missing disk; a marked one explains itself.
        hazard=$(_disk_hazard "/dev/$name")
        local suffix=""
        [ -n "$existing" ] && suffix=" [installed: $existing]"
        [ -n "$hazard" ] && suffix="$suffix [UNSUPPORTED]"
        # #999 — a SpatiumDDI mirror member is installable (the arrays are
        # stopped before the wipe) but the operator must be told that
        # BOTH halves of the mirror go, not just this disk.
        if [ -z "$hazard" ] && _layout_is_on_md "/dev/$name"; then
            suffix="$suffix [RAID member — mirror destroyed]"
        fi
        # The SUFFIXES are budgeted first and the MODEL absorbs whatever is
        # left, because newt does not truncate an over-wide --menu item — it
        # writes past the frame and the box border is destroyed. Reported
        # from a real reinstall: item 25's suffix pushed an ordinary
        # "32G - QEMU HARDDISK" nine columns over, and only on a REINSTALL,
        # since that is the one case where the suffix exists at all.
        # `model` is the right thing to clip: it is the only unbounded part
        # (vendor strings run to 40+ chars) and the least load-bearing, where
        # the size and the two flags are what the operator is choosing on.
        local budget=$((_DISK_ITEM_COLS - ${#size} - ${#suffix} - 3))
        if [ "$budget" -lt 8 ]; then
            # Clip the SUFFIX, do not floor-restore the budget. `budget=8`
            # alone hands back up to 7 columns that were already spent, so
            # the emitted item exceeds _DISK_ITEM_COLS — breaking the exact
            # invariant this block exists to enforce. Reachable: a disk that
            # is both a hazard AND carries an install whose version file is
            # unreadable gives a 43-column suffix, and with a 17-column tag
            # (/dev/mmcblk0boot0 — lsblk lists eMMC boot devices and the
            # filter does not drop them) that destroys the frame, because
            # newt sizes the tag column from the longest tag on the menu.
            suffix=$(_ellipsis "$suffix" "$((_DISK_ITEM_COLS - ${#size} - 3 - 8))")
            budget=8
        fi
        options+=("/dev/$name" "$size - $(_ellipsis "$model" "$budget")$suffix")
    done < <(lsblk -dn -o NAME,SIZE,MODEL -r 2>/dev/null | grep -vE "^(sr|loop|fd|ram|zram|dm-)")

    # #999 Part C3 — offer the multipath MAPS themselves.
    #
    # ``dm-`` is filtered OUT of the generic loop above, and that filter
    # is load-bearing rather than cosmetic. Without it every multipath
    # LUN appears twice — once as the raw ``/dev/dm-N`` and once as the
    # friendly ``/dev/mapper/<name>`` added below — and the two rows are
    # not equivalent: ``partition_node`` maps ``/dev/dm-N`` to
    # ``/dev/dm-N-partN``, which kpartx never creates, so the mkfs that
    # follows writes a regular FILE onto the installer's tmpfs and
    # reports success. The install then completes and produces a LUN with
    # a partition table and no filesystems — the exact failure
    # ``_kpartx_add`` exists to prevent, reachable through the other row.
    # (An LVM LV or a LUKS mapping is a ``dm-`` too, and is not a valid
    # whole-disk install target either.)
    #
    # The loop above lists whole disks, and a SAN LUN's individual paths
    # are both collapsed by WWN and refused by _disk_hazard, so before
    # this a LUN presented over multipath was simply not installable.
    # The map is the correct target: writing through /dev/mapper/mpathX
    # goes down whichever path is healthy, which is the entire point.
    while IFS= read -r line; do
        local mp_name mp_size mp_paths
        mp_name=$(echo "$line" | awk '{print $1}')
        [ -n "$mp_name" ] || continue
        mp_size=$(echo "$line" | awk '{print $2}')
        mp_paths=$(_mpath_path_count "$mp_name")
        # A map down to one path is offered but flagged: installing to it
        # works and has no failover, which the operator should be told
        # rather than have discovered at the next switch reboot.
        local mp_suffix=" [$mp_paths paths]"
        [ "$mp_paths" -le 1 ] && mp_suffix=" [$mp_paths path — NO FAILOVER]"
        options+=("/dev/mapper/$mp_name" "$mp_size - multipath LUN$mp_suffix")
    done < <(_multipath_maps)

    if [ ${#options[@]} -eq 0 ]; then
        log "No installable disks found (lsblk: $(lsblk -dn -o NAME,SIZE,TYPE 2>&1 | tr '\n' ';'))"
        whiptail --backtitle "$BACKTITLE" --title "No disks" \
            --msgbox "No installable disks found.\n\nAttach a target disk to the VM and reboot." 10 60 \
            || true
        on_cancel "disk picker (no disks present)"
    fi

    # Pick-and-validate loop. If the operator picks a disk that's too
    # small for the A/B layout, show the error immediately + send them
    # back to the menu — used to fire much later from inside
    # do_install AFTER the operator had already filled out hostname /
    # admin user / network / timezone, which was wasted typing.
    local MIN_BYTES=$((MIN_DISK_GIB * 1024 * 1024 * 1024))
    while true; do
        TARGET_DISK=$(whiptail --backtitle "$BACKTITLE" --title "Target Disk" \
            --cancel-button "Back" \
            --menu "Select the disk to install SpatiumDDI to.\nALL DATA on the chosen disk will be DESTROYED." \
            20 "$_DISK_MENU_W" 10 "${options[@]}" 3>&1 1>&2 2>&3) \
            || return 1
        # #995 items 23 + 24 / #999 — refuse before the size check, because a
        # multipath path or an md member is not made acceptable by being
        # big enough.
        local why_not
        why_not=$(_disk_hazard "$TARGET_DISK")
        if [ -n "$why_not" ]; then
            whiptail --backtitle "$BACKTITLE" --title "Unsupported target" \
                --msgbox "$TARGET_DISK is $why_not."$'\n\n'"Installing to software RAID or to a multipath LUN is not supported yet (issue #999). Pick a plain disk, or break the array / disable multipathing first."$'\n\n'"Nothing has been written." 16 74 || true
            continue
        fi
        local DISK_BYTES
        DISK_BYTES=$(blockdev --getsize64 "$TARGET_DISK" 2>/dev/null || echo 0)
        if [ "$DISK_BYTES" -ge "$MIN_BYTES" ]; then
            # Hard floor cleared. The Control plane role gets a second,
            # SOFT check against the recommended figures (#312) — it can
            # proceed under-spec but is warned about first-boot
            # DiskPressure. A declined warning re-prompts the disk menu.
            if _control_plane_sizing_ok "$DISK_BYTES"; then
                # #995 item 26 — resolve and record the stable name.
                TARGET_DISK_BY_ID=$(_disk_by_id "$TARGET_DISK")
                # #995 item 25 — offer the reinstall the layout was
                # designed for. Only when the labels are all there: a
                # partial or foreign layout must take the full wipe, not a
                # guess about which partition is which.
                KEEP_VAR="no"
                local existing
                existing=$(_existing_install_version "$TARGET_DISK")
                if [ -n "$existing" ] && _layout_is_reusable "$TARGET_DISK"; then
                    # A --yesno here made ESC (whiptail exit 255) AND a
                    # blind Enter both select the destructive branch. Every
                    # other destructive gate in this wizard demands positive
                    # consent; an ambiguous keypress must not authorise
                    # wiping the database. A menu with no default has no
                    # accidental answer, and Cancel re-asks.
                    local keepvar_pick
                    while true; do
                        keepvar_pick=$(whiptail --backtitle "$BACKTITLE" \
                            --title "Existing SpatiumDDI install" \
                            --cancel-button "Back" \
                            --menu "$TARGET_DISK already has a SpatiumDDI install ($existing) with the standard layout.\n\n  Keep  - the database, logs, container images and the machine identity (SSH host keys, supervisor keypair) survive. Both OS slots are replaced, and the existing partition table is reused so the sizes cannot change.\n  Erase - everything goes, as a fresh install." \
                            20 76 2 \
                            "keep"  "Keep /var and STATE" \
                            "erase" "Erase everything on $TARGET_DISK" \
                            3>&1 1>&2 2>&3) || continue
                        case "$keepvar_pick" in
                            keep)  KEEP_VAR="yes"; break ;;
                            erase) KEEP_VAR="no";  break ;;
                        esac
                    done
                fi
                log "Picked target disk $TARGET_DISK (${TARGET_DISK_BY_ID:-no by-id name}) ($((DISK_BYTES / 1024 / 1024 / 1024)) GiB) keep_var=$KEEP_VAR"
                # #999 Part C2 — offer the mirror. Only after the target
                # is settled, and never on the reinstall path: KEEP_VAR
                # reuses the EXISTING table, and turning a single-disk
                # install into a mirror means repartitioning both disks,
                # which is precisely what "keep /var" says not to do.
                if [ "$KEEP_VAR" = "yes" ]; then
                    MIRROR_MODE="no"
                    TARGET_DISK2=""
                elif ! _ask_mirror_disk "$DISK_BYTES"; then
                    continue   # operator backed out of the mirror screen
                fi
                break
            fi
            continue
        fi
        log "Operator picked $TARGET_DISK ($((DISK_BYTES / 1024 / 1024 / 1024)) GiB) — below ${MIN_DISK_GIB} GiB minimum; re-prompting"
        whiptail --backtitle "$BACKTITLE" --title "Disk too small" --msgbox \
            "Target disk $TARGET_DISK is only $((DISK_BYTES / 1024 / 1024 / 1024)) GiB.\n\nSpatiumDDI's A/B atomic-upgrade layout needs at least ${MIN_DISK_GIB} GiB:\n  ESP        512 MiB\n  STATE      256 MiB\n  root_A       8 GiB\n  root_B       8 GiB\n  var       remainder (≥14 GiB usable)\n\nThe slots carry the full container image set (issue #170 Wave A4) so the appliance works air-gapped without ghcr.io, and /var must hold the k3s image store + database + logs without tipping the kubelet DiskPressure threshold on the Control plane role (issue #312).\n\nPick a different disk, or Cancel out to attach a larger one." 21 76
    done
}

# #312 — soft sizing gate for the heavy Control plane role. The hard
# floor in pick_disk only guarantees the appliance installs + boots; the
# Control plane (k3s etcd + CloudNativePG + Redis + api/worker/beat/
# frontend, plus 2× HA replicas) wants REC_CP_DISK_GIB / REC_CP_RAM_GIB
# or its first boot risks a DiskPressure eviction storm — the image pull
# + Postgres/Redis PVCs land on a small /var and tip the kubelet nodefs
# threshold into an evict / image-GC thrash loop that never converges.
#
# Warns, does not block (the operator can knowingly proceed). Returns 0
# to proceed with the picked disk, 1 to send them back to the disk menu.
# No-op for the lightweight Appliance/agent role — 32 GiB is plenty
# there, so it never sees this.
_control_plane_sizing_ok() {
    local disk_bytes="$1"
    [ "$ROLE" = "control-plane" ] || return 0

    local disk_gib ram_kib ram_gib under_disk=0 under_ram=0
    disk_gib=$((disk_bytes / 1024 / 1024 / 1024))
    ram_kib=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 0)
    # Round RAM to the nearest GiB for display; MemTotal sits a little
    # under provisioned RAM (kernel reserve).
    ram_gib=$(((ram_kib + 524288) / 1024 / 1024))

    [ "$disk_gib" -lt "$REC_CP_DISK_GIB" ] && under_disk=1
    # Warn one GiB under the recommendation so a box provisioned at
    # exactly REC_CP_RAM_GIB (whose MemTotal reads slightly low) doesn't
    # false-warn. ram_kib==0 means /proc/meminfo was unreadable — skip
    # the RAM dimension rather than warn on bad data.
    if [ "$ram_kib" -gt 0 ] && [ "$ram_kib" -lt $(((REC_CP_RAM_GIB - 1) * 1024 * 1024)) ]; then
        under_ram=1
    fi
    if [ "$under_disk" -eq 0 ] && [ "$under_ram" -eq 0 ]; then
        return 0
    fi

    local msg
    msg="The Control plane is the heaviest role — k3s + PostgreSQL (CloudNativePG) + Redis + api / worker / beat / frontend, plus 2× HA replicas.\n\n"
    msg+="Recommended:  ≥ ${REC_CP_DISK_GIB} GiB disk,  ≥ ${REC_CP_RAM_GIB} GiB RAM\n"
    msg+="This machine:  ${disk_gib} GiB disk"
    [ "$ram_kib" -gt 0 ] && msg+=",  ~${ram_gib} GiB RAM"
    msg+="\n\nIt will INSTALL and boot, but at this size the first boot pulls the full control-plane image set onto /var while the Postgres + Redis volumes also land there — very likely tipping the kubelet's DiskPressure threshold into a pod-eviction / image-GC thrash loop that never converges.\n\n"
    msg+="See \"Recommended sizing\" in the README / docs/deployment/APPLIANCE.md.\n\n"
    msg+="Continue with this disk anyway?"

    # --defaultno so a careless Enter re-picks rather than committing to a
    # known-risky control-plane install.
    if whiptail --backtitle "$BACKTITLE" --title "Control plane: below recommended size" \
        --defaultno --yesno "$msg" 23 78; then
        log "Operator acknowledged under-spec control-plane sizing (disk=${disk_gib}G ram=${ram_gib}G); proceeding"
        return 0
    fi
    log "Operator declined under-spec control-plane sizing (disk=${disk_gib}G ram=${ram_gib}G); re-prompting disk"
    return 1
}

# Issue #276 — partition-layout confirmation. Shows the exact GPT
# layout that ``do_install`` will create on $TARGET_DISK and forces
# the operator to tick a confirmation checkbox before proceeding.
# Back (or an un-ticked box) returns to disk selection so a misclick
# costs nothing.
confirm_partition_layout() {
    log "Step: confirm_partition_layout"
    if [ -n "${PRESEED_HAS_DISK:-}" ]; then
        # confirm_wipe: true in the preseed IS the wipe authorisation —
        # don't re-prompt the layout checkbox on an unattended run.
        log "Preseed: partition-layout confirm skipped (confirm_wipe authorised $TARGET_DISK)"
        return 2
    fi
    local DISK_BYTES disk_gib var_gib
    DISK_BYTES=$(blockdev --getsize64 "$TARGET_DISK" 2>/dev/null || echo 0)
    disk_gib=$((DISK_BYTES / 1024 / 1024 / 1024))
    # var = total − (1 MiB BBP + 512 MiB ESP + 256 MiB STATE + 2× 8 GiB
    # slots). Round the fixed overhead up to ~17 GiB and subtract 1 for
    # GPT/rounding slack so the figure shown is a safe lower bound.
    var_gib=$(( disk_gib - 17 - 1 ))
    [ "$var_gib" -lt 1 ] && var_gib=1

    local layout
    layout="Layout to be created on $TARGET_DISK ($disk_gib GiB):\n\n"
    layout+="  p1  BIOS boot   1 MiB    legacy boot chain-load\n"
    layout+="  p2  ESP       512 MiB    /boot/efi (FAT32)\n"
    layout+="  p3  STATE     256 MiB    /var/lib/spatium-state\n"
    layout+="                           machine config + SSH host keys +\n"
    layout+="                           supervisor identity (survives OS\n"
    layout+="                           slot swaps + a /var factory reset)\n"
    layout+="  p4  root_A      8 GiB    active OS slot (this install)\n"
    layout+="  p5  root_B      8 GiB    standby OS slot (next upgrade)\n"
    layout+="  p6  var       ~$var_gib GiB    /var — database, k3s, logs\n\n"
    layout+="ALL EXISTING DATA on $TARGET_DISK will be ERASED.\n"
    layout+="There is no undo.\n\n"
    layout+="Tick the box and choose OK to proceed, or Back to pick\n"
    layout+="a different disk."

    while true; do
        local choice
        choice=$(whiptail --backtitle "$BACKTITLE" --title "Confirm Partition Layout" \
            --cancel-button "Back" \
            --checklist "$layout" 24 76 1 \
            "erase" "I understand all data on $TARGET_DISK will be erased" OFF \
            3>&1 1>&2 2>&3) \
            || return 1
        # whiptail returns the ticked tags quoted, e.g. "erase".
        case "$choice" in
            *erase*)
                log "Operator confirmed partition layout for $TARGET_DISK"
                return 0
                ;;
            *)
                whiptail --backtitle "$BACKTITLE" --title "Confirmation required" \
                    --msgbox "You must tick the confirmation box to continue.\n\nChoose Back on the next screen if you'd rather pick a different disk." 10 64 || true
                ;;
        esac
    done
}

ask_hostname() {
    log "Step: ask_hostname"
    if [ -n "${PRESEED_HAS_HOSTNAME:-}" ]; then
        log "Preseed: hostname=$HOSTNAME (skipping prompt)"
        return 2
    fi
    # No pre-filled default — multiple appliances on the same network
    # all named "spatiumddi" caused real-world server-name collisions
    # (the agent registers its SERVER_NAME with the control plane;
    # two agents on the same name conflict). Require operator input.
    while true; do
        HOSTNAME=$(whiptail --backtitle "$BACKTITLE" --title "Hostname" \
            --cancel-button "Back" \
            --inputbox "System hostname (also used as the SERVER_NAME this appliance registers under for DNS / DHCP agent roles, and shown in shell prompts + audit logs).\n\nGive each appliance a unique name (e.g. dns-east-1, dhcp-prod-a, ddi-control)." \
            14 72 -- "$HOSTNAME" 3>&1 1>&2 2>&3) \
            || return 1
        HOSTNAME=$(echo "$HOSTNAME" | tr -d '[:space:]')
        if [ -z "$HOSTNAME" ]; then
            whiptail --msgbox "Hostname is required. Pick something descriptive for this appliance — it shouldn't collide with any other SpatiumDDI box." 9 60 || true
            continue
        fi
        # Loose RFC 1123 sanity: lower-case alphanum + hyphen, no
        # leading / trailing hyphen, length <= 63. Reject anything
        # that systemd-hostnamed would later refuse silently.
        case "$HOSTNAME" in
            *[!a-zA-Z0-9-]*|-*|*-)
                whiptail --msgbox "Hostname must be alphanumeric + hyphen, not start or end with a hyphen, and contain no spaces or dots. Try again." 10 64 || true
                continue
                ;;
        esac
        if [ "${#HOSTNAME}" -gt 63 ]; then
            whiptail --msgbox "Hostname must be 63 characters or fewer." 8 60 || true
            continue
        fi
        break
    done
}

# #995 items 3 + 4 — one validator, two callers.
#
# spatium-preseed-parse already carried the admin_user and timezone
# rules for the headless path; the interactive prompts had none, so a
# username with a space or a mistyped zone sailed through the wizard and
# was discovered (or silently swallowed) at install time. Rather than
# transcribing the reserved-account list and a TZif check into
# bash — two copies that drift — the wizard shells out to the parser's
# ``--check-field`` mode, which is answered before it even imports YAML.
_preseed_parser_path() {
    local parser
    parser="$(dirname "$0")/spatium-preseed-parse"
    [ -f "$parser" ] || parser="/usr/local/bin/spatium-preseed-parse"
    [ -f "$parser" ] || return 1
    printf '%s' "$parser"
}

# Echoes the rejection reason and returns 1 when the value is unusable.
#
# A validator that cannot RUN is deliberately not the same answer as a
# value that is invalid: returning 1 there would make a missing script
# unrecoverably block the wizard, and returning 0 silently would restore
# exactly the unvalidated behaviour these items exist to remove. So it
# accepts and says so LOUDLY in the install log — which #995 item 1 now
# preserves onto the installed system — and do_install's useradd is
# fatal, so a bad username still fails with a named reason rather than
# leaving a box nobody can log into.
#
# Three outcomes, and the caller must be able to tell them apart:
#   rc 0, no output — fine.
#   rc 0, output    — allowed, but here is the caveat. Only
#                     admin_password produces this today (#995 item 11):
#                     a floor that REFUSES weak-ish passwords is one an
#                     operator routes around with something worse they
#                     can retype, so past the hard floor it advises.
#   rc 1, output    — refused, and this is why.
_check_field() {
    local kind="$1" value="$2" parser out rc
    shift 2
    if ! parser=$(_preseed_parser_path); then
        log "WARN: spatium-preseed-parse not found — accepting $kind unvalidated"
        return 0
    fi
    # stderr goes to the LOG, not into $out: under the "exit 0 with
    # stdout means advisory" contract, any Python chatter (a
    # DeprecationWarning, a locale note) would otherwise become a spurious
    # "weak password" modal for a perfectly strong one.
    out=$(python3 "$parser" --check-field "$kind" "$value" "$@" 2>>"$INSTALL_LOG")
    rc=$?
    case "$rc" in
        0) printf '%s' "$out"; return 0 ;;
        2) printf '%s' "$out"; return 1 ;;
        *)
            log "WARN: --check-field $kind failed to run (rc=$rc): $out — accepting unvalidated"
            return 0
            ;;
    esac
}

# As above, but the value goes in on STDIN instead of argv (the parser
# takes ``-`` for this). argv is readable through /proc and lands in
# shell history, so a password must not travel that way — the same
# reasoning as the `set +x` around the prompt itself.
_check_field_stdin() {
    local kind="$1" value="$2" parser out rc
    shift 2
    if ! parser=$(_preseed_parser_path); then
        log "WARN: spatium-preseed-parse not found — accepting $kind unvalidated"
        return 0
    fi
    out=$(printf '%s' "$value" | python3 "$parser" --check-field "$kind" - "$@" 2>>"$INSTALL_LOG")
    rc=$?
    case "$rc" in
        0) printf '%s' "$out"; return 0 ;;
        2) printf '%s' "$out"; return 1 ;;
        *)
            # Fails CLOSED, unlike _check_field. This wrapper carries only
            # the password, and "the validator did not run" must not
            # silently disable the one security control #995 item 11 adds.
            # There is an operator at this prompt who can pick another
            # password; there is nobody to notice a log line.
            log "ERROR: --check-field $kind could not run (rc=$rc) — refusing rather than accepting unvalidated"
            printf '%s' "The password validator could not run (rc=$rc). This is a problem with the installer image, not with your password. Check /var/log/spatium-install.log."
            return 1
            ;;
    esac
}

ask_user_password() {
    log "Step: ask_user_password"
    # Username prompt is skipped when the admin user is preseeded, OR
    # when a preseeded password makes this a headless run (in which case
    # the ADMIN_USER default of "admin" — or a preseeded value — stands).
    if [ -z "${PRESEED_HAS_ADMIN_USER:-}" ] && [ -z "${PRESEED_HAS_PASSWORD:-}" ]; then
        # #995 item 4 — loop until the name is one useradd will actually
        # accept. Empty still means "admin"; anything else is checked
        # against the same rules the preseed path has enforced since
        # #581, so the interactive and headless doors agree.
        #
        # The `--` before the pre-filled default is load-bearing on every
        # re-prompting box in this file, and newly so here: whiptail uses
        # popt, so a default starting with `-` is parsed as an OPTION.
        # `whiptail --inputbox … "-x"` exits 1 with `-x: unknown option`
        # and draws nothing, which the state machine reads as Back — so an
        # operator who typed `-x` gets bounced to the previous screen with
        # no dialog and no explanation, forever, because the rejected
        # value is what gets re-prefilled. Verified against Debian's
        # whiptail: `--` restores the normal path.
        local uerr
        while true; do
            ADMIN_USER=$(whiptail --backtitle "$BACKTITLE" --title "Admin OS user" \
                --cancel-button "Back" \
                --inputbox "OS-level admin username (for SSH + sudo).\n\nThe SpatiumDDI web UI uses 'admin/admin' separately - change it on first login." \
                12 70 -- "$ADMIN_USER" 3>&1 1>&2 2>&3) \
                || return 1
            if [ -z "$ADMIN_USER" ]; then
                ADMIN_USER="admin"
            fi
            if uerr=$(_check_field admin_user "$ADMIN_USER"); then
                break
            fi
            whiptail --backtitle "$BACKTITLE" --title "Invalid username" \
                --msgbox "$uerr" 13 72 || true
        done
    else
        log "Preseed: admin user=$ADMIN_USER (skipping username prompt)"
    fi

    if [ -n "${PRESEED_HAS_PASSWORD:-}" ]; then
        log "Preseed: admin password supplied (skipping prompt)"
        return 2
    fi

    # Tracing OFF for the whole prompt loop (issue #581). The preseed
    # path already suppressed set -x around the secret env (load_preseed)
    # and around chpasswd (do_install), but the INTERACTIVE path did not:
    # `ADMIN_PASSWORD="$p1"` and `[ "$p1" = "$p2" ]` are argv, so xtrace
    # wrote the operator's plaintext password into the trace log — which
    # on_failure tails 30 lines of to the console on any non-zero exit.
    # Re-enabled at the end of the loop on EVERY exit path (both `return
    # 1`s restore it first).
    { set +x; } 2>/dev/null
    while true; do
        local p1 p2 pwerr
        p1=$(whiptail --backtitle "$BACKTITLE" --title "Admin password" \
            --cancel-button "Back" \
            --passwordbox "Password for '$ADMIN_USER'.\n\nAt least 8 characters. This is the console + sudo password." 12 64 \
            3>&1 1>&2 2>&3) \
            || { set -x; return 1; }
        p2=$(whiptail --backtitle "$BACKTITLE" --title "Confirm password" \
            --cancel-button "Back" \
            --passwordbox "Repeat:" 10 60 3>&1 1>&2 2>&3) \
            || { set -x; return 1; }
        if [ "$p1" != "$p2" ]; then
            whiptail --backtitle "$BACKTITLE" \
                --msgbox "Passwords don't match. Try again." 8 50 || true
            continue
        fi
        # #995 item 11 — the same rules the preseed path applies, over
        # stdin so the password never reaches argv. A refusal re-prompts;
        # an advisory is shown once and the operator decides.
        if ! pwerr=$(_check_field_stdin admin_password "$p1" "$ADMIN_USER" "$HOSTNAME"); then
            whiptail --backtitle "$BACKTITLE" --title "Password not accepted" \
                --msgbox "$pwerr" 12 66 || true
            continue
        fi
        if [ -n "$pwerr" ]; then
            if ! whiptail --backtitle "$BACKTITLE" --title "Weak password" \
                --defaultno --yes-button "Use it anyway" --no-button "Change it" \
                --yesno "$pwerr"$'\n\n'"Use this password anyway?" 13 66; then
                continue
            fi
        fi
        ADMIN_PASSWORD="$p1"
        break
    done
    set -x

    # #995 item 12 — root used to get the same password unconditionally.
    # sshd already refuses root (mkosi.postinst sets PermitRootLogin no),
    # so this only ever mattered on the console and over IPMI — but a
    # locked root with sudo in front of it is the safer default, and it
    # is the Debian default too. Opt-in, --defaultno, so a blind Enter
    # leaves it locked.
    #
    # Skipped when the password came from a preseed: the answer file has
    # its own ``set_root_password`` key and there is nobody to ask.
    if [ -z "${PRESEED_HAS_SET_ROOT_PASSWORD:-}" ]; then
        if whiptail --backtitle "$BACKTITLE" --title "Root account" \
            --defaultno --yes-button "Set it too" --no-button "Leave locked" \
            --yesno "Also set the SAME password on the root account?\n\nDefault is NO: root stays locked and you use 'sudo' from '$ADMIN_USER'. SSH already refuses root either way, so this only affects the physical / IPMI console.\n\nSay yes only if you specifically want a root console login." \
            15 72; then
            SET_ROOT_PASSWORD="yes"
        else
            SET_ROOT_PASSWORD="no"
        fi
    fi
    log "Root password will be $([ "$SET_ROOT_PASSWORD" = yes ] && echo set || echo locked)"
}

# ── Live network facts (issue #995 items 19, 20, 22) ──────────────────
#
# The installer's own host is already on the network the appliance will
# live on. Three screens used to ignore that and make the operator retype
# what the box in front of them already knows.

# Ethernet-ish interfaces, one per line.
#
# Kept as a WIDENING of the rule this replaced (`ls /sys/class/net |
# grep -E "^(en|eth)"`), not a narrowing: that rule is what has shipped,
# and a NIC the picker does not list is a box the operator cannot
# configure. So the predictable names still match by prefix, plus
# anything carrying a `device` symlink — which catches a real NIC that
# udev named something else — minus an explicit list of the virtual
# devices a re-run from an installed system would otherwise offer.
#
# Filtering virtual devices by NAME rather than by the absence of a
# `device` symlink is deliberate: a bridge or bond master has no such
# symlink either, and on some virtio configurations neither does a real
# NIC, so absence is not evidence.
_net_interfaces() {
    local i
    for i in /sys/class/net/*; do
        [ -e "$i" ] || continue
        i=$(basename "$i")
        case "$i" in
            lo|bonding_masters) continue ;;
            veth*|docker*|cni*|flannel*|br-*|virbr*|kube*|cali*|tunl*|nodelocaldns*) continue ;;
        esac
        case "$i" in
            en*|eth*) echo "$i" ;;
            *) [ -e "/sys/class/net/$i/device" ] && echo "$i" ;;
        esac
    done
}

# One human line per interface for the picker: link state, speed, the
# address the live system currently holds, and the driver.
#
# #995 item 19 — the old picker showed name + MAC, which does not answer
# the only question an operator has in front of a multi-port server:
# which socket is the cable in. `operstate` answers it; `carrier` is not
# usable here because reading it on a down interface returns EINVAL.
_iface_summary() {
    local i="$1" state speed addr drv out
    state=$(cat "/sys/class/net/$i/operstate" 2>/dev/null || echo "unknown")
    speed=$(cat "/sys/class/net/$i/speed" 2>/dev/null || true)
    addr=$(ip -4 -br addr show dev "$i" 2>/dev/null | awk '{print $3}' | head -1)
    drv=$(basename "$(readlink -f "/sys/class/net/$i/device/driver" 2>/dev/null || true)" 2>/dev/null || true)
    case "$state" in
        up)   out="UP" ;;
        down) out="DOWN" ;;
        *)    out="$state" ;;
    esac
    # A negative or absent speed means the driver cannot report one,
    # which is normal for a down link and for some virtio NICs.
    case "$speed" in
        ''|-*) : ;;
        *) out="$out ${speed}Mb" ;;
    esac
    [ -n "$addr" ] && out="$out $addr"
    [ -n "$drv" ] && [ "$drv" != "." ] && out="$out ($drv)"
    printf '%s' "$out"
}

# The address / gateway / resolvers the LIVE system is using on $1.
# Prints three lines: "<ip> <prefix>", "<gateway>", "<dns...>". Empty
# lines where the answer is unknown. Feeds item 20's "use what I already
# have" button and item 22's overlap check.
_iface_live_config() {
    local i="$1" cidr gw dns
    cidr=$(ip -4 -br addr show dev "$i" 2>/dev/null | awk '{print $3}' | head -1)
    printf '%s %s\n' "${cidr%%/*}" "${cidr##*/}"
    gw=$(ip -4 route show default dev "$i" 2>/dev/null | awk '{for (n=1;n<NF;n++) if ($n=="via") print $(n+1)}' | head -1)
    printf '%s\n' "$gw"
    # resolvectl knows per-link servers; /etc/resolv.conf is the fallback
    # and on a systemd-resolved box points at the stub, which is useless
    # as a value to install — so filter the stub out.
    dns=$(resolvectl dns "$i" 2>/dev/null | sed -n 's/^.*: *//p' | head -1)
    if [ -z "$dns" ]; then
        dns=$(awk '/^nameserver/ && $2 !~ /^127\./ {printf "%s ", $2}' /etc/resolv.conf 2>/dev/null)
    fi
    printf '%s\n' "$dns"
}

# The LAN subnet to check the k3s CIDRs against when the operator chose
# DHCP (#995 item 22).
#
# _k3s_cidr_error only ever knew the LAN in static mode, so a site whose
# LAN is 10.42.0.0/16 — the k3s pod default, and the range this whole
# check exists for — sailed through on the DHCP path, which is the one
# most installs take. The live system is holding a lease on that LAN
# right now.
#
# Deliberately NOT used by `--check-preseed`: that runs on somebody's
# workstation, whose lease says nothing about the appliance's future LAN.
_dhcp_lease_subnet() {
    [ "$NET_MODE" = "static" ] && return 0
    local i cidr
    if [ -n "$NET_INTERFACE" ]; then
        i="$NET_INTERFACE"
    else
        i=$(ip -4 -br addr show scope global 2>/dev/null \
            | awk '$3!="" {sub(/@.*/, "", $1); print $1; exit}')
    fi
    [ -n "$i" ] || return 0
    cidr=$(ip -4 -br addr show dev "$i" 2>/dev/null | awk '{print $3}' | head -1)
    [ -n "$cidr" ] && printf '%s' "$cidr"
}

# #554 — validate the static-IP fields with Python's ``ipaddress`` (same
# approach as the k3s CIDR step). Without this, a blank gateway wrote
# ``address1=<ip>/<prefix>,`` (trailing comma) into the NetworkManager
# keyfile → NM rejects it → the connection never loads → headless
# appliance comes up with NO IP (console-only recovery). A typo'd
# prefix / IP / gateway failed the same silent way. Prints the problem(s)
# on stdout + exits 1 on any error.
# #1017 — the MTU rule lives in spatium-preseed-parse as ``validate_mtu``
# and is reached here through ``--check-field``, the #995 mechanism for
# exactly this. The first cut transcribed the rule into an inline python
# heredoc and the two copies had already drifted at birth — one accepted
# "+1400" (which int() takes) where the other refused it.
#
# Three things come free with the wrapper, each of which the heredoc got
# wrong: --check-field .strip()s the value, so " 1400" is validated the
# way the preseed door validates it; _check_field sends the parser's
# STDERR to the install log rather than into the captured output, so a
# DeprecationWarning cannot read as a validation failure; and rc=3
# ("the caller asked wrongly") is distinguished from rc=2 ("the value is
# bad") instead of both arriving as text.
#
# Prints the reason and returns 1 when the value is unusable.
_mtu_error() {
    _check_field mtu "$NET_MTU" "$NET6_MODE" "$NET6_IP" "$NET_MODE" "$NET_INTERFACE"
}

# Ask for the MTU once, validate, and CANONICALISE what we keep.
#
# The canonicalisation is the half that is easy to miss: whiptail returns
# the entry buffer verbatim, so a pasted " 1400" was stored in STATE with
# its space and then dropped at boot by the renderer's ASCII digit test —
# the "told it took effect, it did not" failure this whole setting exists
# to avoid, inside the setting itself. The parser validates the stripped
# form, so the wizard must store the stripped form too.
#
# Returns 1 when the operator backs out, so both call sites can pass that
# up as a Back.
_ask_mtu() {
    local prompt merr
    prompt="MTU for ${NET_INTERFACE:-this interface} — leave BLANK for the default (1500 on ordinary Ethernet).\n\nSet this only to MATCH a link that needs a smaller MTU: a WireGuard / IPsec / GRE tunnel, PPPoE, or a provider underlay. Getting it wrong the other way is hard to spot — small requests keep working while large transfers hang.\n\nNot a performance setting. Applied at boot."
    while true; do
        NET_MTU=$(whiptail --backtitle "$BACKTITLE" --title "Interface MTU" \
            --cancel-button "Back" \
            --inputbox "$prompt" 18 72 -- "$NET_MTU" 3>&1 1>&2 2>&3) \
            || return 1
        # Canonicalise before validating AND before storing, so the value
        # the Confirm screen shows is the value STATE gets is the value
        # the renderer sees. The parser does the same on its own path
        # (``str(int(mtu_s))``), and a door that validates one form while
        # storing another is this feature's own failure mode.
        #
        # Whitespace: whiptail returns the entry buffer verbatim, so a
        # pasted " 1400" reached STATE with its space and was dropped at
        # boot by the renderer's ASCII digit test.
        #
        # Leading zeros: "01400" is a perfectly good int to Python — both
        # the wizard and the parser accept it — and the renderer's
        # digit-count pattern refuses it, so it was accepted here and
        # dropped at boot. Worse if it had been written through:
        # NetworkManager normalises "mtu=01400" to "mtu=1400" on its next
        # save, after which the adopt tool sees live=1400 against
        # state=01400 and offers phantom drift forever.
        NET_MTU="$(printf '%s' "$NET_MTU" | tr -d '[:space:]')"
        case "$NET_MTU" in
            ''|*[!0-9]*) : ;;  # not a number — let the validator say so
            *)
                while [ "${#NET_MTU}" -gt 1 ] && [ "${NET_MTU#0}" != "$NET_MTU" ]; do
                    NET_MTU="${NET_MTU#0}"
                done
                ;;
        esac
        if merr=$(_mtu_error); then
            return 0
        fi
        whiptail --backtitle "$BACKTITLE" --title "MTU — invalid" \
            --msgbox "$merr" 14 72 || true
    done
}

_validate_static_net() {
    python3 - "$NET_IP" "$NET_PREFIX" "$NET_GATEWAY" "$NET_DNS" \
             "$NET6_MODE" "$NET6_IP" "$NET6_PREFIX" "$NET6_GATEWAY" <<'PY' 2>&1
import ipaddress
import sys

ip_s, prefix_s, gw_s, dns_s = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
v6_mode, v6_ip_s, v6_prefix_s, v6_gw_s = sys.argv[5], sys.argv[6], sys.argv[7], sys.argv[8]
errs = []

prefix = None
try:
    prefix = int(prefix_s)
    # Allow /1../32. /32 is a valid single-host assignment (some cloud /
    # VPS hosts hand one out with an off-link gateway reached via an
    # on-link route); /31 is RFC 3021 point-to-point.
    if not 0 < prefix <= 32:
        errs.append(f"Prefix must be between 1 and 32 (got {prefix_s!r}).")
        prefix = None
except ValueError:
    errs.append(f"Prefix must be a whole number (got {prefix_s!r}).")

ip = None
try:
    ip = ipaddress.IPv4Address(ip_s.strip())
except ValueError:
    errs.append(f"IP address {ip_s!r} is not a valid IPv4 address.")

gw = None
if not gw_s.strip():
    errs.append("Gateway is required for a static install.")
else:
    try:
        gw = ipaddress.IPv4Address(gw_s.strip())
    except ValueError:
        errs.append(f"Gateway {gw_s!r} is not a valid IPv4 address.")

if ip is not None and gw is not None and prefix is not None and prefix < 32:
    # For /32 the network is the host itself, so an off-link gateway
    # (reached via an on-link route) is normal and expected — skip the
    # in-subnet check. For /1../31 the gateway must be on-link.
    net = ipaddress.ip_network(f"{ip_s.strip()}/{prefix}", strict=False)
    if gw not in net:
        errs.append(
            f"Gateway {gw_s.strip()} is not inside {net} — the appliance "
            "would not be able to reach it."
        )

for tok in dns_s.split():
    try:
        ipaddress.ip_address(tok)
    except ValueError:
        errs.append(f"DNS server {tok!r} is not a valid IP address.")

# ── Static IPv6 (issue #995 item 21) ──────────────────────────────────
# Optional and independent of v4: `auto` is RA/SLAAC, which is what the
# appliance has always done and remains the default. Same rules as v4,
# with the differences that actually matter for v6 rather than a
# transliteration of the v4 checks:
#   * /128 is a legitimate single-host assignment, and so is anything
#     down to /1; SLAAC needs /64 but a manual address does not.
#   * The gateway is very often a LINK-LOCAL address (fe80::/10) that is
#     NOT inside the announced prefix — that is the normal case for a
#     router advertising a /64, so an in-subnet check would refuse the
#     commonest correct answer. Only a global gateway is range-checked.
if v6_mode == "static":
    v6_prefix = None
    try:
        v6_prefix = int(v6_prefix_s)
        if not 0 < v6_prefix <= 128:
            errs.append(f"IPv6 prefix must be between 1 and 128 (got {v6_prefix_s!r}).")
            v6_prefix = None
    except ValueError:
        errs.append(f"IPv6 prefix must be a whole number (got {v6_prefix_s!r}).")

    v6_ip = None
    if not v6_ip_s.strip():
        errs.append("IPv6 address is required when IPv6 is set to static.")
    else:
        try:
            v6_ip = ipaddress.IPv6Address(v6_ip_s.strip())
        except ValueError:
            errs.append(f"IPv6 address {v6_ip_s!r} is not a valid IPv6 address.")
        else:
            if v6_ip.is_link_local:
                errs.append(
                    f"IPv6 address {v6_ip_s.strip()} is link-local (fe80::/10). "
                    "The kernel assigns those itself; give a routable address."
                )
            elif v6_ip.is_loopback or v6_ip.is_multicast:
                errs.append(f"IPv6 address {v6_ip_s.strip()} is not a host address.")

    v6_gw = None
    if v6_gw_s.strip():
        try:
            v6_gw = ipaddress.IPv6Address(v6_gw_s.strip())
        except ValueError:
            errs.append(f"IPv6 gateway {v6_gw_s!r} is not a valid IPv6 address.")

    if (
        v6_ip is not None
        and v6_gw is not None
        and v6_prefix is not None
        and not v6_gw.is_link_local
        and v6_prefix < 128
    ):
        v6_net = ipaddress.ip_network(f"{v6_ip_s.strip()}/{v6_prefix}", strict=False)
        if v6_gw not in v6_net:
            errs.append(
                f"IPv6 gateway {v6_gw_s.strip()} is not inside {v6_net}, and is "
                "not link-local — the appliance would not be able to reach it."
            )

if errs:
    print("\n".join(errs))
    sys.exit(1)
PY
}

ask_network() {
    log "Step: ask_network"
    if [ -n "${PRESEED_HAS_NETWORK:-}" ]; then
        log "Preseed: network=$NET_MODE (skipping prompt)"
        # Validate a preseeded static config too — a bad answer file would
        # otherwise brick a fully-headless install with no way to recover.
        if [ "$NET_MODE" = "static" ]; then
            local perr
            if ! perr=$(_validate_static_net); then
                log "FATAL: preseed static network is invalid: $perr"
                whiptail --msgbox "Preseed static network settings are invalid:\n\n$perr\n\nFix the answer file and reinstall." 16 72 || true
                on_cancel "network (invalid preseeded static config)"
            fi
        fi
        # #1017 — same reasoning one line up, and it applies to BOTH
        # modes: the parser already refuses a bad MTU, but this is the
        # door a rootfs-baked or CIDATA answer file that predates the
        # parser's check comes through.
        local pmerr
        if ! pmerr=$(_mtu_error); then
            log "FATAL: preseed network.mtu is invalid: $pmerr"
            whiptail --msgbox "Preseed network MTU is invalid:\n\n$pmerr\n\nFix the answer file and reinstall." 16 72 || true
            on_cancel "network (invalid preseeded MTU)"
        fi
        return 2
    fi
    NET_MODE=$(whiptail --backtitle "$BACKTITLE" --title "Network" \
        --cancel-button "Back" \
        --menu "How should the appliance configure its network?" 12 70 2 \
        "dhcp"   "Automatic via DHCP (recommended for evaluation)" \
        "static" "Static IP" \
        3>&1 1>&2 2>&3) \
        || return 1

    # A re-answer must not carry the previous one's IPv6 forward. These
    # were only ever reset inside the static branch, so static -> Back ->
    # dhcp left NET6_MODE=static with a stale address that confirm()
    # advertised and the renderer then either applied to the DHCP keyfile
    # or silently dropped — the confirm/apply divergence #554 was about.
    NET6_MODE="auto"
    NET6_IP=""
    NET6_GATEWAY=""
    # NET_MTU is deliberately NOT reset here. #995 lets the Confirm screen
    # jump straight back into this function to fix one field, so clearing
    # it up front discards an MTU the operator already set: they come back
    # to correct the hostname, the MTU box is blank, Enter accepts the
    # blank, and the MTU row silently vanishes from Confirm — on the last
    # screen before an irreversible wipe. Every path below either re-asks
    # with the current value pre-filled or clears it explicitly (any-port
    # DHCP, which has nowhere to put one), so nothing stale survives.

    # #995 item 19 — the interface picker is offered in BOTH modes now.
    #
    # It used to appear only for a static install, on the reasoning that
    # DHCP needs no choice. That is wrong on a multi-NIC server:
    # NetworkManager's default is to DHCP EVERY ethernet port, so the
    # appliance comes up answering on whichever one replied first — a
    # management LAN, a storage VLAN, an idle port on a different switch.
    # The operator then finds the box at an address they did not choose,
    # and the supervisor registers with it.
    #
    # And the rows say which socket the cable is in, which is the only
    # question anyone actually has here. Name + MAC — what the old picker
    # showed — answers a question nobody asks.
    # Same width discipline as the disk picker: newt writes an over-wide
    # --menu item straight through the frame instead of clipping it, and a
    # v6 address plus a driver name comfortably clears the old fixed 74.
    local _IF_MENU_W _IF_ITEM_COLS
    _IF_MENU_W=$(_whiptail_width 88)
    _IF_ITEM_COLS=$((_IF_MENU_W - 18 - 7))
    [ "$_IF_ITEM_COLS" -lt 24 ] && _IF_ITEM_COLS=24
    local ifs=() iface
    while read -r iface; do
        [ -n "$iface" ] || continue
        ifs+=("$iface" "$(_ellipsis "$(_iface_summary "$iface")" "$_IF_ITEM_COLS")")
    done < <(_net_interfaces)
    if [ ${#ifs[@]} -eq 0 ]; then
        whiptail --msgbox "No ethernet interfaces found — falling back to DHCP on whatever appears at boot." 9 66 || true
        NET_MODE="dhcp"
        NET_INTERFACE=""
        return 0
    fi
    local pick_hint="Pick the port this appliance should use."
    if [ "$NET_MODE" = "dhcp" ]; then
        pick_hint="$pick_hint\n\nUP means the link is live; the address shown is the lease this installer is holding right now.\n\nLeave it on \"any\" to let NetworkManager DHCP every port, which is the old behaviour."
        ifs=("any" "Any / all ports (NetworkManager decides)" "${ifs[@]}")
    else
        pick_hint="$pick_hint\n\nUP means the link is live; the address shown is what this installer currently holds on that port."
    fi
    NET_INTERFACE=$(whiptail --backtitle "$BACKTITLE" --title "Network interface" \
        --cancel-button "Back" \
        --menu "$pick_hint" "$(_whiptail_height "$pick_hint" "$_IF_MENU_W" 9)" \
        "$_IF_MENU_W" 8 "${ifs[@]}" 3>&1 1>&2 2>&3) \
        || return 1
    [ "$NET_INTERFACE" = "any" ] && NET_INTERFACE=""

    # #1017 — optional MTU, offered in BOTH modes but ONLY when a port is
    # pinned.
    #
    # That condition is load-bearing rather than tidiness: the MTU rides
    # in the [ethernet] section of the keyfile etc-render writes, and for
    # DHCP-on-any-port it writes NO keyfile at all — NetworkManager uses
    # its own auto profile. Offering the field there would accept a
    # value, show it on the Confirm screen, store it in STATE and have it
    # reach nothing: the "written, never read" shape, on the one setting
    # whose absence presents as large transfers hanging days later.
    #
    # In static mode the prompt lives inside the validation loop below
    # instead, so a value refused for clashing with a static IPv6 address
    # is re-asked alongside the address it clashes with.
    if [ "$NET_MODE" = "dhcp" ] && [ -n "$NET_INTERFACE" ]; then
        _ask_mtu || return 1
    elif [ "$NET_MODE" = "dhcp" ]; then
        # Any-port DHCP has nowhere to put it; make sure a value from an
        # earlier pass through this screen cannot survive the change.
        NET_MTU=""
    fi

    if [ "$NET_MODE" = "static" ]; then
        # #995 item 20 — offer what the box already knows. The installer's
        # own host is on the network the appliance will live on, holding
        # an address, a gateway and resolvers that are almost always the
        # right answer minus the last octet. Retyping them is where the
        # #554 class of typo comes from.
        local live_ip live_prefix live_gw live_dns live_line
        { read -r live_ip live_prefix; read -r live_gw; read -r live_dns; } \
            < <(_iface_live_config "$NET_INTERFACE")
        if [ -n "$live_ip" ]; then
            live_line="Address:  $live_ip/$live_prefix"$'\n'"Gateway:  ${live_gw:-<none seen>}"$'\n'"DNS:      ${live_dns:-<none seen>}"
            if whiptail --backtitle "$BACKTITLE" --title "Use the current settings?" \
                --yes-button "Use these" --no-button "Enter manually" \
                --yesno "$NET_INTERFACE is currently configured as:"$'\n\n'"$live_line"$'\n\n'"Start from these values?"$'\n'"(You can still edit every field on the next screens.)" \
                16 70; then
                NET_IP="$live_ip"
                NET_PREFIX="$live_prefix"
                [ -n "$live_gw" ] && NET_GATEWAY="$live_gw"
                [ -n "$live_dns" ] && NET_DNS="$live_dns"
                log "Static network pre-filled from the live lease on $NET_INTERFACE"
            fi
        fi
        # #554 — collect + validate in a loop: on a validation error re-show
        # the fields (pre-filled with what was entered) instead of writing
        # an invalid keyfile. Back (Cancel) on any field still exits the
        # step backward via ``return 1``.
        while true; do
            NET_IP=$(whiptail --backtitle "$BACKTITLE" --title "Static IP -address" \
                --cancel-button "Back" \
                --inputbox "IPv4 address (e.g. 192.168.1.10):" 10 60 -- "$NET_IP" 3>&1 1>&2 2>&3) \
                || return 1
            NET_PREFIX=$(whiptail --backtitle "$BACKTITLE" --title "Static IP -prefix" \
                --cancel-button "Back" \
                --inputbox "Prefix length:" 10 60 -- "$NET_PREFIX" 3>&1 1>&2 2>&3) \
                || return 1
            NET_GATEWAY=$(whiptail --backtitle "$BACKTITLE" --title "Static IP -gateway" \
                --cancel-button "Back" \
                --inputbox "Gateway:" 10 60 -- "$NET_GATEWAY" 3>&1 1>&2 2>&3) \
                || return 1
            NET_DNS=$(whiptail --backtitle "$BACKTITLE" --title "Static IP -DNS" \
                --cancel-button "Back" \
                --inputbox "DNS servers (space-separated):" 10 60 -- "$NET_DNS" 3>&1 1>&2 2>&3) \
                || return 1
            # #995 item 21 — optional static IPv6 alongside the v4
            # address. Default stays RA / SLAAC, which is every install to
            # date; this only adds the ability to pin one. Asked here
            # rather than as its own wizard step so Back still walks the
            # network screen as a single unit.
            if whiptail --backtitle "$BACKTITLE" --title "IPv6" \
                --defaultno --yes-button "Set a static v6" --no-button "Automatic (SLAAC)" \
                --yesno "IPv6 is automatic (router advertisements / SLAAC) by default, which is what you want on almost every network.\n\nPin a static IPv6 address as well?" \
                13 70; then
                NET6_MODE="static"
                NET6_IP=$(whiptail --backtitle "$BACKTITLE" --title "Static IPv6 -address" \
                    --cancel-button "Back" \
                    --inputbox "IPv6 address (e.g. 2001:db8:1::10):" 10 66 -- "$NET6_IP" 3>&1 1>&2 2>&3) \
                    || return 1
                NET6_PREFIX=$(whiptail --backtitle "$BACKTITLE" --title "Static IPv6 -prefix" \
                    --cancel-button "Back" \
                    --inputbox "Prefix length (usually 64):" 10 66 -- "$NET6_PREFIX" 3>&1 1>&2 2>&3) \
                    || return 1
                NET6_GATEWAY=$(whiptail --backtitle "$BACKTITLE" --title "Static IPv6 -gateway" \
                    --cancel-button "Back" \
                    --inputbox "Gateway — blank to keep using router advertisements for the default route.\n\nA link-local gateway (fe80::…) is normal and correct here." 13 66 -- "$NET6_GATEWAY" 3>&1 1>&2 2>&3) \
                    || return 1
            else
                NET6_MODE="auto"
            fi
            # #1017 — asked last in the loop, AFTER the v6 answer, because
            # the two interact: below 1280 an MTU is refused outright when
            # a static IPv6 address is pinned (RFC 8200). Inside the loop
            # so that refusal re-offers both fields rather than trapping
            # the operator on whichever one they answered second.
            _ask_mtu || return 1
            # EXIT STATUS decides, not output-emptiness. _validate_static_net
            # ends its heredoc with ``2>&1``, so any chatter this ISO's
            # python emits on stderr — a DeprecationWarning, a locale gripe
            # — lands in the captured text. Gating on "did it print
            # anything" would make a VALID static config permanently
            # unacceptable and trap the operator in this loop with an
            # unfixable message. The MTU is already validated by _ask_mtu
            # above, through a wrapper that keeps stderr out of the way.
            local nerr
            if nerr=$(_validate_static_net); then
                break
            fi
            whiptail --backtitle "$BACKTITLE" --title "Static network — invalid" \
                --msgbox "Please correct these before continuing:\n\n$nerr" 16 72 || true
        done
    fi
}

ask_timezone() {
    log "Step: ask_timezone"
    if [ -n "${PRESEED_HAS_TIMEZONE:-}" ]; then
        log "Preseed: timezone=$TIMEZONE (skipping prompt)"
        return 2
    fi
    # #995 item 3 — this was a free-text box with no validation at all,
    # and do_install's only response to a name it could not resolve was
    # to log a WARN and silently install UTC. An operator who typo'd
    # "Amercia/Toronto" got a box four hours out and no indication why,
    # which then shows up as clock skew in logs and TLS.
    local tzerr
    while true; do
        TIMEZONE=$(whiptail --backtitle "$BACKTITLE" --title "Timezone" \
            --cancel-button "Back" \
            --inputbox "Timezone (IANA name, e.g. America/Toronto, Europe/Berlin, UTC):" \
            10 70 -- "$TIMEZONE" 3>&1 1>&2 2>&3) \
            || return 1
        # ``[ -z "$TIMEZONE" ] && TIMEZONE="UTC"`` as the last statement
        # here would return 1 when TIMEZONE is non-empty (the [ test
        # fails, && short-circuits, the function inherits the [ test's
        # exit code), and the state machine would then treat OK as Back —
        # infinite-looping the operator back into ask_network. Use an
        # if/then so the function always exits 0 on success.
        if [ -z "$TIMEZONE" ]; then
            TIMEZONE="UTC"
        fi
        if tzerr=$(_check_field timezone "$TIMEZONE"); then
            break
        fi
        whiptail --backtitle "$BACKTITLE" --title "Unknown timezone" \
            --msgbox "$tzerr"$'\n\n'"Tip: 'ls /usr/share/zoneinfo' from a shell lists the regions." \
            13 72 || true
    done
}

# Issue #302 — operator-customisable k3s pod + service CIDRs.
#
# k3s defaults (10.42.0.0/16 pods, 10.43.0.0/16 services) collide
# with several common LAN ranges in the wild (Flannel docs example,
# some VPN/overlay setups, branch SD-WAN). Defaults pre-filled so
# clean-LAN operators just press Enter through this step; overrides
# kick in for operators whose LAN already uses one of these ranges.
#
# Validation runs server-side via Python's ``ipaddress`` because bash
# regex CIDR validation is awful and we want overlap detection
# (between pod / service / operator's static-IP subnet) for free.
ask_k3s_cidrs() {
    # #995 item 14 — never asked for an Additional node, and no drop-in is
    # written for one either.
    #
    # k3s refuses to join a cluster whose critical config differs:
    # cluster-cidr, service-cidr and cluster-dns are compared against the
    # datastore at join time and a mismatch is fatal. spatium-cluster-join
    # does not touch /etc/rancher/k3s/config.yaml.d/spatium-cidrs.yaml, so
    # an Additional node installed with non-default CIDRs could pair,
    # could be approved, could run DNS and DHCP — and could never be
    # PROMOTED into the control plane it was paired with. The screen
    # offered a choice whose only possible effect was to break something
    # later.
    #
    # A standalone appliance's own k3s runs fine on the upstream defaults
    # (nothing on it is reachable from the LAN by pod IP), and on promotion
    # it inherits the seed's values. So the values are not merely unasked,
    # they are not written: see the drop-in block in do_install.
    if [ "$ROLE" = "appliance" ]; then
        return 2
    fi
    log "Step: ask_k3s_cidrs"
    if [ -n "${PRESEED_HAS_K3S:-}" ]; then
        if [ -n "${PRESEED_HAS_NETWORK:-}" ]; then
            K3S_POD_CIDR=$(_k3s_cidr_canonical "$K3S_POD_CIDR")
            K3S_SERVICE_CIDR=$(_k3s_cidr_canonical "$K3S_SERVICE_CIDR")
            log "Preseed: k3s pod=$K3S_POD_CIDR svc=$K3S_SERVICE_CIDR (skipping prompt)"
            return 2
        fi
        # k3s was preseeded but the network was chosen interactively, so
        # the parser could not check the pod/service CIDRs against the
        # operator's static LAN subnet. Re-run the same validator now
        # that NET_* is known; if it passes we skip the prompt, if it
        # flags an overlap the operator gets the interactive prompt to
        # fix it (this only happens on a partial, already-interactive
        # run — never a fully-unattended one).
        if _validate_k3s_cidrs "$K3S_POD_CIDR" "$K3S_SERVICE_CIDR"; then
            K3S_POD_CIDR=$(_k3s_cidr_canonical "$K3S_POD_CIDR")
            K3S_SERVICE_CIDR=$(_k3s_cidr_canonical "$K3S_SERVICE_CIDR")
            log "Preseed: k3s CIDRs validated against interactive network (skipping prompt)"
            return 2
        fi
        log "Preseed: k3s CIDRs conflict with the interactively-chosen network — prompting"
    fi
    # ONE screen, defaults pre-chosen. This used to be two free-text
    # inputboxes an operator had to tab through on every single install,
    # retyping nothing and risking a fat-finger in a value that is almost
    # always correct — the common path cost two prompts and offered two
    # chances to break k3s. Now it costs one Enter, and the ranges are
    # VISIBLE without entering an edit mode.
    #
    # The pre-check is what keeps the fast path honest. #995 item 22 exists
    # because a LAN on 10.42.0.0/16 — the k3s pod default — collides with
    # the default answer, so "Use these" must not become a way to walk past
    # the one check that matters. _k3s_cidr_error is the QUIET validator
    # (_validate_k3s_cidrs is the same test plus a msgbox), so the state is
    # known before the menu is drawn: a conflict makes "Change" the default
    # item and says why, and choosing "Use these" anyway still refuses.
    while true; do
        local err note default_item body choice
        err=$(_k3s_cidr_error "$K3S_POD_CIDR" "$K3S_SERVICE_CIDR" "$(_dhcp_lease_subnet)")
        if [ -n "$err" ]; then
            note="PROBLEM: $err"
            default_item="change"
        else
            note="These are the k3s defaults and are right for almost every LAN. Checked against this machine's network - no conflict found."
            default_item="accept"
        fi
        body="Internal ranges k3s uses. They never appear on your LAN.\n\n\
  Pod CIDR       $K3S_POD_CIDR   (per-pod IPs)\n\
  Service CIDR   $K3S_SERVICE_CIDR   (service ClusterIPs + cluster DNS)\n\n\
$note"
        local w
        w=$(_whiptail_width 76)
        choice=$(whiptail --backtitle "$BACKTITLE" --title "k3s networking" \
            --cancel-button "Back" \
            --default-item "$default_item" \
            --menu "$body" "$(_whiptail_height "$body" "$w" 3)" "$w" 2 \
            "accept" "Use these ranges" \
            "change" "Change them..." \
            3>&1 1>&2 2>&3) \
            || return 1

        if [ "$choice" = "accept" ]; then
            # Re-run through the loud validator rather than trusting the
            # pre-check: same test, and it is the one that explains itself.
            if _validate_k3s_cidrs "$K3S_POD_CIDR" "$K3S_SERVICE_CIDR"; then
                # Store the masked form, not the typed one — see
                # _k3s_cidr_canonical (#974).
                K3S_POD_CIDR=$(_k3s_cidr_canonical "$K3S_POD_CIDR")
                K3S_SERVICE_CIDR=$(_k3s_cidr_canonical "$K3S_SERVICE_CIDR")
                log "k3s CIDRs: pod=$K3S_POD_CIDR svc=$K3S_SERVICE_CIDR (accepted)"
                return 0
            fi
            continue
        fi

        local pod
        pod=$(whiptail --backtitle "$BACKTITLE" --title "k3s pod network" \
            --cancel-button "Back" \
            --inputbox "Pod CIDR — internal range Flannel uses for per-pod IPs. Change only if your network already uses 10.42.x.x.\n\nIPv4 CIDR (e.g. 10.42.0.0/16):" \
            14 70 -- "$K3S_POD_CIDR" 3>&1 1>&2 2>&3) \
            || continue
        local svc
        svc=$(whiptail --backtitle "$BACKTITLE" --title "k3s service network" \
            --cancel-button "Back" \
            --inputbox "Service CIDR — internal range k8s uses for service ClusterIPs (incl. cluster DNS). Must not overlap with the pod CIDR or your LAN.\n\nIPv4 CIDR (e.g. 10.43.0.0/16):" \
            14 70 -- "$K3S_SERVICE_CIDR" 3>&1 1>&2 2>&3) \
            || continue
        # Canonicalised whether or not they validate: the value that failed
        # is not necessarily the one that was wrong (a pod/svc overlap fails
        # both), and showing the masked form back tells the operator what
        # their host-bits-set entry actually meant. _k3s_cidr_canonical
        # passes an unparseable string through, so a typo is echoed verbatim
        # to be corrected. A bad entry then lands back on a screen that
        # SHOWS the state rather than on a bare re-prompt, with
        # _validate_k3s_cidrs having already explained the problem.
        #
        # Back out of either inputbox is a different thing: it `continue`s
        # without committing, so the edit is DISCARDED and the summary
        # redraws with the values it had. Back means "cancel this edit",
        # not "keep what I typed so far".
        if _validate_k3s_cidrs "$pod" "$svc"; then
            K3S_POD_CIDR=$(_k3s_cidr_canonical "$pod")
            K3S_SERVICE_CIDR=$(_k3s_cidr_canonical "$svc")
            log "k3s CIDRs: pod=$K3S_POD_CIDR svc=$K3S_SERVICE_CIDR (operator-set)"
            return 0
        fi
        K3S_POD_CIDR=$(_k3s_cidr_canonical "$pod")
        K3S_SERVICE_CIDR=$(_k3s_cidr_canonical "$svc")
    done
}

# Pure validation core for a pod/service CIDR pair — prints the problem
# on stdout (empty output = valid), reading NET_MODE/NET_IP/NET_PREFIX to
# cross-check the operator's static LAN subnet. Split out of
# _validate_k3s_cidrs (issue #581) so the headless `--check-preseed`
# linter can reuse the EXACT rule the interactive wizard enforces,
# without the whiptail dialog.
_k3s_cidr_error() {
    local pod="$1" svc="$2" lan_override="${3:-}"
    # Hand off to Python — ``ipaddress`` does parsing, prefix-len
    # checking, and overlap detection in three idiomatic lines. The
    # bash regex alternative would be 30 lines + still wrong on edge
    # cases. We pass the operator's static-IP subnet (if static
    # mode) so we can refuse pod/svc CIDRs that would mask the LAN.
    #
    # #995 item 22 — in DHCP mode there was NO known LAN, so the whole
    # overlap check was dead on the path most installs take. A site whose
    # LAN is 10.42.0.0/16 — the k3s pod default, and the exact range this
    # check exists for — sailed straight through. The caller passes the
    # live lease's subnet as $3 for that case; `--check-preseed` passes
    # nothing, because the linting workstation's own lease says nothing
    # about the appliance's future LAN.
    local static_subnet=""
    if [ "$NET_MODE" = "static" ] && [ -n "$NET_IP" ] && [ -n "$NET_PREFIX" ]; then
        static_subnet="$NET_IP/$NET_PREFIX"
    elif [ -n "$lan_override" ]; then
        static_subnet="$lan_override"
    fi
    python3 - "$pod" "$svc" "$static_subnet" <<'PY' 2>&1
import ipaddress
import sys
pod_s, svc_s, static_s = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    pod = ipaddress.ip_network(pod_s, strict=False)
except ValueError as exc:
    print(f"Pod CIDR is not a valid IPv4 network: {exc}")
    sys.exit(1)
try:
    svc = ipaddress.ip_network(svc_s, strict=False)
except ValueError as exc:
    print(f"Service CIDR is not a valid IPv4 network: {exc}")
    sys.exit(1)
if pod.version != 4 or svc.version != 4:
    print("Only IPv4 CIDRs are supported.")
    sys.exit(1)
# /22 is the upper bound — k3s allocates /24 per node out of the pod
# CIDR (max ~64 nodes from /22) and /16 service CIDRs are k3s
# convention. Tighter than /22 silently breaks at scale + once-
# allocated CIDRs can't be expanded without a reinstall.
if pod.prefixlen > 22:
    print(f"Pod CIDR prefix {pod.prefixlen} is too small. Use /22 or wider (e.g. /16).")
    sys.exit(1)
if svc.prefixlen > 22:
    print(f"Service CIDR prefix {svc.prefixlen} is too small. Use /22 or wider (e.g. /16).")
    sys.exit(1)
if pod.overlaps(svc):
    print(f"Pod CIDR {pod} overlaps with service CIDR {svc}. They must be disjoint.")
    sys.exit(1)
if static_s:
    try:
        lan = ipaddress.ip_interface(static_s).network
    except ValueError:
        # Bad static-IP shape elsewhere in the wizard — let that
        # surface there, not here.
        sys.exit(0)
    if pod.overlaps(lan):
        print(
            f"Pod CIDR {pod} overlaps with the LAN subnet {lan} you "
            f"just configured. Flannel's host-gw backend would mask "
            f"the LAN. Pick a non-overlapping range."
        )
        sys.exit(1)
    if svc.overlaps(lan):
        print(
            f"Service CIDR {svc} overlaps with the LAN subnet {lan}. "
            f"Pick a non-overlapping range."
        )
        sys.exit(1)
PY
}

# Helper: validate the two CIDRs typed by ask_k3s_cidrs. Returns 0 on
# success; on fail, shows a whiptail msgbox describing the problem +
# returns 1 so the caller re-prompts. The check itself lives in
# _k3s_cidr_error (issue #581) so the `--check-preseed` linter can reuse
# it without popping a dialog.
_validate_k3s_cidrs() {
    local err
    # The interactive path knows the live lease; the linter does not, and
    # must not guess (see _dhcp_lease_subnet).
    err=$(_k3s_cidr_error "$1" "$2" "$(_dhcp_lease_subnet)")
    if [ -z "$err" ]; then
        return 0
    fi
    whiptail --backtitle "$BACKTITLE" --title "k3s networking — invalid" \
        --msgbox "$err\n\nPress OK to fix." 14 72 || true
    return 1
}

# Helper: canonicalise a CIDR — mask off any host bits the operator
# typed (``10.42.0.5/16`` → ``10.42.0.0/16``) and normalise the spelling.
# Prints the input unchanged if it does not parse; the validator above is
# what refuses those, and a canonicaliser is not the place to fail.
#
# Why (#974): the validator parses with ``strict=False``, which masks for
# the purposes of the overlap checks and then throws the masked value
# away — the operator's literal string is what reached ``config.yaml``.
# The effective network was always the masked one, so the file recorded
# something that was never what the cluster ran. Kubernetes 1.36 turns
# that from untidy into risky: ``StrictIPCIDRValidation`` is on by
# default and rejects host-bits-set CIDRs in core API objects, and the
# apiserver derives a ``ServiceCIDR`` object from
# ``--service-cluster-ip-range``. Writing the canonical form removes the
# question.
_k3s_cidr_canonical() {
    python3 - "$1" <<'PY' 2>/dev/null || printf '%s' "$1"
import ipaddress
import sys
print(str(ipaddress.ip_network(sys.argv[1], strict=False)), end="")
PY
}

# Helper: compute the cluster-dns IP from the chosen service CIDR.
# k3s + kube-dns convention is ``<service_cidr_base>.10`` (e.g. the
# 10.43.0.0/16 default gives 10.43.0.10). Outputs the address only;
# called by do_install when writing the k3s config drop-in.
_cluster_dns_ip_from_svc_cidr() {
    python3 - "$1" <<'PY'
import ipaddress
import sys
net = ipaddress.ip_network(sys.argv[1], strict=False)
print(str(net.network_address + 10))
PY
}

# Height for a whiptail box whose body is $1, rendered at width $2.
#
# Counts WRAPPED rows, not logical lines. whiptail re-wraps at about
# width-4, and the longest lines on both screens that use this are
# operator-supplied — a control-plane URL, a /dev/disk/by-id target path —
# so a logical-line count under-sizes exactly when the content is unusual,
# and newt CLIPS rather than scrolls. The line that goes missing is the
# last one, which on the Done screen is "Press OK to reboot." and on
# Confirm is "Proceed with installation?" below the ERASE warning.
#
# Clamped to one below the terminal: an 80x24 serial console is a
# first-class install path here (spatium-console@ttyS0), newt cannot draw
# a window taller than the screen, and the backtitle owns row 0.
#
# `printf %b` because confirm() builds its body with literal ``\n``
# escapes, which whiptail expands the same way — so the estimate is made
# against what actually gets rendered.
_whiptail_height() {
    # $3 (optional): extra rows the dialog needs beyond its body — a
    # --menu's list height, which whiptail reserves on top of the message
    # area rather than inside it. Without it a menu sized from its body
    # alone silently clips the last lines of the message (#995 item 28 saw
    # the same thing eat a Confirm screen's ERASE warning).
    #
    # A --menu wants LIST_HEIGHT + 1: measured against a real 80x24 pty, a
    # menu is text_rows + list_rows + 7 of chrome while this function adds
    # 6, so passing the bare list height is short by exactly one row and
    # drops the LAST wrapped line. That is not a cosmetic loss — on the k3s
    # screen the dropped line was the sentence naming the fix for the very
    # PROBLEM the screen had just reported.
    local body="$1" width="$2" extra="${3:-0}" rows term h
    rows=$(printf '%b\n' "$body" | fold -s -w "$((width - 4))" | wc -l | tr -d ' ')
    case "$rows" in ''|*[!0-9]*) rows=20 ;; esac
    # stty is in coreutils (Essential); tput comes from ncurses-bin, which
    # mkosi.conf never names and --no-install-recommends will not pull in.
    term=$(stty size 2>/dev/null | awk '{print $1}' || true)
    if [ -z "$term" ]; then
        term=$(tput lines 2>/dev/null || true)
    fi
    # Non-numeric, absent, or implausible (stty reports 0 0 when stdin is
    # not a tty) all mean "assume the smallest console we support".
    case "$term" in ''|*[!0-9]*) term=24 ;; esac
    if [ "$term" -lt 12 ]; then
        term=24
    fi
    h=$((rows + 6 + extra))
    if [ "$h" -ge "$term" ]; then
        h=$((term - 1))
    fi
    if [ "$h" -lt 9 ]; then
        h=9
    fi
    printf '%s' "$h"
}

# Usable columns for a dialog, clamped to the terminal.
#
# Companion to _whiptail_height. The appliance console is ~128 cols under
# KMS, but a serial console is 80 and that is a first-class install path
# here, so a hardcoded width is either cramped on one or wasteful on the
# other. `want` is the preferred width; the result never exceeds the
# terminal and never drops below 70 (the historical value every screen
# was written against).
_whiptail_width() {
    local want="${1:-76}" term
    term=$(stty size 2>/dev/null | awk '{print $2}' || true)
    if [ -z "$term" ]; then
        term=$(tput cols 2>/dev/null || true)
    fi
    case "$term" in ''|*[!0-9]*) term=80 ;; esac
    if [ "$term" -lt 70 ]; then
        term=80
    fi
    if [ "$want" -gt "$((term - 6))" ]; then
        want=$((term - 6))
    fi
    if [ "$want" -lt 70 ]; then
        want=70
    fi
    printf '%s' "$want"
}

# Truncate to $2 columns, marking the cut so a clipped name never reads as
# a complete one. ASCII "..." deliberately, not "…": the appliance console
# font is 256 glyphs and only a handful of box/blocks render (see the
# console dashboard's fill-bar gauges).
_ellipsis() {
    local str="$1" max="$2"
    if [ "${#str}" -le "$max" ]; then
        printf '%s' "$str"
        return
    fi
    if [ "$max" -le 3 ]; then
        printf '%s' "${str:0:$max}"
        return
    fi
    printf '%s...' "${str:0:$((max - 3))}"
}

confirm() {
    log "Step: confirm"
    # #995 item 6 — the old control-plane label read "api + db + DNS +
    # DHCP", which contradicts the role screen two steps back: since #272
    # DNS and DHCP are OFF at install and are enabled per node from the
    # Fleet UI. A confirm screen that promises services the install does
    # not start is worse than a terse one. #995 item 7 — and both labels
    # lead with the role-screen wording.
    #
    # Keep each rendered row under ~62 chars: the box is 76 wide, which
    # leaves ~68 usable, and whiptail hard-wraps past that into a ragged
    # second line rather than widening. The role detail therefore gets
    # its own indented continuation row instead of a longer label.
    local role_label role_detail
    case "$ROLE" in
        control-plane)
            role_label="First node — control plane (api + db + web UI)"
            role_detail="DNS + DHCP stay OFF; enable per node in the Fleet UI"
            ;;
        appliance)
            role_label="Additional node — DNS / DHCP agent"
            role_detail="Registers below, then waits for Approve in the Fleet UI"
            ;;
        *)
            role_label="$ROLE"
            role_detail=""
            ;;
    esac
    local s
    s="Role:        $role_label\n"
    if [ -n "$role_detail" ]; then
        s+="             $role_detail\n"
    fi
    if [ "$ROLE" = "appliance" ]; then
        s+="Control URL: $CONTROL_PLANE_URL\n"
        # Mask the code in the confirmation screen — the IPMI / serial
        # console operator already typed it; no need to flash all 8
        # digits back at them. ●●●●●●●● is enough confirmation that
        # something landed.
        s+="Pair code:   ●●●●●●●●\n"
    fi
    s+="Target disk: $TARGET_DISK\n"
    # #999 Part C2 — a mirror changes what "ERASED" covers, so it is named
    # on the review screen and again in the warning below.
    if [ "$MIRROR_MODE" = "yes" ]; then
        s+="Mirror (RAID1): $TARGET_DISK2\n"
    fi
    if [ -n "$TARGET_DISK_BY_ID" ]; then
        s+="             $TARGET_DISK_BY_ID\n"
    fi
    s+="Hostname:    $HOSTNAME\n"
    s+="OS user:     $ADMIN_USER\n"
    s+="Network:     $NET_MODE"
    if [ "$NET_MODE" = "static" ]; then
        s+=" ($NET_INTERFACE: $NET_IP/$NET_PREFIX via $NET_GATEWAY)"
    elif [ -n "$NET_INTERFACE" ]; then
        # #995 item 19 — DHCP can be pinned to one port now, and a
        # confirm screen that hides that is one an operator cannot use to
        # catch the wrong pick.
        s+=" (on $NET_INTERFACE)"
    else
        s+=" (any port)"
    fi
    if [ "$NET6_MODE" = "static" ]; then
        s+="\nIPv6:        $NET6_IP/$NET6_PREFIX${NET6_GATEWAY:+ via $NET6_GATEWAY}"
    fi
    # #1017 — only when set. An unset MTU is the default on every install
    # to date, and a row reading "MTU: default" on every Confirm screen
    # is noise on the one screen that has to stay readable.
    if [ -n "$NET_MTU" ]; then
        s+="\nMTU:         $NET_MTU"
    fi
    s+="\nTimezone:    $TIMEZONE\n"
    # #995 item 2 — say which firmware the LIVE ISO booted under, because
    # that is the mode whose bootloader install is about to be treated as
    # fatal. The other one is installed too but cannot be verified from
    # here, and an operator who plans to move the disk between a UEFI and
    # a BIOS machine should know which half is untested.
    if [ "$FIRMWARE_MODE" = "uefi" ]; then
        s+="Booted:      UEFI (BIOS boot also installed, untested here)\n"
    else
        s+="Booted:      BIOS/CSM (UEFI boot also installed, untested here)\n"
    fi
    # #995 Phase 3 — the new answers belong on the last review screen
    # before an irreversible wipe. Key-only SSH especially: it is the most
    # consequential thing the wizard can now do, and it was invisible here.
    if [ "$KEYMAP" != "us" ]; then
        s+="Keyboard:    $KEYMAP\n"
    fi
    if [ -z "$NTP_SERVERS" ]; then
        s+="Time source: none - chrony left with no sources\n"
    elif [ "$NTP_SERVERS" != "pool.ntp.org" ]; then
        s+="Time source: $NTP_SERVERS\n"
    fi
    # Field rows are label + operator-supplied value, and the values are
    # NOT bounded by anything the labels know about: a hostname is legal to
    # 63 chars (RFC 1123, and our own validator allows it), and Time source
    # holds however many servers were typed. An over-wide --menu item is
    # not clipped by newt, it is drawn through the frame.
    local _CONF_MENU_W _CONF_VAL_COLS
    _CONF_MENU_W=$(_whiptail_width 88)
    # Longest tag is "ask_user_password" (17), plus frame chrome, minus the
    # 19-column label field the rows are hand-aligned to.
    _CONF_VAL_COLS=$((_CONF_MENU_W - 17 - 7 - 19))
    [ "$_CONF_VAL_COLS" -lt 16 ] && _CONF_VAL_COLS=16

    local nkeys
    nkeys=$(_ssh_key_count)
    if [ "$nkeys" -gt 0 ]; then
        s+="SSH keys:    $nkeys authorised for $ADMIN_USER"
        if [ "$SSH_DISABLE_PASSWORD" = "yes" ]; then
            s+=" (password SSH OFF)"
        fi
        s+="\n"
    fi
    if [ "$SET_ROOT_PASSWORD" != "yes" ]; then
        s+="Root:        locked (use sudo)\n"
    fi
    # Only show the k3s CIDR row when the operator overrode either
    # default — keeps the confirm screen short for the common case.
    # ...and never for an Additional node, which pins none (#995 item 14).
    if [ "$ROLE" != "appliance" ] && { [ "$K3S_POD_CIDR" != "10.42.0.0/16" ] || \
         [ "$K3S_SERVICE_CIDR" != "10.43.0.0/16" ]; }; then
        s+="K3s pod CIDR: $K3S_POD_CIDR\n"
        s+="K3s svc CIDR: $K3S_SERVICE_CIDR\n"
    fi
    if [ "$KEEP_VAR" = "yes" ]; then
        s+="\nREINSTALL: both OS slots on $TARGET_DISK are replaced.\n"
        s+="/var and STATE are KEPT. There is no undo.\n\n"
    elif [ "$MIRROR_MODE" = "yes" ]; then
        s+="\nWARNING: BOTH $TARGET_DISK and $TARGET_DISK2 will be ERASED.\n"
        s+="There is no undo.\n\n"
    else
        s+="\nWARNING: $TARGET_DISK will be ERASED. There is no undo.\n\n"
    fi
    s+="Proceed with installation?"
    # Sized to the body, not hardcoded: items 2 + 6 added the firmware row
    # and a role continuation row, taking an Additional node with
    # overridden CIDRs to 16 logical lines — already past what the old
    # ``20 72`` could show — and the Control URL row wraps for any
    # control-plane URL over about 52 characters. This is the screen that
    # must never be truncated, since the last two rows are the ERASE
    # warning and the question itself.
    # #995 item 28 — the review, then a menu of fields.
    #
    # TWO screens, not one. The first cut put the whole summary in a
    # --menu's message area and it did not fit: _whiptail_height clamps to
    # term-1, whiptail then spends the list height plus chrome on the
    # rows, and on the 80x24 serial console every appliance install
    # actually uses, the bottom of the body was cut — which is where the
    # ERASE / REINSTALL warning and the question live. Padding the height
    # argument cannot beat a cap that is already binding. So the summary
    # keeps its own full-height --msgbox, and the picker is a second,
    # short screen that needs almost no message area.
    #
    # Back used to walk one screen at a time, so correcting the hostname
    # from here meant pressing Back past four screens and OK through them
    # again — on a serial console the slowest interaction in the wizard,
    # reached precisely when the operator has spotted something wrong on
    # the last screen before a wipe.
    whiptail --backtitle "$BACKTITLE" --title "Review" \
        --cancel-button "Back" \
        --yes-button "Continue" --no-button "Back" \
        --scrolltext \
        --yesno "$s" "$(_whiptail_height "$s" 76)" 76 \
        || return 1

    CONFIRM_JUMP=""
    local pick
    # --default-item is a field row, never `install`: this is the last
    # screen before an irreversible wipe and a reflexive Enter must not
    # be the thing that starts it. `install` is also LAST in the list,
    # so reaching it is a deliberate movement.
    pick=$(whiptail --backtitle "$BACKTITLE" --title "Confirm" \
        --cancel-button "Back" \
        --default-item "pick_disk" \
        --menu "Change a field, or choose Install to begin." 20 "$_CONF_MENU_W" 11 \
        "pick_disk"     "Target disk        $(_ellipsis "$TARGET_DISK" "$_CONF_VAL_COLS")" \
        "ask_role"      "Role               $ROLE" \
        "ask_hostname"  "Hostname           $(_ellipsis "$HOSTNAME" "$_CONF_VAL_COLS")" \
        "ask_user_password" "Admin account      $(_ellipsis "$ADMIN_USER" "$_CONF_VAL_COLS")" \
        "ask_ssh_keys"  "SSH keys           $nkeys authorised" \
        "ask_network"   "Network            $NET_MODE" \
        "ask_timezone"  "Timezone           $(_ellipsis "$TIMEZONE" "$_CONF_VAL_COLS")" \
        "ask_ntp"       "Time source        $(_ellipsis "${NTP_SERVERS:-none}" "$_CONF_VAL_COLS")" \
        "ask_keyboard"  "Keyboard           $KEYMAP" \
        "install"       "*** INSTALL - $([ "$KEEP_VAR" = yes ] && echo "reinstall" || echo "erase") $TARGET_DISK ***" \
        3>&1 1>&2 2>&3) \
        || return 1
    if [ "$pick" != "install" ]; then
        CONFIRM_JUMP="$pick"
        log "Confirm: operator jumped to $pick"
        return 1
    fi
}

# ── Install ───────────────────────────────────────────────────────────────────

partition_node() {
    # Translate a disk + partition index → its device node.
    #
    # Three naming rules, not two (#999 Part C3 adds the third):
    #   /dev/sda        → /dev/sda1        (bare index)
    #   /dev/nvme0n1    → /dev/nvme0n1p1   ("p" separator)
    #   /dev/mapper/mpX → /dev/mapper/mpX-part1  (kpartx "-part" suffix)
    #
    # The multipath rule is what makes a SAN LUN installable at all: the
    # kernel does not create partition nodes for a device-mapper device
    # the way it does for sd*, so kpartx maps them as
    # ``<mapname>-part<N>`` under /dev/mapper. Getting this wrong does
    # not fail loudly — it yields a path that does not exist, and the
    # mkfs that follows would create a FILE at that path on the
    # installer's tmpfs while reporting success.
    #
    # ``$2`` optionally names the disk; without it the global
    # $TARGET_DISK is used, which is every pre-#999 call site.
    local idx="$1"
    local disk="${2:-$TARGET_DISK}"
    case "$disk" in
        /dev/mapper/*|*/dm-*) echo "${disk}-part${idx}" ;;
        *nvme*|*mmcblk*)      echo "${disk}p${idx}"     ;;
        *)                    echo "${disk}${idx}"      ;;
    esac
}

# #999 Part C2 — the md array device backing one logical partition when
# installing to a mirror, e.g. index 4 (root_A) → /dev/md/root_a.
#
# NAMED arrays, not /dev/md0..3: the kernel assigns md minor numbers in
# assembly order, so a numeric name is not stable across a boot where one
# member is missing — exactly the boot this feature exists to survive.
# ``mdadm --create /dev/md/<name>`` writes the name into the 1.2
# superblock, and the initramfs assembles it back to the same
# /dev/md/<name> symlink regardless of which member came up first.
_MD_NAMES=([3]="state" [4]="root_a" [5]="root_b" [6]="var")

md_node() {
    local idx="$1"
    echo "/dev/md/${_MD_NAMES[$idx]}"
}

# #999 Part C2 — stop every md array assembled on this disk.
#
# Called before the wipe. A running array holds its members open, and
# the wipe does NOT respect that: `wipefs -af` and `sgdisk -Z` both
# return 0 on a disk held open by a live map (measured for #995 item 10;
# md behaves the same way), so without this the GPT is destroyed while
# the kernel keeps serving the array from the stale table and the
# subsequent mkfs writes through it to the old offsets.
#
# Deliberately scoped to arrays that actually have a member ON this
# disk — an installer must not stop an array belonging to storage it was
# not pointed at, the same rule _dm_maps_on_target enforces for LVM.
_stop_arrays_on() {
    local disk="$1" base md holder member
    [ -n "$disk" ] || return 0
    command -v mdadm >/dev/null 2>&1 || return 0
    base=$(basename "$(readlink -f "$disk" 2>/dev/null || echo "$disk")")
    # Holders of the whole disk AND of each of its partitions: a member
    # is normally a partition (sda4), never the bare disk.
    for holder in "/sys/block/$base"/holders/md* "/sys/block/$base"/*/holders/md*; do
        [ -e "$holder" ] || continue
        md="/dev/$(basename "$holder")"
        log "Stopping md array $md (has a member on $disk)"
        mdadm --stop "$md" >> "$INSTALL_LOG" 2>&1 || \
            log "WARN: could not stop $md — the wipe below may not take effect"
        # Erase the superblock so a later --scan cannot re-assemble a
        # ghost of it from the member we are about to repartition.
        #
        # ``$holder`` is a SYSFS path (/sys/block/sda/sda4/holders/md127),
        # so trimming the /holders/ suffix yields /sys/block/sda/sda4 —
        # NOT a device node. mdadm errored on it every time and ``|| true``
        # swallowed that, so this protection has never once run. Take the
        # basename and address the real node.
        member="/dev/$(basename "${holder%/holders/*}")"
        if [ -b "$member" ]; then
            mdadm --zero-superblock "$member" >> "$INSTALL_LOG" 2>&1 || \
                log "WARN: could not zero the md superblock on $member"
        else
            log "WARN: could not resolve an md member device from $holder"
        fi
    done
    return 0
}

# #999 Part C2 — build the four raid1 arrays across the two members.
#
# ``--metadata=1.2`` (the mdadm default, stated explicitly because the
# whole layout depends on it): the superblock sits 4 KiB in, at the
# START of the device, so the array is NOT byte-identical to a bare
# partition and nothing can mistake a member for a mountable filesystem.
# 0.90/1.0 put it at the end, where a member is mountable directly — and
# an operator who mounts one member of a live mirror read-write has
# silently forked the data.
#
# ``--assume-clean`` is deliberately NOT used. It skips the initial
# resync, which is safe for a freshly-mkfs'd array in theory, and the
# theory fails the first time somebody reads a block neither member has
# written: the two copies disagree and raid1 serves whichever it picks.
# The resync runs in the background, so the install does not wait for it.
#
# ``--homehost=any`` + a NAME: the array name is written into the
# superblock, so the initramfs re-assembles it to /dev/md/<name>
# regardless of member enumeration order or of the hostname the array
# happened to be created under (the installer's is not the installed
# system's).
_create_mirror_arrays() {
    local idx name dev1 dev2 md
    for idx in 3 4 5 6; do
        name="${_MD_NAMES[$idx]}"
        dev1=$(partition_node "$idx" "$TARGET_DISK")
        dev2=$(partition_node "$idx" "$TARGET_DISK2")
        md=$(md_node "$idx")
        log "Creating raid1 $md from $dev1 + $dev2"
        if ! mdadm --create "$md" \
                --level=1 --raid-devices=2 --metadata=1.2 \
                --homehost=any --name="$name" \
                --run "$dev1" "$dev2" >> "$INSTALL_LOG" 2>&1; then
            log "FATAL: could not create the $name mirror from $dev1 + $dev2."
            log "  Nothing further has been written. See $INSTALL_LOG."
            exit 1
        fi
    done
    udevadm settle >> "$INSTALL_LOG" 2>&1 || true
    # Fail LOUDLY if a device we are about to mkfs is not actually there.
    # mkfs against a non-existent /dev/md/x creates a regular FILE on the
    # installer's tmpfs and reports success, so the install would run to
    # completion and produce a disk with no filesystems on it.
    for idx in 3 4 5 6; do
        md=$(md_node "$idx")
        if [ ! -b "$md" ]; then
            log "FATAL: $md is not a block device after mdadm --create."
            exit 1
        fi
    done
    log "Mirror arrays created: $(cat /proc/mdstat 2>/dev/null | tr '\n' ' ')"
}

# #995 item 10 — device-mapper maps that must be released before
# $TARGET_DISK can be repartitioned, and ONLY those.
#
# The old inline loop removed EVERY `dmsetup ls --target linear` device
# on the machine. On a box with LVM on a second disk — the ordinary case
# when someone installs the appliance alongside existing storage — that
# tore down volume groups the operator intends to keep. It is not
# destructive of data by itself, but it yanks live filesystems out from
# under anything using them, and there is no reason for an installer to
# touch a disk it was not pointed at.
#
# THE SEED MUST EXCLUDE HOLDERS. `lsblk` walks the whole subtree unless
# told otherwise — its own help says "-d, --nodeps  don't print slaves or
# holders" — so `lsblk -nro KNAME /dev/sda` on a box with LVM prints
# `sda sda1 sda2 sda3 dm-0 dm-1`. The first cut of this function seeded
# from exactly that and used the same string as its dedup set, so every
# map on the target matched "already known" and was skipped: the function
# returned nothing, on precisely the disks it exists for. Hence the
# `dm-*` filter here, and a separate `seen` list below. (The test fixture
# had modelled lsblk WITH --nodeps, so eight passing tests were
# exercising a function that was inert in the field.)
#
# Filtered by KNAME rather than by TYPE: `dm-<minor>` is what the kernel
# calls a device-mapper block device, unconditionally, whereas the TYPE
# vocabulary varies with what the thing is (`disk` for sda, `loop` for a
# loop device, `mpath` for a SAN LUN) and an allowlist over it drops the
# target itself in cases it did not anticipate. Everything else lsblk
# reports for this disk — its partitions, and an md array stacked on them
# — is legitimately part of the frontier, because a map depending on one
# of those IS a map backed by the target.
#
# ONE DEPENDENCY LEVEL PER PASS. Hits are tested against `known`, which
# only takes this pass's discoveries at the END of the pass. That is what
# makes `found` strictly depth-ordered, so reversing it is genuinely
# outermost-first — `dmsetup remove` refuses a device another map is
# stacked on. Merging mid-pass would let a child be appended right after
# its parent in the same sweep, and for an LVM-RAID or thin pool, whose
# siblings sit at one depth under a map that spans them, the reversal
# would then emit an inner leg before the map on top of it.
#
# The closure runs to a fixed point rather than one level deep because
# LVM-on-LUKS-on-$TARGET_DISK gives the LV no direct dependency on the
# disk at all — its only dependency is the crypt device.
#
# FAILING TO RELEASE A MAP IS NOT SELF-CORRECTING, which is why
# _assert_target_released exists below rather than this leaving it to the
# next command. `wipefs -af` FORCES — measured against a disk held open
# by a live dm map, `wipefs -af` and `sgdisk -Z` both return 0 and erase
# the table; only `blockdev --rereadpt` fails, and that is `|| true`. So
# an unreleased map does not abort the install, it lets the GPT be
# destroyed while the kernel keeps the stale partition table, and mkfs
# then writes at the OLD offsets, over whatever the map was serving.
#
# DORMANT ON A STOCK ISO TODAY, and that is worth knowing before reading
# the rest as a description of live behaviour: `mkosi.conf` names neither
# `lvm2` nor `dmsetup` nor `cryptsetup`, no `Depends:` chain from the
# packages it does name reaches them, and mkosi installs with
# --no-install-recommends. So `command -v dmsetup` fails and this returns
# immediately — as did the loop it replaced. Nothing activates a volume
# group on an attached disk either, so a reinstall over an existing LVM
# box works because there are no maps, not because they were released.
# Adding the storage tooling belongs with #999 (RAID + multipath),
# which owns that part of mkosi.conf; the point of getting this right now
# is that the code is correct on the day it arrives, and correct today for
# anyone running `spatium-install` from a live shell that has dmsetup.
_dm_maps_on_target() {
    local disk="$1"
    command -v dmsetup >/dev/null 2>&1 || return 0
    command -v lsblk   >/dev/null 2>&1 || return 0

    # Seed: the target disk and everything under it EXCEPT its
    # device-mapper holders, which are what we are here to discover.
    local known=" " kname
    while read -r kname; do
        [ -n "$kname" ] || continue
        case "$kname" in dm-*) continue ;; esac
        known+="$kname "
    done < <(lsblk -nro KNAME "$disk" 2>/dev/null || true)
    if [ "$known" = " " ]; then
        return 0
    fi

    local found=() seen=" " pending name rest minor dmk deps dep hit any
    local depth=0 max_depth=16
    while [ "$depth" -lt "$max_depth" ]; do
        depth=$((depth + 1))
        pending=""
        any=0
        # `dmsetup ls` prints "<name>\t(<major>:<minor>)". Split on the tab
        # rather than taking the first whitespace field: a map name may
        # contain a space (dmsetup rejects '/', not ' '), and awk '{print
        # $1}' would silently truncate it to something that matches no map.
        # A line with no tab is "No devices found", the empty-system case.
        while IFS="$(printf '\t')" read -r name rest; do
            [ -n "$name" ] || continue
            [ -n "$rest" ] || continue
            case "$seen" in *" $name "*) continue ;; esac
            # The kernel names a dm block device dm-<minor>, which is what
            # another map's dependency list will report. Derived from the
            # major:minor `ls` already printed — no readlink, no basename,
            # and correct even where /dev/mapper carries no udev symlinks.
            minor="${rest##*:}"
            minor="${minor%%)*}"
            case "$minor" in ''|*[!0-9]*) continue ;; esac
            dmk="dm-$minor"
            deps=$(dmsetup deps -o blkdevname "$name" 2>/dev/null | \
                   sed -n 's/^.*: *//p' | tr -d '()' || true)
            hit=0
            for dep in $deps; do
                case "$known" in *" $dep "*) hit=1; break ;; esac
            done
            if [ "$hit" = 1 ]; then
                seen+="$name "
                pending+="$dmk "
                found+=("$name")
                any=1
            fi
        done < <(dmsetup ls 2>/dev/null || true)
        if [ "$any" = 0 ]; then
            break
        fi
        known+="$pending"
    done
    if [ "$any" = 1 ]; then
        # Still finding maps at the bound. Emitting a truncated list is
        # worse than saying so: the missing entries are the OUTERMOST ones,
        # so every remove the caller attempts fails on a device something
        # is still stacked on.
        log "WARN: device-mapper stack on $disk deeper than $max_depth levels — the list below is incomplete"
    fi

    # Reverse: the closure discovers depth 1 first, and it has to be
    # removed last.
    local i
    for (( i=${#found[@]}-1; i>=0; i-- )); do
        echo "${found[$i]}"
    done
}

# Run a release command whose failure is expected and uninteresting.
#
# #1003 item 7. "not mounted" and swapoff's "Invalid argument" mean the
# partition was simply not in use — the normal case, and not something the
# operator or a support bundle reader needs to see eighteen times. Those go
# to the trace log; anything else is a real surprise and goes to the install
# log where it will be read. Never fails: the caller's next step is the
# _assert_target_released gate, which is what actually decides whether the
# disk is safe to write.
_release_quietly() {
    local out rc=0
    # `|| rc=$?`, NOT a bare assignment. do_install runs under `set -e`, and
    # the exit status of `out=$(cmd)` IS cmd's — so the very first swapoff
    # of a partition that is not swap (the NORMAL case, and the whole reason
    # this function exists) aborted the install and dropped the operator to
    # a shell. That is precisely what the `|| true` this replaced was buying,
    # and removing it turned a cosmetic log fix into a total install failure.
    out=$("$@" 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
        printf '%s: released %s\n' "$1" "${*: -1}" >> "$TRACE_LOG"
        return 0
    fi
    case "$out" in
        *"not mounted"*|*"Invalid argument"*|*"not found"*|*"no mount point"*)
            printf '%s\n' "$out" >> "$TRACE_LOG" ;;
        *)
            printf '%s\n' "$out" >> "$INSTALL_LOG" ;;
    esac
    return 0
}

# The gate that makes an unreleased device-mapper map a refusal rather
# than a corruption (#995 item 10).
#
# Measured, not assumed: with a live dm map holding the disk open,
# `wipefs -af` returns 0 and erases the signatures, `sgdisk -Z` returns 0
# and writes a new table, and only `blockdev --rereadpt` fails — which
# do_install deliberately tolerates with `|| true` because it is
# advisory. The kernel therefore keeps the STALE partition table, and the
# very next step formats `$ESP` / `$ROOT_A` / `$VAR`, which still resolve
# to the old extents. The disk ends up destroyed and the install reports
# a different failure later, or none.
#
# So the release has to be verified here, while nothing has been written.
# Runs after the teardown loop and before `wipefs`.
_assert_target_released() {
    local remaining
    remaining=$(_dm_maps_on_target "$TARGET_DISK" | tr '\n' ' ')
    remaining="${remaining%"${remaining##*[![:space:]]}"}"
    if [ -z "$remaining" ]; then
        return 0
    fi
    log "FATAL: device-mapper maps still hold $TARGET_DISK: $remaining"
    log "  Refusing to partition a disk something is still using. Nothing"
    log "  has been written. Deactivate them (vgchange -an / cryptsetup"
    log "  close) from a shell and re-run the installer, or pick another"
    log "  disk."
    exit 1
}

# The other pre-wipe refusal (#995 item 4).
#
# `useradd` is now fatal, which is right — mkosi.postinst sets
# PermitRootLogin no, so a swallowed failure yields a box with no way in
# at all. But it fires at ~63%, after the disk is wiped and the rootfs
# rsynced, so a name that useradd will reject turns a recoverable mistake
# into an unbootable disk — and on a FULLY_UNATTENDED run there is nobody
# at the console to see why.
#
# spatium-preseed-parse's reserved-account list is a hand-written
# approximation of what the image ships and cannot help but drift: `_apt`
# alone matches the username regex, is created by a package mkosi.conf
# names explicitly, and is not on it. The live ISO's rootfs IS the rootfs
# about to be rsynced onto the target, so its own passwd database answers
# the question exactly, and keeps answering it as the package set
# changes. Both paths reach here — the interactive one and the preseed
# one — so this is also the only check the headless door cannot skip.
_assert_admin_user_available() {
    local why=""
    if [ -z "$ADMIN_USER" ]; then
        why="No admin username was chosen."
    elif getent passwd "$ADMIN_USER" >/dev/null 2>&1; then
        why="The account '$ADMIN_USER' already exists in the appliance image, so useradd would fail after the disk had been wiped. Pick a different name."
    fi

    [ -z "$why" ] && { log "Admin-user pre-flight OK: $ADMIN_USER"; return 0; }

    log "Admin-user pre-flight REFUSED '$ADMIN_USER': $why"
    if [ "$FULLY_UNATTENDED" = "1" ]; then
        preseed_halt "Refusing to install with this admin_user:"$'\n\n'"$why"
    fi
    set +x
    whiptail --backtitle "$BACKTITLE" --title "Unusable admin username" \
        --msgbox "$why"$'\n\n'"Nothing has been written." 12 72 \
        || true
    on_cancel "admin-user pre-flight ($ADMIN_USER)"
}

# Last-line defence immediately before the irreversible wipe (issue
# #581). Everything below is re-checked here rather than trusted from
# whichever path set TARGET_DISK, because the two paths do NOT validate
# equally:
#
#   * interactive — pick_disk builds the menu from lsblk minus the live
#     boot disks and enforces the size floor in its pick-and-validate
#     loop, so the value is already known-good.
#   * preseed — pick_disk returns EARLY on PRESEED_HAS_DISK and never
#     runs any of that. The parser checks the disk exists, is a whole
#     disk, and clears the size floor, but it has NO notion of the live
#     boot medium: a preseed naming the install USB reintroduced exactly
#     the #554 "wipe the media you are booted from" failure through the
#     preseed door, mid-install and unattended.
#
# Re-validating for BOTH paths also covers the gap between validation
# and use — the parser ran before NetworkManager and udev settled, and
# on a bare sdX name (which the parser explicitly permits, only noting
# the risk) the device can renumber onto a different physical disk in
# between.
#
# Aborts via preseed_halt on an unattended run (loud, non-zero, no
# guessing) and via a whiptail message + on_cancel when there is an
# operator to tell.
_assert_safe_wipe_target() {
    # ``$1`` optionally names the disk and ``$2`` how to describe it, so
    # the identical gate covers the #999 mirror member. It must: a
    # preseed naming the live USB as ``mirror_disk`` is the #554
    # "wipe the media you are booted from" bug through a new door, and
    # the mirror is wiped in the same breath as the target.
    local disk="${1:-$TARGET_DISK}"
    local what="${2:-Target disk}"
    local why="" real
    real=$(readlink -f "$disk" 2>/dev/null || echo "$disk")

    if [ -z "$disk" ]; then
        why="No target disk was selected."
    elif [ ! -b "$real" ]; then
        why="$what $disk ($real) is not a block device."
    elif [ ! -d "/sys/block/$(basename "$real")" ]; then
        why="$what $disk resolves to $real, which is a partition, not a whole disk."
    else
        local _d
        while IFS= read -r _d; do
            [ -z "$_d" ] && continue
            if [ "$(readlink -f "$_d" 2>/dev/null || echo "$_d")" = "$real" ]; then
                why="$what $disk ($real) is the live install medium this installer is running from. Wiping it would destroy the running system mid-install."
                break
            fi
        done < <(_live_boot_disks)
    fi

    if [ -z "$why" ]; then
        local bytes min
        bytes=$(blockdev --getsize64 "$real" 2>/dev/null || echo 0)
        min=$((MIN_DISK_GIB * 1024 * 1024 * 1024))
        if [ "$bytes" -lt "$min" ]; then
            why="$what $disk is $((bytes / 1024 / 1024 / 1024)) GiB — below the ${MIN_DISK_GIB} GiB minimum for the A/B partition layout."
        fi
    fi

    # #995 items 23 + 24 / #999 — the picker refuses a multipath path or an md
    # member, and this function is the documented place where the picker's
    # checks are re-applied for a preseeded disk. Without it an answer file
    # naming one installs straight through the refusal, producing exactly
    # the no-failover install the change calls a trap, with nobody at the
    # console.
    # #999 — the picker still refuses a disk that is already an md member
    # or one path of a multipath map, and this is where that check is
    # re-applied for a preseeded disk. It is NOT contradicted by the
    # mirror install: #999 Part C creates an array from PLAIN disks. An
    # existing member belongs to somebody else's array, and installing
    # over it degrades that array silently — which is what the refusal
    # has always been about.
    #
    # A multipath MAP (/dev/mapper/mpathX) is now a legitimate target
    # (Part C3), and _disk_hazard does not flag one — it flags the
    # individual paths, which remain wrong to install to.
    if [ -z "$why" ]; then
        local hazard
        hazard=$(_disk_hazard "$disk")
        [ -n "$hazard" ] && why="$what $disk is $hazard. Install to the whole disk, or to the multipath map (/dev/mapper/…) rather than one of its paths."
    fi

    [ -z "$why" ] && { log "Pre-wipe guard OK: $disk ($real)"; return 0; }

    log "Pre-wipe guard REFUSED $disk: $why"
    if [ "$FULLY_UNATTENDED" = "1" ]; then
        preseed_halt "Refusing to wipe the preseeded target disk:"$'\n\n'"$why"
    fi
    set +x
    whiptail --backtitle "$BACKTITLE" --title "Unsafe target disk" \
        --msgbox "$why"$'\n\n'"Nothing has been written. Pick a different disk." 14 72 \
        || true
    on_cancel "pre-wipe safety check ($disk)"
}

# #995 item 1 — carry the installer's own logs onto the installed
# system, immediately before the unmount block.
#
# INSTALL_LOG, TRACE_LOG and the launch log all live on the live ISO's
# tmpfs, and the rsync above excludes /var/log/* — so every record of
# what the installer actually did evaporated at the reboot. After a bad
# first boot there was nothing to read: the one artefact that explains
# the install was the one artefact the install threw away.
#
# Destination is a SUBDIRECTORY of the host log dir on purpose. That dir
# is bind-mounted into the api pod as /var/log/spatiumddi-host and its
# collector globs ``*.log`` non-recursively, so a subdir (a) keeps three
# static install-time files out of the live Logs-tab dropdown, and
# (b) sidesteps /etc/logrotate.d/spatiumddi's ``/var/log/spatiumddi/*.log``
# stanza, which would otherwise age the install record out after twelve
# weeks. The support bundle reaches it explicitly instead (#875).
#
# 0755/0644, matching every sibling in that directory rather than the
# 0700/0600 the first cut used. The api container reads these through the
# read-only host-log bind mount and runs as uid 1000
# (charts/spatiumddi/templates/api.yaml), with no fsGroup and no userns
# remap — `hostUsers: false` is refused whenever the appliance host mounts
# are on. Root-only modes therefore made `iterdir()` raise PermissionError
# and the support bundle ship an error note instead of the logs, on every
# appliance: the collector half of item 1 would never have fired. This is
# why firstboot chmods /var/log/spatiumddi 0755 and logrotate creates the
# logs beside it `0644 root root`.
#
# Safe to widen because the content is not secret: the trace is a bash
# xtrace with `set +x` around the password (#581) and around the pairing
# code (this change), and the sibling firstboot.log is already 0644. It
# does name every hostname, address and disk the wizard touched — which
# is what the support bundle's scrubber is for.
#
# Never fatal. It runs under `set -e` after a successful install, and
# again from on_failure; a failure to save a log must not be the thing
# that aborts, or reports, anything.
_save_install_logs() {
    local dest="$MOUNT/var/log/spatiumddi/install"
    mkdir -p "$dest" 2>>"$INSTALL_LOG" || {
        log "WARN: could not create $dest — installer logs not preserved"
        return 0
    }
    chmod 0755 "$dest" 2>/dev/null || true
    local src base saved=0 failed=0
    for src in "$INSTALL_LOG" "$TRACE_LOG" /var/log/spatium-install-launch.log; do
        # INSTALL_LOG / TRACE_LOG fall back to /dev/null when /var/log is
        # not writable (the #581 host-portable path); copying that would
        # make an empty file that reads as "the installer logged nothing".
        [ "$src" = "/dev/null" ] && continue
        [ -f "$src" ] || continue
        base=$(basename "$src")
        if cp -f "$src" "$dest/$base" 2>>"$INSTALL_LOG"; then
            chmod 0644 "$dest/$base" 2>/dev/null || true
            saved=$((saved + 1))
        else
            log "WARN: could not copy $src to $dest"
            failed=$((failed + 1))
        fi
    done
    # Say what happened. An unconditional success line is the last thing
    # written to the log that is then (not) copied, so on a full or
    # read-only /var it ends with a claim the three WARNs above disprove.
    if [ "$saved" -gt 0 ]; then
        log "Installer logs preserved under /var/log/spatiumddi/install/ ($saved file(s), $failed failed)"
    else
        log "WARN: no installer logs could be preserved ($failed failed)"
    fi
    return 0
}

do_install() {
    # #1026 — refuse an unbootable architecture/firmware pairing before
    # the disk is touched. Both the wizard and the headless preseed path
    # come through here, so one call covers both.
    _assert_arch_bootable
    # Re-validate the wipe target before anything destructive (#581).
    # Runs BEFORE `set -e` so its own probes can fail harmlessly.
    _assert_safe_wipe_target
    # #999 Part C2 — the mirror member is wiped in the same breath, so it
    # goes through the identical gate. Two extra refusals it must also
    # make, which the single-disk gate has no reason to know about:
    #   * mirroring a disk onto ITSELF is not redundancy, and on a
    #     multipath LUN "the same disk" can wear two different names;
    #   * a member smaller than the target silently shrinks /var,
    #     because a raid1 is the size of its smallest member.
    if [ "$MIRROR_MODE" = "yes" ]; then
        _assert_safe_wipe_target "$TARGET_DISK2" "Mirror member"
        local _t_real _m_real _t_bytes _m_bytes
        _t_real=$(readlink -f "$TARGET_DISK" 2>/dev/null || echo "$TARGET_DISK")
        _m_real=$(readlink -f "$TARGET_DISK2" 2>/dev/null || echo "$TARGET_DISK2")
        if [ "$_t_real" = "$_m_real" ]; then
            log "Pre-wipe guard REFUSED: mirror member resolves to the target ($_t_real)"
            if [ "$FULLY_UNATTENDED" = "1" ]; then
                preseed_halt "mirror_disk resolves to the same device as target_disk ($_t_real). A disk cannot mirror itself."
            fi
            whiptail --backtitle "$BACKTITLE" --title "Unsafe mirror member" \
                --msgbox "The mirror member and the target disk are the same device ($_t_real)."$'\n\n'"Nothing has been written." 12 72 || true
            on_cancel "pre-wipe safety check (mirror = target)"
        fi
        _t_bytes=$(blockdev --getsize64 "$_t_real" 2>/dev/null || echo 0)
        _m_bytes=$(blockdev --getsize64 "$_m_real" 2>/dev/null || echo 0)
        if [ "$_m_bytes" -lt "$_t_bytes" ]; then
            log "Pre-wipe guard REFUSED: mirror member smaller than target ($_m_bytes < $_t_bytes)"
            if [ "$FULLY_UNATTENDED" = "1" ]; then
                preseed_halt "mirror_disk is smaller than target_disk. A RAID1 is the size of its smallest member, so this would silently shrink /var."
            fi
            whiptail --backtitle "$BACKTITLE" --title "Mirror member too small" \
                --msgbox "The mirror member ($((_m_bytes / 1024 / 1024 / 1024)) GiB) is smaller than the target disk ($((_t_bytes / 1024 / 1024 / 1024)) GiB)."$'\n\n'"A RAID1 is the size of its smallest member, so this would silently shrink /var."$'\n\n'"Nothing has been written." 14 72 || true
            on_cancel "pre-wipe safety check (mirror too small)"
        fi
    fi
    # ...and the account that will be the only way into the installed
    # system, for the same reason and in the same place (#995 item 4).
    _assert_admin_user_available

    # Now we're past all the prompts — enable -e so any failure
    # inside the partitioning / rsync / chroot block aborts cleanly
    # and the EXIT trap drops the operator to a shell with the log.
    set -e

    # GPT layout — Atomic A/B image upgrade (issue #138 Phase 8a-1) +
    # Talos-style STATE partition (issue #276):
    #
    #   p1  BIOS Boot     1 MiB     ef02   legacy chain-load (grub i386-pc)
    #                                      **x86-64 ONLY** (#1026). On arm64
    #                                      p1 is simply ABSENT — the rest do
    #                                      NOT shift down, so every partition
    #                                      index below is the same on both
    #                                      architectures and nothing that
    #                                      indexes them needs an arch branch.
    #   p2  ESP          512 MiB    ef00   FAT32, /boot/efi
    #   p3  state        256 MiB    8300   /var/lib/spatium-state — machine
    #                                      config, SSH host keys, supervisor
    #                                      identity. Survives slot swaps AND
    #                                      a /var factory reset; replaces
    #                                      the per-slot /etc.image drift
    #                                      that #272 Phase 1 bandaided.
    #   p4  root_A         8 GiB    8304   active slot (this install lands here)
    #   p5  root_B         8 GiB    8304   inactive slot (staging next image)
    #                                      (8305 = Linux root ARM-64 on arm64)
    #   p6  var          rest       8310   /var, persisted across slot swaps
    #
    # Slot sizing — #170 Phase A4 bakes every container image into the
    # rootfs (~800 MB-1.2 GB compressed depending on third-party
    # versions); base Debian + Python + system packages is ~1.8 GiB.
    # 8 GiB per slot gives ~2.7× headroom over the current ~3 GiB
    # working set and accommodates Wave B+ growth (CA tooling, the
    # supervisor's expanded toolset, future kernel upgrades).
    # Previous 4 GiB slots predated baking and are too tight once
    # the full container set lives on-rootfs.
    #
    # Hard floor: MIN_DISK_GIB (32) target disk (= 1 MiB BBP + 512 MiB
    # ESP + 256 MiB STATE + 2× 8 GiB slots + ~14 GiB usable /var). Below
    # that, postgres + k3s state (containerd content store, local-path
    # PV dirs) + audit log outgrow /var quickly — on the Control plane
    # role a 24 GiB disk's ~7 GiB /var tipped the kubelet DiskPressure
    # threshold into an eviction storm on first boot (issue #312).
    local BBP ESP STATE ROOT_A ROOT_B VAR
    BBP=$(partition_node 1)
    ESP=$(partition_node 2)
    STATE=$(partition_node 3)
    ROOT_A=$(partition_node 4)
    ROOT_B=$(partition_node 5)
    VAR=$(partition_node 6)
    # #999 Part C2 — mirror install. The FILESYSTEMS move onto md
    # devices; the two boot-critical partitions do not.
    #
    #   bios_boot — grub embeds core.img in it per disk, so each member
    #               needs its own and there is nothing to mirror.
    #   ESP       — firmware reads it before any md driver exists, so it
    #               CANNOT live on an array. Two independent ESPs,
    #               kept byte-identical by ``spatiumddi-esp-sync``.
    #   state / root_a / root_b / var — raid1 across both members.
    #
    # ESP2 is the second disk's ESP. It is labelled distinctly on
    # purpose: two FAT filesystems both labelled ``ESP`` would make the
    # image-baseline fstab's ``LABEL=ESP`` resolve to whichever udev
    # enumerated last, so /boot/efi would silently be a different disk
    # between boots — and the sync would then have no fixed direction.
    local ESP2=""
    if [ "$MIRROR_MODE" = "yes" ]; then
        ESP2=$(partition_node 2 "$TARGET_DISK2")
        STATE=$(md_node 3)
        ROOT_A=$(md_node 4)
        ROOT_B=$(md_node 5)
        VAR=$(md_node 6)
    fi
    # #995 item 25 — on the KEEP_VAR path the table is NOT rewritten, so
    # the positional names above are whatever the disk already has.
    # _layout_is_reusable gates on all five being findable and its comment
    # even promises numbering-independence, so a disk carrying them at other
    # indices would get `mkfs -L root_a` written over the var the operator
    # asked to keep. Resolve each one, and refuse if any is missing rather
    # than falling back to a position that could be anything.
    if [ "$KEEP_VAR" = "yes" ]; then
        local _l _dev _name
        # Resolved against THIS disk only. `blkid -L` searched every disk on
        # the machine, so a box with a second SpatiumDDI disk attached could
        # resolve `var` to the wrong one and mkfs the slots of a disk the
        # operator never picked (#1045).
        #
        # ESP / state / var by filesystem label, the two OS slots by GPT name
        # — same split, and for the same reason, as _layout_is_reusable.
        for _l in ESP:ESP state:STATE var:VAR; do
            _name="${_l%%:*}"
            _dev=$(_labelled_device_on "$TARGET_DISK" "$_name" || true)
            if [ -z "$_dev" ] || [ ! -b "$_dev" ]; then
                log "FATAL: reinstall keeping /var, but no partition of $TARGET_DISK is labelled '$_name'."
                log "  Refusing rather than guessing a partition number. Nothing has been written."
                exit 1
            fi
            printf -v "${_l##*:}" '%s' "$_dev"
            log "Reinstall: ${_l##*:} resolved by label to $_dev"
        done
        for _l in root_a:ROOT_A root_b:ROOT_B; do
            _name="${_l%%:*}"
            _dev=$(_slot_device_on "$TARGET_DISK" "$_name" || true)
            if [ -z "$_dev" ] || [ ! -b "$_dev" ]; then
                log "FATAL: reinstall keeping /var, but $TARGET_DISK has no OS slot '$_name'."
                log "  Refusing rather than guessing a partition number. Nothing has been written."
                exit 1
            fi
            printf -v "${_l##*:}" '%s' "$_dev"
            log "Reinstall: ${_l##*:} resolved to $_dev"
        done
        # A disk carrying the #1045 duplicate resolves both slots by GPT name
        # above, so they are two different partitions and the mkfs a few
        # steps below writes each its correct label — the reinstall leaves
        # the disk consistent. Assert it rather than trust it: installing
        # both slots onto one partition would produce a box with no
        # rollback and nothing would say so.
        if [ "$ROOT_A" = "$ROOT_B" ]; then
            log "FATAL: both OS slots of $TARGET_DISK resolved to $ROOT_A."
            log "  Refusing rather than installing both slots onto one partition."
            exit 1
        fi
    fi

    # Disk-size validation lives in ``pick_disk`` now (fires right
    # after the operator picks rather than at the end of the wizard
    # after they've typed hostname / admin / network / timezone).

    log "Install starting: target=$TARGET_DISK BBP=$BBP ESP=$ESP STATE=$STATE ROOT_A=$ROOT_A ROOT_B=$ROOT_B VAR=$VAR"
    # A marker left by an earlier attempt would make this run report a
    # bootloader failure that did not happen.
    rm -f "$BOOT_LEG_MISSING_FILE" 2>/dev/null || true

    {
        echo "XXX"; echo "3"; echo "Releasing existing partitions on $TARGET_DISK..."; echo "XXX"
        # Pre-existing install on the target disk leaves partitions
        # that the live system's systemd-gpt-auto-generator may have
        # auto-mounted (ESP → /boot/efi, root → /sysroot) or that
        # the kernel still holds open via stale device-mapper or
        # swap entries. sgdisk -Z, mkfs.fat, and the subsequent
        # mount all fail on a busy device, so unconditionally
        # release everything before partitioning.
        #
        # #1003 item 7 — the expected-failure noise goes to the TRACE log,
        # not the install log. Every one of these fails on a partition that
        # is not mounted and not swap, which is the normal case, so a
        # six-partition disk produced eighteen lines of
        #
        #     swapoff: /dev/sda1: swapoff failed: Invalid argument
        #     umount: /dev/sda1: not mounted.
        #
        # That was tolerable while the log died with the live medium. Since
        # #995 item 1 it is copied onto the installed system and #875 ships
        # it in support bundles, so it is now the first thing somebody
        # debugging a failed install reads — and it reads as six failed
        # unmounts. A genuine failure still lands in the install log: only
        # "not mounted" / "Invalid argument" are filtered, and anything else
        # is reported as itself.
        for part in $(lsblk -nr -o NAME "$TARGET_DISK" 2>/dev/null | tail -n +2); do
            _release_quietly swapoff "/dev/$part"
            _release_quietly umount "/dev/$part"
            _release_quietly umount -l "/dev/$part"
        done
        # device-mapper entries (LVM / dm-crypt) backed by this disk —
        # and, since #995 item 10, ONLY this disk. Retry until the target
        # is clear rather than a fixed number of sweeps: the helper emits
        # outermost-first so one pass should do it, and a second is for a
        # transient EBUSY (udev still holding a node open) rather than for
        # ordering. Bounded, because a map that will never release must
        # reach the gate below instead of spinning here.
        local dm dm_maps _rel_disk
        for _rel_disk in $TARGET_DISK ${MIRROR_MODE:+$TARGET_DISK2}; do
            [ -n "$_rel_disk" ] || continue
            # #999 Part C3 — when the TARGET IS a multipath map, the map
            # is the thing we are installing to, not something holding
            # the target open. Tearing it down here would remove the
            # device under our own feet, and the kpartx partition maps
            # are re-created after the new table is written anyway.
            case "$_rel_disk" in
                /dev/mapper/*|*/dm-*)
                    log "Target $_rel_disk is a device-mapper device — skipping dm release (it IS the target)"
                    continue
                    ;;
            esac
            for _ in 1 2 3; do
                dm_maps=$(_dm_maps_on_target "$_rel_disk")
                [ -n "$dm_maps" ] || break
                while read -r dm; do
                    [ -n "$dm" ] || continue
                    log "Releasing device-mapper map '$dm' (backed by $_rel_disk)"
                    dmsetup remove "$dm" >> "$INSTALL_LOG" 2>&1 || true
                done <<EOF
$dm_maps
EOF
            done
        done
        _assert_target_released

        if [ "$KEEP_VAR" = "yes" ]; then
            # #995 item 25 — reuse the table. Repartitioning would destroy
            # the very thing the operator asked to keep, so the whole
            # wipefs / sgdisk / partprobe sequence is skipped and only the
            # two OS slots and the ESP are reformatted below.
            echo "XXX"; echo "5"; echo "Reusing the existing partition table (keeping /var)..."; echo "XXX"
            log "Reinstall keeping /var: partition table left intact on $TARGET_DISK"
        else
        echo "XXX"; echo "5"; echo "Partitioning $TARGET_DISK (A/B + var layout)..."; echo "XXX"
        # #999 Part C2 — stop any array that is already assembled on
        # EITHER target before repartitioning. A live md device holds its
        # members open, and `wipefs -af` FORCES past that (measured — see
        # _assert_target_released): the GPT would be destroyed while the
        # kernel kept the array running on the stale table, and the mkfs
        # that follows would write through it.
        _stop_arrays_on "$TARGET_DISK"
        [ "$MIRROR_MODE" = "yes" ] && _stop_arrays_on "$TARGET_DISK2"
        wipefs -af "$TARGET_DISK"           >> "$INSTALL_LOG" 2>&1
        sgdisk -Z "$TARGET_DISK"            >> "$INSTALL_LOG" 2>&1
        # Force the kernel to forget the old partition table before
        # we lay down a new one. Without this, mkfs against the new
        # partition nodes can race with udev rebuilding /dev/disk/.
        blockdev --rereadpt "$TARGET_DISK"  >> "$INSTALL_LOG" 2>&1 || true
        # GPT type codes — sgdisk shortcuts:
        #   ef02 = BIOS Boot         (i386-pc grub core.img target)
        #   ef00 = EFI System        (FAT32 /boot/efi)
        #   8304 = Linux root (x86-64) — systemd-gpt-auto-generator
        #          can find /usr-aware slots by partition type, used
        #          by 8b's sysupdate slot picker
        #   8300 = generic Linux fs  (var; we mount via /etc/fstab)
        # Partition type codes:
        #   ef02 = BIOS Boot                  (grub i386-pc core.img target;
        #                                      x86-64 ONLY — omitted on
        #                                      arm64, which has no BIOS)
        #   ef00 = EFI System                 (FAT32 /boot/efi)
        #   8304 = Linux root x86-64 / 8305 = Linux root ARM-64 (#1026)
        #                                     (systemd-gpt-auto-generator
        #                                      hint for root slot — used
        #                                      by 8b's slot-write logic;
        #                                      $_ROOT_TYPE picks the one
        #                                      matching this machine)
        #   8310 = Linux /var (4d21b016-...)  (sysd-gpt-auto-generator
        #                                      auto-mounts /var without
        #                                      needing an /etc/fstab
        #                                      entry — critical because
        #                                      the operator-overlay's
        #                                      fstab is INSIDE the
        #                                      overlay we're trying to
        #                                      mount; chicken+egg
        #                                      otherwise. Sets the var
        #                                      partition discoverable.)
        # #1026 — two things vary by architecture, and NOTHING ELSE
        # does. The partition NUMBERS are deliberately identical on both:
        # p1 is simply absent on arm64 rather than the rest shifting
        # down, so ``partition_node``, ``_MD_NAMES``, the mirror path and
        # the verification pass all keep working with no arch branch of
        # their own. sgdisk is happy to create p2..p6 with no p1.
        sgdisk "${_BIOS_BOOT_ARGS[@]}" \
               -n2:0:+512M  -t2:ef00 -c2:ESP \
               -n3:0:+256M  -t3:8300 -c3:state \
               -n4:0:+8G    "-t4:$_ROOT_TYPE" -c4:root_A \
               -n5:0:+8G    "-t5:$_ROOT_TYPE" -c5:root_B \
               -n6:0:0      -t6:8310 -c6:var \
               "$TARGET_DISK"               >> "$INSTALL_LOG" 2>&1
        partprobe "$TARGET_DISK"            >> "$INSTALL_LOG" 2>&1 || true
        udevadm settle                      >> "$INSTALL_LOG" 2>&1 || true
        sleep 1
        # #999 Part C3 — the kernel does not create partition nodes for a
        # device-mapper device the way it does for sd*, so partprobe
        # above did nothing useful on a multipath target. kpartx maps
        # them as /dev/mapper/<name>-partN, which is what partition_node
        # returns for this target.
        _kpartx_add "$TARGET_DISK"
        # #999 Part C2 — the mirror member gets the IDENTICAL table.
        # Written out rather than sgdisk --replicate: --replicate also
        # copies the GPT disk GUID, which must be unique (two disks
        # claiming one GUID is exactly the ambiguity the ESP labelling
        # below exists to avoid), and -G to randomise it afterwards is a
        # second call that can fail on its own.
        if [ "$MIRROR_MODE" = "yes" ]; then
            echo "XXX"; echo "6"; echo "Partitioning mirror member $TARGET_DISK2..."; echo "XXX"
            wipefs -af "$TARGET_DISK2"      >> "$INSTALL_LOG" 2>&1
            sgdisk -Z "$TARGET_DISK2"       >> "$INSTALL_LOG" 2>&1
            blockdev --rereadpt "$TARGET_DISK2" >> "$INSTALL_LOG" 2>&1 || true
            # fd00 (Linux RAID) on every mirrored member, so the array is
            # discoverable by type as well as by superblock and nothing
            # else (a future installer, a rescue distro's autodetect)
            # mistakes a member for a plain ext4 partition.
            sgdisk "${_BIOS_BOOT_ARGS[@]}" \
                   -n2:0:+512M  -t2:ef00 -c2:ESP \
                   -n3:0:+256M  -t3:fd00 -c3:state \
                   -n4:0:+8G    -t4:fd00 -c4:root_A \
                   -n5:0:+8G    -t5:fd00 -c5:root_B \
                   -n6:0:0      -t6:fd00 -c6:var \
                   "$TARGET_DISK2"          >> "$INSTALL_LOG" 2>&1
            # ...and re-type the FIRST disk's mirrored partitions to
            # match. They were laid down as 8300/8304/8310 above.
            sgdisk -t3:fd00 -t4:fd00 -t5:fd00 -t6:fd00 \
                   "$TARGET_DISK"           >> "$INSTALL_LOG" 2>&1
            partprobe "$TARGET_DISK"        >> "$INSTALL_LOG" 2>&1 || true
            partprobe "$TARGET_DISK2"       >> "$INSTALL_LOG" 2>&1 || true
            udevadm settle                  >> "$INSTALL_LOG" 2>&1 || true
            sleep 1
            _create_mirror_arrays
        fi
        fi

        echo "XXX"; echo "10"; echo "Formatting partitions..."; echo "XXX"
        mkfs.fat -F32 -n ESP "$ESP"         >> "$INSTALL_LOG" 2>&1
        # #999 Part C2 — the mirror member's own ESP. Labelled ESP2, not
        # ESP: the image-baseline fstab mounts /boot/efi by LABEL, and two
        # filesystems sharing that label would resolve to whichever udev
        # enumerated last, so /boot/efi could be a different disk between
        # boots and the sync would have no fixed direction.
        if [ "$MIRROR_MODE" = "yes" ]; then
            mkfs.fat -F32 -n ESP2 "$ESP2"   >> "$INSTALL_LOG" 2>&1
        fi
        # STATE partition — issue #276. Small ext4 holding machine
        # config + SSH host keys + supervisor identity. Mounted at
        # /var/lib/spatium-state. Label ``state`` so fstab can
        # ``LABEL=state`` it without chasing UUIDs across re-installs.
        # STATE and var are the two the reinstall keeps. STATE carries the
        # machine identity (SSH host keys, supervisor keypair) and /var
        # the database — losing either is what "keep /var" exists to
        # avoid. The OS slots are replaced either way.
        if [ "$KEEP_VAR" != "yes" ]; then
        mkfs.ext4 -F -L state "$STATE"      >> "$INSTALL_LOG" 2>&1
        fi
        # Label the slots distinctly. NOT because anything boots by this
        # label — grub.cfg renders `root=UUID=` and the image-baseline fstab
        # carries no root entry — but so that `blkid` output, a support
        # bundle and a human at a console all read honestly. The thing that
        # actually identifies a slot is its GPT name (`-c4:root_A` /
        # `-c5:root_B` above), which is what spatium-upgrade-slot matches on
        # and what survives a slot being overwritten with a filesystem image.
        #
        # Both run on the KEEP_VAR path too: the OS slots are replaced either
        # way, which is also what repairs the #1045 duplicate on a disk
        # upgraded by an appliance that predates the fix. root_b is empty
        # until `spatium-upgrade-slot` writes the next image there.
        mkfs.ext4 -F -L root_a "$ROOT_A"    >> "$INSTALL_LOG" 2>&1
        mkfs.ext4 -F -L root_b "$ROOT_B"    >> "$INSTALL_LOG" 2>&1
        if [ "$KEEP_VAR" != "yes" ]; then
        mkfs.ext4 -F -L var    "$VAR"       >> "$INSTALL_LOG" 2>&1
        fi

        echo "XXX"; echo "15"; echo "Mounting target..."; echo "XXX"
        # Mount layout for rsync: root_A as / and var as /var BEFORE
        # rsync runs, so files going to /var land on the var partition
        # automatically (rsync follows the mount tree).
        mkdir -p "$MOUNT"
        mount "$ROOT_A" "$MOUNT"
        mkdir -p "$MOUNT/var"
        mount "$VAR" "$MOUNT/var"
        mkdir -p "$MOUNT/boot/efi"
        mount "$ESP" "$MOUNT/boot/efi"
        # Issue #276 — mount the STATE partition under the eventual
        # runtime path so the install-time render seeds it directly.
        # The unmount step at the end of do_install drops it before
        # /var (LIFO ordering); on next boot fstab re-mounts it via
        # LABEL=state.
        mkdir -p "$MOUNT/var/lib/spatium-state"
        mount "$STATE" "$MOUNT/var/lib/spatium-state"

        echo "XXX"; echo "20"; echo "Copying root filesystem (3-5 min)..."; echo "XXX"
        # #995 item 27 — feed rsync's own progress into the gauge instead
        # of leaving it frozen at 20% for the longest step in the install.
        # A five-minute pause with a static bar is indistinguishable from
        # a hang, and it is the point at which an operator power-cycles.
        #
        # --info=progress2 gives a whole-transfer percentage, written with
        # \r rather than \n. Parsed by a BASH read loop, not awk: the
        # first attempt piped through awk and delivered nothing until
        # rsync exited — Debian ships mawk, which buffers its input on a
        # non-newline RS *and* block-buffers its output to a pipe, so all
        # 41 gauge blocks arrived in one burst at EOF and the bar stayed
        # frozen at 20% exactly as before. `read -d` has no buffer between
        # it and the pipe, and printf from the shell is unbuffered.
        # (`|| [ -n "$_line" ]` so a final record with no trailing \r is
        # not dropped.)
        #
        # stdout here IS the gauge stream — the brace group is piped to
        # whiptail --gauge — so the blocks go straight out and rsync's own
        # stderr goes to the log. Only emit on a CHANGE, or the protocol
        # is flooded with thousands of identical blocks.
        rsync -aAXH --info=progress2 \
            --exclude="/dev/*" \
            --exclude="/proc/*" \
            --exclude="/sys/*" \
            --exclude="/tmp/*" \
            --exclude="/run/*" \
            --exclude="/mnt/*" \
            --exclude="/media/*" \
            --exclude="/lib/live" \
            --exclude="/var/log/*" \
            --exclude="/var/cache/apt/archives/*" \
            --exclude="/var/lib/spatiumddi/firstboot.done" \
            --exclude="/var/lib/spatiumddi/swapfile" \
            --exclude="/etc/spatiumddi/.env" \
            --exclude="/etc/ssh/sshd_config.d/00-spatium-live.conf" \
            --exclude="/etc/issue.d/zz-spatium-live.issue" \
            / "$MOUNT/" 2>> "$INSTALL_LOG" \
            | { _last=-1
                while IFS= read -r -d $'\r' _line || [ -n "$_line" ]; do
                    case "$_line" in
                        *%*) : ;;
                        *) continue ;;
                    esac
                    _pct=${_line#*(} ; _pct=${_line%%\%*} ; _pct=${_pct##* }
                    case "$_pct" in ''|*[!0-9]*) continue ;; esac
                    _g=$(( 20 + (60 - 20) * _pct / 100 ))
                    [ "$_g" = "$_last" ] && continue
                    _last=$_g
                    printf 'XXX\n%d\nCopying root filesystem... %d%%\nXXX\n' "$_g" "$_pct"
                done
              }

        echo "XXX"; echo "60"; echo "Writing boot-critical config to root baseline..."; echo "XXX"
        # IMPORTANT: fstab + /etc/hostname need to land on the
        # UNDERLYING root_A partition (not in the overlay upper), since
        # systemd reads them at boot BEFORE etc.mount can fire. If they
        # were in the overlay only, systemd would never see them, /var
        # wouldn't mount, and the overlay would never mount either —
        # which was the build030 install bug.
        #
        # Belt + braces: /var has GPT type Linux /var
        # (4d21b016-b534-45c2-a9fb-5c16e091fd2d, sgdisk code 8310, set
        # earlier in the partitioning step) so systemd-gpt-auto-
        # generator auto-mounts it even without an fstab entry. On a
        # Phase 8b slot swap to image v2, root_B will ship its own
        # vanilla fstab that lacks our /var UUID — gpt-auto picks up
        # the slack.
        #
        # /home + /root bind mounts deliberately NOT in fstab. They
        # ship as systemd .mount unit files
        # (/etc/systemd/system/home.mount + root.mount) baked into the
        # image baseline, so EVERY image slot's /etc has them. fstab
        # entries would get reset to vanilla on slot swap → operator
        # data masked because /home wouldn't bind-mount; the .mount
        # files are immune to that failure mode.
        # Phase 8a-7 — fstab is IMAGE-BASELINE (no operator-specific
        # UUIDs). Every slot's image-shipped /etc/fstab carries the
        # same content, so a slot swap to image v2 doesn't need any
        # fstab rewrite — root_B's image-baseline fstab is identical.
        #
        # Each mountpoint uses a slot-stable identifier:
        #
        # / (root)         — NOT in fstab. Mounted by kernel via
        #                    root=UUID=… on the cmdline (set per-slot
        #                    in grub.cfg menuentries via grub-install).
        #
        # /var             — LABEL=var. Belt-and-braces with
        #                    systemd-gpt-auto-generator (GPT type
        #                    8310 / 4d21b016-…). gpt-auto's machine-id
        #                    matching can be finicky on first boot;
        #                    LABEL=var in fstab is a reliable fallback.
        #
        # /boot/efi        — LABEL=ESP (set by `mkfs.fat -n ESP`).
        #                    fmask=0133 / dmask=0022 makes files 0644
        #                    and dirs 0755 so the api container (uid
        #                    1000) can read grubenv through the read-
        #                    only /boot/efi:/boot/efi-host bind mount
        #                    that drives the SlotUpgradeCard. No
        #                    secrets live on the ESP — just grub.cfg
        #                    + grubenv + boot loader binaries —
        #                    relaxing perms here is fine.
        #
        # /tmp             — tmpfs, image-baseline.
        #
        # /home + /root    — systemd .mount unit files (image-shipped
        #                    at /etc/systemd/system/home.mount +
        #                    root.mount). Not in fstab.
        # /var/lib/spatium-state — LABEL=state (issue #276). Holds
        # machine config + SSH host keys + supervisor identity.
        # ``nofail`` so a missing/corrupt STATE partition degrades
        # to a normal boot instead of dropping to emergency.target
        # (the render service tolerates an absent STATE and falls
        # back to image-baseline values). Mounted under /var so it
        # orders after the /var mount — the render service's
        # After=local-fs.target dependency covers ordering.
        # #999 Part C2 — ``nofail`` on the ESP for the same reason STATE
        # has it, and it is load-bearing on a mirror: the label ``ESP``
        # exists on the PRIMARY disk only (the mirror member's is
        # ``ESP2``, deliberately, so /boot/efi has a fixed direction).
        # Lose the primary and the survivor boots — grub is on its own
        # ESP and its own bios_boot — only to have systemd fail the
        # /boot/efi mount and drop the whole box into emergency.target.
        # The appliance would be storage-redundant and unbootable, which
        # is precisely the outcome this feature exists to prevent.
        cat > "$MOUNT/etc/fstab" <<'EOF'
LABEL=var    /var                    ext4   defaults                              0 2
LABEL=state  /var/lib/spatium-state  ext4   defaults,nofail                       0 2
LABEL=ESP    /boot/efi               vfat   fmask=0133,dmask=0022,shortname=winnt,nofail 0 2
tmpfs        /tmp                     tmpfs  nosuid,nodev,noexec,mode=1777         0 0
EOF
        echo "$HOSTNAME" > "$MOUNT/etc/hostname"

        echo "XXX"; echo "62"; echo "Snapshotting /etc baseline + mounting overlay (Phase 8a)..."; echo "XXX"
        # Phase 8a-2 — Atomic A/B image upgrade (#138).
        # /usr/lib/etc.image is the slot's "image-shipped /etc"
        # baseline. We snapshot AFTER fstab + hostname write so the
        # snapshot has working boot config (root_B will get its own
        # snapshot from image v2 — sysupdate updates the lower layer).
        # Operator-mutable config (passwd, shadow, network, certs) goes
        # through the overlay later in this install + persists via the
        # /var/persist/etc upper layer across slot swaps.
        #
        # Use cp -a to preserve perms / xattrs / symlinks. /etc is
        # only ~10 MiB so the copy is fast (<2 s on any disk worth
        # running an appliance on).
        mkdir -p "$MOUNT/usr/lib/etc.image"
        cp -a "$MOUNT/etc/." "$MOUNT/usr/lib/etc.image/" >> "$INSTALL_LOG" 2>&1

        # Phase 8a-3 — overlay layout on /var:
        #   /var/persist/etc       upperdir  (operator writes land here)
        #   /var/persist/etc-work  workdir   (overlay scratch space)
        mkdir -p "$MOUNT/var/persist/etc" "$MOUNT/var/persist/etc-work"

        # Issue #276 — SSH host keys + machine config are seeded into
        # the STATE partition, which spatium-etc-render copies into
        # /etc on every boot BEFORE sshd / k3s start. STATE survives
        # both an OS slot swap AND a /var factory reset, so the host
        # key + hostname stay stable forever. Strip the keys out of
        # /etc.image (the overlay LOWER) so a future slot image's
        # mkosi-built keys can never shadow the operator's. (Supersedes
        # the #272 Phase 1 bandaid that parked keys in
        # /var/persist/etc/ssh — STATE is the authoritative home now.)
        STATE_MNT="$MOUNT/var/lib/spatium-state"
        mkdir -p "$STATE_MNT/ssh"
        for k in "$MOUNT/usr/lib/etc.image/ssh/"ssh_host_*_key \
                 "$MOUNT/usr/lib/etc.image/ssh/"ssh_host_*_key.pub; do
            [ -f "$k" ] || continue
            # #995 item 25 — never overwrite a key STATE already holds.
            # STATE is not reformatted on a reinstall, so this loop would
            # otherwise copy the NEW image's freshly-generated host keys
            # over the preserved ones and every client that knew this
            # appliance would get REMOTE HOST IDENTIFICATION HAS CHANGED —
            # the one thing keeping STATE is for.
            if [ -e "$STATE_MNT/ssh/$(basename "$k")" ]; then
                rm -f "$k"
                continue
            fi
            cp -a "$k" "$STATE_MNT/ssh/" >> "$INSTALL_LOG" 2>&1
            rm -f "$k"
        done

        # spatium-config.yaml — the operator-authoritative machine
        # config the render service reads. Flat ``key: value`` shape
        # (see spatium-etc-render's get_cfg parser). Network config is
        # a follow-up; v1 carries hostname + role + control-plane
        # pairing fields.
        cat > "$STATE_MNT/spatium-config.yaml" <<EOF
# SpatiumDDI appliance machine config (issue #276).
# Authoritative source for hostname / role / pairing / network —
# rendered into /etc by spatium-etc-render on every boot. Survives
# OS slot swaps + a /var factory reset.
hostname: "$HOSTNAME"
# #995 item 18 — the operator-chosen admin account. spatiumddi-ssh-reload
# reads this to find whose authorized_keys to manage; without it the #157
# plane hardcodes "admin" and errors out on every appliance installed
# with a different name.
admin_user: "$ADMIN_USER"
# #995 item 26 — the stable name of the disk this was installed to. sdX
# is assigned in discovery order and can move between boots.
target_disk_by_id: "$TARGET_DISK_BY_ID"
role: "$ROLE"
control_plane_url: "$CONTROL_PLANE_URL"
bootstrap_pairing_code: "$BOOTSTRAP_PAIRING_CODE"
# Network — flat keys (no nested map) so the render service's sed
# parser stays dependency-free. mode=dhcp leaves NetworkManager on
# its auto-DHCP default; mode=static makes the render service write
# a keyfile connection profile.
network_mode: "$NET_MODE"
network_interface: "$NET_INTERFACE"
network_ip: "$NET_IP"
network_prefix: "$NET_PREFIX"
network_gateway: "$NET_GATEWAY"
network_dns: "$NET_DNS"
# #995 items 19 + 21 — the chosen port (empty means "any", the old
# NetworkManager-decides behaviour) and the optional static IPv6.
network6_mode: "$NET6_MODE"
network6_ip: "$NET6_IP"
network6_prefix: "$NET6_PREFIX"
network6_gateway: "$NET6_GATEWAY"
# #1017 — optional interface MTU; empty means NetworkManager's default.
# Rendered into the [ethernet] section of whichever keyfile above applies,
# so it only reaches anything when a port is pinned. Applied at boot.
network_mtu: "$NET_MTU"
# #995 items 16 + 17 — recorded so spatium-state and a support bundle can
# show what the install chose. Both are already applied on disk; the
# render service does not act on them.
ntp_servers: "$NTP_SERVERS"
keymap: "$KEYMAP"
# #995 item 12 — recorded, not acted on at boot: the account state is
# already on disk. Here so spatium-state can show what was chosen, and so
# a support bundle explains why root has no password.
root_password_set: "$SET_ROOT_PASSWORD"
EOF
        chmod 0644 "$STATE_MNT/spatium-config.yaml"

        # #995 item 29 — the wizard's answers as a #549 answer file, so an
        # identical reinstall or a fleet clone is one file away instead of
        # nineteen screens. Secrets are deliberately absent: the password
        # (and its hash) and the pairing code are the three things this
        # must never carry, because the file is world-readable on STATE
        # and is meant to be copied off the box. A reader adds them, and
        # --check-preseed will tell them which are missing.
        cat > "$STATE_MNT/spatium-preseed.yaml" <<EOF
# Exported by spatium-install (issue #995 item 29) — the answers this
# appliance was installed with, in the #549 answer-file format.
#
# Public keys ARE included — they are not secrets, and a clone built
# without them comes up with password SSH back on and nothing authorised,
# the inverse of the posture this node was installed with.
#
# NOT directly reusable: admin_password (or admin_password_hash) is
# required, and role: appliance additionally needs pairing_code. Both are
# omitted on purpose. Add them, then lint with:
#     spatium-install --check-preseed spatium-preseed.yaml
spatium_preseed:
  role: "$ROLE"
  confirm_wipe: true
  target_disk: "${TARGET_DISK_BY_ID:+/dev/disk/by-id/}${TARGET_DISK_BY_ID:-$TARGET_DISK}"
  hostname: "$HOSTNAME"
  admin_user: "$ADMIN_USER"
  set_root_password: $([ "$SET_ROOT_PASSWORD" = "yes" ] && echo true || echo false)
  timezone: "$TIMEZONE"
  keymap: "$KEYMAP"
  ntp_servers: "$NTP_SERVERS"
  network:
    mode: "$NET_MODE"
    interface: "$NET_INTERFACE"
$( [ -n "$NET_MTU" ] && printf '    mtu: %s\n' "$NET_MTU" )
$( [ "$NET_MODE" = "static" ] && cat <<NETEOF
    ip: "$NET_IP"
    prefix: $NET_PREFIX
    gateway: "$NET_GATEWAY"
    dns: "$NET_DNS"
NETEOF
)
$( [ "$NET6_MODE" = "static" ] && [ "$NET_MODE" = "static" ] && cat <<NET6EOF
    ip6: "$NET6_IP"
    prefix6: $NET6_PREFIX
    gateway6: "$NET6_GATEWAY"
NET6EOF
)
$( [ "$ROLE" != "appliance" ] && cat <<K3SEOF
  k3s:
    pod_cidr: "$K3S_POD_CIDR"
    service_cidr: "$K3S_SERVICE_CIDR"
K3SEOF
)
$( [ "$ROLE" = "appliance" ] && printf '  control_plane_url: "%s"\n' "$CONTROL_PLANE_URL" )
$( [ -n "$SSH_AUTHORIZED_KEYS" ] && { printf '  ssh_authorized_keys:\n'; printf '%s\n' "$SSH_AUTHORIZED_KEYS" | while IFS= read -r _k; do [ -n "$_k" ] && printf '    - "%s"\n' "$_k"; done; printf '  ssh_disable_password: %s\n' "$([ "$SSH_DISABLE_PASSWORD" = yes ] && echo true || echo false)"; } )
EOF
        chmod 0644 "$STATE_MNT/spatium-preseed.yaml"
        log "Answers exported to /var/lib/spatium-state/spatium-preseed.yaml (no secrets)"

        # Mount overlay over /target/etc for the REMAINDER of the
        # install. Every chroot useradd / chpasswd / file write that
        # would normally land in /etc instead lands in the upper layer
        # on /var/persist/etc — which persists across slot swaps. The
        # subsequent unmount step has to release this BEFORE /var.
        # #995 item 25 — on a reinstall the upper layer is the PREVIOUS
        # install's /etc: its passwd, shadow, group, sshd drop-ins and
        # whiteouts, copied up when that install ran useradd. Left in
        # place, `chroot useradd` finds the old account and — fatal since
        # item 4 — aborts at ~63%, after both slots are already wiped;
        # and a different username would silently leave the old account,
        # its hash and its sudo grant live on the "reinstalled" system.
        #
        # The OS is being replaced, so its mutable /etc goes with it. What
        # the operator asked to keep is /var's DATA and STATE's identity,
        # neither of which lives here.
        if [ "$KEEP_VAR" = "yes" ] && [ -d "$MOUNT/var/persist/etc" ]; then
            rm -rf "$MOUNT/var/persist/etc.previous" 2>/dev/null || true
            mv "$MOUNT/var/persist/etc" "$MOUNT/var/persist/etc.previous" \
                >> "$INSTALL_LOG" 2>&1 || true
            rm -rf "$MOUNT/var/persist/etc-work" 2>/dev/null || true
            mkdir -p "$MOUNT/var/persist/etc" "$MOUNT/var/persist/etc-work"
            log "Reinstall: previous /etc overlay moved aside to /var/persist/etc.previous"
        fi
        mount -t overlay overlay \
            -o "lowerdir=$MOUNT/usr/lib/etc.image,upperdir=$MOUNT/var/persist/etc,workdir=$MOUNT/var/persist/etc-work" \
            "$MOUNT/etc" >> "$INSTALL_LOG" 2>&1

        # Phase 8a — /home + /root on /var so operator home dirs
        # survive slot swaps. The bind mounts are wired via shipped
        # systemd unit files (home.mount + root.mount, baked into the
        # image) rather than fstab — fstab gets reset to image vanilla
        # on slot swap, but every image slot ships the same .mount unit
        # files, so binds are immune to that reset path.
        #
        # useradd inside the upcoming chroot writes to /home/admin →
        # transparent via the install-time bind mount → /var/home/admin
        # on disk → ready for the .mount unit to re-bind at every boot.
        mkdir -p "$MOUNT/var/home" "$MOUNT/home"
        mkdir -p "$MOUNT/var/root"
        # /root already exists in the image rootfs with the live-system
        # contents — move them to /var/root so they live on the
        # persistent side, then re-create an empty /root mountpoint.
        if [ -d "$MOUNT/root" ] && [ -z "$(ls -A "$MOUNT/var/root" 2>/dev/null)" ]; then
            cp -a "$MOUNT/root/." "$MOUNT/var/root/" >> "$INSTALL_LOG" 2>&1 || true
            rm -rf "$MOUNT/root"
        fi
        mkdir -p "$MOUNT/root"
        mount --bind "$MOUNT/var/home" "$MOUNT/home" >> "$INSTALL_LOG" 2>&1
        mount --bind "$MOUNT/var/root" "$MOUNT/root" >> "$INSTALL_LOG" 2>&1

        # Write operator's hostname through the overlay too — lands in
        # /var/persist/etc/hostname on disk → persists across slot
        # swaps verbatim. The underlying root_A /etc/hostname (written
        # earlier) covers the brief window before the overlay mounts
        # on first boot; the overlay upper covers everything else.
        echo "$HOSTNAME" > "$MOUNT/etc/hostname"

        echo "XXX"; echo "65"; echo "Writing system config..."; echo "XXX"
        # fstab + /etc/hostname were already written to the underlying
        # root_A /etc earlier (before the overlay was mounted) so boot
        # can find them. The overlay's lower layer (/usr/lib/etc.image)
        # captured those writes in the snapshot — so they appear in the
        # merged view even though we don't re-write them through the
        # overlay here.
        #
        # role-config + /etc/hosts go through the overlay → upper. The
        # role-config IS operator state (carries the agent key + control
        # plane URL the wizard captured); /etc/hosts carries the
        # operator's hostname. Both must persist across slot swaps.
        mkdir -p "$MOUNT/etc/spatiumddi"
        cat > "$MOUNT/etc/spatiumddi/role-config" <<EOF
ROLE=$ROLE
CONTROL_PLANE_URL=$CONTROL_PLANE_URL
BOOTSTRAP_PAIRING_CODE=$BOOTSTRAP_PAIRING_CODE
EOF
        # Mode 0644 — readable by the host's non-root user (`app`,
        # uid 1000) so the api pod can introspect ``ROLE=`` via its
        # ``/etc/spatiumddi-host/role-config`` bind mount (#272 Phase
        # 1's self-bootstrap endpoint gates on that match). Pairing
        # codes are single-use + 15 min TTL, so a non-root shell on
        # the host already has access via ``sudo`` and the looser
        # mode isn't a meaningful exfiltration vector. firstboot
        # transcribes the value into ``/etc/spatiumddi/.env`` (also
        # mode 0644) on first boot anyway.
        chmod 0644 "$MOUNT/etc/spatiumddi/role-config"

        # Phase 11 (#183) — pre-bake the per-role node labels at
        # install time so the appliance chart's DaemonSets +
        # umbrella chart's control-plane Deployments schedule at
        # first boot without waiting for the supervisor pod to
        # come up + apply labels via its heartbeat reconciler.
        # The supervisor (now running on every variant per #272
        # Phase 1) maintains the labels going forward.
        #
        # IMPORTANT: k3s ``config.yaml.d/*`` drop-ins REPLACE (not
        # append to) list-valued keys from the main ``config.yaml``,
        # so we must re-list the base ``spatium.io/role=appliance``
        # label here. Without it, the chart's
        # ``global.nodeSelector: {spatium.io/role: appliance}``
        # default wouldn't match — DaemonSets compute DESIRED=0 and
        # nothing schedules.
        mkdir -p "$MOUNT/etc/rancher/k3s/config.yaml.d"
        if [ "$ROLE" = "control-plane" ]; then
            # control-plane runs ONLY the umbrella control-plane
            # workloads (api / frontend / worker / beat / postgres /
            # redis) at install time. DNS / DHCP are NOT enabled by
            # default (#272) — the operator turns them on per node via
            # the Fleet role toggle, so DNS/DHCP are a deliberate fleet
            # decision rather than a silent install-time default. Baked
            # unconditionally so the umbrella pods can schedule before
            # the supervisor pod itself is healthy.
            cat > "$MOUNT/etc/rancher/k3s/config.yaml.d/spatium-roles.yaml" <<EOF
# Auto-generated by spatium-install for ROLE=control-plane.
# #272 — supervisor reconciles these on every heartbeat; install-time
# bake is the boot-up bootstrap so pods schedule before the supervisor
# is healthy. DNS/DHCP are enabled later via the Fleet role toggle.
node-label:
  - spatium.io/role=appliance
  - spatium.io/role-control-plane=true
EOF
            chmod 0644 "$MOUNT/etc/rancher/k3s/config.yaml.d/spatium-roles.yaml"
        fi
        # ROLE=appliance leaves the role-label drop-in absent; the
        # supervisor applies role-* labels dynamically via the
        # heartbeat-driven role-assignment flow.

        # Issue #302 — k3s pod + service CIDR drop-in. ALWAYS written,
        # even on defaults, so the values are explicit on disk + a
        # future operator editing /etc/rancher/k3s/config.yaml.d/
        # spatium-cidrs.yaml sees what's in effect (instead of having
        # to grep the upstream k3s default elsewhere). Drop-in form
        # rather than editing the main config.yaml so the in-tree
        # config.yaml stays operator-readable + the install-time
        # choices are isolated in their own file.
        #
        # cluster-dns is derived from the service CIDR base + 10 —
        # k3s + kube-dns convention. The coredns Deployment binds to
        # this IP at startup; changing it post-install requires a
        # coredns restart and is documented as "reinstall" today.
        #
        # #995 item 14 — EXCEPT for an Additional node, which must not
        # pin CIDRs at all: a drop-in that disagrees with the cluster it
        # later joins makes `k3s server --server` refuse to start, and
        # nothing removes the file at join time. Its own single-node k3s
        # runs on the upstream defaults until then.
        local cluster_dns_ip
        if [ "$ROLE" = "appliance" ]; then
            rm -f "$MOUNT/etc/rancher/k3s/config.yaml.d/spatium-cidrs.yaml" \
                >> "$INSTALL_LOG" 2>&1 || true
            log "k3s CIDRs: not pinned (Additional node inherits them on promotion)"
        else
        cluster_dns_ip=$(_cluster_dns_ip_from_svc_cidr "$K3S_SERVICE_CIDR")
        cat > "$MOUNT/etc/rancher/k3s/config.yaml.d/spatium-cidrs.yaml" <<EOF
# Auto-generated by spatium-install (issue #302) — operator-chosen
# k3s pod + service CIDRs from the install wizard. Values default to
# k3s upstream defaults (10.42.0.0/16 / 10.43.0.0/16) unless the
# operator overrode them on an installation where the LAN collided.
#
# These CANNOT be changed in-place — k3s does not support live CIDR
# migration. Reinstall is required to change them (the partition
# layout permits keeping /var across reinstalls; data + Postgres
# state on the persistent volume survive).
cluster-cidr: $K3S_POD_CIDR
service-cidr: $K3S_SERVICE_CIDR
cluster-dns: $cluster_dns_ip
EOF
        chmod 0644 "$MOUNT/etc/rancher/k3s/config.yaml.d/spatium-cidrs.yaml"
        log "k3s CIDRs: pod=$K3S_POD_CIDR svc=$K3S_SERVICE_CIDR dns=$cluster_dns_ip"
        fi

        cat > "$MOUNT/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 $HOSTNAME
::1 ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

        # Timezone
        if [ -e "/usr/share/zoneinfo/$TIMEZONE" ]; then
            ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MOUNT/etc/localtime"
            echo "$TIMEZONE" > "$MOUNT/etc/timezone"
        else
            log "WARN: timezone $TIMEZONE not found, defaulting to UTC"
            ln -sf "/usr/share/zoneinfo/UTC" "$MOUNT/etc/localtime"
            echo "UTC" > "$MOUNT/etc/timezone"
        fi

        # Static-IP config — issue #276. The NetworkManager keyfile is
        # NOT written here anymore; spatium-etc-render materializes it
        # from STATE's spatium-config.yaml (network_* keys, seeded
        # above) on every boot, before NetworkManager starts. That
        # makes the static config survive a /var factory reset (STATE
        # outlives /var) and keeps a single source of truth. NM
        # auto-DHCPs every ethernet interface by default, so dhcp mode
        # needs no keyfile at all.

        echo "XXX"; echo "75"; echo "Creating admin user..."; echo "XXX"
        # Bind /proc /sys /dev for chroot operations.
        for d in proc sys dev; do
            mount --bind "/$d" "$MOUNT/$d"
        done

        # User + password. -m creates home; -G adds to sudo only.
        # (Issue #183 Phase 7 — no docker group on the appliance.)
        #
        # #995 item 4 — this used to end in `|| true`. It is the ONE
        # account that can log into the installed system: mkosi.postinst
        # sets PermitRootLogin no, so a swallowed useradd produces a box
        # with no SSH access at all, discovered after the reboot with the
        # installer gone. Fatal, with the reason named — the validator in
        # ask_user_password should mean this never fires, which is
        # exactly why it must be loud if it does.
        if ! chroot "$MOUNT" useradd -m -G sudo -s /bin/bash "$ADMIN_USER" \
                >> "$INSTALL_LOG" 2>&1; then
            log "FATAL: useradd '$ADMIN_USER' failed inside the target rootfs."
            log "  The installed system would have no sudo-capable account, and"
            log "  root SSH login is disabled — it would be unreachable. Aborting"
            log "  rather than finishing an install nobody can log into."
            exit 1
        fi
        # Set the admin + root passwords with tracing OFF so the
        # plaintext / hash never lands in the set -x trace log. A
        # preseed can supply a crypt(3) hash (ADMIN_PASSWORD_HASH) via
        # `chpasswd -e` instead of the plaintext (#549); the interactive
        # path always uses the plaintext ADMIN_PASSWORD.
        { set +x; } 2>/dev/null
        if [ -n "$ADMIN_PASSWORD_HASH" ]; then
            echo "$ADMIN_USER:$ADMIN_PASSWORD_HASH" | chroot "$MOUNT" chpasswd -e \
                >> "$INSTALL_LOG" 2>&1
            if [ "$SET_ROOT_PASSWORD" = "yes" ]; then
                echo "root:$ADMIN_PASSWORD_HASH" | chroot "$MOUNT" chpasswd -e \
                    >> "$INSTALL_LOG" 2>&1
            fi
        else
            echo "$ADMIN_USER:$ADMIN_PASSWORD" | chroot "$MOUNT" chpasswd \
                >> "$INSTALL_LOG" 2>&1
            if [ "$SET_ROOT_PASSWORD" = "yes" ]; then
                echo "root:$ADMIN_PASSWORD" | chroot "$MOUNT" chpasswd \
                    >> "$INSTALL_LOG" 2>&1
            fi
        fi
        set -x
        # #995 item 12 — root is LOCKED unless the operator asked for it.
        # `passwd -l` prefixes the hash with '!', which refuses password
        # auth without disabling the account: `sudo -i`, `su -` from a
        # sudoer, and single-user mode all still work, so this removes a
        # console login rather than a recovery path. Debian's own default
        # for a fresh install with a sudo user.
        if [ "$SET_ROOT_PASSWORD" != "yes" ]; then
            chroot "$MOUNT" passwd -l root >> "$INSTALL_LOG" 2>&1 || \
                log "WARN: could not lock the root account"
            # ...and make the rescue path this would otherwise remove work
            # again. rescue.target / emergency.target run sulogin, which
            # loops "Login incorrect" forever on a locked account — and
            # spatium-grub-render ships a "(rescue / single-user)"
            # menuentry, so without this the documented recovery route is a
            # dead end on every appliance installed with the new default.
            # SYSTEMD_SULOGIN_FORCE is a PHYSICAL-console escalation only,
            # which is the same threat model as "sshd refuses root either
            # way": someone at the console can already boot from anything.
            mkdir -p "$MOUNT/etc/systemd/system/rescue.service.d" \
                     "$MOUNT/etc/systemd/system/emergency.service.d"
            for _u in rescue emergency; do
                cat > "$MOUNT/etc/systemd/system/$_u.service.d/10-spatium-sulogin.conf" <<EOF
# Written by spatium-install (issue #995 item 12).
# Root has no password (passwd -l), and sulogin cannot authenticate a
# locked account — so without this the shipped rescue menuentry drops to
# a prompt that can never be satisfied. Physical-console only.
[Service]
Environment=SYSTEMD_SULOGIN_FORCE=1
EOF
            done
            log "Root account locked (no console password); use sudo from $ADMIN_USER"
            log "  rescue/emergency targets set SYSTEMD_SULOGIN_FORCE=1 so the console recovery path still works"
        else
            log "Root account password set from the admin password (operator opted in)"
        fi

        # #995 item 17 — persist the console keymap, for the two readers:
        # /etc/default/keyboard is what console-setup applies at boot on
        # Debian, and /etc/vconsole.conf is systemd-vconsole-setup's.
        #
        # #1003 item 1b — but on this image /etc/vconsole.conf is a SYMLINK
        # to default/keyboard, so writing them in sequence made the second
        # write clobber the first: the XKB block went in, `KEYMAP=` replaced
        # the entire file, and console-setup was left with no XKBMODEL —
        # four "keyboard model is unknown, assuming pc105" warnings on every
        # boot and the layout never applied. Masked on a `us` install, and
        # exactly the mangled-password-at-login failure item 17 exists to
        # prevent on any other.
        #
        # So: resolve both paths and write the second only when it is a
        # genuinely different file. Resolving beats special-casing the
        # symlink because what matters is whether they are the same inode,
        # not how they came to be that way — nothing in mkosi.extra creates
        # it, so it arrives from a package postinst that can change.
        #
        # Both files get the XKB block rather than a `KEYMAP=` line.
        # vconsole.conf(5) documents XKBLAYOUT / XKBMODEL / XKBVARIANT, and
        # `KEYMAP=` would name a console keymap that does not exist on this
        # image at all (#1003 item 1a) — so it is inert at best and, since
        # systemd would try to load it, a boot-time failure at worst.
        local xkb_layout xkb_variant xkb_model
        _keymap_to_xkb "$KEYMAP"
        local _kb_block
        _kb_block=$(cat <<EOF
# Written by spatium-install (issue #995 item 17, #1003 item 1b).
# Read by console-setup (Debian) and systemd-vconsole-setup, which is why
# this is the XKB block and not a KEYMAP= line: the image ships no console
# keymaps, so console-setup compiles this with ckbcomp instead.
XKBMODEL="$xkb_model"
XKBLAYOUT="$xkb_layout"
XKBVARIANT="$xkb_variant"
XKBOPTIONS=""
BACKSPACE="guess"
EOF
)
        printf '%s\n' "$_kb_block" > "$MOUNT/etc/default/keyboard"
        chmod 0644 "$MOUNT/etc/default/keyboard"
        local _vc="$MOUNT/etc/vconsole.conf" _kbf="$MOUNT/etc/default/keyboard"
        if [ "$(readlink -f "$_vc" 2>/dev/null || printf '%s' "$_vc")" \
             != "$(readlink -f "$_kbf" 2>/dev/null || printf '%s' "$_kbf")" ]; then
            printf '%s\n' "$_kb_block" > "$_vc"
            chmod 0644 "$_vc"
            log "Keymap persisted: $KEYMAP (keyboard + vconsole)"
        else
            log "Keymap persisted: $KEYMAP (vconsole.conf is the same file - written once)"
        fi

        # #995 item 16 — the operator's time source, as a chrony
        # sourcedir file rather than an edit to chrony.conf.
        #
        # Debian's chrony.conf carries `sourcedir /etc/chrony/sources.d`,
        # so a file there is additive and survives a package upgrade
        # rewriting the main config. It is also the seam the #154 control
        # -plane plane can take over cleanly: that runner replaces
        # chrony.conf wholesale and deletes this file, so central config
        # wins without the two silently stacking.
        mkdir -p "$MOUNT/etc/chrony/sources.d"
        if [ -n "$NTP_SERVERS" ]; then
            {
                echo "# Written by spatium-install (issue #995 item 16)."
                echo "# Replaced by the control plane if NTP is managed centrally."
                # read -a, not `for x in $VAR`: the latter also GLOBS, so a
                # value containing * would emit one server line per file in
                # the current directory.
                local -a _srvs=()
                read -r -a _srvs <<< "$NTP_SERVERS"
                for _srv in "${_srvs[@]}"; do
                    echo "server $_srv iburst"
                done
            } > "$MOUNT/etc/chrony/sources.d/spatium-install.sources"
            chmod 0644 "$MOUNT/etc/chrony/sources.d/spatium-install.sources"
            log "NTP sources written: $NTP_SERVERS"
        else
            # An empty answer is a real choice (air-gapped, trusted RTC) and
            # since #1002 it MEANS no time source: our sources file goes, and
            # so do Debian's own `pool` line and the DHCP sourcedir. See
            # _suppress_default_ntp_sources for why the conffile edit is the
            # only place this can happen and how it composes with #154.
            rm -f "$MOUNT/etc/chrony/sources.d/spatium-install.sources"
            _suppress_default_ntp_sources "$MOUNT/etc/chrony/chrony.conf"
        fi

        # #995 item 18 — the admin's authorized_keys, written after
        # useradd so the home directory exists.
        #
        # /home is bind-mounted onto /var/home for the rest of the
        # install, so this lands on the persistent side and the boot-time
        # .mount unit re-binds it. Ownership by NAME inside the chroot,
        # not a numeric uid guessed out here.
        if [ -n "$SSH_AUTHORIZED_KEYS" ]; then
            mkdir -p "$MOUNT/home/$ADMIN_USER/.ssh"
            printf '%s\n' "$SSH_AUTHORIZED_KEYS" \
                > "$MOUNT/home/$ADMIN_USER/.ssh/authorized_keys"
            chmod 0700 "$MOUNT/home/$ADMIN_USER/.ssh"
            chmod 0600 "$MOUNT/home/$ADMIN_USER/.ssh/authorized_keys"
            chroot "$MOUNT" chown -R "$ADMIN_USER:$ADMIN_USER" \
                "/home/$ADMIN_USER/.ssh" >> "$INSTALL_LOG" 2>&1 || \
                log "WARN: could not chown the admin .ssh directory"
            log "SSH: authorized_keys written for $ADMIN_USER"
        fi
        if [ "$SSH_DISABLE_PASSWORD" = "yes" ]; then
            # The same drop-in path the #157 control-plane plane manages,
            # so central config later REPLACES this rather than fighting
            # it.
            #
            # The 10- file has to GO, not be layered over. mkosi.postinst
            # ships /etc/ssh/sshd_config.d/10-spatiumddi-password-auth.conf
            # carrying `PasswordAuthentication yes` (it exists to undo
            # Debian 13's default), sshd takes the FIRST value it obtains
            # for a keyword, and Include expands the glob in lexical order
            # — so `10-…` beats anything named `spatiumddi.conf` and the
            # setting would report success while doing nothing. Removing
            # it makes precedence irrelevant instead of making this file's
            # name load-bearing.
            mkdir -p "$MOUNT/etc/ssh/sshd_config.d"
            rm -f "$MOUNT/etc/ssh/sshd_config.d/10-spatiumddi-password-auth.conf"
            cat > "$MOUNT/etc/ssh/sshd_config.d/spatiumddi.conf" <<EOF
# Written by spatium-install (issue #995 item 18).
# Superseded wholesale if the control plane manages SSH (#157).
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF
            chmod 0644 "$MOUNT/etc/ssh/sshd_config.d/spatiumddi.conf"
            log "SSH: password authentication disabled (key-only)"
        fi

        # Disable cloud-init on the installed system (we configured
        # everything ourselves; cloud-init would just sit waiting for a
        # datasource that isn't there).
        chroot "$MOUNT" systemctl mask \
            cloud-init.service cloud-init-local.service \
            cloud-config.service cloud-final.service \
            >> "$INSTALL_LOG" 2>&1 || true

        echo "XXX"; echo "78"; echo "Installing kernel into /boot..."; echo "XXX"
        # mkosi strips /boot from the rootfs during image build —
        # it stages the kernel and initrd as separate output files
        # for its own bootable image, then deletes them from /boot.
        # The rsync above brought across an empty /boot, so we need
        # to put the kernel binary back before update-grub can scan
        # for boot menu entries.
        local KVER
        KVER=$(ls "$MOUNT/lib/modules" 2>/dev/null | head -1)
        if [ -z "$KVER" ]; then
            log "ERROR: no /lib/modules in target — rsync didn't copy modules?"
            exit 1
        fi
        log "Target kernel version: $KVER"

        local LIVE_KERNEL=""
        for path in /run/live/medium/live/vmlinuz \
                    /lib/live/mount/medium/live/vmlinuz \
                    /run/live/medium/live/vmlinuz1 \
                    /lib/live/mount/medium/live/vmlinuz1; do
            [ -f "$path" ] && LIVE_KERNEL="$path" && break
        done
        if [ -z "$LIVE_KERNEL" ]; then
            log "ERROR: couldn't find live kernel binary to install"
            ls /run/live/medium/live/ >> "$INSTALL_LOG" 2>&1 || true
            ls /lib/live/mount/medium/live/ >> "$INSTALL_LOG" 2>&1 || true
            exit 1
        fi
        log "Copying $LIVE_KERNEL -> /boot/vmlinuz-$KVER"
        install -m 0644 "$LIVE_KERNEL" "$MOUNT/boot/vmlinuz-$KVER"
        ln -sf "vmlinuz-$KVER" "$MOUNT/boot/vmlinuz"
        # Phase 8c — initrd.img symlink alongside vmlinuz so grub.cfg
        # can reference stable paths regardless of kernel version. The
        # symlink target is created by update-initramfs below.
        ln -sf "initrd.img-$KVER" "$MOUNT/boot/initrd.img"

        echo "XXX"; echo "80"; echo "Configuring initramfs (virtio + storage modules)..."; echo "XXX"
        # Force the storage / virtio drivers into the initrd so the
        # installed kernel can find its root partition. MODULES=most
        # is the Debian default but is overly conservative on slim
        # cloud-amd64 — explicit module list guarantees they're in.
        # Without virtio_blk the kernel panics at boot with
        # "VFS: Unable to mount root fs on unknown-block(0,0)" on
        # any VM hypervisor.
        sed -i 's/^MODULES=.*/MODULES=most/' \
            "$MOUNT/etc/initramfs-tools/initramfs.conf" 2>/dev/null || true
        cat > "$MOUNT/etc/initramfs-tools/modules" <<'EOF'
# Forced into the initrd by spatium-install for VM compatibility.
virtio
virtio_pci
virtio_blk
virtio_scsi
virtio_net
virtio_ring
ext4
EOF
        # #999 Part C2 — a mirrored root cannot be mounted until the array
        # is assembled, and that happens in the initrd. Two halves, and
        # BOTH are required:
        #
        #   * the raid modules, so the kernel can drive an array at all;
        #   * /etc/mdadm/mdadm.conf, because Debian's initramfs hook
        #     copies that file in and its local-top script assembles from
        #     it. Without ARRAY lines the assemble is a scan that may or
        #     may not run depending on the AUTO policy — and "may or may
        #     not" resolves to an unbootable box, so the real UUIDs are
        #     written rather than relying on a scan.
        if [ "$MIRROR_MODE" = "yes" ]; then
            cat >> "$MOUNT/etc/initramfs-tools/modules" <<'EOF'
# #999 — mirrored root: assembled by the initrd before / is mounted.
md_mod
raid1
EOF
            mkdir -p "$MOUNT/etc/mdadm"
            {
                echo "# Written by spatium-install (#999 Part C2)."
                echo "# The initramfs hook copies this file in; its local-top"
                echo "# script assembles these arrays before / is mounted."
                echo "HOMEHOST <ignore>"
                echo "DEVICE partitions"
                mdadm --detail --scan 2>/dev/null
            } > "$MOUNT/etc/mdadm/mdadm.conf"
            log "mdadm.conf written:"
            cat "$MOUNT/etc/mdadm/mdadm.conf" >> "$INSTALL_LOG" 2>&1
            # An mdadm.conf with no ARRAY line would produce an initrd
            # that cannot find root. Refuse now, while the operator is
            # still in front of the installer.
            if ! grep -q '^ARRAY' "$MOUNT/etc/mdadm/mdadm.conf"; then
                log "FATAL: mdadm --detail --scan produced no ARRAY lines."
                log "  The initrd would not assemble the mirror and the box would not boot."
                exit 1
            fi
        fi

        echo "XXX"; echo "82"; echo "Regenerating initrd for disk boot..."; echo "XXX"
        # live-tools dpkg-diverts /usr/sbin/update-initramfs into a
        # no-op symlink that points at /usr/bin/live-update-initramfs
        # (the live-update-initramfs binary prints "I: update-initramfs
        # is disabled (live system is running...)" and exits 0). The
        # rsync'd rootfs inherits that diversion, so a naive
        # `chroot $MOUNT update-initramfs` is silently the no-op and
        # /boot/initrd.img-<kver> never lands. Fix in three steps:
        # (1) `rm` the live-tools symlink at /usr/sbin/update-initramfs.
        #     A bare `dpkg-divert --rename --remove` errors with
        #     "rename involves overwriting ... with different file ...
        #     not allowed" because the symlink is in the way.
        # (2) `dpkg-divert --rename --remove` then moves the parked
        #     /usr/sbin/update-initramfs.orig.initramfs-tools back
        #     into /usr/sbin/update-initramfs cleanly.
        # (3) update-initramfs is now the real binary and future
        #     kernel upgrades on the installed system regenerate
        #     initrds normally.
        log "Undiverting update-initramfs (live-tools shadowed it as a no-op)"
        chroot "$MOUNT" rm -f /usr/sbin/update-initramfs \
            >> "$INSTALL_LOG" 2>&1 || true
        chroot "$MOUNT" /usr/bin/dpkg-divert --rename --remove \
            /usr/sbin/update-initramfs >> "$INSTALL_LOG" 2>&1 || true

        chroot "$MOUNT" env \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
            /usr/sbin/update-initramfs -c -k "$KVER" \
            >> "$INSTALL_LOG" 2>&1

        # Verify the initrd actually landed. The wrap-iso pipeline
        # to whiptail --gauge has surprised us before by swallowing
        # the failure (subshell + pipefail interactions); on the
        # previous install attempt update-initramfs silently failed
        # and the installed system grub then couldn't find
        # /boot/initrd.img-<kver>.
        if [ ! -f "$MOUNT/boot/initrd.img-$KVER" ]; then
            log "ERROR: update-initramfs did NOT produce /boot/initrd.img-$KVER"
            log "Contents of $MOUNT/boot:"
            ls -la "$MOUNT/boot" >> "$INSTALL_LOG" 2>&1
            log "End of install log — see above for update-initramfs output."
            exit 1
        fi
        log "initrd written: $(ls -lh "$MOUNT/boot/initrd.img-$KVER" | awk '{print $5}')"
        ln -sf "initrd.img-$KVER" "$MOUNT/boot/initrd.img"

        echo "XXX"; echo "85"; echo "Writing GRUB config (Phase 8c A/B + boot counting)..."; echo "XXX"
        # GRUB still needs the slot UUIDs for `search --fs-uuid` (so
        # it can find each slot's /boot/vmlinuz regardless of disk
        # ordering) and `root=UUID=…` on the kernel cmdline. fstab no
        # longer carries them (Phase 8a-7 — image-baseline fstab uses
        # LABEL= only); grub.cfg keeps using per-slot UUIDs because
        # it's WHERE the boot menu lives + the menuentries are
        # per-slot anyway.
        local ROOT_A_UUID ROOT_B_UUID
        ROOT_A_UUID=$(blkid -s UUID -o value "$ROOT_A")
        ROOT_B_UUID=$(blkid -s UUID -o value "$ROOT_B")
        # #554 — guard against an empty UUID (blkid racing the just-created
        # filesystem). An empty value renders ``root=UUID=`` into grub.cfg —
        # valid syntax that grub-script-check accepts but that produces an
        # unbootable slot. Settle udev + retry once before giving up.
        if [ -z "$ROOT_A_UUID" ] || [ -z "$ROOT_B_UUID" ]; then
            udevadm settle 2>/dev/null || true
            [ -z "$ROOT_A_UUID" ] && ROOT_A_UUID=$(blkid -s UUID -o value "$ROOT_A")
            [ -z "$ROOT_B_UUID" ] && ROOT_B_UUID=$(blkid -s UUID -o value "$ROOT_B")
        fi
        if [ -z "$ROOT_A_UUID" ] || [ -z "$ROOT_B_UUID" ]; then
            log "ERROR: could not read slot filesystem UUIDs (A=$ROOT_A_UUID B=$ROOT_B_UUID) — refusing to render grub with an empty root=UUID="
            exit 1
        fi

        # Write /etc/default/grub explicitly so future `update-grub`
        # runs (e.g. on kernel upgrade) get the same cmdline. We
        # don't rely on update-grub at install time — we write
        # grub.cfg directly below — but installed-system tooling
        # will read this file later.
        cat > "$MOUNT/etc/default/grub" <<EOF
GRUB_DEFAULT=saved
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="SpatiumDDI"
GRUB_SAVEDEFAULT=true
# Issue #136: do NOT hide boot output ("quiet" / show_status=false).
# spatium-console.service claims tty1 seconds after kernel boot and
# overpaints whatever was there, so the brief visible boot text only
# matters when something is wrong (a panic, a missed module, plymouth
# eating keystrokes — all silently undebuggable otherwise).
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 audit=0"
# systemd.ssh_auto=no — #1003 item 9. systemd-ssh-generator probes for an
# AF_VSOCK CID and exits 1 on a VM that has a vsock device but no CID
# (Proxmox), which is the ONLY non-kernel journalctl -p err entry on an
# otherwise healthy boot. The appliance has no use for the vsock SSH
# endpoint, and per #994 a healthy node whose logs say otherwise trains
# operators to skim past the one that matters.
GRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200n8 systemd.ssh_auto=no"
GRUB_TERMINAL_INPUT="console serial"
GRUB_TERMINAL_OUTPUT="console serial"
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_LINUX_UUID=false
EOF

        # Phase 8c — grub.cfg + grubenv on the ESP (/boot/efi/grub/),
        # NOT on each slot's /boot/grub/. Reasons:
        #   * ESP is shared between slots → single source of truth for
        #     the boot menu. spatium-upgrade-slot doesn't need to keep
        #     two grub.cfg copies in sync.
        #   * grub-reboot / grub-set-default write to grubenv on the
        #     same filesystem as grub.cfg — keeping both on ESP means
        #     they survive verbatim across slot swaps.
        #   * If an operator wipes /var, the boot menu still works
        #     (it's on the ESP, untouched).
        #
        # Two slot menuentries with --id=slot_a / slot_b. default reads
        # ${saved_entry} from grubenv. spatiumddi-firstboot.service
        # commits saved_entry via grub-set-default once the new slot
        # passes /health/live. grub-reboot from spatium-upgrade-slot
        # is the one-shot "try this slot once" mechanism.
        #
        # APPLIANCE_VERSION_LABEL feeds the menuentry titles so the
        # grub menu shows "SpatiumDDI Appliance <ver> (slot A)" instead
        # of the bare slot letter. Both slots get the same version at
        # install time (they're identical copies after the rsync at
        # line 1060); spatium-upgrade-slot apply re-stamps the
        # inactive slot's title after each dd via _patch_grub_cfg_slot_
        # _label so the menu stays accurate across upgrades.
        local APPLIANCE_VERSION_LABEL
        APPLIANCE_VERSION_LABEL=$(_appliance_version_from \
            "$MOUNT/etc/spatiumddi/appliance-release")
        mkdir -p "$MOUNT/boot/efi/grub"
        # #395 — grub.cfg is now rendered by spatium-grub-render (one source of
        # truth for the menu, shared with the firstboot reconcile and
        # spatium-upgrade-slot apply). The renderer runs in a chroot so it uses
        # the rootfs's own grub-script-check for syntax validation. Both UUIDs
        # come from the freshly-formatted partitions (blkid'd above); the version
        # label seeds both slot titles (root_B is an rsync clone of root_A at
        # install, so both slots have the same version at this point).
        chroot "$MOUNT" /usr/local/bin/spatium-grub-render \
            --install-root / \
            --root-a-uuid "$ROOT_A_UUID" \
            --root-b-uuid "$ROOT_B_UUID" \
            --version-label "$APPLIANCE_VERSION_LABEL" \
            >> "$INSTALL_LOG" 2>&1
        # Seed grubenv with default + saved_entry pointing at slot_a so
        # the very first boot lands on slot_a unambiguously. grub-editenv
        # creates the file with the right size (1024 bytes, zero-padded).
        chroot "$MOUNT" /usr/bin/grub-editenv /boot/efi/grub/grubenv set saved_entry=slot_a \
            >> "$INSTALL_LOG" 2>&1
        # Seed the verbose-boot toggle OFF (quiet boot + dashboard) so the
        # menuentry's ${spatium_verbose} conditional resolves to the default
        # branch from the very first boot. The Fleet UI flips it to 1 later via
        # spatiumddi-verbose-boot-reload.
        chroot "$MOUNT" /usr/bin/grub-editenv /boot/efi/grub/grubenv set spatium_verbose=0 \
            >> "$INSTALL_LOG" 2>&1

        echo "XXX"; echo "88"; echo "Installing bootloader (BIOS + UEFI to ESP)..."; echo "XXX"
        # Use --boot-directory=/boot/efi so BOTH BIOS and UEFI grub
        # read their config (and grubenv) from the ESP. Without this,
        # BIOS grub embeds slot_a's UUID + /boot/grub path into
        # core.img — meaning a damaged slot_a breaks the boot menu
        # even when slot_b is healthy.
        #
        # #995 item 2 — the UEFI call used to end in `|| true`, so on a
        # UEFI-only guest a failed EFI install still reached the Done
        # screen and the box simply did not boot, with the reason sitting
        # unread in a log that (until item 1) did not survive the reboot
        # either. Both targets are still attempted — the disk should boot
        # in either firmware mode — but the one matching how the LIVE ISO
        # booted is the one we can actually hold to account here, so that
        # one is fatal and the other stays best-effort.
        #
        # Neither ordering can be assumed away: `--removable` writes
        # EFI/BOOT/BOOTX64.EFI (BOOTAA64.EFI on arm64) and needs no
        # efivars or efibootmgr, so the
        # EFI install can legitimately succeed on a BIOS-booted machine,
        # and the i386-pc install can legitimately succeed on a UEFI one
        # because the BIOS Boot partition (p1, ef02) is laid down
        # regardless. Which is why the failure of the *other* one is a
        # log line rather than an abort.
        # #1026 — the BIOS leg exists on x86-64 only. On arm64 there is
        # no i386-pc target to install and no BIOS-boot partition to
        # install it into, so skipping it is not a degraded install to
        # warn about: the EFI leg below is the ONLY boot path, and it is
        # already fatal-on-failure there because a non-UEFI arm64 machine
        # was refused before the disk was touched.
        if [ "$TARGET_ARCH" != "arm64" ]; then
            if ! chroot "$MOUNT" /usr/sbin/grub-install --target=i386-pc \
                    --boot-directory=/boot/efi \
                    "$TARGET_DISK" >> "$INSTALL_LOG" 2>&1; then
                if [ "$FIRMWARE_MODE" = "bios" ]; then
                    log "FATAL: grub-install --target=i386-pc failed and this"
                    log "  machine booted in BIOS/CSM mode, so that is the path it"
                    log "  will boot from. Refusing to report a successful install."
                    exit 1
                fi
                log "WARN: grub-install --target=i386-pc failed. This machine"
                log "  booted in UEFI mode so the install continues, but the disk"
                log "  will NOT boot in a BIOS/CSM machine."
                echo "BIOS/CSM" > "$BOOT_LEG_MISSING_FILE" 2>/dev/null || true
            fi
        fi
        if ! chroot "$MOUNT" /usr/sbin/grub-install --target="$_GRUB_EFI_TARGET" \
                --efi-directory=/boot/efi \
                --boot-directory=/boot/efi \
                --bootloader-id=SPATIUMDDI \
                --removable \
                >> "$INSTALL_LOG" 2>&1; then
            # On arm64 this is unconditionally fatal — FIRMWARE_MODE
            # cannot be anything but uefi by the time we get here, so the
            # branch reads the same either way, but the message must not
            # offer a BIOS consolation that does not exist.
            if [ "$FIRMWARE_MODE" = "uefi" ]; then
                log "FATAL: grub-install --target=$_GRUB_EFI_TARGET failed and"
                log "  this machine booted in UEFI mode, so that is the path it"
                log "  will boot from. Refusing to report a successful install."
                exit 1
            fi
            log "WARN: grub-install --target=$_GRUB_EFI_TARGET failed. This"
            log "  machine booted in BIOS/CSM mode so the install continues, but"
            log "  the disk will NOT boot in a UEFI machine."
            echo "UEFI" > "$BOOT_LEG_MISSING_FILE" 2>/dev/null || true
        fi

        # #999 Part C2 — the mirror member must boot on its own, which is
        # the entire point: a mirror whose surviving disk cannot boot has
        # protected the data and not the appliance.
        #
        # This is the part of a RAID1 install that is easy to skip and
        # fatal to skip. Three separate things have to land on disk 2:
        #
        #   1. BIOS core.img in ITS bios_boot partition (grub embeds a
        #      disk-specific image; disk 1's is useless here).
        #   2. EFI/BOOT/BOOTX64.EFI (BOOTAA64.EFI on arm64) on ITS ESP,
        #      via --removable so no
        #      efivars entry is needed — firmware falls back to the
        #      removable path when the NVRAM entry points at a dead disk.
        #   3. grub.cfg + grubenv, which live on the ESP and are NOT
        #      mirrored (the ESP cannot be an md member — firmware reads
        #      it before any md driver exists). Handled by the sync below
        #      and kept in step afterwards by spatiumddi-esp-sync.
        #
        # Failures here are WARNINGS, not aborts: the appliance boots
        # from disk 1 either way, and refusing the whole install because
        # the redundant bootloader did not take would be a worse outcome
        # than an install that works but is not yet fully redundant. The
        # post-install verification pass re-checks it and says so.
        if [ "$MIRROR_MODE" = "yes" ]; then
            echo "XXX"; echo "90"; echo "Installing bootloader on the mirror member..."; echo "XXX"
            # ESP2 is mounted FIRST, and BOTH installs point at it.
            #
            # The BIOS install is the subtle one. grub-install embeds the
            # filesystem UUID of --boot-directory into the core.img it
            # writes to that disk's bios_boot partition. Pointing it at
            # /boot/efi — the PRIMARY disk's ESP — puts disk 2's core.img
            # in the position of looking for a filesystem that is on the
            # disk that just died, so BIOS-booting the survivor alone
            # lands at `grub rescue>`. It has to embed ITS OWN ESP.
            mkdir -p "$MOUNT/boot/efi2"
            if mount "$ESP2" "$MOUNT/boot/efi2" >> "$INSTALL_LOG" 2>&1; then
                # #1026 — x86-64 only; arm64 has no BIOS boot path on
                # either member, so there is nothing to install and
                # nothing to warn about.
                if [ "$TARGET_ARCH" != "arm64" ]; then
                    if ! chroot "$MOUNT" /usr/sbin/grub-install --target=i386-pc \
                            --boot-directory=/boot/efi2 \
                            "$TARGET_DISK2" >> "$INSTALL_LOG" 2>&1; then
                        log "WARN: grub-install --target=i386-pc failed on the mirror"
                        log "  member $TARGET_DISK2. The array is redundant but the box"
                        log "  will not BIOS-boot from that disk alone."
                    fi
                fi
                if ! chroot "$MOUNT" /usr/sbin/grub-install --target="$_GRUB_EFI_TARGET" \
                        --efi-directory=/boot/efi2 \
                        --boot-directory=/boot/efi2 \
                        --bootloader-id=SPATIUMDDI \
                        --removable \
                        >> "$INSTALL_LOG" 2>&1; then
                    log "WARN: grub-install --target=$_GRUB_EFI_TARGET failed on ESP2."
                    log "  The box will not UEFI-boot from $TARGET_DISK2 alone."
                fi
                # Unmount BEFORE syncing: spatiumddi-esp-sync mounts ESP2
                # itself (it has to — on the running appliance nothing
                # else ever mounts it), and a second mount of the same
                # device would either fail or give it a view it does not
                # own.
                umount "$MOUNT/boot/efi2" >> "$INSTALL_LOG" 2>&1 || true
                # Unmount BEFORE syncing: spatiumddi-esp-sync mounts ESP2
                # itself (it has to — on the running appliance nothing
                # else ever mounts it), and a second mount of the same
                # device would either fail or hand it a view it does not
                # own.
                umount "$MOUNT/boot/efi2" >> "$INSTALL_LOG" 2>&1 || \
                    log "WARN: could not unmount ESP2 before the initial sync"
                # Copy the rendered menu + environment across. Done here
                # rather than left to the first sync so the appliance is
                # redundant from the moment the installer finishes, not
                # from the first upgrade.
                chroot "$MOUNT" /usr/local/bin/spatiumddi-esp-sync --install-root / \
                    >> "$INSTALL_LOG" 2>&1 || \
                    log "WARN: initial ESP sync failed — run spatiumddi-esp-sync on the host."
            else
                log "WARN: could not mount $ESP2 — the mirror member has no boot config."
            fi
            rmdir "$MOUNT/boot/efi2" 2>/dev/null || true
        fi

        echo "XXX"; echo "93"; echo "Cloning root_A → root_B (slot redundancy)..."; echo "XXX"
        # Phase 8c — install BOTH slots with the same content so an
        # operator can `spatium-upgrade-slot set-next-boot slot_b`
        # immediately after install. Without this, root_B is mkfs'd
        # but empty — the first set-next-boot fails at the grub prompt
        # with "no such device: <root_B-UUID>" and "file /boot/vmlinuz
        # not found", leaving the system stuck at the grub menu.
        #
        # Source: /target with the overlay /etc + var/home/root binds
        # mounted. We rsync the merged view of /etc (so root_B's
        # underlying /etc has the same hostname/fstab as root_A's
        # snapshot did at install) but skip the mount-targets for
        # /var, /home, /root, /boot/efi (those are bind/auto-mounted
        # at runtime, root_B doesn't carry their content).
        mkdir -p /mnt/spatium-root-b
        mount "$ROOT_B" /mnt/spatium-root-b
        rsync -aAXH \
            --exclude="/var/*" \
            --exclude="/home/*" \
            --exclude="/root/*" \
            --exclude="/boot/efi/*" \
            --exclude="/dev/*" \
            --exclude="/proc/*" \
            --exclude="/sys/*" \
            --exclude="/tmp/*" \
            --exclude="/run/*" \
            --exclude="/mnt/*" \
            "$MOUNT/" /mnt/spatium-root-b/ >> "$INSTALL_LOG" 2>&1
        # rsync excludes ./var/* but it can still create the empty
        # /var dir — make sure all the mount-points exist as empty
        # directories on root_B so the boot-time mount units succeed.
        mkdir -p /mnt/spatium-root-b/var /mnt/spatium-root-b/home \
                 /mnt/spatium-root-b/root /mnt/spatium-root-b/boot/efi
        umount /mnt/spatium-root-b 2>/dev/null || umount -l /mnt/spatium-root-b 2>/dev/null || true
        rmdir /mnt/spatium-root-b 2>/dev/null || true

        mkdir -p "$MOUNT/var/log/spatiumddi/install" 2>/dev/null || true
        echo "XXX"; echo "93"; echo "Verifying the installed system..."; echo "XXX"
        # #995 item 30 — check the things whose absence is only
        # discovered at the next boot, while the operator is still here
        # and the disk is still mounted. Each failure is a WARN on the
        # Done screen rather than an abort: the install is complete, and
        # an operator who can see "the ESP has no bootloader" before
        # rebooting is in a far better position than one who reboots into
        # a grub prompt.
        # A FILE on the live tmpfs, not a variable: the whole install runs
        # inside `{ … } | whiptail --gauge` and the left side of a pipeline
        # is a subshell, so an assignment here is discarded before the Done
        # screen reads it. The same trap shellcheck caught on
        # BOOT_LEG_MISSING_FILE. $MOUNT is unmounted by then, so /run it is.
        rm -f "$VERIFY_FAIL_FILE" 2>/dev/null || true
        local verify_fail=""
        # Takes the check as ARGUMENTS, not as a string to eval: eval on a
        # quoted expression is both a footgun and the reason shellcheck
        # cannot see inside it.
        _verify() {
            local desc="$1"
            shift
            if ! "$@" >/dev/null 2>&1; then
                verify_fail="${verify_fail}  - $desc"$'\n'
                log "VERIFY FAILED: $desc"
            fi
        }
        # shellcheck disable=SC2329  # invoked indirectly, via _verify "$@"
        _grubenv_points_at_slot_a() {
            chroot "$MOUNT" /usr/bin/grub-editenv /boot/efi/grub/grubenv list \
                | grep -q "saved_entry=slot_a"
        }
        # shellcheck disable=SC2329  # invoked indirectly, via _verify "$@"
        _slot_b_has() {
            # A glob, so it needs a shell rather than `test`.
            compgen -G "/mnt/spatium-verify-b/boot/$1*" >/dev/null
        }
        # #1026 — the removable-media default bootloader filename is
        # per-architecture (UEFI spec §3.5.1.1): BOOTX64.EFI on x86-64,
        # BOOTAA64.EFI on AArch64. Hardcoding the x86 name made a
        # perfectly good arm64 install report POST-INSTALL CHECKS FAILED
        # on the Done screen — the one screen whose entire job is to tell
        # the operator whether to trust the reboot.
        _verify "the ESP carries a UEFI bootloader (EFI/BOOT/$_EFI_REMOVABLE)" \
            test -f "$MOUNT/boot/efi/EFI/BOOT/$_EFI_REMOVABLE"
        _verify "the ESP carries grub.cfg" \
            test -f "$MOUNT/boot/efi/grub/grub.cfg"
        _verify "grub.cfg parses" \
            chroot "$MOUNT" /usr/bin/grub-script-check /boot/efi/grub/grub.cfg
        _verify "grubenv points at slot_a" _grubenv_points_at_slot_a
        _verify "the machine config on STATE is present" \
            test -s "$MOUNT/var/lib/spatium-state/spatium-config.yaml"
        _verify "the admin account exists in the installed system" \
            chroot "$MOUNT" getent passwd "$ADMIN_USER"
        # root_B was unmounted after the clone; re-mount briefly to check
        # that the slot an operator can switch to on day one is actually
        # bootable, which is the whole point of cloning it.
        mkdir -p /mnt/spatium-verify-b
        if mount -o ro "$ROOT_B" /mnt/spatium-verify-b 2>/dev/null; then
            _verify "the inactive slot (root_B) carries a kernel" _slot_b_has vmlinuz
            _verify "the inactive slot (root_B) carries an initrd" _slot_b_has initrd.img
            umount /mnt/spatium-verify-b 2>/dev/null || true
        else
            verify_fail="${verify_fail}  - the inactive slot (root_B) could not be mounted"$'\n'
        fi
        rmdir /mnt/spatium-verify-b 2>/dev/null || true
        if [ -n "$verify_fail" ]; then
            printf '%s' "$verify_fail" > "$VERIFY_FAIL_FILE" 2>/dev/null || true
            # ...and a copy on the installed system, which outlives the
            # reboot the operator is about to do.
            printf '%s' "$verify_fail" \
                > "$MOUNT/var/log/spatiumddi/install/verify.failed" 2>/dev/null || true
            log "Post-install verification found problems (see the Done screen)"
        else
            log "Post-install verification: all checks passed"
        fi

        echo "XXX"; echo "94"; echo "Saving installer logs to the target..."; echo "XXX"
        # #995 item 1 — last write before the unmount block, so the copy
        # captures everything except the unmounts themselves.
        _save_install_logs

        echo "XXX"; echo "95"; echo "Unmounting..."; echo "XXX"
        for d in dev sys proc; do
            umount "$MOUNT/$d" 2>/dev/null || true
        done
        # #554 — these cleanup unmounts run AFTER the install is complete,
        # under ``set -e``. A single busy mount (e.g. something still holding
        # /var) would abort do_install → the EXIT trap fires → the reboot
        # below never runs, showing "Installer exited with status N" after a
        # SUCCESSFUL install. Make each best-effort with a lazy-unmount
        # fallback; the imminent reboot clears anything still held.
        # Phase 8a unmount order matters:
        #   1. /home, /root            — bind mounts onto /var subdirs
        #   2. /etc (overlay)          — upper is on /var, release first
        #   3. /var/lib/spatium-state  — STATE partition, mounted under
        #                                /var so release before /var (#276)
        #   4. /var partition          — after /etc overlay + binds + STATE
        #   5. root_A                  — last
        for mp in \
            "$MOUNT/boot/efi" \
            "$MOUNT/home" \
            "$MOUNT/root" \
            "$MOUNT/etc" \
            "$MOUNT/var/lib/spatium-state" \
            "$MOUNT/var" \
            "$MOUNT"; do
            umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
        done
        sync

        echo "XXX"; echo "100"; echo "Done."; echo "XXX"
        sleep 1
    } | whiptail --backtitle "$BACKTITLE" --title "Installing SpatiumDDI" \
        --gauge "Starting installation…" 12 76 0
    # Notes on the --gauge args:
    #   * Initial text MUST be non-empty. newt-based whiptail (Debian)
    #     skips drawing the message line entirely when the initial text
    #     is "", and subsequent XXX/N/message/XXX update blocks then
    #     don't bring it back. The operator sees only the % bar and no
    #     "Creating admin user" / "Installing bootloader" copy.
    #   * Height 12 (was 10) gives enough vertical space for a wrapped
    #     line — a few of the step messages run ~50 chars and on the
    #     fbcon=font:VGA8x8 console they can wrap before width=70 fits.
    #   * Width 76 (was 70) for the same wrap-headroom reason.

    # Best-effort eject of the install media BEFORE the operator
    # confirms reboot. Real CD-ROM drives obviously unmount and pop
    # the tray; QEMU/Proxmox virtual CD-ROMs honor the guest's ATA
    # EJECT — the device stays present in the VM but the ISO is
    # unmapped, so even if BIOS boot order still prefers CD it gets
    # "no media" and falls through to the disk. Errors are
    # ignored: ejecting a USB stick from inside the running guest
    # can't actually disconnect it electrically; the message below
    # tells the operator to pull it manually.
    for dev in /dev/sr0 /dev/sr1 /dev/cdrom; do
        [ -b "$dev" ] || continue
        eject "$dev" >> "$INSTALL_LOG" 2>&1 || true
    done

    # Title kept short (4 chars) so it doesn't collide with the
    # BACKTITLE on the dialog top frame — whiptail renders backtitle on
    # row 0 + dialog title on the immediately-adjacent dialog top
    # border, and overlong combined widths cause the title to overflow
    # into the backtitle (visible as e.g. "0.1.0ation complete"). The
    # backtitle is no longer a fixed 36 chars either: #995 item 8 made it
    # carry the real APPLIANCE_VERSION, so a CalVer tag takes it to ~43.
    # Which is a reason to keep the title short, not a reason to grow it.
    #
    # No inner box-drawing in the body: whiptail's own dialog frame
    # is the visual container, an inner ASCII box renders inconsistently
    # across console fonts (right edge alignment depends on each
    # content line being padded to the exact same column, which is
    # fragile + ugly) and the console font on the live ISO doesn't
    # render Unicode box-drawing chars at all. Plain indented text +
    # the `*** … ***` attention rule scans cleanly on tty1, in serial
    # consoles, and over SSH.
    #
    # #549 headless follow-up — GATE this msgbox on FULLY_UNATTENDED, the
    # same as welcome + the final confirm are gated in main()'s state
    # machine. A fully-preseeded install has no operator on tty1 to press
    # OK, so showing it unconditionally hangs the run FOREVER: the disk is
    # already partitioned, rsynced, grub-installed, answer-injected and
    # synced, and the media ATA-ejected — but `systemctl reboot` below is
    # never reached, so the appliance completes its install correctly yet
    # never boots into it. (Hypervisor-side workarounds can't rescue this:
    # the install ISO is the live boot medium, so its tray stays LOCKED —
    # `eject /dev/sr0` above fails and a "tray-open" completion signal can
    # never fire; and whiptail on tty1 ignores an injected Enter/ACPI on a
    # headless guest.) The msgbox's "remove the install media" advice is
    # moot when unattended (the eject already fired; hypervisors honor the
    # ATA EJECT) and there is no human to read it. Interactive + partial-
    # preseed installs still show it (an operator was prompted for
    # something, so give them the review + media reminder).
    # #995 item 5 — the Done screen was wrong three ways, and each one
    # sent the operator somewhere useless:
    #
    #   * it advertised http://, and the appliance frontend 301s to
    #     https, so the very first thing they tried redirected;
    #   * it said first boot "pulls the SpatiumDDI container images",
    #     which has not been true since #170 Wave A4 baked them into the
    #     rootfs — the wait is k3s starting and IMPORTING them, and an
    #     operator told it is pulling goes hunting for a network problem
    #     that does not exist;
    #   * it showed a web login to BOTH roles, and an Additional node has
    #     no web UI at all — it registers and waits in pending. The
    #     screen has to be role-aware or half of all installs end at a
    #     connection refused.
    #
    # And in DHCP mode the address is not "<appliance IP>": the live
    # system is holding a lease right now, and barring a reservation
    # change the installed system comes back on the same one. Show it,
    # hedged, rather than a placeholder.
    local done_addr=""
    if [ "$NET_MODE" = "static" ] && [ -n "$NET_IP" ]; then
        done_addr="$NET_IP"
    else
        done_addr=$(ip -4 -br addr 2>/dev/null \
            | awk '$1!="lo" && $3!="" {sub(/\/.*/, "", $3); print $3; exit}' || true)
    fi

    if [ -f "$BOOT_LEG_MISSING_FILE" ]; then
        BOOT_LEG_WARNING=$(cat "$BOOT_LEG_MISSING_FILE" 2>/dev/null || true)
    fi

    local done_next
    if [ "$ROLE" = "appliance" ]; then
        # No web UI on this node; the next action is on the control plane.
        done_next="\
  This node has no web UI. It registers on first boot and waits in
  \"pending\" until an admin approves it and assigns DNS / DHCP roles:
    Control plane:  ${CONTROL_PLANE_URL:-<not set>}
    Approve it at:  Appliance -> Fleet -> Approvals"
    else
        done_next="\
  Web UI:  https://${done_addr:-<appliance IP>}/
  Login:   admin / admin  (change forced on first login)"
        if [ -z "$done_addr" ]; then
            done_next+="
  Address unreadable here; see the console banner after reboot."
        elif [ "$NET_MODE" != "static" ]; then
            done_next+="
  DHCP: that is the installer's own lease; confirm it after reboot."
        fi
    fi

    # Body assembled first so the box can be sized to it. The old screen
    # was a fixed 24 rows around ~23 lines of text — over newt's usable
    # area (height minus borders, spacer and button row) even before this
    # change, and the role block now makes the length vary. So
    # compute the height, and clamp it to the terminal: an 80x24 serial
    # console is a first-class install path here (spatium-console@ttyS0),
    # and asking newt for a window taller than the screen is not a
    # cosmetic problem, it fails to draw.
    local done_body
    done_body="SpatiumDDI is installed on $TARGET_DISK.

  *** REMOVE THE INSTALL MEDIA before the reboot ***
  An ATA EJECT already fired, but detach the ISO in the VM config
  (Proxmox: Hardware -> CD/DVD -> Do not use) or unplug the USB
  stick, or the firmware boots straight back into this installer.

First boot takes 2-5 min while k3s starts and imports the container
images baked into this build. Nothing is downloaded.

$done_next
${BOOT_LEG_WARNING:+
  NOTE: the $BOOT_LEG_WARNING bootloader did NOT install. This disk boots
  only in $FIRMWARE_MODE mode — see /var/log/spatiumddi/install/.
}
Installer logs are kept at /var/log/spatiumddi/install/.
Your answers are at /var/lib/spatium-state/spatium-preseed.yaml.
Press OK to reboot."
    if [ -s "$VERIFY_FAIL_FILE" ]; then
        done_body="POST-INSTALL CHECKS FAILED:
$(cat "$VERIFY_FAIL_FILE")
$done_body"
    fi

    if [ "${FULLY_UNATTENDED:-0}" != "1" ]; then
    # `|| true` because whiptail returns 255 on ESC and `set -e` is still
    # on: without it, an operator who dismisses the final screen with ESC
    # instead of Enter aborts a SUCCESSFUL install, and `systemctl reboot`
    # below never runs. Same reasoning as the #554 comment on the unmount
    # loop above.
    # --scrolltext: _whiptail_height clamps to the terminal, and whiptail
    # then TRUNCATES the tail rather than scrolling it. On an 80x24 console
    # with BOOT_LEG_WARNING or a VERIFY_FAIL_FILE prepended, the lines lost
    # are the last three — the install-log path (#995 item 1's entire
    # deliverable), the answers-file path, and "Press OK to reboot" — and
    # they vanish on exactly the failure path that needs them.
    whiptail --backtitle "$BACKTITLE" --title "Done" \
        --scrolltext \
        --msgbox "$done_body" "$(_whiptail_height "$done_body" 76)" 76 || true
    else
        log "Fully unattended: install complete on $TARGET_DISK — skipping the interactive Done prompt and rebooting straight into the installed system."
    fi

    log "Install complete. Rebooting."
    systemctl reboot
}

# ── Headless preseed (issue #549) ──────────────────────────────────────────────

# Fetch a URL to $2 with a bounded retry loop — the installer wizard can
# reach discover_preseed before NetworkManager has finished DHCP, so a
# single curl would lose the race and drop a URL-preseeded fleet box to
# the interactive wizard. Retry ~6× over ~30 s (only the cmdline-URL
# path pays this; file / CIDATA transports never call it). Returns 0 on
# success.
_fetch_preseed_url() {
    local url="$1" dest="$2" attempt
    for attempt in 1 2 3 4 5 6; do
        if curl -fsSL --max-time 20 "$url" -o "$dest" 2>>"$INSTALL_LOG"; then
            return 0
        fi
        log "Preseed: fetch attempt $attempt/6 for $url failed (network may still be coming up)"
        sleep 5
    done
    return 1
}

# Optional integrity pin for a cmdline preseed URL (issue #581):
#   spatium.preseed.sha256=<64 hex>
# Read once, here, so both the scheme gate and the post-fetch verify use
# the same value.
_preseed_url_sha256() {
    sed -n 's/.*spatium\.preseed\.sha256=\([0-9a-fA-F]*\).*/\1/p' \
        "$PROC_CMDLINE" 2>/dev/null | tr 'A-F' 'a-f'
}

# Integrity gate for the kernel-cmdline URL transport (issue #581).
#
# The URL transport is the ONE preseed source that arrives over the
# network from a party we cannot authenticate: file / CIDATA transports
# are physically attached, but a PXE/IPMI-supplied `spatium.preseed=`
# URL is fetched over whatever the DHCP-advertised path offers. That
# answer file carries `confirm_wipe: true` and a `target_disk` — so
# whoever controls the bytes on the wire controls a full unattended disk
# wipe, the admin password, and (appliance role) the pairing code that
# enrols the box into a control plane. Plain http gives an on-path
# attacker all three for free.
#
# Accept a URL only when its integrity is established one of two ways:
#   * https:// — TLS authenticates the origin and protects the body.
#   * a sha256 pin on the cmdline — content-addressed, so the transport
#     no longer has to be trusted (this is the escape hatch for the
#     air-gapped / internal-CA PXE setups where https isn't practical).
# A sha256 pin is verified whenever it is supplied, https or not.
#
# Returns 0 to proceed with $1 (the URL), 1 to refuse it.
_preseed_url_allowed() {
    local url="$1" pin
    pin=$(_preseed_url_sha256)
    case "$url" in
        https://*) return 0 ;;
    esac
    if [ -n "$pin" ]; then
        log "Preseed: plain-http URL accepted — pinned to sha256 $pin"
        return 0
    fi
    return 1
}

# Verify a fetched preseed against the cmdline sha256 pin, if one was
# given. Returns 0 when there is no pin (nothing to check) or the digest
# matches; 1 on mismatch or when no sha256 tool is available to check a
# pin that WAS supplied (fail closed — a pin the installer cannot verify
# must not be treated as verified).
_preseed_url_verified() {
    local file="$1" pin got
    pin=$(_preseed_url_sha256)
    [ -n "$pin" ] || return 0
    if ! command -v sha256sum >/dev/null 2>&1; then
        log "Preseed: sha256 pin supplied but sha256sum is unavailable — refusing"
        return 1
    fi
    got=$(sha256sum "$file" 2>/dev/null | awk '{print $1}')
    if [ "$got" = "$pin" ]; then
        log "Preseed: sha256 pin verified ($got)"
        return 0
    fi
    log "Preseed: sha256 MISMATCH — expected $pin, got ${got:-<unreadable>}"
    return 1
}

# Append a discovered candidate to the parallel arrays.
#   $1 local file path, $2 human source description, $3 kind
_add_preseed_cand() {
    PRESEED_CAND_FILE+=("$1")
    PRESEED_CAND_SRC+=("$2")
    PRESEED_CAND_KIND+=("$3")
}

# Collect every preseed answer-file candidate, in priority order, into
# the PRESEED_CAND_* arrays. Sources:
#   1. Kernel cmdline `spatium.preseed=<url|path>` (PXE/IPMI) — explicit.
#   2. A block device labelled CIDATA (NoCloud): spatium-preseed.yaml /
#      .yml (explicit) or a cloud-init user-data (opportunistic — only
#      used if it actually carries a spatium_preseed block). VM/Proxmox.
#   3. The live install medium / rootfs-baked spatium-preseed.yaml
#      (sneakernet / CI) — explicit.
# Returns 0 if at least one candidate was found; 1 otherwise.
discover_preseed() {
    local cmdval
    cmdval=$(sed -n 's/.*spatium\.preseed=\([^ ]*\).*/\1/p' "$PROC_CMDLINE" 2>/dev/null)
    if [ -n "$cmdval" ]; then
        case "$cmdval" in
            http://*|https://*)
                local dest=/run/spatium-cand-cmdline.yaml
                # Integrity gate BEFORE the fetch (issue #581) — refuse
                # an unauthenticated source outright rather than pulling
                # it and hoping. Halt rather than silently dropping to
                # the interactive wizard: the operator explicitly asked
                # for a headless install from this URL, and a fleet
                # rollout that quietly waits at a whiptail prompt looks
                # identical to one that hung.
                if ! _preseed_url_allowed "$cmdval"; then
                    PRESEED_SOURCE="kernel cmdline URL $cmdval"
                    preseed_halt \
"Refusing preseed URL over plain http with no integrity pin:

  $cmdval

An answer file authorises an unattended disk wipe and carries the
admin password (and, for the appliance role, the pairing code), so
it must come from a source that cannot be tampered with in transit.

Use either:
  * an https:// URL, or
  * spatium.preseed.sha256=<64-hex-digest> on the kernel cmdline
    alongside spatium.preseed=<url>  (content-pinned, so plain
    http is fine — for air-gapped / internal-CA PXE setups)"
                fi
                if _fetch_preseed_url "$cmdval" "$dest"; then
                    if _preseed_url_verified "$dest"; then
                        _add_preseed_cand "$dest" "kernel cmdline URL $cmdval" explicit
                    else
                        rm -f "$dest"
                        PRESEED_SOURCE="kernel cmdline URL $cmdval"
                        preseed_halt \
"Preseed URL failed its sha256 integrity check:

  $cmdval

The fetched answer file does not match the spatium.preseed.sha256
digest on the kernel cmdline. The install has stopped rather than
act on content that may have been modified in transit.
See $INSTALL_LOG for the expected and actual digests."
                    fi
                else
                    log "Preseed: gave up fetching $cmdval from cmdline after retries"
                fi
                ;;
            *)
                if [ -f "$cmdval" ]; then
                    _add_preseed_cand "$cmdval" "kernel cmdline path $cmdval" explicit
                else
                    log "Preseed: cmdline path $cmdval not found"
                fi
                ;;
        esac
    fi

    # NoCloud CIDATA volume(s). Case-insensitive label match; try a few
    # spellings operators use.
    local dev label
    for label in CIDATA cidata Cidata; do
        dev=$(blkid -L "$label" 2>/dev/null || true)
        [ -n "$dev" ] && break
    done
    if [ -n "$dev" ]; then
        local mnt=/run/spatium-cidata
        mkdir -p "$mnt"
        if mount -o ro "$dev" "$mnt" 2>>"$INSTALL_LOG"; then
            local cand kind dest i=0
            for cand in spatium-preseed.yaml spatium-preseed.yml user-data; do
                [ -f "$mnt/$cand" ] || continue
                case "$cand" in
                    user-data) kind=opportunistic ;;
                    *)         kind=explicit ;;
                esac
                # Copy off the volume before we umount it.
                dest="/run/spatium-cand-cidata-$i.yaml"
                i=$((i + 1))
                cp "$mnt/$cand" "$dest" 2>>"$INSTALL_LOG"
                _add_preseed_cand "$dest" "CIDATA volume $dev ($cand)" "$kind"
            done
            umount "$mnt" 2>>"$INSTALL_LOG" || true
        fi
    fi

    # Live install medium + rootfs-baked locations (all explicit).
    local path
    for path in \
        /run/live/medium/spatium-preseed.yaml \
        /lib/live/mount/medium/spatium-preseed.yaml \
        /spatium-preseed.yaml \
        /etc/spatium-preseed.yaml; do
        [ -f "$path" ] && _add_preseed_cand "$path" "$path" explicit
    done

    [ "${#PRESEED_CAND_FILE[@]}" -gt 0 ]
}

# Recompute FULLY_UNATTENDED — true only when EVERY field the wizard
# would prompt for is preseeded (so the run needs zero console input).
# Missing anything leaves it 0 and the wizard shows welcome + the final
# confirm around whatever prompts still fire.
compute_unattended() {
    FULLY_UNATTENDED=0
    [ -n "${PRESEED_HAS_ROLE:-}" ]      || return 0
    [ -n "${PRESEED_HAS_DISK:-}" ]      || return 0
    [ -n "${PRESEED_HAS_HOSTNAME:-}" ]  || return 0
    [ -n "${PRESEED_HAS_PASSWORD:-}" ]  || return 0
    [ -n "${PRESEED_HAS_NETWORK:-}" ]   || return 0
    [ -n "${PRESEED_HAS_TIMEZONE:-}" ]  || return 0
    [ -n "${PRESEED_HAS_K3S:-}" ]       || return 0
    if [ "$ROLE" = "appliance" ]; then
        [ -n "${PRESEED_HAS_CONTROL_URL:-}" ]  || return 0
        [ -n "${PRESEED_HAS_PAIRING_CODE:-}" ] || return 0
    fi
    FULLY_UNATTENDED=1
}

# Halt-loud helper — a preseed that WAS supplied but failed validation
# (or couldn't be parsed) must stop the unattended run with a clear
# message + non-zero exit, never silently pick a default on a wipe.
preseed_halt() {
    set +x
    clear
    cat <<EOF

============================================================
  SpatiumDDI headless install — PRESEED ERROR
============================================================

$1

The preseed answer file was found but could not be used, so
the install has stopped rather than guess a value on an
unattended disk wipe.

Fix the answer file and reboot the installer, or run
'spatium-install' from this shell to install interactively.

Source: ${PRESEED_SOURCE:-<unknown>}
Log:    $INSTALL_LOG
============================================================

EOF
    log "Preseed halt: $1"
    exit 1
}

# ── Offline preseed linter — `--check-preseed` (issue #581) ────────────────────
#
# Usage text, printed by `--help` (to stdout) and shared with the usage
# error path (which prints its own one-liner to stderr).
usage() {
    cat <<'EOF'
spatium-install — SpatiumDDI appliance disk installer

Usage:
  spatium-install
      Run the interactive install wizard (must be root). Also picks up a
      headless preseed answer file automatically when one is present
      (spatium.preseed= cmdline, a CIDATA seed, or a rootfs-baked
      spatium-preseed.yaml) — see docs for the format.

  spatium-install --check-preseed <preseed.yaml>
      Offline-lint a headless preseed answer file (issue #549 format)
      WITHOUT installing anything. Runs unprivileged, reads only the
      given file, and touches no disk / whiptail / /run. Reports every
      problem it finds in one pass. Exit status:
        0  the preseed is valid (a real headless install would accept it)
        1  the preseed is invalid (errors printed to stderr)
        2  usage error (missing / unreadable file)
      Machine-specific checks (does target_disk exist / clear the size
      floor on THIS box) are reported as warnings, so the same file lints
      identically on a dev laptop and the real appliance.

  spatium-install --help
      Show this help.
EOF
}

# Host-portable pre-flight for a #549 preseed answer file. It parses the
# file with the SAME helper the real headless install uses
# (spatium-preseed-parse) so the lint can never diverge from what an
# unattended boot actually accepts, then re-runs the interactive wizard's
# own rules (_validate_static_net + _k3s_cidr_error) against the resolved
# values.
#
# That second layer matters: the parser's built-in static-network check
# is looser than _validate_static_net (it does NOT enforce
# gateway-in-subnet or validate the DNS list). On a real install
# ask_network re-validates a preseeded static block and halts — but only
# at install time, after the operator has already committed the boot. The
# linter surfaces the same problem offline, before any disk is touched,
# on any machine — which is the whole point of a pre-flight.
check_preseed() {
    local file="$1"
    local -a errors=() warns=()
    local line

    local parser
    if ! parser=$(_preseed_parser_path); then
        echo "ERROR: spatium-preseed-parse not found next to $0 or in /usr/local/bin" >&2
        return 2
    fi

    # Reuse the real parser. Its two output files (non-secret env + secret
    # env) go to tempfiles we own and delete; the secret file may carry an
    # admin password / pairing code, so it's 0600.
    local tmp_env tmp_secret out rc
    tmp_env=$(mktemp 2>/dev/null) || { echo "ERROR: cannot create tempfile" >&2; return 2; }
    tmp_secret=$(mktemp 2>/dev/null) || { rm -f "$tmp_env"; echo "ERROR: cannot create tempfile" >&2; return 2; }
    chmod 0600 "$tmp_secret" 2>/dev/null || true

    out=$(python3 "$parser" "$file" "$tmp_env" "$tmp_secret" 2>&1)
    rc=$?

    case "$rc" in
        0) : ;;  # parsed OK — resolved values are in $tmp_env / $tmp_secret
        2)
            # A supplied field failed the parser's own validation. The
            # parser accumulates + prints EVERY such error already, one
            # per `  - ` line — lift them verbatim.
            while IFS= read -r line; do
                case "$line" in
                    "  - "*) errors+=("${line#  - }") ;;
                esac
            done <<<"$out"
            [ "${#errors[@]}" -eq 0 ] && errors+=("preseed validation failed: $out")
            ;;
        3) errors+=("preseed file is not valid YAML / could not be read: $out") ;;
        4) errors+=("no spatium preseed content — the file has no spatium_preseed block and no recognised preseed field; is this the right file?") ;;
        *) errors+=("unexpected spatium-preseed-parse error (rc=$rc): $out") ;;
    esac

    # Advisory parser NOTES (e.g. an absent target_disk, a bare sdX name)
    # become WARNINGS — they never fail the lint.
    while IFS= read -r line; do
        case "$line" in
            "NOTE: "*) warns+=("${line#NOTE: }") ;;
        esac
    done <<<"$out"

    local role_display="<interactive>" unattended="no"
    if [ "$rc" -eq 0 ]; then
        # Load the resolved values + PRESEED_HAS_* markers exactly as
        # load_preseed would, then apply the interactive wizard's rules on
        # top. shellcheck can't follow the runtime source.
        # shellcheck disable=SC1090
        [ -f "$tmp_env" ] && . "$tmp_env"
        # shellcheck disable=SC1090
        [ -f "$tmp_secret" ] && . "$tmp_secret"

        # Static network — reuse the interactive prompt's own helper,
        # which is stricter than the parser (gateway-in-subnet + DNS).
        if [ -n "${PRESEED_HAS_NETWORK:-}" ] && [ "${NET_MODE:-}" = "static" ]; then
            local nerr
            if ! nerr=$(_validate_static_net); then
                while IFS= read -r line; do
                    [ -n "$line" ] && errors+=("network: $line")
                done <<<"$nerr"
            fi
        fi

        # #1017 — the MTU, for the same belt-and-braces reason. The
        # linter exists to predict what the install will do, and
        # ``ask_network``'s preseed branch runs this check and aborts on
        # it; without it here a file that lints clean can still stop a
        # headless install at "Preseed network MTU is invalid".
        if [ -n "${PRESEED_HAS_NETWORK:-}" ] && [ -n "${NET_MTU:-}" ]; then
            local merr
            if ! merr=$(_mtu_error); then
                errors+=("network.mtu: $merr")
            fi
        fi

        # k3s CIDRs — reuse the shared _k3s_cidr_error core (belt-and-
        # braces: the parser already validates k3s, so this only fires if
        # the two implementations ever drift).
        if [ -n "${PRESEED_HAS_K3S:-}" ]; then
            local kerr
            kerr=$(_k3s_cidr_error "${K3S_POD_CIDR}" "${K3S_SERVICE_CIDR}")
            [ -n "$kerr" ] && errors+=("k3s: $kerr")
        fi

        [ -n "${PRESEED_HAS_ROLE:-}" ] && role_display="$ROLE"
        compute_unattended
        [ "$FULLY_UNATTENDED" = "1" ] && unattended="yes"
    fi

    rm -f "$tmp_env" "$tmp_secret"

    local i
    for ((i = 0; i < ${#warns[@]}; i++)); do
        echo "WARN: ${warns[$i]}"
    done

    if [ "${#errors[@]}" -gt 0 ]; then
        {
            echo ""
            echo "The preseed answer file failed validation:"
            for ((i = 0; i < ${#errors[@]}; i++)); do
                echo "  ERROR: ${errors[$i]}"
            done
        } >&2
        return 1
    fi

    echo "OK: $file is a valid spatium preseed (role=$role_display, fully-unattended=$unattended)."
    return 0
}

# Discover + parse a preseed, if present. Tries every discovered
# candidate in priority order; the first one that carries real preseed
# content is adopted. A candidate with a spatium block but an invalid
# field halts loudly; a candidate with NO preseed content (e.g. a plain
# cloud-init user-data) is skipped so it can't shadow a real preseed on
# a lower-priority source. On success sources the resolved wizard
# variables + PRESEED_HAS_* markers and sets PRESEED_ACTIVE=1.
load_preseed() {
    if ! discover_preseed; then
        log "No preseed answer file found — interactive install"
        return 0
    fi

    local i f src kind out rc chosen=""
    for i in "${!PRESEED_CAND_FILE[@]}"; do
        f="${PRESEED_CAND_FILE[$i]}"
        src="${PRESEED_CAND_SRC[$i]}"
        kind="${PRESEED_CAND_KIND[$i]}"
        # The answer file may carry a plaintext admin password / pairing
        # code — lock it down on the (tmpfs) live rootfs before parsing.
        chmod 0600 "$f" 2>/dev/null || true
        log "Preseed: trying candidate ($kind) $src -> $f"

        # Through the shared resolver, not a hardcoded absolute path: with
        # three spellings in one file the linter and the wizard could find
        # the repo's parser while a real preseed load found the installed
        # one, which is the divergence _preseed_parser_path exists to
        # remove. (The `|| true` keeps the pre-existing behaviour of
        # falling through to the parser's own not-found error.)
        out=$(python3 "$(_preseed_parser_path || echo /usr/local/bin/spatium-preseed-parse)" \
            "$f" "$PRESEED_ENV" "$PRESEED_SECRET_ENV" 2>&1)
        rc=$?
        printf '%s\n' "$out" >> "$INSTALL_LOG"
        case "$rc" in
            0)
                PRESEED_SOURCE="$src"
                chosen=1
                break
                ;;
            2)
                # Has a spatium block but a supplied field is invalid —
                # halt regardless of source kind (it IS an intended
                # preseed, just broken).
                PRESEED_SOURCE="$src"
                preseed_halt "Preseed validation failed:"$'\n\n'"$out"
                ;;
            3)
                # Malformed YAML. An explicit spatium-preseed.yaml / a
                # cmdline value the operator clearly meant as a preseed
                # halts; an opportunistic user-data that just happens to
                # be unparseable is not ours — skip it.
                if [ "$kind" = "explicit" ]; then
                    PRESEED_SOURCE="$src"
                    preseed_halt "Preseed file could not be parsed:"$'\n\n'"$out"
                fi
                log "Preseed: skipping unparseable opportunistic $src"
                ;;
            4)
                # Parsed fine but no spatium content (plain cloud-init
                # user-data). Skip to the next candidate.
                log "Preseed: $src has no spatium preseed content — trying next candidate"
                ;;
            *)
                PRESEED_SOURCE="$src"
                preseed_halt "Unexpected preseed parser error (rc=$rc):"$'\n\n'"$out"
                ;;
        esac
    done

    if [ -z "$chosen" ]; then
        log "Preseed: no candidate carried preseed content — interactive install"
        return 0
    fi
    log "Preseed source adopted: $PRESEED_SOURCE"

    # Source the resolved non-secret values (ROLE / HOSTNAME / TARGET_DISK
    # / NET_* / K3S_* / PRESEED_HAS_* markers). shellcheck can't follow
    # the runtime path.
    # shellcheck disable=SC1090
    [ -f "$PRESEED_ENV" ] && . "$PRESEED_ENV"
    # Secrets (admin password / hash, pairing code) with tracing OFF so
    # they never reach the set -x trace log.
    { set +x; } 2>/dev/null
    # shellcheck disable=SC1090
    [ -f "$PRESEED_SECRET_ENV" ] && . "$PRESEED_SECRET_ENV"
    set -x

    PRESEED_ACTIVE=1
    compute_unattended
    log "Preseed loaded: role=${ROLE} disk=${TARGET_DISK:-<interactive>} fully_unattended=$FULLY_UNATTENDED"
    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    # Non-install command modes (issue #581). These run BEFORE the root
    # check so an operator can lint an answer file or read the help on any
    # workstation. Clear the on_failure EXIT trap first: its drop-to-shell
    # recovery is for the live installer, not a CLI that intentionally
    # exits non-zero.
    case "${1:-}" in
        -h|--help)
            trap - EXIT
            usage
            exit 0
            ;;
        --check-preseed)
            trap - EXIT
            if [ -z "${2:-}" ] || [ ! -f "${2:-}" ]; then
                echo "usage: spatium-install --check-preseed <preseed.yaml>" >&2
                exit 2
            fi
            check_preseed "$2"
            exit $?
            ;;
    esac

    if [ "$(id -u)" -ne 0 ]; then
        echo "Run as root." >&2
        exit 1
    fi

    # Headless preseed (issue #549) — if an answer file is present, load
    # + validate it first. Populated fields skip their prompt below; a
    # fully-preseeded run skips welcome + the final confirm too. A bad
    # preseed halts loudly here rather than falling through.
    load_preseed
    if [ "$PRESEED_ACTIVE" = "1" ]; then
        if [ "$FULLY_UNATTENDED" = "1" ]; then
            log "Preseed: fully unattended — no console interaction required"
        else
            log "Preseed: partial — prompting interactively for missing fields"
        fi
    fi

    # Linear step table + a three-way return, replacing the hand-written
    # per-step case that routed Back by name.
    #
    #   0  the screen drew and the operator went forward
    #   1  Back
    #   2  the screen drew NOTHING (preseeded, or inert for this role)
    #
    # The third code is the fix. Every ask_* short-circuits when its field
    # is preseeded, so with a partial answer file — everything but the
    # password, which operators keep out of files — Back from `confirm`
    # landed on a step that returned 0 without drawing and was immediately
    # routed forward again. The confirm screen redrew on every Back press
    # and the operator could not reach the disk picker to correct the very
    # thing they had just spotted, one keystroke from an irreversible
    # wipe. Item 14 added a second inert screen and made it worse.
    #
    # With the direction tracked, "I drew nothing" means "keep going the
    # way you were going", which is right in both directions and needs no
    # screen to know anything about its neighbours.
    local -a STEPS=(
        welcome preflight ask_keyboard ask_role pick_disk
        confirm_partition_layout ask_hostname ask_user_password
        ask_ssh_keys ask_network ask_timezone ask_ntp ask_k3s_cidrs
        ask_application_config confirm do_install
    )
    # The index of `confirm`, so a field edit can come back to it.
    local confirm_index=0 j2=0
    while [ "$j2" -lt "${#STEPS[@]}" ]; do
        [ "${STEPS[$j2]}" = "confirm" ] && confirm_index="$j2"
        j2=$((j2 + 1))
    done
    local i=0 dir="fwd" rc step RETURN_TO_CONFIRM=""
    while [ "$i" -lt "${#STEPS[@]}" ]; do
        step="${STEPS[$i]}"
        log "Wizard state: $step (dir=$dir)"
        case "$step" in
            welcome)
                # Cancel here calls on_cancel, which exec's a shell and
                # never returns — the one "I changed my mind" exit.
                if [ "$FULLY_UNATTENDED" != "1" ]; then
                    welcome
                    rc=0
                else
                    rc=2
                fi
                ;;
            confirm)
                # confirm_wipe:true in the answer file already authorised
                # the destructive install.
                if [ "$FULLY_UNATTENDED" = "1" ]; then
                    rc=2
                else
                    confirm
                    rc=$?
                fi
                ;;
            do_install)
                do_install
                return 0
                ;;
            *)
                "$step"
                rc=$?
                ;;
        esac
        # A field edited from the Confirm menu returns there rather than
        # continuing the forward walk.
        if [ -n "$RETURN_TO_CONFIRM" ] && [ "$rc" != "2" ] && [ "$step" != "confirm" ]; then
            i="$RETURN_TO_CONFIRM"
            RETURN_TO_CONFIRM=""
            dir="fwd"
            continue
        fi
        case "$rc" in
            0) dir="fwd"; i=$((i + 1)) ;;
            2) if [ "$dir" = "back" ]; then i=$((i - 1)); else i=$((i + 1)); fi ;;
            *)
                # #995 item 28 — confirm's menu names a step to jump to
                # rather than walking back one screen at a time. Forward,
                # not back: the operator asked for that screen, and a
                # preseeded one passing through toward confirm again is
                # the right behaviour rather than reversing past it.
                if [ -n "$CONFIRM_JUMP" ]; then
                    local jump_idx=0 jump_found=0
                    while [ "$jump_idx" -lt "${#STEPS[@]}" ]; do
                        if [ "${STEPS[$jump_idx]}" = "$CONFIRM_JUMP" ]; then
                            i="$jump_idx"
                            jump_found=1
                            break
                        fi
                        jump_idx=$((jump_idx + 1))
                    done
                    CONFIRM_JUMP=""
                    if [ "$jump_found" = 1 ]; then
                        # Come straight back here once the field is
                        # answered. Without this the walk continued
                        # forward through every remaining screen — so
                        # changing the hostname still meant OK-ing through
                        # the password (typed twice, a passwordbox cannot
                        # be pre-filled), the keys, the network and the
                        # rest. That is the half of the cost item 28 said
                        # it removed and did not.
                        RETURN_TO_CONFIRM="$confirm_index"
                        dir="fwd"
                    else
                        # A renamed step, or a typo in a menu tag. Falling
                        # through with `i` unassigned redrew Confirm with
                        # the selection silently discarded — nine rows
                        # that quietly do nothing.
                        log "BUG: confirm menu named an unknown step '$CONFIRM_JUMP'"
                        dir="back"; i=$((i - 1))
                    fi
                else
                    dir="back"; i=$((i - 1))
                fi
                ;;
        esac
        # Backing past the first screen is not an exit — welcome owns that.
        if [ "$i" -lt 0 ]; then
            i=0
            dir="fwd"
        fi
    done
}

on_failure() {
    local exit_code=$?
    [ "$exit_code" -eq 0 ] && exit 0
    set +x
    # #995 item 1 — save on the way out too. The success-path call sits at
    # 94%, downstream of every fatal abort this change introduced (useradd
    # at ~63%, the two grub-installs at ~90%, the device-mapper gate at
    # ~4%) — so without this the failures that most need a durable record
    # are exactly the ones that leave none, and the operator's natural
    # next move re-runs the installer, whose startup TRUNCATES both logs.
    # The target is still mounted here: the unmount block is at 95%.
    if [ -d "$MOUNT/var/log" ]; then
        _save_install_logs || true
    fi
    clear
    echo
    echo "Installer exited with status $exit_code"
    echo
    echo "-- Last 20 lines of $INSTALL_LOG --"
    tail -20 "$INSTALL_LOG" 2>/dev/null \
        || echo "  (install log empty or missing - script bailed before any log() call)"
    echo
    echo "-- Last 20 lines of /var/log/spatium-install-launch.log --"
    tail -20 /var/log/spatium-install-launch.log 2>/dev/null \
        || echo "  (launch log missing - bash didn't even parse the script)"
    echo
    echo "-- Last 30 lines of $TRACE_LOG --"
    tail -30 "$TRACE_LOG" 2>/dev/null \
        || echo "  (trace log empty - script bailed before set -x at line 51)"
    echo "------------------------------------------------------------------"
    echo
    if [ -r /var/log/spatium-live-ssh-password ]; then
        echo "Live-mode SSH (for log capture from a real terminal):"
        echo "  user:     root"
        echo "  password: $(cat /var/log/spatium-live-ssh-password)"
        echo "  address:  $(ip -4 -br addr 2>/dev/null | awk '$1!="lo" && $3!="" {print $3; exit}' || echo '?')"
        echo
    fi
    echo "Also useful from the shell:"
    echo "  journalctl -u spatium-install.service --no-pager"
    echo "  systemctl cat spatium-install.service"
    echo
    echo "Press Enter to drop to a root shell."
    echo "(From the shell you can re-run 'spatium-install' or 'reboot'.)"
    read -r _ || true
    exec /bin/bash --login
}
trap on_failure EXIT

main "$@"
