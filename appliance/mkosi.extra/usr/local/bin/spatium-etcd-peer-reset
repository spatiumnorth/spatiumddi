#!/bin/sh
# spatium-etcd-peer-reset — runs before every k3s start (k3s.service
# ExecStartPre), #4591.
#
# A reinstall with "Keep /var and STATE" keeps the k3s datastore, whose etcd
# member is registered under the node's OLD address. When the node comes up on
# another one (new hardware, a new VM or NIC, so a new DHCP lease) k3s refuses
# its own etcd and never starts:
#
#   this server is not a member of the etcd cluster. Found
#   [<name>=https://<old>:2380], expect: <name>=https://<new>:2380
#
# For a SINGLE-member etcd the fix is what the snapshot restore does
# (spatium-cluster-restore): ``k3s server --cluster-reset`` collapses etcd to
# a fresh one-member cluster on the current address, keeping every key.
#
# Detection. The member list cannot be read offline (the db is a bbolt file
# and the appliance ships no etcdutl), and etcd's config file under db/etcd
# lists only the members known at bootstrap, so it cannot prove an HA seed has
# no peers. k3s's own refusal CAN: its "Found [...]" is the live member list.
# So this acts on that exact message, read from the journal of the previous
# start (the unit restarts after 5 s, Restart=always), and only when:
#   * the list holds exactly one member, and it is this node's etcd name;
#   * this node is not a joined member (no spatium-cluster.yaml drop-in);
#   * the member's address is not the one k3s expects.
# More than one member (an HA control plane) is never touched: a member whose
# address changed there needs a real member update or a rejoin. It is logged
# on the console instead.
#
# Idempotent: a stamp records when a reset ran, and only refusals logged after
# it count, so a reset never repeats for an old message. A reset that died
# half way leaves no stamp and k3s fails the same way again, so the next start
# runs it again; ``--cluster-reset`` is itself re-runnable.
#
# Never fails k3s's start (the unit runs it as ExecStartPre=-).
set -u

K3S="${SPATIUM_K3S_BIN:-/usr/local/bin/k3s}"
JOURNALCTL="${SPATIUM_JOURNALCTL:-journalctl}"
JOIN_DROPIN="${SPATIUM_K3S_JOIN_DROPIN:-/etc/rancher/k3s/config.yaml.d/spatium-cluster.yaml}"
ETCD_CONFIG="${SPATIUM_ETCD_CONFIG_FILE:-/var/lib/rancher/k3s/server/db/etcd/config}"
STAMP="${SPATIUM_ETCD_PEER_RESET_STAMP:-/var/lib/spatiumddi/etcd-peer-reset.stamp}"
LOG="${SPATIUM_ETCD_PEER_RESET_LOG:-/var/log/spatiumddi/etcd-peer-reset.log}"
CONSOLE="${SPATIUM_CONSOLE:-/dev/console}"

say() {
    msg="spatium-etcd-peer-reset: $*"
    printf '[%s] %s\n' "$(date -Iseconds)" "$msg" >>"$LOG" 2>/dev/null
    printf '%s\n' "$msg" >&2
    printf '%s\n' "$msg" >"$CONSOLE" 2>/dev/null || true
}

mkdir -p "$(dirname "$LOG")" "$(dirname "$STAMP")" 2>/dev/null

# Only a kept datastore can hold a stale member.
[ -f "$ETCD_CONFIG" ] || exit 0

since=0
if [ -f "$STAMP" ]; then
    since=$(cat "$STAMP" 2>/dev/null)
    case "$since" in '' | *[!0-9]*) since=0 ;; esac
fi

line=$("$JOURNALCTL" -u k3s -o cat --no-pager --since "@$since" 2>/dev/null \
    | grep 'this server is not a member of the etcd cluster' | tail -n 1)
[ -n "$line" ] || exit 0

# Found [a=https://x:2380 b=https://y:2380], expect: a=https://z:2380
found=$(printf '%s\n' "$line" | sed -n 's/.*Found \[\([^]]*\)\].*/\1/p')
expect=$(printf '%s\n' "$line" | sed -n 's/.*expect: *\([^ ]*\).*/\1/p')
[ -n "$found" ] && [ -n "$expect" ] || exit 0

# members separated by spaces or commas
count=$(printf '%s\n' "$found" | tr ', ' '\n\n' | grep -c .)
if [ "$count" -ne 1 ]; then
    say "etcd has $count members and one of them is not at this node's address ($line). NOT resetting: that would orphan the other members. Update the member's peer address or rejoin the node (Fleet -> Replace)."
    exit 0
fi

if [ -f "$JOIN_DROPIN" ]; then
    say "this node joined another node's cluster; not resetting its etcd ($line). Rejoin it (Fleet -> Replace)."
    exit 0
fi

found_name=${found%%=*}
expect_name=${expect%%=*}
etcd_name=$(sed -n 's/^name: *//p' "$ETCD_CONFIG" | head -n 1 | tr -d "\"'")
if [ "$found_name" != "$expect_name" ] \
    || { [ -n "$etcd_name" ] && [ "$found_name" != "$etcd_name" ]; }; then
    say "the only etcd member ($found_name) is not this node ($expect_name); not resetting."
    exit 0
fi
[ "$found" != "$expect" ] || exit 0

say "single-node etcd member is registered at ${found#*=} but this node is now ${expect#*=} (kept /var, new address): running k3s --cluster-reset once (#4591)"
if "$K3S" server --cluster-reset >>"$LOG" 2>&1; then
    date +%s >"$STAMP"
    say "cluster-reset done; k3s starts on the new address with its data intact"
else
    say "cluster-reset FAILED (see $LOG); k3s will fail again and this retries on the next start"
fi
exit 0
