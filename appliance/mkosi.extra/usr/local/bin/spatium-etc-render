#!/bin/sh
# spatium-etc-render — issue #276.
#
# Early-boot generator that materializes operator-mutable /etc bits
# from the STATE partition (/var/lib/spatium-state) BEFORE the
# services that read them start (systemd-hostnamed, sshd, k3s).
#
# Why this exists: pre-#276 the appliance's hostname + SSH host keys
# lived in the /etc overlay LOWER (/usr/lib/etc.image), captured
# per-slot at build/install time. Every fresh slot image carried its
# own keys + an empty hostname, so an OS slot upgrade silently
# changed the SSH host key (MITM warning) and reset the kernel
# hostname to ``localhost`` (k3s registered a brand-new node). This
# script makes STATE — a dedicated partition that survives slot swaps
# AND a /var factory reset — the single source of truth, rendered
# into /etc on every boot before anything reads it.
#
# Runs After=etc.mount + the STATE fstab mount, Before=sysinit.target
# / sshd / k3s. Degrades gracefully: a missing/empty STATE leaves the
# image-baseline /etc untouched (and seeds STATE from the current
# values so the NEXT boot is authoritative).

set -eu

STATE_DIR=/var/lib/spatium-state
CONFIG="$STATE_DIR/spatium-config.yaml"
LOG=/var/log/spatiumddi/etc-render.log

mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== spatium-etc-render $(date -Iseconds) ==="

# Flat ``key: value`` reader for the top level of spatium-config.yaml.
# The config is intentionally flat (no nested maps in v1) so a sed
# one-liner avoids a python/yaml dependency this early in boot.
# Strips surrounding quotes + leading/trailing whitespace.
get_cfg() {
    [ -f "$CONFIG" ] || return 0
    sed -n "s/^$1:[[:space:]]*//p" "$CONFIG" | head -1 \
        | sed 's/[[:space:]]*$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//'
}

if [ ! -d "$STATE_DIR" ]; then
    echo "STATE dir $STATE_DIR absent — using image-baseline /etc (no render)."
    exit 0
fi

# ── Hostname ─────────────────────────────────────────────────────────
# Set the kernel hostname immediately (``hostname`` syscall) so k3s +
# sshd, which start after this unit, see the right name. Also write
# /etc/hostname (overlay upper) so a later systemd-hostnamed read
# agrees. systemd already set a (wrong, image-baseline) hostname in
# PID1 before etc.mount fired; this corrects it before any consumer.
HOSTNAME_VAL="$(get_cfg hostname)"
if [ -n "$HOSTNAME_VAL" ]; then
    echo "$HOSTNAME_VAL" > /etc/hostname
    hostname "$HOSTNAME_VAL" 2>/dev/null \
        && echo "hostname → $HOSTNAME_VAL" \
        || echo "WARN: 'hostname $HOSTNAME_VAL' failed (kernel hostname unchanged)"
else
    echo "no hostname in $CONFIG — leaving image-baseline hostname"
fi

# ── SSH host keys ────────────────────────────────────────────────────
# Authoritative copy lives in STATE. Restore into /etc/ssh so sshd
# presents a stable identity across slot swaps. If STATE has none yet
# (a fresh install — the image ships no host keys and the installer no
# longer seeds any — or an upgrade off a pre-#276 image), generate the
# standard set + persist to STATE so the next boot is authoritative.
#
# GHSA-vvh9-6gfw-wphp — until the fix, the openssh postinst generated
# host keys inside the mkosi build container and the installer copied
# THOSE into STATE, so every appliance installed from one release
# presented the same keys, and the private halves shipped in the public
# ISO. Such a key is recognised by the comment ssh-keygen stamped on it:
# ``root@`` + docker's default hostname, the 12-hex short container id
# (the builder runs with no --hostname, in CI and in `make appliance`
# alike). A key generated ON an appliance carries ``root@<its own
# hostname>``, and an operator's own key whatever comment they chose, so
# neither matches — the one ambiguity, a node genuinely named like a
# container id, is excluded by comparing against this node's hostname.
# Rotation runs at most once per STATE: the marker records that the
# check was done, so a later rename can never trigger a second rotation.
SSH_DIR=/etc/ssh
SSH_STATE="$STATE_DIR/ssh"
BUILD_KEY_MARKER="$SSH_STATE/.build-keys-checked"

# True when any public host key in $1 carries a build-container comment.
has_build_key() {
    _self="$(hostname 2>/dev/null || true)"
    for _pub in "$1"/ssh_host_*_key.pub; do
        [ -f "$_pub" ] || continue
        _comment="$(awk '{print $3; exit}' "$_pub")"
        case "$_comment" in
            root@*) _host="${_comment#root@}" ;;
            *) continue ;;
        esac
        [ "$_host" = "$HOSTNAME_VAL" ] && continue
        [ "$_host" = "$_self" ] && continue
        if printf '%s\n' "$_host" | grep -Eqx '[0-9a-f]{12}'; then
            return 0
        fi
    done
    return 1
}

# Generate a fresh set into a scratch prefix and only THEN replace
# STATE's, so a failed ssh-keygen leaves the old keys in place rather
# than none (sshd refuses to start keyless).
generate_into_state() {
    _tmp="$(mktemp -d)"
    mkdir -p "$_tmp/etc/ssh"
    if ssh-keygen -A -f "$_tmp" >/dev/null 2>&1 \
            && ls "$_tmp"/etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
        mkdir -p "$SSH_STATE"
        rm -f "$SSH_STATE"/ssh_host_*
        cp -a "$_tmp"/etc/ssh/ssh_host_* "$SSH_STATE/"
        rm -rf "$_tmp"
        return 0
    fi
    rm -rf "$_tmp"
    return 1
}

if [ ! -f "$BUILD_KEY_MARKER" ] && has_build_key "$SSH_STATE"; then
    echo "STATE holds the image-baked build host keys — rotating once (GHSA-vvh9-6gfw-wphp)"
    generate_into_state \
        || echo "WARN: ssh-keygen failed — keeping the existing keys, will retry next boot"
fi

if ! ls "$SSH_STATE"/ssh_host_*_key >/dev/null 2>&1; then
    # Pre-#276 upgrades parked unique keys in /etc; adopt those, but
    # never a baked set.
    if ls "$SSH_DIR"/ssh_host_*_key >/dev/null 2>&1 && ! has_build_key "$SSH_DIR"; then
        echo "no SSH host keys in STATE — persisting the ones in $SSH_DIR"
        mkdir -p "$SSH_STATE"
        cp -a "$SSH_DIR"/ssh_host_*_key "$SSH_DIR"/ssh_host_*_key.pub "$SSH_STATE/" 2>/dev/null || true
    else
        echo "no SSH host keys in STATE — generating + persisting"
        generate_into_state || echo "WARN: ssh-keygen failed — no SSH host keys in STATE"
    fi
fi

if ls "$SSH_STATE"/ssh_host_*_key >/dev/null 2>&1; then
    mkdir -p "$SSH_DIR"
    # Clear first: the overlay upper still holds whatever was restored on
    # earlier boots, and a key type STATE no longer has must not linger.
    rm -f "$SSH_DIR"/ssh_host_*
    cp -a "$SSH_STATE"/ssh_host_* "$SSH_DIR/" 2>/dev/null || true
    chmod 600 "$SSH_DIR"/ssh_host_*_key 2>/dev/null || true
    chmod 644 "$SSH_DIR"/ssh_host_*_key.pub 2>/dev/null || true
    if ! has_build_key "$SSH_STATE"; then
        touch "$BUILD_KEY_MARKER"
    fi
    echo "SSH host keys restored from STATE"
fi

# ── role-config ──────────────────────────────────────────────────────
# The appliance's role + control-plane URL + bootstrap pairing code.
# firstboot transcribes ROLE into /etc/spatiumddi/.env; the supervisor
# self-bootstrap path + the api's host bind mount read it too. Source
# of truth moves to STATE; this renders it into the runtime path.
ROLE_VAL="$(get_cfg role)"
if [ -n "$ROLE_VAL" ]; then
    CONTROL_PLANE_URL_VAL="$(get_cfg control_plane_url)"
    BOOTSTRAP_PAIRING_CODE_VAL="$(get_cfg bootstrap_pairing_code)"
    mkdir -p /etc/spatiumddi
    # printf for the same reason as the network-status sidecar below:
    # dash's echo expands backslash escapes, and both of these values
    # come verbatim from the hand-editable STATE config.
    {
        printf '%s\n' "ROLE=$ROLE_VAL"
        printf '%s\n' "CONTROL_PLANE_URL=$CONTROL_PLANE_URL_VAL"
        printf '%s\n' "BOOTSTRAP_PAIRING_CODE=$BOOTSTRAP_PAIRING_CODE_VAL"
    } > /etc/spatiumddi/role-config
    chmod 0644 /etc/spatiumddi/role-config
    echo "role-config rendered (ROLE=$ROLE_VAL)"
else
    echo "no role in $CONFIG — leaving existing /etc/spatiumddi/role-config"
fi

# #995 item 21 — the [ipv6] section of the static keyfile.
#
# ``method=auto`` (RA / SLAAC) unless the operator pinned an address,
# which is what every install before this did and stays the default. A
# blank gateway is left OUT rather than written empty: NetworkManager
# rejects a trailing comma in address1 the same way it does for v4 (the
# #554 failure), and with no gateway line NM keeps taking the default
# route from router advertisements, which is the sane behaviour when
# someone pins an address on a network that still advertises a router.
_render_ipv6_block() {
    if [ "$NET6_MODE_VAL" != "static" ]; then
        echo "method=auto"
        return 0
    fi
    _v6_ip="$(get_cfg network6_ip)"
    _v6_prefix="$(get_cfg network6_prefix)"
    _v6_gw="$(get_cfg network6_gateway)"
    if [ -z "$_v6_ip" ]; then
        echo "method=auto"
        return 0
    fi
    echo "method=manual"
    if [ -n "$_v6_gw" ]; then
        echo "address1=$_v6_ip/${_v6_prefix:-64},$_v6_gw"
    else
        echo "address1=$_v6_ip/${_v6_prefix:-64}"
    fi
}

# #1017 — the [ethernet] section's optional ``mtu=``.
#
# Unset is the normal case and means "NetworkManager's default", which
# is the link's own MTU; the key is simply not written. The setting
# exists for links that need a MTU *below* 1500 — a WireGuard / IPsec /
# GRE tunnel, PPPoE, a provider underlay — where the failure mode is
# that ping and small requests work while large TCP hangs, and reads as
# an application fault. It is NOT a throughput knob: SpatiumDDI's own
# traffic is small UDP and small JSON, and raising the MTU on a
# DHCP-served segment is actively hazardous because PXE ROMs are 1500.
#
# Validated HERE as well as at the two doors that write it (the wizard
# and the preseed parser), because this file is hand-editable on STATE
# and is the last thing between a typo and NetworkManager. A value that
# is not a plain integer in range is DROPPED with a warning rather than
# written through: an unparseable ``mtu=`` risks NM rejecting the
# profile, and a box that comes up with no network at all is a far worse
# outcome than one that comes up at the default MTU. The warning lands
# in the render log, which the support bundle collects.
_effective_mtu() {
    _mtu="$(get_cfg network_mtu)"
    [ -n "$_mtu" ] || return 0
    # Three tests, in this order, and the ORDER is the safety property.
    #
    # ``[ -lt ]`` does not fail safe: given a digit string too long for a
    # signed 64-bit integer, dash and bash both print "Illegal number" and
    # exit NON-ZERO, which reads as "not out of range" and falls through
    # to writing the value — and ``set -e`` does not catch it, because the
    # test sits in an ``if`` condition. So a 20-digit MTU reached the
    # keyfile, NetworkManager rejected the profile, and every surface
    # reported the MTU as applied.
    #
    # The fix is a DIGIT-COUNT pattern rather than a length comparison:
    # four digits is the entire legal range (9000), so the numeric test
    # below is never reached with a string it cannot handle. An earlier
    # cut used ``[ ${#_mtu} -gt 5 ]``, which let ``01400`` through to the
    # keyfile verbatim — NetworkManager normalises that to 1400 on its
    # next save, after which the adopt tool sees live=1400 against
    # state=01400 and offers permanent phantom drift on a box where
    # nothing changed.
    case "$_mtu" in
        *[!0-9]*)
            echo "WARN: network_mtu '$_mtu' is not a whole number — ignoring" >&2
            return 0
            ;;
        [0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) : ;;
        *)
            echo "WARN: network_mtu '$_mtu' is outside 576-9000 — ignoring" >&2
            return 0
            ;;
    esac
    if [ "$_mtu" -lt 576 ] || [ "$_mtu" -gt 9000 ]; then
        echo "WARN: network_mtu $_mtu is outside 576-9000 — ignoring" >&2
        return 0
    fi
    # RFC 8200 makes 1280 the IPv6 minimum link MTU, so a static v6
    # address on a link below it is broken by specification. Both doors
    # refuse that combination outright; reaching it here means STATE was
    # hand-edited, and the MTU is what gets dropped rather than the
    # address — dropping the address would take the appliance off the
    # network the operator reaches it on.
    if [ "$NET6_MODE_VAL" = "static" ] && [ "$_mtu" -lt 1280 ] \
        && [ -n "$(get_cfg network6_ip)" ]; then
        echo "WARN: network_mtu $_mtu is below the RFC 8200 IPv6 minimum of 1280" >&2
        echo "      and this appliance pins a static IPv6 address — ignoring the MTU" >&2
        return 0
    fi
    echo "$_mtu"
}

# ── Network (NetworkManager keyfile) ─────────────────────────────────
# Runs Before=NetworkManager.service so the profile is in place before
# NM reads its connections. dhcp mode = no keyfile (NM auto-DHCPs every
# ethernet interface by default); static mode writes a keyfile-format
# connection. Remove a stale keyfile when the mode flips back to dhcp.
NET_MODE_VAL="$(get_cfg network_mode)"
NET6_MODE_VAL="$(get_cfg network6_mode)"
# #1017 — resolved once. Both keyfile branches and the status sidecar at
# the end of this block read this variable rather than re-invoking the
# helper, so the file the supervisor reports upward cannot claim an MTU
# the keyfile does not carry.
NET_MTU_EFFECTIVE="$(_effective_mtu)"
# Set to yes by whichever branch below actually writes a keyfile. The
# status sidecar keys off this rather than re-deriving the condition:
# a static stanza with no interface is skipped too, and a sidecar that
# re-tested "mode = static" would report an MTU in force on a box whose
# keyfile was never written.
NET_KEYFILE_WRITTEN=no
NM_KEYFILE=/etc/NetworkManager/system-connections/10-spatium-static.nmconnection
# #995 item 19 — a DHCP install can now pin ONE port. NetworkManager's
# default is to DHCP every ethernet interface, so on a multi-NIC server
# the appliance came up on whichever replied first — a management LAN, a
# storage VLAN, an idle port on another switch — and the supervisor
# registered from there. A keyfile naming the interface makes the choice
# stick; no interface still means the old any-port behaviour.
NM_DHCP_KEYFILE=/etc/NetworkManager/system-connections/10-spatium-dhcp.nmconnection
if [ "$NET_MODE_VAL" = "static" ]; then
    NET_IFACE_VAL="$(get_cfg network_interface)"
    NET_IP_VAL="$(get_cfg network_ip)"
    NET_PREFIX_VAL="$(get_cfg network_prefix)"
    NET_GATEWAY_VAL="$(get_cfg network_gateway)"
    NET_DNS_VAL="$(get_cfg network_dns)"
    if [ -n "$NET_IP_VAL" ] && [ -n "$NET_IFACE_VAL" ]; then
        # NM wants DNS servers semicolon-separated + trailing ';'.
        net_dns_csv="$(echo "$NET_DNS_VAL" | tr -s ' ' ';')"
        # Stable UUID derived from the interface so re-renders don't
        # churn NM's connection list. uuidgen if present, else a
        # deterministic fallback (NM only needs it present + unique).
        net_uuid="$(uuidgen 2>/dev/null || echo "5a71c0de-0000-4000-8000-$(printf '%012d' "$(echo "$NET_IFACE_VAL" | cksum | cut -d' ' -f1)")")"
        # Preserve the existing UUID across re-renders if a keyfile is
        # already present (avoids NM treating it as a new connection).
        if [ -f "$NM_KEYFILE" ]; then
            existing_uuid="$(sed -n 's/^uuid=//p' "$NM_KEYFILE" | head -1)"
            [ -n "$existing_uuid" ] && net_uuid="$existing_uuid"
        fi
        install -d -m 0755 /etc/NetworkManager/system-connections
        cat > "$NM_KEYFILE" <<EOF
[connection]
id=spatium-static
uuid=$net_uuid
type=ethernet
interface-name=$NET_IFACE_VAL
autoconnect=true
# Same reason the pinned-DHCP twin sets one: NetworkManager's own
# auto-generated "Wired connection N" profiles default to 0, and a static
# profile that merely ties them is not guaranteed to win.
autoconnect-priority=100

[ethernet]
${NET_MTU_EFFECTIVE:+mtu=$NET_MTU_EFFECTIVE}

[ipv4]
method=manual
address1=$NET_IP_VAL/$NET_PREFIX_VAL,$NET_GATEWAY_VAL
dns=$net_dns_csv;

[ipv6]
$(_render_ipv6_block)
EOF
        # NM refuses keyfiles that aren't mode 600.
        chmod 0600 "$NM_KEYFILE"
        # Drop the pinned-DHCP twin. The dhcp branch is symmetric about
        # this and the static one was not. Both keyfiles now carry
        # autoconnect-priority=100, so a leftover does not strictly
        # outrank the profile just written — NetworkManager breaks the tie
        # by connection timestamp, which is worse than losing: it is
        # non-deterministic. Two autoconnect profiles on one interface is
        # a race either way.
        if [ -f "$NM_DHCP_KEYFILE" ]; then
            rm -f "$NM_DHCP_KEYFILE"
            echo "  removed the stale pinned-DHCP keyfile"
        fi
        NET_KEYFILE_WRITTEN=yes
        echo "network → static $NET_IP_VAL/$NET_PREFIX_VAL on $NET_IFACE_VAL"
    else
        # #1017 — remove the stale profile rather than leaving it loaded.
        #
        # Leaving it was the pre-existing behaviour and it made the status
        # sidecar LIE: the previous boot's keyfile, complete with its
        # ``mtu=``, is still what NetworkManager reads, while the sidecar
        # reports MTU_APPLIED=n/a because this boot wrote nothing. The
        # fleet check upstream maps n/a to "the link default", so a node
        # genuinely running 1400 was compared as though it were not — the
        # host-gw black hole the check exists to catch, scored as healthy.
        #
        # Removing it is also the honest outcome on its own terms: STATE
        # no longer describes a usable static config, so continuing to
        # serve one assembled from a previous STATE is exactly the drift
        # #276 built this renderer to prevent. NM falls back to its own
        # auto profile, which is what an unconfigured box gets.
        if [ -f "$NM_KEYFILE" ]; then
            rm -f "$NM_KEYFILE"
            echo "  removed the stale static keyfile (its STATE is incomplete)"
        fi
        echo "WARN: network_mode=static but ip/interface missing — skipping keyfile"
    fi
elif [ "$NET_MODE_VAL" = "dhcp" ]; then
    # Flip back to DHCP — drop any static keyfile a prior render wrote.
    if [ -f "$NM_KEYFILE" ]; then
        rm -f "$NM_KEYFILE"
        echo "network → dhcp (removed stale static keyfile)"
    fi
    # #995 item 19 — pin DHCP to one port when the operator chose one.
    NET_IFACE_VAL="$(get_cfg network_interface)"
    if [ -n "$NET_IFACE_VAL" ]; then
        dhcp_uuid="$(uuidgen 2>/dev/null || echo "5a71c0de-0001-4000-8000-$(printf '%012d' "$(echo "$NET_IFACE_VAL" | cksum | cut -d' ' -f1)")")"
        if [ -f "$NM_DHCP_KEYFILE" ]; then
            existing_uuid="$(sed -n 's/^uuid=//p' "$NM_DHCP_KEYFILE" | head -1)"
            [ -n "$existing_uuid" ] && dhcp_uuid="$existing_uuid"
        fi
        install -d -m 0755 /etc/NetworkManager/system-connections
        cat > "$NM_DHCP_KEYFILE" <<EOF
[connection]
id=spatium-dhcp
uuid=$dhcp_uuid
type=ethernet
interface-name=$NET_IFACE_VAL
autoconnect=true
# Beat NetworkManager's own auto-generated "Wired connection N" profiles,
# which default to 0 — otherwise whichever port comes up first still wins.
autoconnect-priority=100

[ethernet]
${NET_MTU_EFFECTIVE:+mtu=$NET_MTU_EFFECTIVE}

[ipv4]
method=auto

[ipv6]
$(_render_ipv6_block)
EOF
        chmod 0600 "$NM_DHCP_KEYFILE"
        NET_KEYFILE_WRITTEN=yes
        echo "network → dhcp pinned to $NET_IFACE_VAL"
    elif [ -f "$NM_DHCP_KEYFILE" ]; then
        rm -f "$NM_DHCP_KEYFILE"
        echo "network → dhcp on any port (removed stale pinned keyfile)"
    fi
fi

# ── Network status sidecar (#1017) ───────────────────────────────────
#
# What this boot actually applied, for the supervisor to report upward.
# /etc/spatiumddi is already bind-mounted into the supervisor pod
# read-only as /etc/spatiumddi-host, so this needs no chart change and
# no new hostPath — the same route role-config takes.
#
# Why a sidecar at all, rather than the supervisor reading STATE or the
# live kernel: the supervisor pod is not hostNetwork, so /sys/class/net
# shows pod veths and the host's real MTU is not visible to it; and STATE
# says what was REQUESTED, which is not the same thing — this script
# drops a value that is out of range or that would break a pinned IPv6
# address. The fleet-consistency check upstream has to compare what is
# in force, or it reports agreement between a node running 9000 and one
# that asked for 9000 and had it refused.
#
# APPLIED distinguishes the three outcomes a single number cannot:
#   default   no MTU configured — NetworkManager's own, the normal case
#   applied   the requested value is in the keyfile
#   dropped   a value was requested and this script refused it
#   n/a       no keyfile is written for this install shape (DHCP with no
#             pinned port), so there is nowhere for an MTU to go
_mtu_requested="$(get_cfg network_mtu)"
if [ "$NET_KEYFILE_WRITTEN" = yes ]; then
    if [ -n "$NET_MTU_EFFECTIVE" ]; then
        _mtu_applied=applied
    elif [ -n "$_mtu_requested" ]; then
        _mtu_applied=dropped
    else
        _mtu_applied=default
    fi
else
    _mtu_applied="n/a"
fi
# What is ACTUALLY in force, which is not NET_MTU_EFFECTIVE when no
# keyfile was written. Kept as its own local rather than clobbering
# NET_MTU_EFFECTIVE, whose defining comment promises every consumer reads
# one value: reassigning it here would silently give it two meanings
# either side of this line, and anything added below would get the wrong
# one with no test able to see the difference.
if [ "$_mtu_applied" = applied ]; then
    _mtu_inforce="$NET_MTU_EFFECTIVE"
else
    _mtu_inforce=""
fi
mkdir -p /etc/spatiumddi
# printf, NOT echo. This is /bin/sh = dash, whose echo EXPANDS backslash
# escapes — so a hand-edited ``network_mtu: "x\nMTU=9000"`` in STATE
# would emit a SECOND ``MTU=`` line here. Every reader of this file
# assigns while iterating, so the last occurrence wins: the supervisor
# would report 9000 on a node running the link default, and the fleet
# check would compare it as such. That is the one invariant this sidecar
# exists to hold, defeated downstream of the validation that exists
# precisely because STATE is hand-editable.
{
    printf '%s\n' "INTERFACE=$(get_cfg network_interface)"
    printf '%s\n' "MODE=$NET_MODE_VAL"
    printf '%s\n' "MTU=$_mtu_inforce"
    printf '%s\n' "MTU_REQUESTED=$_mtu_requested"
    printf '%s\n' "MTU_APPLIED=$_mtu_applied"
    # Which boot wrote this. /etc is an overlay whose upperdir lives on
    # /var and is therefore SHARED ACROSS A/B SLOTS, so a trial boot of a
    # new slot that then rolls back leaves this file behind, written by a
    # renderer the running slot does not have. Without a boot identity
    # that stale claim is indistinguishable from a fresh one, and every
    # MTU surface reports a value the running system is not using. Readers
    # compare it with /proc/sys/kernel/random/boot_id and treat a
    # mismatch as "not reported" rather than as fact.
    printf '%s\n' "BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
} > /etc/spatiumddi/network-status
chmod 0644 /etc/spatiumddi/network-status
echo "network-status rendered (MTU=${_mtu_inforce:-default} $_mtu_applied)"

# ── Supervisor identity on STATE ─────────────────────────────────────
# The spatium-supervisor pod's persistent identity (Ed25519 keypair,
# signed cert, approval state) lives at /var/persist/spatium-supervisor
# — the path its hostPath mount + the host-side console / pair / watchdog
# tools all reference. Point that path at STATE so the identity survives
# a /var factory reset (not just slot swaps). The symlink itself lives
# on /var and is re-created here every boot, so even after a /var wipe
# the next boot relinks to the (surviving) STATE copy → the box stays
# paired + approved.
if [ -d "$STATE_DIR" ]; then
    mkdir -p "$STATE_DIR/spatium-supervisor"
    mkdir -p /var/persist
    if [ ! -L /var/persist/spatium-supervisor ]; then
        # Migrate any pre-#276 real directory's contents into STATE
        # before replacing it with the symlink (no-op on fresh installs).
        if [ -d /var/persist/spatium-supervisor ]; then
            cp -a /var/persist/spatium-supervisor/. "$STATE_DIR/spatium-supervisor/" 2>/dev/null || true
            rm -rf /var/persist/spatium-supervisor
        fi
        ln -s "$STATE_DIR/spatium-supervisor" /var/persist/spatium-supervisor
        echo "supervisor identity → STATE (symlinked /var/persist/spatium-supervisor)"
    fi
fi

# ── machine-id ───────────────────────────────────────────────────────
# Persist /etc/machine-id into STATE so it survives a /var factory
# reset (journald continuity, any machine-id-keyed state). Restore
# from STATE only when it diverges — normally they match, so this is
# a no-op after the first boot. systemd already committed the
# image-baseline machine-id in PID1; rewriting it here is safe for
# our purposes (no per-boot machine-id consumers run before sysinit).
if [ -s "$STATE_DIR/machine-id" ]; then
    if ! cmp -s "$STATE_DIR/machine-id" /etc/machine-id; then
        cp "$STATE_DIR/machine-id" /etc/machine-id
        echo "machine-id restored from STATE"
    fi
elif [ -s /etc/machine-id ]; then
    cp /etc/machine-id "$STATE_DIR/machine-id"
    echo "machine-id persisted to STATE"
fi

echo "=== spatium-etc-render done ==="
