#!/bin/bash
# spatiumddi-slot-rollback — host-side rollback runner (Phase 8c-3,
# issue #138).
#
# The api container writes /var/lib/spatiumddi/release-state/
# slot-rollback-pending with one optional line: the explicit target
# slot ("slot_a" or "slot_b"). When the line is empty or absent the
# runner auto-picks "the inactive slot" via spatium-upgrade-slot.
#
# Then `spatiumddi-slot-rollback.path` notices the file and runs this
# script as root. It:
#   1. Reads the trigger file (target slot, optional)
#   2. Invokes /usr/local/bin/spatium-upgrade-slot rollback  (no target
#      → inactive slot) or `set-default <slot>` (explicit target), both
#      of which call grub-set-default — durably flip saved_entry. The
#      swap doesn't take effect until the operator reboots; the active
#      slot keeps running until then. (There is NO `commit` subcommand —
#      the earlier version called one that argparse rejects, so every
#      rollback failed, #551.)
#   3. Renames the trigger to .done or .failed so the .path unit
#      doesn't re-fire on the next watch.
#
# This is the "I just upgraded and want to go back to the previous
# slot" path — separate from the trial-boot auto-revert (which is
# the kernel-panic-or-/health/live-fail safety net during the trial
# boot window). Rollback is the operator's explicit choice.

set -euo pipefail

TRIGGER=/var/lib/spatiumddi/release-state/slot-rollback-pending
LOG_DIR=/var/log/spatiumddi
LOG="$LOG_DIR/slot-upgrade.log"

# #1747 — a power loss right after a write must never leave a state file
# full of NUL bytes (extended length, unwritten data): the supervisor ships
# these on every heartbeat and Postgres refuses U+0000, so the api would
# 422 every heartbeat from the node for good. Durable write = temp file in
# the SAME directory, fsync it, rename over the target, fsync the directory.
# ``sync FILE`` (coreutils >= 8.24) fsyncs just that path; a plain ``sync``
# is the fallback when it is unavailable.
fsync_path() {  # $@ = paths
    sync "$@" 2>/dev/null || sync 2>/dev/null || true
}
atomic_write() {  # $1 = target path, $2 = content (a newline is appended)
    local target="$1" tmp
    tmp=$(mktemp "${target}.XXXXXX") || return 1
    # mktemp makes 0600; keep the target's mode + group (the supervisor reads
    # these as a different user), else the world-readable default. The api
    # and the supervisor can create names in release-state and this runs as
    # root, so the target may be a symlink planted there: its referent is not
    # consulted, and the rename (-T) replaces whatever is at the name rather
    # than moving the file into a directory a link points at.
    if [ -f "$target" ] && [ ! -L "$target" ]; then
        chmod --reference="$target" "$tmp" 2>/dev/null || chmod 0644 "$tmp" 2>/dev/null || true
        chgrp --reference="$target" "$tmp" 2>/dev/null || true
    else
        chmod 0644 "$tmp" 2>/dev/null || true
    fi
    if printf '%s\n' "$2" > "$tmp" && fsync_path "$tmp" && mv -fT "$tmp" "$target"; then
        fsync_path "$(dirname "$target")"
    else
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
}

mkdir -p "$LOG_DIR"
exec >> "$LOG" 2>&1
echo
echo "[$(date -Iseconds)] === spatiumddi-slot-rollback fired ==="

if [ ! -f "$TRIGGER" ]; then
    echo "  no trigger file at $TRIGGER, nothing to do"
    exit 0
fi

# Trigger file format:
#   line 1 (optional): explicit target slot — "slot_a" or "slot_b".
#                      When empty, spatium-upgrade-slot commit defaults
#                      to the inactive slot.
TARGET_SLOT=$(sed -n '1p' "$TRIGGER" | tr -d '\r\n' || true)

# Reject anything that isn't an expected slot name.
case "$TARGET_SLOT" in
    ""|slot_a|slot_b|root_a|root_b|a|b|A|B)  ;;
    *)
        echo "  ERROR: target slot must be empty or one of slot_a/slot_b: $TARGET_SLOT"
        mv -T "$TRIGGER" "${TRIGGER}.invalid.$(date +%s)"
        exit 1
        ;;
esac

if [ -n "$TARGET_SLOT" ]; then
    echo "  target: $TARGET_SLOT (explicit)"
else
    echo "  target: (auto — spatium-upgrade-slot will pick the inactive slot)"
fi
echo

# Mark trigger as in-flight so the UI can show "applying" state.
atomic_write "${TRIGGER}.state" "in-flight $(date -Iseconds)"

# Map to the real subcommands: `rollback` targets the inactive slot with
# no argument; `set-default <slot>` durably flips to an explicit slot.
if [ -n "$TARGET_SLOT" ]; then
    COMMIT_ARGS=("set-default" "$TARGET_SLOT")
else
    COMMIT_ARGS=("rollback")
fi

echo "  → /usr/local/bin/spatium-upgrade-slot ${COMMIT_ARGS[*]}"
if /usr/local/bin/spatium-upgrade-slot "${COMMIT_ARGS[@]}"; then
    echo
    echo "  ✓ rollback committed — durable default updated."
    echo "  Operator needs to reboot to switch slots."
    atomic_write "${TRIGGER}.state" "done $(date -Iseconds)"
    mv -T "$TRIGGER" "${TRIGGER}.done.$(date +%s)"
else
    echo
    echo "  ✗ rollback (grub-set-default) failed — durable default unchanged"
    atomic_write "${TRIGGER}.state" "failed $(date -Iseconds)"
    mv -T "$TRIGGER" "${TRIGGER}.failed.$(date +%s)"
    exit 1
fi
