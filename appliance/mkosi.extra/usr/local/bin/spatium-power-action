#!/bin/bash
# spatium-power-action — the one entry point for an operator-initiated
# reboot or poweroff of an appliance node (#2974): the web-UI local reboot
# (spatiumddi-reboot.service), the Fleet reboot (spatiumddi-reboot-agent,
# #3008) and the console's F5 / F6 (spatium-power-action@reboot|poweroff
# .service, so that systemd owns the run and not the console process).
#
# Usage: spatium-power-action reboot|poweroff
#
# On a cluster node holding the PostgreSQL primary, spatium-reboot-handoff
# first hands the primary off to another node (#2849), bounded by its own
# budgets, always exiting 0: a handoff that cannot be done never holds the
# reboot or poweroff. Those budgets add up to about 3.5 min at worst (an
# API that answers nothing), so the handoff is also capped here, at
# HANDOFF_CAP_S; past the cap it is stopped and the reboot or poweroff goes
# on. A unit start timeout would not do: it stops this script, which is a
# cancel, and a cancel does not reboot. Then systemctl runs. If systemctl
# fails the node stays up, so the handoff's cordon is undone. If this script
# is stopped before systemctl ran (the console's F9 "cancel reboot" stops
# the unit) the cordon is undone too. A stop that comes once systemctl has
# been issued is the shutdown itself stopping this unit: the cordon must
# then stay, or the node would take pods back while it goes down. After a
# reboot or poweroff the cordon stays until the node next boots, where
# spatiumddi-reboot-handoff.service uncordons it; a node powered off for
# good stays cordoned in the cluster until it is removed from it.
#
# A stop before systemctl is a cancel, not a failure (#3162): the wrapper then
# ends by the signal it was stopped with, which the units running it list in
# SuccessExitStatus= (a Type=oneshot unit otherwise counts it as failed, as it
# did the old exit 1), so the unit is left inactive, not failed, while a
# caller still reads "no reboot" (a non-zero status). A failed systemctl
# stays exit 1.
#
# The handoff's request to CloudNativePG cannot be taken back (#3162): its
# cordon makes CNPG switch the primary over, and a switchover CNPG has begun
# runs to its end: undoing the cordon does not stop it, and nothing else asks
# CNPG to put the primary back (that would be a second outage). So the cancel
# undoes the cordon and does not reboot, but the switchover already asked for
# completes, with its few seconds of API unavailability, and the wrapper says
# so. The handoff writes SWITCHOVER just before its cordon (the console reads
# it after its cancel to tell the operator); a cancel before that point, the
# console's 10 s grace included, never reaches CNPG at all.
#
# While it runs, MARKER holds "<pid> <action>", so the console shows the
# reboot or poweroff as under way and F9 can cancel it. /run is a tmpfs:
# nothing of it outlives the reboot.
#
# The api cannot see /run, so the wrapper also holds an flock(2) on LOCK,
# the release-state DIRECTORY itself, which the api has mounted (#3008): the
# web UI keeps its Reboot button disabled while the lock is held, i.e. from
# the moment the trigger is renamed until systemctl has been issued (the
# node's own api pod is stopped moments later by the kubelet's graceful
# shutdown). A lock is released by the kernel when its holder dies, so a
# wrapper killed outright leaves nothing stuck (the api checks no pid: it has
# no view of the host's). The directory and not a file in it, because the api
# and the supervisor can write in that directory and this runs as root: a
# file there could be a symlink planted to make root create or truncate any
# path on the host (GHSA-h2j9-qrg7-grfw's threat model). The directory is
# the api's mount point; it cannot replace it.
#
# The lock ends when this script does, moments after systemctl was issued and
# before the node is actually down. So just before systemctl the wrapper also
# writes ISSUED, "<action> <boot_id>" (#3008), which the api reads as still
# under way while the boot id is the host's current one: it expires by itself
# with the reboot (a new boot has a new id) and needs no cleanup. A failed
# systemctl removes it. It is written under a fresh name and renamed into
# place (state_write), never through the name, for the same planted-symlink
# reason as the lock.

set -uo pipefail

HANDOFF="${SPATIUM_REBOOT_HANDOFF:-/usr/local/bin/spatium-reboot-handoff}"
HANDOFF_CAP_S="${SPATIUM_POWER_ACTION_HANDOFF_CAP_S:-240}"
MARKER="${SPATIUM_POWER_ACTION_MARKER:-/run/spatium-power-action}"
LOCK="${SPATIUM_POWER_ACTION_LOCK:-/var/lib/spatiumddi/release-state}"
ISSUED="${SPATIUM_POWER_ACTION_ISSUED:-/var/lib/spatiumddi/release-state/power-action-issued}"
BOOT_ID_FILE="${SPATIUM_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
# #3162 — written by the handoff just before it cordons (asks CNPG for the
# switchover); kept by a cancel, for the console to read, and removed at the
# start of the next run and when systemctl fails. /run is a tmpfs.
SWITCHOVER="${SPATIUM_POWER_ACTION_SWITCHOVER:-${MARKER}-switchover}"
# #3008 — a grace between taking the lock and the handoff / systemctl. The
# console's unit sets it (10 s, as the web-UI reboot has); the web-UI and Fleet
# paths sleep their own grace before calling this, so they leave it 0. It is
# spent while the lock and the marker are held, so the web UI reads the reboot
# under way and F9 can cancel it, and the api answers long enough for the
# Maintenance tab's poll to see it on a one-node install (where systemctl would
# otherwise be issued within a second of the console's confirm).
GRACE_S="${SPATIUM_POWER_ACTION_GRACE_S:-0}"
case "$GRACE_S" in ''|*[!0-9]*) GRACE_S=0 ;; esac
ACTION="${1:-}"

case "$ACTION" in
    reboot|poweroff) ;;
    *)
        echo "usage: spatium-power-action reboot|poweroff" >&2
        exit 2
        ;;
esac

log() {
    printf '[power-action] %s\n' "$*"
}

undo() {
    if [ -x "$HANDOFF" ]; then
        "$HANDOFF" --undo 2>&1 || true
    fi
}

clear_marker() {
    rm -f "$MARKER" 2>/dev/null || true
}

# Root writes in release-state go under a fresh name and are renamed onto the
# target (GHSA-h2j9-qrg7-grfw).
state_write() {
    local _dst="$1" _tmp
    _tmp=$(mktemp "$(dirname -- "$_dst")/.$(basename -- "$_dst").XXXXXX") || return 1
    if cat > "$_tmp" && chmod "${2:-0644}" "$_tmp" && mv -fT -- "$_tmp" "$_dst"; then
        return 0
    fi
    rm -f -- "$_tmp"
    return 1
}

child=""
issued=0

on_signal() {
    local sig="$1"
    if [ "$issued" = 1 ]; then
        # systemctl has been issued: this is the shutdown stopping us (or a
        # cancel that came too late). Undoing the cordon now would hand the
        # node pods back while it goes down, so it is left for the next boot.
        log "stopped after systemctl $ACTION was issued: the cordon stays for the next boot"
        return
    fi
    log "stopped before systemctl $ACTION: the handoff's cordon is undone"
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    undo
    if [ -e "$SWITCHOVER" ]; then
        log "the PostgreSQL primary switchover the handoff had asked of CloudNativePG still" \
            "completes (the API pauses for a few seconds while the primary moves); the node" \
            "stays up"
    fi
    clear_marker
    log "$ACTION cancelled"
    # #3162 — end by the signal itself, not exit 1: the units list SIGTERM /
    # SIGINT / SIGHUP in SuccessExitStatus=, so a cancel no longer leaves the
    # unit failed, while a caller still reads a non-zero status (no reboot).
    # The cleanup above has finished: the traps are reset first so the signal
    # is not caught again. `exit 1` is reached only when it is ignored.
    trap - TERM INT HUP
    kill -s "$sig" "$$"
    exit 1
}
trap 'on_signal TERM' TERM
trap 'on_signal INT' INT
trap 'on_signal HUP' HUP

rm -f -- "$SWITCHOVER" 2>/dev/null || true
printf '%s %s\n' "$$" "$ACTION" > "$MARKER" 2>/dev/null || true

# fd 9 holds the lock for the life of this process; the children get it
# closed (9>&-) so a stray child cannot keep it held after we are gone.
# Opened read-only: nothing is created or written. A short wait, not -n: the
# api's probe takes a shared lock for an instant, and failing on that would
# run the whole action without the lock, the button enabled throughout.
if { exec 9<"$LOCK"; } 2>/dev/null; then
    flock -w 5 9 || log "another power action holds $LOCK: going on regardless"
fi

if [ "$GRACE_S" -gt 0 ]; then
    log "$ACTION in ${GRACE_S}s (a stop cancels it)"
    # In the background and waited for, so a stop is acted on at once.
    sleep "$GRACE_S" 9>&- &
    child=$!
    wait "$child"
    child=""
fi

if [ -x "$HANDOFF" ]; then
    # In the background and waited for, so a stop is acted on at once: bash
    # runs a trap only once a foreground command has finished.
    SPATIUM_HANDOFF_SWITCHOVER_FILE="$SWITCHOVER" \
        timeout -k 10 "$HANDOFF_CAP_S" "$HANDOFF" --before-reboot 2>&1 9>&- &
    child=$!
    wait "$child"
    rc=$?
    child=""
    if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
        log "the handoff did not finish within ${HANDOFF_CAP_S} s: stopped, going on with $ACTION"
    fi
fi

# Written while the lock is still held, so the api never sees a gap between
# the two.
boot_id="$(cat "$BOOT_ID_FILE" 2>/dev/null || true)"
if [ -n "$boot_id" ]; then
    printf '%s %s\n' "$ACTION" "$boot_id" | state_write "$ISSUED" 9>&- \
        || log "could not write $ISSUED"
fi
issued=1
log "issuing systemctl $ACTION"
if ! systemctl "$ACTION" 9>&-; then
    log "systemctl $ACTION failed: the node stays up, so the handoff's cordon is undone"
    rm -f -- "$ISSUED" "$SWITCHOVER" 2>/dev/null || true
    undo
    clear_marker
    exit 1
fi
