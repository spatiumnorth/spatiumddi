#!/bin/bash
# spatium-power-action — the one entry point for an operator-initiated
# reboot or poweroff of an appliance node that is not the Fleet reboot
# (#2974): the web-UI local reboot (spatiumddi-reboot.service) and the
# console's F5 / F6.
#
# Usage: spatium-power-action reboot|poweroff
#
# On a cluster node holding the PostgreSQL primary, spatium-reboot-handoff
# first hands the primary off to another node (#2849), bounded by its own
# budgets, always exiting 0: a handoff that cannot be done never holds the
# reboot or poweroff. Then systemctl runs. If systemctl fails the node stays
# up, so the handoff's cordon is undone. If this script is stopped meanwhile
# (the console's "cancel pending reboot" stops the web-UI unit) the cordon is
# undone too. After a poweroff the cordon stays until the node is next
# booted, where spatiumddi-reboot-handoff.service uncordons it.
# The Fleet path (spatiumddi-reboot-agent) does the same steps itself.

set -uo pipefail

HANDOFF="${SPATIUM_REBOOT_HANDOFF:-/usr/local/bin/spatium-reboot-handoff}"
ACTION="${1:-}"

case "$ACTION" in
    reboot|poweroff) ;;
    *)
        echo "usage: spatium-power-action reboot|poweroff" >&2
        exit 2
        ;;
esac

log() {
    printf '[power-action] %s\n' "$*"
}

undo() {
    if [ -x "$HANDOFF" ]; then
        "$HANDOFF" --undo 2>&1 || true
    fi
}

stopped() {
    log "stopped before systemctl $ACTION: the handoff's cordon is undone"
    undo
    exit 1
}
trap stopped TERM INT HUP

if [ -x "$HANDOFF" ]; then
    "$HANDOFF" --before-reboot 2>&1 || true
fi

log "issuing systemctl $ACTION"
trap - TERM INT HUP
if ! systemctl "$ACTION"; then
    log "systemctl $ACTION failed: the node stays up, so the handoff's cordon is undone"
    undo
    exit 1
fi
