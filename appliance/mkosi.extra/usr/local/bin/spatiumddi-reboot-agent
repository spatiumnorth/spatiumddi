#!/bin/bash
# spatiumddi-reboot-agent — host-side runner for operator-triggered
# reboot requests from the control plane's Fleet view (Phase 8f-8,
# issue #138).
#
# Flow:
#   1. Operator clicks Reboot in the OS Versions table → backend
#      stamps ``reboot_requested=true`` on the agent's server row.
#   2. ConfigBundle long-poll carries the field down → the supervisor
#      writes ``/var/lib/spatiumddi-host/release-state/reboot-pending-fleet``
#      via the bind-mounted release-state directory (#553 gave the fleet
#      path its own filename so it no longer collides with the web-UI
#      ``reboot-pending`` trigger).
#   3. ``spatiumddi-reboot-agent.path`` notices the file and runs this
#      script as root.
#   4. Script:
#        a. Logs the request to /var/log/spatiumddi/reboot-agent.log
#           so the operator can audit from the appliance UI / SSH
#        b. Renames the trigger to .done so the path unit doesn't
#           re-fire after the box comes back up (next-boot will see
#           the same dir contents otherwise — we want a clean state)
#        c. Issues ``systemctl reboot`` with a small grace window so
#           in-flight DNS / DHCP responses can finish, then runs
#           ``spatium-power-action reboot`` (#3008), which on a cluster
#           node holding the PostgreSQL primary first hands the primary
#           off to another node (spatium-reboot-handoff, #2849).
#
# Idempotent — if a stale .done file already exists it's overwritten;
# if no trigger file is present the script no-ops with a warning.

set -euo pipefail

# #553 — fleet reboots use a DEDICATED trigger filename so this runner and
# the web-UI spatiumddi-reboot.service don't both fire on a single write.
TRIGGER=/var/lib/spatiumddi/release-state/reboot-pending-fleet
LOG_DIR=/var/log/spatiumddi
LOG="$LOG_DIR/reboot-agent.log"
GRACE_SECONDS=5
POWER_ACTION="${SPATIUM_POWER_ACTION:-/usr/local/bin/spatium-power-action}"

mkdir -p "$LOG_DIR"

log() {
    printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG"
}

if [ ! -f "$TRIGGER" ]; then
    log "reboot-agent invoked without a trigger file — nothing to do"
    exit 0
fi

# Read the trigger payload (just a timestamp from the agent) for the
# audit log, then move it aside so the path unit doesn't re-fire.
TRIGGER_PAYLOAD="$(cat "$TRIGGER" 2>/dev/null || true)"
mv -f "$TRIGGER" "${TRIGGER}.done" || true

log "operator-triggered reboot accepted (agent stamp: ${TRIGGER_PAYLOAD:-unknown})"
log "scheduling reboot in ${GRACE_SECONDS}s"

# #3008 — the same wrapper the web-UI reboot and the console use
# (spatium-power-action, #2974), so there is one implementation: it hands
# the PostgreSQL primary off first when this node holds it (#2849), then runs
# ``systemctl reboot`` (through logind, which first lets the kubelet's
# graceful node shutdown run, #1976; the grace window above is in addition
# to that). It holds the in-progress marker and lock, so the console shows
# the handoff and the web UI keeps its Reboot button disabled, and a stop
# before systemctl (this unit being stopped) undoes the handoff's cordon. It
# undoes it too when systemctl fails. Its lines go to this log.
log "handing over to spatium-power-action reboot"
if ! "$POWER_ACTION" reboot >>"$LOG" 2>&1; then
    log "spatium-power-action reboot failed: the node stays up"
    exit 1
fi
