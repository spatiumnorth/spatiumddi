#!/bin/bash
# spatiumddi-reboot-agent — host-side runner for operator-triggered
# reboot requests from the control plane's Fleet view (Phase 8f-8,
# issue #138).
#
# Flow:
#   1. Operator clicks Reboot in the OS Versions table → backend
#      stamps ``reboot_requested=true`` on the agent's server row.
#   2. ConfigBundle long-poll carries the field down → the supervisor
#      writes ``/var/lib/spatiumddi-host/release-state/reboot-pending-fleet``
#      via the bind-mounted release-state directory (#553 gave the fleet
#      path its own filename so it no longer collides with the web-UI
#      ``reboot-pending`` trigger).
#   3. ``spatiumddi-reboot-agent.path`` notices the file and runs this
#      script as root.
#   4. Script:
#        a. Logs the request to /var/log/spatiumddi/reboot-agent.log
#           so the operator can audit from the appliance UI / SSH
#        b. Writes the grace marker (GRACE_MARKER, #3008) so the
#           console and the web UI see the reboot from here on, then
#           renames the trigger to .done so the path unit doesn't
#           re-fire after the box comes back up (next-boot will see
#           the same dir contents otherwise — we want a clean state)
#        c. Issues ``systemctl reboot`` with a small grace window so
#           in-flight DNS / DHCP responses can finish, then runs
#           ``spatium-power-action reboot`` (#3008), which on a cluster
#           node holding the PostgreSQL primary first hands the primary
#           off to another node (spatium-reboot-handoff, #2849).
#
# Idempotent — if a stale .done file already exists it's overwritten;
# if no trigger file is present the script no-ops with a warning.

set -euo pipefail

# #553 — fleet reboots use a DEDICATED trigger filename so this runner and
# the web-UI spatiumddi-reboot.service don't both fire on a single write.
TRIGGER=/var/lib/spatiumddi/release-state/reboot-pending-fleet
LOG_DIR=/var/log/spatiumddi
LOG="$LOG_DIR/reboot-agent.log"
GRACE_SECONDS="${SPATIUM_REBOOT_AGENT_GRACE_S:-5}"
POWER_ACTION="${SPATIUM_POWER_ACTION:-/usr/local/bin/spatium-power-action}"
# #3008 — "<pid> <boot_id>" while this runner is between taking the trigger
# and handing over to spatium-power-action: the trigger is renamed first and
# the wrapper's own marker and lock only exist once it runs, so without this
# the console's F9 found nothing to cancel during the grace and the web UI
# read no reboot under way. Removed when this runner exits, however it exits
# (a stop included); it is kept while the wrapper runs, so the two overlap
# and there is no instant in which neither is there. The pid is for the
# console, the boot id for the api (its own pid namespace): a marker left by
# a runner killed outright counts for nothing once its process is gone (the
# console) or after a short age (the api), and never after a reboot.
GRACE_MARKER=/var/lib/spatiumddi/release-state/reboot-fleet-grace
BOOT_ID_FILE="${SPATIUM_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"

mkdir -p "$LOG_DIR"

log() {
    printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG"
}

# Root writes in release-state go under a fresh name and are renamed onto the
# target (GHSA-h2j9-qrg7-grfw): the api and the supervisor can create names
# there, and a redirect would follow a symlink one of them planted.
state_write() {
    local _dst="$1" _tmp
    _tmp=$(mktemp "$(dirname -- "$_dst")/.$(basename -- "$_dst").XXXXXX") || return 1
    if cat > "$_tmp" && chmod "${2:-0644}" "$_tmp" && mv -fT -- "$_tmp" "$_dst"; then
        return 0
    fi
    rm -f -- "$_tmp"
    return 1
}

if [ ! -f "$TRIGGER" ]; then
    log "reboot-agent invoked without a trigger file — nothing to do"
    exit 0
fi

# #3008 — the grace marker goes up BEFORE the trigger is moved aside, so the
# reboot is visible throughout; it comes down when this runner exits. A stop
# (the console's F9 stops this unit) ends the run there: during the grace
# nothing has been done yet, and during the wrapper the wrapper undoes its own
# work (this shell runs the trap once the wrapper has returned).
sleep_pid=""
clear_grace() {
    rm -f -- "$GRACE_MARKER" 2>/dev/null || true
}
on_stop() {
    if [ -n "$sleep_pid" ]; then
        kill "$sleep_pid" 2>/dev/null || true
    fi
    clear_grace
    log "reboot-agent stopped: the grace marker is cleared"
    # #3162 — a stop is a cancel, not a failure: end by the signal itself, which
    # systemd counts as a clean stop (the unit inactive, not failed).
    trap - EXIT TERM INT HUP
    kill -s "$1" "$$"
    exit 1
}
trap clear_grace EXIT
trap 'on_stop TERM' TERM
trap 'on_stop INT' INT
trap 'on_stop HUP' HUP

BOOT_ID="$(cat "$BOOT_ID_FILE" 2>/dev/null || true)"
printf '%s %s\n' "$$" "${BOOT_ID:-unknown}" | state_write "$GRACE_MARKER" \
    || log "could not write the grace marker $GRACE_MARKER"

# Read the trigger payload (just a timestamp from the agent) for the
# audit log, then move it aside so the path unit doesn't re-fire.
TRIGGER_PAYLOAD="$(cat "$TRIGGER" 2>/dev/null || true)"
mv -fT "$TRIGGER" "${TRIGGER}.done" || true

log "operator-triggered reboot accepted (agent stamp: ${TRIGGER_PAYLOAD:-unknown})"
log "scheduling reboot in ${GRACE_SECONDS}s"

# The grace lets in-flight DNS / DHCP responses finish. It runs before the
# wrapper, so a cancel during it (the console's F9 sees the grace marker and
# stops this unit) has no cordon to undo, and the wrapper is never called.
# In the background and waited for, so a stop is acted on at once: bash runs
# a trap only once a foreground command has finished.
sleep "$GRACE_SECONDS" &
sleep_pid=$!
wait "$sleep_pid"
sleep_pid=""

# #3008 — the same wrapper the web-UI reboot and the console use
# (spatium-power-action, #2974), so there is one implementation: it hands
# the PostgreSQL primary off first when this node holds it (#2849), then runs
# ``systemctl reboot`` (through logind, which first lets the kubelet's
# graceful node shutdown run, #1976; the grace window is in addition to
# that). It holds the in-progress marker and lock, so the console shows
# the handoff and the web UI keeps its Reboot button disabled, and a stop
# before systemctl (this unit being stopped) undoes the handoff's cordon. It
# undoes it too when systemctl fails. Its lines go to this log: a file
# redirect, not a pipe through log(), because a stop kills a pipe's reader
# and the wrapper's undo would then die of SIGPIPE on its first line.
log "handing over to spatium-power-action reboot"
if ! "$POWER_ACTION" reboot >>"$LOG" 2>&1; then
    log "spatium-power-action reboot failed: the node stays up"
    exit 1
fi
