#!/usr/bin/env python3
"""spatium-etcd-evict — removes the etcd members of the nodes Fleet → Replace
evicts, on the seed (#1284).

┌─────────────────────────────────────────────────────────────────────┐
│ ⚠️  Removes etcd members. Only the members of a node the control      │
│ plane is evicting are touched: the name k3s gave it                  │
│ (<hostname>-<8 hex>, exactly), or no name yet and a peer URL on one  │
│ of that node's addresses. Never this node's own member — except      │
│ --leave-self (#1541), which removes exactly that one, and is run     │
│ only by the leave runner on a demoted node.                          │
└─────────────────────────────────────────────────────────────────────┘

Flow (the host-runner pattern of spatium-cluster-join / -restore):
  1. Fleet → Replace flags a row evict_requested. On its next heartbeat the
     seed's supervisor deletes the node's k8s Node, then writes
       /var/lib/spatiumddi/release-state/etcd-evict-pending
     (the confirm marker, `id <request>`, then
     `node<TAB><hostname><TAB><ip>[,<ip>…]` per node) through its
     release-state bind mount.
  2. spatiumddi-etcd-evict.path notices it and runs this script as root.
  3. This script takes the request out of the trigger's path, lists the
     seed's etcd members, removes each member that belongs to a listed
     node, lists them again, and writes
       /var/lib/spatiumddi/release-state/etcd-evict.state
     (`id <request>`, then `<hostname><TAB><state><TAB><detail>`, where the
     state is one of absent | removed | present | error). The supervisor
     reports a node evicted, and the row settles `left`, only once its
     state is absent or removed.
  4. The answered request is kept as etcd-evict-pending.done (.failed when
     the member list was unreadable), so nothing can run it again: a
     manual start of the unit, or a touch of the trigger, finds no request.
     A request older than MAX_REQUEST_AGE_S is refused without touching
     etcd (.stale). The supervisor writes a fresh one whenever it still
     wants an answer.

Why: k3s removes a server's etcd member only through its k8s Node (the
Node's deletion, or the etcd.k3s.cattle.io/remove annotation). A node that
became an etcd voter before its Node registered has no Node. That is a failed
joiner whose own retry re-joined it and which then died. Deleting "its" Node
answered 404 and removed nothing, and the dead voter kept its seat for good:
two live voters of three, and every later member add refused (etcdserver:
unhealthy cluster). The supervisor cannot do this itself, because its process
user can read neither the etcd client key nor the host's loopback etcd port.

How etcd is reached. The appliance ships no etcdctl, and k3s's embedded etcd
serves no JSON gateway on its client port. Over HTTP/1.1 the connection is
closed with an empty reply. Over HTTP/2 the gRPC server answers 415 to
anything that is not application/grpc. So:
- the member list is k3s's own /db/info on 127.0.0.1:6443, the endpoint a
  joining server reads. It uses the server token's basic auth, and its member
  IDs are uint64s, which Python's json keeps exact;
- a removal is the etcd gRPC call itself, etcdserverpb.Cluster/MemberRemove,
  framed here (one uint64 field) and sent by curl over HTTP/2 with k3s's etcd
  client certificate. --leave-self's hand-off of the lead is sent the same way
  (etcdserverpb.Maintenance/MoveLeader);
- what etcd lists afterwards is the verdict, not what the call answered.
"""

from __future__ import annotations

import base64
import ipaddress
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path
from urllib.parse import urlsplit

RELEASE_STATE = Path(os.environ.get("SPATIUM_RELEASE_STATE", "/var/lib/spatiumddi/release-state"))
TRIGGER = RELEASE_STATE / "etcd-evict-pending"
STATE = RELEASE_STATE / "etcd-evict.state"
# Must stay byte-identical to CONFIRM in the supervisor's etcd_evict.py.
CONFIRM = "SPATIUMDDI-ETCD-EVICT-CONFIRM-V1"
K3S_SERVER_DIR = Path(os.environ.get("SPATIUM_K3S_SERVER_DIR", "/var/lib/rancher/k3s/server"))
K3S_URL = os.environ.get("SPATIUM_K3S_URL", "https://127.0.0.1:6443")
ETCD_URL = os.environ.get("SPATIUM_ETCD_URL", "https://127.0.0.1:2379")
LOG = Path(os.environ.get("SPATIUM_LOG_DIR", "/var/log/spatiumddi")) / "etcd-evict.log"
# appliance/tests replace the two etcd calls with commands of their own.
MEMBERS_CMD = os.environ.get("SPATIUM_ETCD_MEMBERS_CMD", "")
REMOVE_CMD = os.environ.get("SPATIUM_ETCD_REMOVE_CMD", "")
# A request is acted on only while it is fresh. The path unit starts this
# script about a second after the supervisor writes one, and the supervisor
# writes a new request once an answer is 90 s overdue (RUNNER_SILENT_S in its
# etcd_evict.py). An older request was never run when it was written, and
# nobody waits on it any more: acting on it would act on the past, and a node
# promoted again since then (its new member appears about 80 s after the
# promote) would lose that member as the evicted one's.
MAX_REQUEST_AGE_S = 60.0
# --leave-self (#1541): the join drop-in names the survivor this node joined
# (``server: <url>``); its /db/info is what confirms the removal.
JOIN_DROPIN = Path(os.environ.get("SPATIUM_K3S_DROPIN_DIR", "/etc/rancher/k3s/config.yaml.d")) \
    / "spatium-cluster.yaml"
SURVIVOR_MEMBERS_CMD = os.environ.get("SPATIUM_ETCD_SURVIVOR_MEMBERS_CMD", "")
STOP_K3S_CMD = os.environ.get("SPATIUM_STOP_K3S_CMD", "systemctl stop k3s")
# How long --leave-self waits for a survivor to stop listing this node's
# member. A control-plane VIP this node was announcing moves in seconds.
LEAVE_CONFIRM_S = float(os.environ.get("SPATIUM_LEAVE_CONFIRM_S", "90"))
LEAVE_POLL_S = float(os.environ.get("SPATIUM_LEAVE_POLL_S", "3"))
# k3s writes this, then closes etcd, when a peer rejects its etcd as a removed
# member, which a peer does only once it has applied that member's removal. The
# next k3s start finds it and rejoins as a new member (k3s v1.36.4+k3s1:
# pkg/executor/embed/etcd/etcd.go, and pkg/etcd/etcd.go's tombstone check).
TOMBSTONE = K3S_SERVER_DIR / "db" / "etcd" / "tombstone"
# --leave-self hands the etcd lead to the survivor before this node removes its
# own member (#2874). It waits at most LEAD_HANDOFF_S for that. Whether the
# cluster has a leader at all is etcd's etcd_server_has_leader gauge, on the
# metrics listener k3s binds on the loopback (spatium-console reads it too).
LEAD_HANDOFF_S = float(os.environ.get("SPATIUM_LEAD_HANDOFF_S", "30"))
METRICS_URL = os.environ.get("SPATIUM_ETCD_METRICS_URL", "http://127.0.0.1:2381/metrics")
# appliance/tests replace the MoveLeader call as they replace the removal.
MOVE_LEADER_CMD = os.environ.get("SPATIUM_ETCD_MOVE_LEADER_CMD", "")


def log(msg: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%dT%H:%M:%S%z')}] {msg}\n")
    except OSError:
        # Best effort: a log that cannot be written (a full or read-only
        # /var/log) must not stop an eviction or its answer.
        pass


# ---- the request -------------------------------------------------------------------

def read_request(text: str) -> tuple[str, list[tuple[str, list[str]]]] | None:
    """(request id, [(hostname, [ips])]), or None when the confirm marker is
    missing: a stray or hand-made file must remove nothing."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != CONFIRM:
        return None
    request_id = ""
    nodes: list[tuple[str, list[str]]] = []
    for line in lines[1:]:
        if line.startswith("id "):
            request_id = re.sub(r"[^A-Za-z0-9]", "", line[3:])[:64]
            continue
        parts = line.split("\t")
        if len(parts) >= 2 and parts[0] == "node" and parts[1].strip():
            ips = [a.strip() for a in (parts[2] if len(parts) > 2 else "").split(",") if a.strip()]
            nodes.append((parts[1].strip(), ips))
    return request_id, nodes


# ---- which members belong to a node -----------------------------------------------

def canonical_addr(text: str) -> str:
    """An address in one spelling, so `fd00:0::1` and `fd00::1` (or upper-case
    hex) compare equal. Anything that is not an IP stays as written, lower-cased."""
    text = text.strip().strip("[]")
    try:
        return str(ipaddress.ip_address(text))
    except ValueError:
        return text.lower()


def peer_host(url: str) -> str:
    try:
        return canonical_addr(urlsplit(url).hostname or "")
    except ValueError:
        return ""


def _member_name_re(host: str) -> re.Pattern[str]:
    """The name k3s gives a server's etcd member: `<node name>-<8 hex>`, and
    nothing after it (`\\Z`: `$` also matches before a trailing newline)."""
    # k3s lowercases the host's name for the node, and the member is named
    # after that (#1757): `Ddi-Member-1` owns `ddi-member-1-1a2b3c4d`.
    return re.compile(r"^" + re.escape(host.strip().rstrip(".").lower()) + r"-[0-9a-f]{8}\Z")


def node_members(members: list[dict], host: str, ips: list[str],
                 own_names: set[str]) -> list[dict]:
    """The members that belong to one node: the name k3s gives a server's member
    (<hostname>-<8 hex>, exactly), or, while it has no name yet (a learner that
    never started), a peer URL on one of the node's addresses. Never one of
    this node's own."""
    name_re = _member_name_re(host)
    own_res = [_member_name_re(o) for o in own_names]
    addrs = {canonical_addr(a) for a in ips}
    out = []
    for m in members:
        name = str(m.get("name") or "")
        if name and (name in own_names or any(r.match(name) for r in own_res)):
            continue
        if name_re.match(name) or (not name and any(
                peer_host(u) in addrs for u in (m.get("peerURLs") or []))):
            out.append(m)
    return out


def etcd_name() -> str:
    """The name of the etcd member this node's k3s runs, from k3s's etcd config;
    '' when there is none to read."""
    try:
        text = (K3S_SERVER_DIR / "db" / "etcd" / "config").read_text(encoding="utf-8")
    except OSError:
        return ""
    m = re.search(r"(?m)^name:\s*(\S+)", text)
    return m.group(1) if m else ""


def own_names() -> set[str]:
    """This node's own etcd member name (k3s's etcd config) and its hostname:
    neither may ever be removed here."""
    # With no etcd config to read, the set still holds the hostname, which is
    # the k3s node name this node's own member name starts with.
    names = {os.environ.get("SPATIUM_NODE_NAME") or socket.gethostname(), etcd_name()}
    # Both spellings: socket.gethostname() keeps an uppercase hostname as
    # typed, while the member k3s named is lowercase (#1757). Missing the
    # lowercase one would let this runner take its own member for a stranger's.
    return {n for n in names if n} | {n.lower() for n in names if n}


# ---- etcd --------------------------------------------------------------------------

def list_members(url: str = "", cmd: str = "") -> list[dict]:
    """The etcd members through k3s's /db/info: this node's k3s by default, or
    the k3s at ``url`` (``--leave-self`` reads a survivor's). Raises when the
    list is unreadable, including k3s's canned fallback: when its own
    MemberList fails it answers a list that names only itself and carries no
    member IDs."""
    url = url or K3S_URL
    cmd = cmd if url != K3S_URL else (cmd or MEMBERS_CMD)
    if cmd:
        body = subprocess.run(["sh", "-c", cmd], capture_output=True, text=True,
                              timeout=30, check=False).stdout
    else:
        token = (K3S_SERVER_DIR / "token").read_text(encoding="utf-8").strip()
        password = token.split("::server:", 1)[1] if "::server:" in token else token
        ctx = ssl.create_default_context(cafile=str(K3S_SERVER_DIR / "tls" / "server-ca.crt"))
        req = urllib.request.Request(f"{url}/db/info")
        req.add_header("Authorization",
                       "Basic " + base64.b64encode(f"server:{password}".encode()).decode())
        with urllib.request.urlopen(req, context=ctx, timeout=15) as resp:
            body = resp.read().decode("utf-8", errors="replace")
    data = json.loads(body)
    members = data.get("members") if isinstance(data, dict) else None
    if not isinstance(members, list) or not members:
        raise ValueError(f"no member list in the answer: {body[:160]!r}")
    if not all(isinstance(m, dict) and m.get("ID") for m in members):
        raise ValueError("k3s answered its fallback list (no member IDs): its MemberList failed")
    return members


def _varint(n: int) -> bytes:
    out = bytearray()
    while True:
        byte, n = n & 0x7F, n >> 7
        if n:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)


def remove_frame(member_id: int) -> bytes:
    """A gRPC frame carrying MemberRemoveRequest{ID: member_id} (field 1, varint).
    MoveLeaderRequest{targetID} has the same one field, so it is framed alike."""
    msg = b"\x08" + _varint(int(member_id))
    return b"\x00" + len(msg).to_bytes(4, "big") + msg


def remove_member(member_id: int) -> str:
    """etcdserverpb.Cluster/MemberRemove over HTTP/2; '' when etcd accepted it or
    the member was already gone, else etcd's error. The list read afterwards is
    the verdict either way."""
    if REMOVE_CMD:
        r = subprocess.run(["sh", "-c", REMOVE_CMD, "remove", str(member_id)],
                           capture_output=True, text=True, timeout=30, check=False)
        return "" if r.returncode == 0 else (r.stdout or r.stderr).strip()[:200]
    return etcd_call("/etcdserverpb.Cluster/MemberRemove", member_id)


def move_leader(target_id: int) -> str:
    """etcdserverpb.Maintenance/MoveLeader on this node's etcd: '' once the
    member ``target_id`` leads (etcd answers only after it has taken over), else
    etcd's error. Only the leader takes the call. Any other member answers
    "etcdserver: not leader" and moves nothing."""
    if MOVE_LEADER_CMD:
        r = subprocess.run(["sh", "-c", MOVE_LEADER_CMD, "move-leader", str(target_id)],
                           capture_output=True, text=True, timeout=30, check=False)
        return "" if r.returncode == 0 else (r.stdout or r.stderr).strip()[:200]
    # etcd waits for the transferee with no limit of its own. The deadline makes
    # it answer ("leader transfer took too long") before curl's --max-time cuts in.
    return etcd_call("/etcdserverpb.Maintenance/MoveLeader", target_id, "grpc-timeout: 10S")


def etcd_call(method: str, member_id: int, *headers: str) -> str:
    """One etcd gRPC call whose request is a member ID alone (remove_frame), sent
    by curl over HTTP/2 with k3s's etcd client certificate: '' on grpc-status 0,
    else what went wrong (grpc_error, or curl's own failure)."""
    tls = K3S_SERVER_DIR / "tls" / "etcd"
    cmd = ["curl", "-sS", "--http2", "--max-time", "15",
           "--cacert", str(tls / "server-ca.crt"),
           "--cert", str(tls / "client.crt"), "--key", str(tls / "client.key"),
           "-H", "content-type: application/grpc", "-H", "te: trailers",
           *(arg for h in headers for arg in ("-H", h)),
           "--data-binary", "@-", "-D", "-", "-o", "/dev/null",
           f"{ETCD_URL}{method}"]
    try:
        r = subprocess.run(cmd, input=remove_frame(member_id), capture_output=True,
                           timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"curl: {exc}"[:200]
    if r.returncode != 0:
        return f"curl exit {r.returncode}: {r.stderr.decode(errors='replace').strip()[:160]}"
    return grpc_error(r.stdout.decode("utf-8", errors="replace"))


def grpc_error(headers: str) -> str:
    """'' when etcd's answer says the member is gone (grpc-status 0, or the
    member was not found), else what went wrong. curl dumps the HTTP/2 trailers
    with the headers, and every gRPC answer carries a grpc-status; an answer
    without one (an HTTP 415 from a server that did not take the call as gRPC)
    removed nothing, and the log must not say it did."""
    status = re.search(r"(?im)^grpc-status:\s*(\d+)", headers)
    message = re.search(r"(?im)^grpc-message:\s*(.*?)\s*$", headers)
    text = urllib.request.unquote(message.group(1)) if message else ""
    if status is None:
        http = re.search(r"(?im)^HTTP/[\d.]+\s+(\d{3})", headers)
        return f"no grpc-status in etcd's answer (HTTP {http.group(1) if http else '?'})"
    if status.group(1) == "0" or "member not found" in text:
        return ""
    return f"grpc-status {status.group(1)}: {text}"[:200]


# curl exits that show etcd never saw the removal. curl raises them only while
# it connects (6 the name lookup, which only a SPATIUM_ETCD_URL naming a host
# needs; 7 the TCP connect; 35 the TLS handshake; 58 loading this node's client
# certificate or key; 60 checking etcd's certificate; 77 reading the CA file),
# and it sends the call only once connected. It sends the call again, on a new
# connection, only after etcd refused the stream unprocessed (REFUSED_STREAM).
# Any other exit can come after the call was sent: a timeout (28, as
# --max-time covers the whole call) or a connection lost mid-call (16, 52, 55,
# 56, 92). Read from curl 8.14.1, the one Debian trixie ships.
CURL_NEVER_SENT = frozenset({6, 7, 35, 58, 60, 77})


def refused_before_proposing(err: str) -> bool:
    """True when remove_member()'s error shows etcd never acted on the call: a
    curl that failed before it sent the call (CURL_NEVER_SENT), no gRPC answer
    at all (see grpc_error), or a refusal etcd gives before it proposes the
    change. For MemberRemove those are FailedPrecondition (9, from its gRPC
    interceptor or its strict reconfiguration check) and that check's
    "unhealthy cluster" (14). Any other error does not show it: "server
    stopped" comes after the change was proposed, and a timeout or a
    connection lost mid-call can, so it may have been applied (#2394)."""
    curl = re.match(r"curl exit (\d+):", err)
    if curl:
        return int(curl.group(1)) in CURL_NEVER_SENT
    if err.startswith("no grpc-status"):
        return True
    m = re.match(r"grpc-status (\d+): (.*)", err, re.S)
    if not m:
        return False
    return m.group(1) == "9" or (
        m.group(1) == "14" and m.group(2).strip() == "etcdserver: unhealthy cluster")


# ---- the run -----------------------------------------------------------------------

def write_state(request_id: str, lines: list[str]) -> None:
    # A fresh temp name from mkstemp (O_EXCL, never through a symlink), not
    # a predictable one: the api and the supervisor can create names in
    # release-state, and a write through a link planted there would land on
    # any host file. The rename replaces whatever is at STATE's name.
    fd, name = tempfile.mkstemp(prefix=f".{STATE.name}.", dir=STATE.parent)
    try:
        os.fchmod(fd, 0o644)
        with open(fd, "w", encoding="utf-8") as fh:
            fh.write("".join([f"id {request_id}\n", *(f"{ln}\n" for ln in lines)]))
        os.replace(name, STATE)
    except BaseException:
        try:
            os.unlink(name)
        except OSError:
            pass  # already renamed into place: nothing left to remove
        raise


def describe(m: dict) -> str:
    return f"{m.get('ID')} {m.get('name') or '(unnamed)'}"


def retire(taken: Path, outcome: str) -> None:
    """Keep the request just handled as etcd-evict-pending.<outcome>, out of the
    trigger's path. Only that request: one the supervisor wrote meanwhile is at
    the trigger's path, and it is left for the next run."""
    try:
        taken.replace(TRIGGER.with_name(f"{TRIGGER.name}.{outcome}"))
    except OSError as exc:
        log(f"could not set the handled request aside: {exc}")


def run() -> int:
    if not TRIGGER.exists():
        return 0
    # Take the request before acting on it. Renamed out of the trigger's path,
    # it can never run twice, whatever starts this unit again. The rename is one
    # more change on the watched path while this run is active, so systemd
    # folds it into this run's start job.
    taken = TRIGGER.with_name(f"{TRIGGER.name}.processing")
    try:
        TRIGGER.replace(taken)
        text = taken.read_text(encoding="utf-8", errors="replace")
        age = time.time() - taken.stat().st_mtime
    except OSError:
        # Gone between the check and the rename: a run started by hand took it.
        return 0
    req = read_request(text)
    if req is None:
        log("request without the confirmation marker — refusing, nothing removed")
        retire(taken, f"rejected.{int(time.time())}")
        return 0
    request_id, nodes = req
    if abs(age) > MAX_REQUEST_AGE_S:
        why = (f"refused a request {int(age)}s old (the limit is {int(MAX_REQUEST_AGE_S)}s): "
               "nothing removed; the supervisor asks again if it still wants it")
        log(why)
        write_state(request_id, [f"{host}\terror\t{why}" for host, _ in nodes])
        retire(taken, "stale")
        return 0
    rc = answer(request_id, nodes)
    retire(taken, "done" if rc == 0 else "failed")
    return rc


def answer(request_id: str, nodes: list[tuple[str, list[str]]]) -> int:
    """Remove the listed nodes' members and write what etcd lists afterwards."""
    mine = own_names()
    try:
        members = list_members()
    except Exception as exc:  # noqa: BLE001 — every failure is reported per node
        why = f"the seed's etcd member list is unreadable: {exc}"[:240]
        log(why)
        write_state(request_id, [f"{host}\terror\t{why}" for host, _ in nodes])
        return 1
    removed: dict[str, list[str]] = {}
    failed: dict[str, list[str]] = {}
    for host, ips in nodes:
        for m in node_members(members, host, ips, mine):
            err = remove_member(int(m["ID"]))
            if err:
                failed.setdefault(host, []).append(f"{describe(m)}: {err}")
                log(f"could not remove etcd member {describe(m)} of {host}: {err}")
            else:
                removed.setdefault(host, []).append(describe(m))
                log(f"removed etcd member {describe(m)} of {host}")
    try:
        after = list_members() if (removed or failed) else members
    except Exception as exc:  # noqa: BLE001
        why = f"the seed's etcd member list is unreadable after the removal: {exc}"[:240]
        write_state(request_id, [f"{host}\terror\t{why}" for host, _ in nodes])
        return 1
    lines = []
    for host, ips in nodes:
        left = node_members(after, host, ips, mine)
        if left:
            detail = "etcd member " + "; ".join(describe(m) for m in left) + " still listed"
            if failed.get(host):
                detail += " (remove failed: " + "; ".join(failed[host]) + ")"
            lines.append(f"{host}\tpresent\t{detail}")
        elif removed.get(host):
            lines.append(f"{host}\tremoved\t" + "; ".join(removed[host]))
        else:
            lines.append(f"{host}\tabsent\t")
    write_state(request_id, lines)
    return 0


# ---- --leave-self (#1541) ---------------------------------------------------------
#
# A demoted member resets itself to a fresh single-node seed (spatium-cluster-join
# leave). It used to wipe without leaving etcd, so the seed kept its seat as a
# voter nobody would ever answer for. From three members the only demote allowed
# takes both non-seed members, so the seed held three voters with two gone and
# lost quorum: its apiserver, and the control plane on it, wedged.
#
# etcd removes a member only while the cluster has quorum, so the removal has to
# come BEFORE the wipe, while this node still votes: on the last step, two
# members of which one is already gone have no quorum to remove it with. So this
# node removes its own member through its own etcd (the request is committed by
# the leader like any other), stops k3s at once (a restart against a removed
# member's data could try to re-join), and then asks a survivor whether the
# member is gone. The banner above still holds for every other mode: only this
# mode, called only by the leave runner, touches this node's own member.
#
# A node whose etcd leads hands the lead to the survivor first (#2874). A leader
# that removes itself leaves the cluster without one: it stops leading once the
# removal applies, and the rest elect a new leader only after an election
# timeout (about 5 s on ddi-pg's rigs). With both members of three leaving at
# once, the other member's removal waits through that election. When that
# member wins it, its removal commits at once with itself as the leader, and the
# seed is left the only voter, again without a leader. The seed's
# controller-manager lost its lease within seconds and k3s exited. k3s came back
# counting the removed member as a voter, so the seed never elected itself again
# and its API server stayed down. Neither demoted row settled (ddi-pg's
# ha/demoted_members_settle_left, nightly-20261026).


def survivor_url() -> str:
    """The ``server:`` this node joined, from the join drop-in; '' when there is
    none (a seed, or a node that never joined)."""
    try:
        text = JOIN_DROPIN.read_text(encoding="utf-8")
    except OSError:
        return ""
    m = re.search(r"(?m)^server:\s*(\S+)\s*$", text)
    return m.group(1) if m else ""


def own_members(members: list[dict]) -> list[dict]:
    """This node's own member: the name in k3s's etcd config exactly, or the
    name k3s gives this hostname's member (<hostname>-<8 hex>)."""
    names = own_names()
    res = [_member_name_re(n) for n in names]
    return [m for m in members
            if (name := str(m.get("name") or "")) and (name in names or any(r.match(name) for r in res))]


def tombstoned(members: list[dict]) -> bool:
    """k3s's tombstone shows these members removed. It speaks only for the
    member this node's etcd runs as, and only a peer that has applied that
    member's removal makes k3s write it, so the removal is committed."""
    name = etcd_name()
    return bool(name) and TOMBSTONE.exists() and all(m.get("name") == name for m in members)


def has_leader() -> bool | None:
    """Whether this node's etcd knows of a leader (its etcd_server_has_leader
    gauge); None when its metrics cannot be read."""
    try:
        with urllib.request.urlopen(METRICS_URL, timeout=5) as resp:
            text = resp.read().decode("utf-8", errors="replace")
    except Exception:  # noqa: BLE001 — unreadable is "cannot tell"
        return None
    m = re.search(r"(?m)^etcd_server_has_leader\s+(\S+)\s*$", text)
    try:
        return float(m.group(1)) == 1 if m else None
    except ValueError:
        return None


def lead_target(members: list[dict], server: str) -> dict | None:
    """The member to hand the lead to: the survivor's, the voter with a peer URL
    on the host this node joined (``server:``, the seed's node IP); else any
    other voter. None when there is no other voter."""
    mine = {m.get("ID") for m in own_members(members)}
    voters = [m for m in members if m.get("ID") not in mine and not m.get("isLearner")]
    host = peer_host(server)
    for m in voters:
        if host and any(peer_host(u) == host for u in (m.get("peerURLs") or [])):
            return m
    return voters[0] if voters else None


def hand_off_lead(members: list[dict], server: str) -> str:
    """See that this node's etcd does not lead when its member is removed: ''
    once it does not, else why it may still lead after LEAD_HANDOFF_S.

    A leader hands the lead to the survivor (MoveLeader). A follower has nothing
    to hand off, unless the cluster has no leader at all. Its removal would then
    wait through the election and commit at once if this node won it, so it
    waits for a leader and asks again."""
    target = lead_target(members, server)
    if target is None:
        return ""
    if peer_host(server) not in {peer_host(u) for u in (target.get("peerURLs") or [])}:
        log(f"leave-self: no voter has a peer URL on {server}; the lead goes to "
            f"{describe(target)} if this node holds it")
    deadline = time.monotonic() + LEAD_HANDOFF_S
    while True:
        err = move_leader(int(target["ID"]))
        if not err:
            log(f"leave-self: handed the etcd lead to {describe(target)} before removing "
                "this node's member")
            return ""
        curl = re.match(r"curl exit (\d+):", err)
        if curl and int(curl.group(1)) in CURL_NEVER_SENT:
            # This node's etcd cannot be reached, so the removal cannot be sent
            # either; it refuses on its own (refused_before_proposing).
            return ""
        if "etcdserver: not leader" in err:
            if has_leader() is not False:
                return ""
            why = "the cluster has no leader: an election is running"
        else:
            why = err
        if time.monotonic() >= deadline:
            return why
        time.sleep(LEAVE_POLL_S)


def leave_self() -> int:
    """0: this node's etcd member is gone and k3s is stopped. 2: this node
    joined nobody, so there is no member to remove. 1: the removal did not
    happen, or nothing shows that it did; k3s may be stopped, and the caller
    must restart it and must not wipe this node.

    etcd accepting the MemberRemove is the removal: a member change is
    committed through raft, so an accepted one already has the quorum's
    agreement. An error answer is not proof either way (#2394): this node's
    etcd can apply its own removal and shut down while the call waits, and
    the call then answers `etcdserver: server stopped` with the member gone.
    So only an error showing that etcd never acted on the call refuses at
    once, with k3s left running (refused_before_proposing: curl never sent
    it, or etcd refused it before proposing). After any other error k3s is
    stopped and the survivor is asked, as after an accepted one.

    Only a survivor that answers and still lists the member refuses the
    leave. One that cannot be reached in the window does not refuse an
    accepted removal: refusing there restarts k3s on a node whose member is
    already gone, which deletes its etcd data and rejoins it as a NEW member,
    leaving the seed alone for minutes and the control plane on two voters
    (found by ddi-pg's walk of #1659). After an error answer, an unreachable
    survivor lets the leave go on only when k3s left its tombstone
    (tombstoned). With nothing to show the member gone, a wipe could leave a
    voter nobody answers for (the #1541 harm), so the leave is refused.

    Before any removal this node sees that its etcd does not lead
    (hand_off_lead, #2874): a leader that removes itself leaves the cluster
    without one for an election timeout, and with both members leaving at once
    that cost the seed its quorum for good. When the lead cannot be handed off
    within LEAD_HANDOFF_S the leave is refused at once, with k3s left running,
    as for a removal etcd refused."""
    server = survivor_url()
    if not server:
        log("leave-self: no server: in the join drop-in; not a joined member, nothing to remove")
        return 2
    try:
        members = list_members()
        mine = own_members(members)
    except Exception as exc:  # noqa: BLE001 — reported, and the wipe is refused
        log(f"leave-self: this node's etcd member list is unreadable: {exc}")
        return 1
    why = hand_off_lead(members, server) if mine else ""
    if why:
        log(f"leave-self: this node's etcd may still lead ({why}); not removing its member "
            "while it may lead, k3s left running (#2874)"[:400])
        return 1
    unsure: list[dict] = []  # members whose removal etcd answered with an error
    for m in mine:
        err = remove_member(int(m["ID"]))
        if not err:
            log(f"leave-self: removed this node's etcd member {describe(m)}")
        elif refused_before_proposing(err):
            log(f"leave-self: could not remove this node's etcd member {describe(m)}: {err}")
            return 1
        else:
            unsure.append(m)
            log(f"leave-self: removing this node's etcd member {describe(m)} answered {err}, "
                "which does not say whether it was removed; the survivor decides (#2394)")
    subprocess.run(["sh", "-c", STOP_K3S_CMD], capture_output=True, timeout=120, check=False)
    deadline = time.monotonic() + LEAVE_CONFIRM_S
    answered = False
    while True:
        try:
            still = own_members(list_members(url=server, cmd=SURVIVOR_MEMBERS_CMD))
            answered = True
            if not still:
                log(f"leave-self: {server} no longer lists this node's etcd member")
                return 0
            why = "still listed: " + "; ".join(describe(m) for m in still)
        except Exception as exc:  # noqa: BLE001 — a survivor mid-failover; retried
            why = f"unreadable: {exc}"
        if time.monotonic() >= deadline:
            if not answered and not unsure:
                log(f"leave-self: etcd accepted the removal; {server} could not be reached "
                    f"to confirm it within {LEAVE_CONFIRM_S:.0f} s ({why}); going on, "
                    "since the member is already gone"[:400])
                return 0
            if not answered and tombstoned(unsure):
                log(f"leave-self: {server} could not be reached to confirm the removal within "
                    f"{LEAVE_CONFIRM_S:.0f} s ({why}); going on, since k3s left its tombstone "
                    f"{TOMBSTONE}: a peer has applied this member's removal"[:400])
                return 0
            if not answered:
                log(f"leave-self: {server} could not be reached to confirm the removal within "
                    f"{LEAVE_CONFIRM_S:.0f} s ({why}), and etcd answered with an error and k3s "
                    "left no tombstone, so nothing shows the member gone; not wiping a node "
                    "whose member may still vote (#1541)"[:400])
                return 1
            log(f"leave-self: {server} did not confirm the removal within "
                f"{LEAVE_CONFIRM_S:.0f} s ({why})"[:400])
            return 1
        time.sleep(LEAVE_POLL_S)


if __name__ == "__main__":
    sys.exit(leave_self() if sys.argv[1:] == ["--leave-self"] else run())
