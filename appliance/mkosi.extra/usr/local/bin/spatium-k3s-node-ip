#!/bin/sh
# spatium-k3s-node-ip — runs before every k3s start (k3s.service
# ExecStartPre), #4801.
#
# k3s picks the node's address (and the interface flannel uses) by looking up
# the default route. On a network with no default route (an isolated or
# air-gapped segment whose DHCP lease or static config has no gateway) that
# lookup is fatal:
#
#   no default routes found in "/proc/net/route" or "/proc/net/ipv6_route"
#
# and the unit restarts every 5 s forever, so first boot never converges.
#
# With a default route this script does nothing but remove its own drop-in, so
# k3s keeps choosing the address exactly as before. Without one it writes
# config.yaml.d/spatium-node-ip.yaml with ``node-ip`` and ``flannel-iface``
# taken from the address the management interface holds RIGHT NOW. Doing it at
# every start, not once at install, is deliberate: a DHCP lease can change the
# address, and a pinned value would then be wrong.
#
# Interface choice: the first global address on a physical-looking interface
# (cni / flannel / veth / bridge / docker / kube / wireguard devices are
# skipped, they are k3s's own), IPv4 first and IPv6 only when there is no IPv4,
# so an IPv6-only install pins its IPv6 address.
#
# Service-CIDR route: with no default route the HOST kernel has no route to the
# service CIDR either, so a hostNetwork pod (the frontend's nginx resolving the
# api through cluster DNS at 10.43.0.10) or the host itself fails connect() with
# "Network unreachable" BEFORE kube-proxy's DNAT can apply. So in the same
# no-default-route case the script also adds ``<service-cidr> dev <iface>
# scope link proto 198`` (service-cidr from config.yaml.d/spatium-cidrs.yaml,
# default 10.43.0.0/16; every entry of a dual-stack list). The route is the
# script's own: ``proto 198`` is how it finds and deletes exactly its entries
# once a default route exists. It must outlive DHCP renewals and NM
# reconnects, and a NetworkManager keyfile edit cannot: the installer's keyfile
# is re-rendered from STATE by spatium-etc-render at every boot (and DHCP-on-
# any-port has no keyfile at all). So
# /etc/NetworkManager/dispatcher.d/50-spatium-k3s-service-route re-runs this
# script with --routes-only on every up / dhcp4-change / dhcp6-change / reapply.
#
# Never fails k3s's start (the unit runs it as ExecStartPre=-).
set -u

ROUTES_ONLY=0
[ "${1:-}" = "--routes-only" ] && ROUTES_ONLY=1

DROPIN="${SPATIUM_K3S_NODE_IP_DROPIN:-/etc/rancher/k3s/config.yaml.d/spatium-node-ip.yaml}"
LOG="${SPATIUM_K3S_NODE_IP_LOG:-/var/log/spatiumddi/k3s-node-ip.log}"
# The installer binds the management connection to one NIC
# (``interface-name=`` in its NetworkManager keyfile); on a multi-NIC host that
# is the interface to pin, not whichever address happens to come first.
NM_DIR="${SPATIUM_K3S_NODE_IP_NM_DIR:-/etc/NetworkManager/system-connections}"
CIDRS="${SPATIUM_K3S_NODE_IP_CIDRS:-/etc/rancher/k3s/config.yaml.d/spatium-cidrs.yaml}"
RTPROTO=198

# Delete only the routes this script added (proto 198).
del_routes() {
    for fam in 4 6; do
        ip "-$fam" route show proto "$RTPROTO" 2>/dev/null | awk '{print $1}' | while read -r dst; do
            [ -n "$dst" ] && ip "-$fam" route del "$dst" proto "$RTPROTO" 2>/dev/null
        done
    done
}

add_routes() {
    dev="$1"
    svc=$(sed -n 's/^service-cidr:[[:space:]]*//p' "$CIDRS" 2>/dev/null | head -1 | tr -d "\"' ")
    [ -n "$svc" ] || svc="10.43.0.0/16"
    for c in $(printf '%s' "$svc" | tr ',' ' '); do
        case "$c" in
            *:*) ip -6 route replace "$c" dev "$dev" proto "$RTPROTO" 2>/dev/null ;;
            *.*) ip -4 route replace "$c" dev "$dev" scope link proto "$RTPROTO" 2>/dev/null ;;
            *) continue ;;
        esac
        say "no default route: service route $c dev $dev"
    done
}

say() {
    msg="spatium-k3s-node-ip: $*"
    printf '[%s] %s\n' "$(date -Iseconds)" "$msg" >>"$LOG" 2>/dev/null
    printf '%s\n' "$msg" >&2
}

mkdir -p "$(dirname "$LOG")" "$(dirname "$DROPIN")" 2>/dev/null

if [ -n "$(ip -4 route show default 2>/dev/null)" ] \
    || [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
    [ "$ROUTES_ONLY" = 1 ] || rm -f "$DROPIN" 2>/dev/null
    del_routes
    exit 0
fi

# "2: eth0    inet 10.0.0.5/24 brd ... scope global eth0" -> "eth0 10.0.0.5"
pick() {
    fam="$1"
    ip -o "-$fam" addr show scope global 2>/dev/null | awk -v fam="$fam" -v want="$PREF" '
        want != "" && $2 != want { next }
        {
            dev = $2
            if (dev ~ /^(lo|flannel|cni|veth|docker|br-|kube|cali|wg|tun)/) next
            for (i = 3; i < NF; i++) if ($i == "inet" || $i == "inet6") { a = $(i + 1); break }
            if (fam == "6" && $0 ~ /deprecated|tentative/) next
            sub(/\/.*/, "", a)
            if (a != "") { print dev, a; exit }
        }'
}

PREF=$(sed -n 's/^interface-name=//p' "$NM_DIR"/10-spatium-*.nmconnection 2>/dev/null | head -1)
found=$(pick 4)
[ -n "$found" ] || found=$(pick 6)
if [ -z "$found" ] && [ -n "$PREF" ]; then
    # The bound NIC holds no address (yet): fall back to any physical one.
    PREF=""
    found=$(pick 4)
    [ -n "$found" ] || found=$(pick 6)
fi
if [ -z "$found" ]; then
    [ "$ROUTES_ONLY" = 1 ] || rm -f "$DROPIN" 2>/dev/null
    say "no default route and no global address on any interface; leaving k3s to choose (it will fail until the network has an address)"
    exit 0
fi
iface=${found%% *}
addr=${found#* }

add_routes "$iface"
[ "$ROUTES_ONLY" = 1 ] && exit 0

tmp="$DROPIN.tmp.$$"
{
    echo "# Auto-generated by spatium-k3s-node-ip (k3s.service ExecStartPre) at every"
    echo "# start while the node has no default route (#4801). Removed again as soon"
    echo "# as a default route exists. Do not edit."
    echo "node-ip: $addr"
    echo "flannel-iface: $iface"
} >"$tmp" 2>/dev/null && chmod 0644 "$tmp" && mv -f "$tmp" "$DROPIN" \
    || { rm -f "$tmp" 2>/dev/null; say "could not write $DROPIN"; exit 0; }
say "no default route: pinned k3s node-ip=$addr flannel-iface=$iface for this start"
exit 0
