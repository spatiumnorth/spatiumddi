[Unit]
Description=Apply pending SpatiumDDI slot-set-next-boot trigger (Fleet UI)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/138

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/slot-set-next-boot-pending
ExecStart=/usr/local/bin/spatiumddi-slot-set-next-boot
# No Install section — only invoked by the matching .path unit.
