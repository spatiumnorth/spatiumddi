[Unit]
Description=Remove the etcd members of nodes Fleet -> Replace evicts (#1284)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/1284

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/etcd-evict-pending
ExecStart=/usr/local/bin/spatium-etcd-evict
# No Install section — only invoked by the matching .path unit.
