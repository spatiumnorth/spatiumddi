[Unit]
Description=Join this node to the SpatiumDDI control-plane cluster (#272 Phase 7b)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/272
# k3s reconfigure; the runner stops/starts k3s itself.

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/cluster-join-pending
ExecStart=/usr/local/bin/spatium-cluster-join join
# No Install section — only invoked by the matching .path unit.
