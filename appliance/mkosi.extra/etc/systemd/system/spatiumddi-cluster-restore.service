[Unit]
Description=Restore etcd from a snapshot — single-node cluster-reset (#272 Phase 9b)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/272
# k3s --cluster-reset surgery; the runner stops/starts k3s itself.

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/cluster-restore-pending
ExecStart=/usr/local/bin/spatium-cluster-restore
# No Install section — only invoked by the matching .path unit.
