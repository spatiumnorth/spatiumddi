[Unit]
Description=SpatiumDDI appliance %i from the console, after the PostgreSQL primary handoff (#2974)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/2974
# Started by spatium-console's F5 (reboot) / F6 (poweroff) with
# ``systemctl start --no-block``, so systemd owns the run: the console
# stays responsive during the handoff (up to a few minutes on the node of
# the PostgreSQL primary), and a console restart cannot kill the wrapper
# mid-handoff and leave the node cordoned without a reboot. F9 cancels it
# with ``systemctl stop``. %i is reboot or poweroff; the wrapper refuses
# anything else.

[Service]
Type=oneshot
# No start timeout (a oneshot's default, stated so nobody adds one): a
# timeout stops the wrapper, which it takes as a cancel. The wrapper caps
# the handoff itself.
TimeoutStartSec=infinity
# #3008 — a 10 s grace (as the web-UI reboot has), held with the wrapper's
# lock and marker: F9 can cancel it, and the Maintenance tab sees the reboot
# before the api goes down (on a one-node install nothing else delays it).
Environment=SPATIUM_POWER_ACTION_GRACE_S=10
ExecStart=/usr/local/bin/spatium-power-action %i
# #3162 — F9 (systemctl stop) is a cancel, not a failure: the wrapper ends by
# the stop's own signal. For Type=oneshot systemd counts death by SIGTERM /
# SIGINT / SIGHUP as a FAILURE (result 'signal') unless listed here, so
# without this line the unit is left 'failed' exactly as with the old exit 1
# (verified on systemd 257). Exit 1 (a failed systemctl reboot) stays a
# failure.
SuccessExitStatus=TERM INT HUP
# No Install section — only started by spatium-console.
