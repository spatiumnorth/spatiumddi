[Unit]
Description=Leave the SpatiumDDI control-plane cluster, reset to single-node (#272 Phase 7b)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/272

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/cluster-leave-pending
ExecStart=/usr/local/bin/spatium-cluster-join leave
