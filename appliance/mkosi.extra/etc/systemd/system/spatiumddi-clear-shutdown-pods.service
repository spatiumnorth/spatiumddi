[Unit]
Description=Keep the API's view of this node's pods true across its shutdown (issues #1976, #2848)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/1976
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/2848
# Where k3s runs, and only there: k3s.service's own conditions.
ConditionKernelCommandLine=!boot=live
ConditionPathExists=/etc/spatiumddi/appliance-release
# Ordering only: a unit never pulls k3s in (#1723). The runner waits for
# the API itself. At shutdown the same ordering stops this unit before
# k3s, so its ExecStop still has the local API.
After=k3s.service

[Service]
# The kubelet's graceful node shutdown (#1976) ends every pod of the node
# before a reboot goes on, and their controllers replace them.
#
# At boot (ExecStart): the pods a ReplicaSet owns then stay listed as
# Completed (or Error) beside their replacements, because nothing deletes a
# terminal pod of a ReplicaSet until the pod GC's threshold of 12,500. This
# deletes them once the node is back, and nothing else (the runner's header
# has the selector). exec, not oneshot: boot does not wait for the API. The
# runner gives up after 15 minutes and always exits 0; the next boot looks
# again.
#
# At shutdown (ExecStop, #2848): the kubelet releases its shutdown lock once
# its pods have stopped, before every final status of theirs has reached the
# API, and nothing marks a pod whose last write was lost: it stays Ready, a
# Service endpoint, until the node is back. Systemd stops this unit after
# that lock is released (logind holds the shutdown until then) and before
# k3s, so the runner marks NotReady each pod of the node the API still reads
# Ready. It acts only while the system is stopping, takes at most 10 s and
# always exits 0; TimeoutStopSec is the backstop.
Type=exec
RemainAfterExit=yes
ExecStart=/usr/local/bin/spatium-clear-shutdown-pods
ExecStop=/usr/local/bin/spatium-clear-shutdown-pods --at-shutdown
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
