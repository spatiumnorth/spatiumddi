[Unit]
Description=Apply pending SpatiumDDI removable-disk mount config (issue #989)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/989
# The runner writes .mount units into /etc/systemd/system, which on the
# appliance is the /var-backed overlay upper layer (Phase 8a) — so it
# needs etc.mount up, exactly like the chrony sibling. The trigger and
# the mountpoints both live under /var/lib/spatiumddi.
After=etc.mount local-fs.target
Requires=etc.mount

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/removable-config-pending
ExecStart=/usr/local/bin/spatiumddi-removable-reload
# No Install section — only invoked by the matching .path unit.
