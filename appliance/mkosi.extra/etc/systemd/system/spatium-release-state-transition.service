[Unit]
Description=Keep the outgoing api readable on release-state until the booted api serves (#1661)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/1661
# tmpfiles re-owns the directory to root:2770 at sysinit; this re-opens it
# to uid 1000 ONLY when detect stamped a pre-#1621 (1777) directory, and
# closes it again when every api pod runs the booted image, at the
# deadline, or when the unit stops for any reason.
After=systemd-tmpfiles-setup.service spatium-release-state-detect.service local-fs.target
Before=k3s.service
ConditionPathExists=/run/spatium-release-state-transition

[Service]
Type=simple
ExecStartPre=/usr/local/bin/spatium-release-state-transition open
ExecStart=/usr/local/bin/spatium-release-state-transition wait
ExecStopPost=/usr/local/bin/spatium-release-state-transition close
# Hard ceiling above the script's own 900 s deadline.
RuntimeMaxSec=1000

[Install]
WantedBy=multi-user.target
