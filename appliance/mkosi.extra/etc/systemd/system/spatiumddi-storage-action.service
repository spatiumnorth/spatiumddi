[Unit]
Description=Apply a pending SpatiumDDI md / multipath management request (issue #999 Part B)
Documentation=https://github.com/spatiumnorth/spatiumddi/issues/999
# The request + result files live under /var/lib/spatiumddi, and the
# runner reads /sys/block and shells to mdadm / multipathd.
After=local-fs.target

[Service]
Type=oneshot
# GHSA-h2j9-qrg7-grfw — act only on a trigger written by root, the
# supervisor or the api; anything else is renamed aside and the unit
# skips cleanly. See spatiumddi-trigger-guard.
ExecCondition=/usr/local/bin/spatiumddi-trigger-guard /var/lib/spatiumddi/release-state/storage/*.request.json
ExecStart=/usr/local/bin/spatiumddi-storage-action
# No Install section — only invoked by the matching .path unit.
