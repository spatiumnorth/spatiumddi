[Unit]
# Issue #183 Phase 1 — single-node k3s on the appliance.
#
# k3s lives at /usr/local/bin/k3s (baked from the upstream release
# pin in Makefile / fetch-k3s.sh). Config in /etc/rancher/k3s/
# config.yaml controls the flag set; this unit just dispatches.
#
# The air-gap images tarball at /var/lib/rancher/k3s/agent/images/
# k3s-airgap-images-<arch>.tar.zst is auto-imported by k3s on first
# start, so CoreDNS / local-path-provisioner / metrics-server / pause
# / traefik are all available without an outbound network call.
#
# We do NOT enable k3s.service in mkosi.postinst yet — Phase 3 wires
# the supervisor to it. Phase 1 only proves the slot ships k3s; an
# operator can ``systemctl enable --now k3s`` to validate.
Description=Lightweight Kubernetes (k3s)
Documentation=https://docs.k3s.io
# Issue #183 Phase 7 — start in parallel with firstboot. firstboot
# writes the bootstrap HelmChart manifest into the manifests dir;
# k3s's helm-controller watches that dir continuously, so order
# doesn't matter (whatever lands gets applied). Pre-Phase-7 we
# ordered k3s.service After=firstboot, but firstboot waits for
# kubeapi /readyz at the end — that's a deadlock.
After=network-online.target nss-lookup.target spatium-etc-reconcile.service
Wants=network-online.target nss-lookup.target
# #1910 — the node's identity lives in the /etc overlay's upper: its
# hostname (k3s names the Node after it), machine-id, the role and CIDR
# drop-ins in config.yaml.d (--node-label spatium.io/role-control-plane,
# --cluster-cidr/--service-cidr/--cluster-dns), .env and role-config. The
# ordering above only WAITS for etc.mount; when the mount failed after a
# power-off, k3s started anyway on the slot's bare /etc and registered a
# brand-new Node, ``localhost``, without its role or CIDRs, and the
# cluster never recovered. Require the overlay, as the host runners'
# units already do (spatiumddi-ssh-reload.service and its siblings): no
# overlay, no k3s.
Requires=etc.mount
After=etc.mount
# Skip on the live ISO — installer environment, no slot partitions,
# no kubeapi state to bootstrap. firstboot also writes /etc/rancher/
# /k3s after install; until then k3s would hit a read-only config dir.
ConditionKernelCommandLine=!boot=live
# Skip when there's no slot rootfs yet — fresh-out-of-box live boots
# before install also lack the persistent paths.
ConditionPathExists=/etc/spatiumddi/appliance-release

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
EnvironmentFile=-/etc/rancher/k3s/k3s.env
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
# Pre-create dirs so k3s doesn't have to. ExecStartPre is in the
# main unit (not in /etc/systemd/system/k3s.service.d/) so a slot
# upgrade carrying a new unit file picks up the same pre-step.
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStartPre=/bin/mkdir -p /etc/rancher/k3s /var/lib/rancher/k3s /var/log/spatiumddi
# Persist k3s's image-import cache. Without ``.cache.json`` in the images
# dir k3s re-imports EVERY baked tarball on EVERY start — not only the
# first one this unit's header describes: the importer opens the cache
# ``O_WRONLY|O_TRUNC`` and never creates it (pkg/agent/containerd/
# watcher.go ``syncCache``), and the docs say so outright ("Image
# archives are imported every time k3s starts … To enable [the cache],
# create a .cache.json file in the images directory"). The appliance
# ships ~20 tarballs there, and the import runs BEFORE the kubelet
# starts, so every k3s restart costs 90-160 s of node-NotReady on a
# nested QA rig (a member returning from a network partition rejoined
# in 168-284 s, of which 126 s was "Importing images from …"; the
# nightly's HA drill budget is 240 s). With the cache a tarball is
# re-imported only when its size or mtime changes — exactly what a slot
# upgrade does when it copies the new slot's set across
# (spatium-upgrade-slot ``_refresh_baked_images``), so upgrades still
# import. ``touch`` creates the file when absent and only bumps the
# timestamps of an existing, populated cache; the cluster-join identity
# wipe moves it aside together with the containerd store it describes.
ExecStartPre=/bin/mkdir -p /var/lib/rancher/k3s/agent/images
ExecStartPre=/bin/touch /var/lib/rancher/k3s/agent/images/.cache.json
# #1630 — clear containerd's unfinished content writes ("ingests") before
# k3s starts. k3s imports every tarball's ``index.json`` under one shared
# ref, ``tar-index.json``. An import that died part-way leaves that write
# on disk, and containerd then fails every SHORTER ``index.json`` after it
# with "unexpected commit size N, expected M", on every boot, until a
# longer one happens to commit over it. A slot upgrade's first boot lost
# the DNS and DHCP agents' images that way. No import can be in flight
# here (k3s's containerd dies with the k3s that started it), and the
# appliance resumes no pulls. ``-``: a failure here never keeps k3s down;
# firstboot's image check is the backstop.
ExecStartPre=-/usr/local/bin/spatium-k3s-images clear-ingests
# #1215 — k3s re-applies every manifest each time it starts, which put the
# first-boot certificate back over the api's in spatium-appliance-tls.
# firstboot skips that manifest once the Secret exists, but only once k3s is
# up; this skips it before k3s starts on a seed that finished its first boot
# on an earlier boot (a slot upgraded from a build without the marker).
# ``-``: never keeps k3s down; the worst case is one more revert.
ExecStartPre=-/usr/local/bin/spatium-tls-manifest-skip
# #1976 — kubelet graceful node shutdown. KillMode=process (above) is right
# for a k3s restart: the pods keep running while the kubelet is away. A node
# shutdown is different: systemd then stopped every container at once while
# the kubelet died with k3s, so nothing told the cluster, and the node's pods
# stayed Ready in their Services until node-lifecycle noticed the silence
# about 70 s later. With a shutdown grace period the kubelet holds a logind
# delay lock, reports the node NotReady, stops its pods and only then lets
# the shutdown go on (the drop-in's header has the detail). The drop-in
# ships in the slot's /usr and is copied, on every start, into the
# directory k3s hands the kubelet as --config-dir (it writes its own
# 00-k3s-defaults.conf there), so an upgrade carrying a new value applies it
# on the next start. ``-``: a failed copy never keeps k3s down; the node
# then reboots the old way.
ExecStartPre=-/usr/bin/install -d -m 0700 /var/lib/rancher/k3s/agent/etc/kubelet.conf.d
ExecStartPre=-/usr/bin/install -m 0600 /usr/lib/spatiumddi/kubelet.conf.d/50-spatium-graceful-shutdown.conf /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/50-spatium-graceful-shutdown.conf
# ``server`` boots an all-in-one node (control plane + agent). Single
# node — no joining a cluster. All other flags live in /etc/rancher/
# k3s/config.yaml so they're operator-editable without touching the
# unit.
ExecStart=/usr/local/bin/k3s server

[Install]
WantedBy=multi-user.target
