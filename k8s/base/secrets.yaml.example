# Template only — deliberately NOT named *.yaml, so `kubectl apply -f
# k8s/base/` skips it (#1222). Applied, it would overwrite a real secret
# with the placeholders below, and the api refuses to boot on the
# placeholder SECRET_KEY. Create the secret instead with:
#   kubectl create secret generic spatiumddi-secrets \
#     --from-literal=postgres-password=CHANGEME \
#     --from-literal=secret-key=$(openssl rand -hex 32) \
#     --from-literal=redis-password=$(openssl rand -hex 32) \
#     --from-literal=metrics-token=$(openssl rand -hex 32) \
#     --from-literal=credential-key=$(python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())') \
#     -n spatiumddi
#
# Or use an external secrets manager (Vault, AWS SSM, SOPS).
apiVersion: v1
kind: Secret
metadata:
  name: spatiumddi-secrets
  namespace: spatiumddi
type: Opaque
stringData:
  postgres-password: "CHANGEME"
  secret-key: "CHANGEME-generate-with-openssl-rand-hex-32"
  # #1547 — the Redis requirepass. The api / worker / beat interpolate
  # it into their sentinel:// URLs as $(REDIS_PASSWORD); the Sentinel
  # StatefulSet's init container renders it into redis.conf /
  # sentinel.conf. One key, every consumer — rotate it in one place.
  redis-password: "CHANGEME"
  # #1159 — bearer token for /metrics (any API token works too). Optional:
  # without it only API tokens can scrape. Don't ship a placeholder value;
  # a known token is no protection.
  # metrics-token: "<openssl rand -hex 32>"
  # #1358 — the Fernet key stored credentials are encrypted under. Optional
  # (without it the key is derived from SECRET_KEY), but set it: SECRET_KEY
  # also signs every session token. Adding it to a running install is safe,
  # old values keep decrypting; then run
  # `python -m app.core.rotate_credential_key` in the api pod. Never ship a
  # placeholder, and keep it: values written under it are unreadable without.
  # credential-key: "<Fernet.generate_key()>"
  # #1358 — when adding credential-key to an install that is already running,
  # also set this to the version you are running (or about to roll out). That
  # version reads the key but keeps writing under the old one, so a pod that
  # has not restarted since cannot meet a value it cannot read; the next
  # release writes with it. Leave it out on a fresh install.
  # credential-key-since: "<running version>"
