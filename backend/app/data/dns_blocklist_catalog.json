  "profiles": [
    {
      "id": "family",
      "name": "Family filter",
      "description": "Adult content and gambling blocked, SafeSearch forced on the major engines, and the common DNS-filter bypass routes closed. Scope it to the views or server groups that serve the networks you want filtered \u2014 applying it everywhere filters your servers too.",
      "source_ids": [
        "hagezi-nsfw",
        "hagezi-gambling",
        "hagezi-doh-vpn-proxy-bypass",
        "hagezi-nosafesearch"
      ],
      "template_ids": [
        "safesearch"
      ],
      "note": "A filtered public resolver (Cloudflare 1.1.1.3, OpenDNS FamilyShield) is the zero-maintenance alternative for a forward-everything deployment \u2014 see the forwarder presets on the server group. The two approaches compose."
    }
  ]
}
