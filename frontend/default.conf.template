# Rendered at container start by the official nginx image's
# ``20-envsubst-on-templates.sh`` entrypoint drop-in (envsubst-style
# variable substitution from /etc/nginx/templates/*.template to
# /etc/nginx/conf.d/). Only the three variables below get substituted
# — nginx's own ``$host`` / ``$remote_addr`` / etc are safe because the
# entrypoint restricts envsubst to explicitly-named env vars.
#
# Issue #176: the previous baked-in ``api:8000`` upstream + ``127.0.0.11``
# resolver assumed Docker Compose's embedded DNS and broke the moment
# anyone deployed this image on Kubernetes (where the API Service is
# ``{release}-api`` and cluster DNS lives on 10.96.x.x via CoreDNS, not
# 127.0.0.11). The three knobs:
#
#   * API_UPSTREAM_HOST     — DNS name of the api Service. Defaults to
#                             ``api`` (Compose). Helm chart overrides
#                             to ``{{ fullname }}-api``.
#   * API_UPSTREAM_PORT     — TCP port the api listens on. Defaults to
#                             ``8000`` everywhere.
#   * NGINX_LOCAL_RESOLVERS — Space-separated nameserver list for the
#                             ``resolver`` directive. Auto-populated
#                             from /etc/resolv.conf by the official
#                             ``15-local-resolvers.envsh`` script when
#                             NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 (set
#                             in the Dockerfile). Operators can pin a
#                             specific IP by setting this env var
#                             explicitly.

# ── /health + /metrics rate limit (#2944) ─────────────────────────
# /health/ready and /health/platform are unauthenticated and each call runs
# database and Redis checks; /health/ready has a single database connection
# of its own, so a flood through this proxy could queue the kubelet's probe
# behind it. One bucket per client address: $binary_remote_addr is read
# after the real_ip module has rewritten it, so behind a proxy listed in
# FRONTEND_TRUSTED_PROXY_CIDRS each end client gets its own bucket (an
# unlisted proxy shares one bucket for everyone behind it). 5 r/s with a
# burst of 20 is far above any monitor polling every few seconds, and a
# Prometheus scrape is usually every 15 s. The kubelet probes the api
# pod directly, not through here.
# /health/platform, the console's own Platform Health call, is exempt
# (its own exact location): a browser whose allowance was spent must still
# render the card, and its worker ping is cached and single-flight.
limit_req_zone $binary_remote_addr zone=spatium_health:1m rate=5r/s;

# ── Reverse proxy in front of this nginx (#1868) ───────────────────
# FRONTEND_TRUSTED_PROXY_CIDRS (rendered into the two ${...} blocks below by
# 16-trusted-proxies.envsh) names the TCP peers that are an operator's
# reverse proxy. It is NOT the api's TRUSTED_PROXY_CIDRS (the api's peer is
# this nginx; this nginx's peer is the proxy). UNSET = none, which keeps the
# behaviour of a direct install: the proxy_set_header lines below describe
# THIS nginx's own peer and a client-supplied X-Forwarded-* is never believed.
#
#   * set_real_ip_from / real_ip_header / real_ip_recursive make
#     $remote_addr the real client when the TCP peer is a listed proxy,
#     walking X-Forwarded-For from the right past every listed hop and
#     stopping at the first unlisted one, so an address a client prepends
#     is never reached. The api then sees the real client in X-Real-IP
#     (always written below, never passed through) and its login throttle
#     buckets per user, not per proxy.
#   * $spatium_forwarded_proto is the outer proxy's X-Forwarded-Proto, but
#     only when the TCP peer ($realip_remote_addr, before real_ip rewrites
#     it) is listed, else this server's own scheme. Behind an
#     https-terminating proxy the api therefore builds https URLs (OIDC
#     redirect_uri, SAML ACS) and marks the refresh cookie Secure.
#
# Must not diverge from charts/spatiumddi/templates/frontend-tls-config.yaml.
geo $realip_remote_addr $spatium_proxy_trusted {
    default 0;
${SPATIUM_TRUSTED_GEO}}

map "$spatium_proxy_trusted:$http_x_forwarded_proto" $spatium_forwarded_proto {
    default $scheme;
    "~*^1:https" https;
    "~*^1:http" http;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # #2935 — no ``Server: nginx/<version>`` on any response, or the
    # version on nginx's own error pages: version details are for signed-in
    # users only. Must not diverge from the other template.
    server_tokens off;

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
${SPATIUM_REAL_IP_FROM}
    # ── Security response headers (SECURITY #400, L2) ──────────────
    # Applied at the server level so they cover the SPA, static
    # assets, and proxied /api responses. NOTE: nginx ``add_header``
    # does NOT inherit into a location that declares its own
    # ``add_header`` — the @starting + static-asset locations below
    # re-emit these via ``include`` of the same snippet.
    #
    # CSP rationale (verified against the Vite build):
    #   * default-src 'self'    — lock everything to same origin.
    #   * script-src 'self'     — Vite emits external module scripts
    #                             only (no inline <script>, no eval /
    #                             new Function in the bundle), so NO
    #                             'unsafe-inline' / 'unsafe-eval'.
    #   * style-src 'self' 'unsafe-inline'
    #                           — Tailwind ships an external stylesheet,
    #                             but recharts / transition deps inject
    #                             <style> elements at runtime and React
    #                             style props set inline styles. Those
    #                             genuinely need 'unsafe-inline' for
    #                             STYLES ONLY (style injection can't
    #                             execute script, so the risk is low).
    #   * img-src 'self' data:  — favicons / small logos are data URIs.
    #   * connect-src 'self'    — all XHR/fetch/SSE go to same-origin
    #                             /api (LLM providers are proxied through
    #                             the backend, never called from the SPA).
    #   * font-src 'self'       — fonts are self-hosted.
    #   * frame-ancestors 'none'— clickjacking defence (pairs with
    #                             X-Frame-Options: DENY for old browsers).
    #   * base-uri / form-action / object-src locked down.
    set $spatium_csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
    # /api/redoc's policy (#1157): the one above plus the two things ReDoc
    # needs on that page only. See ``location = /api/redoc``.
    set $spatium_redoc_csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.redoc.ly; font-src 'self'; connect-src 'self'; worker-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
    add_header Content-Security-Policy $spatium_csp always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # HSTS is intentionally NOT set here: this image's server block is
    # plain HTTP (TLS terminates upstream at an ingress / the appliance
    # nginx). The appliance HTTPS server block sets HSTS itself.

    # Re-resolve the upstream periodically so a container / Pod restart
    # that hands out a new IP doesn't strand nginx on the old one. The
    # nameserver list comes from /etc/resolv.conf at container start —
    # 127.0.0.11 under Docker Compose, the kube-dns Service IP under
    # Kubernetes, host /etc/resolv.conf under ``--network=host``.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Issue #299 phase 2 — when the api upstream isn't reachable
    # (cold boot before the api passes /health/ready, mid-rolling-
    # upgrade replica gap, mid-CNPG-failover blip) serve the
    # friendly "still booting" page instead of bare nginx 502 HTML.
    #
    # Why 502 + 504 only:
    # * 502 covers "upstream connect refused" (no ready pods in the
    #   Service's endpoint slice; the schema-aware readiness probe
    #   landed in phase 1 keeps api pods out of that slice until the
    #   migrate Job lands the alembic head).
    # * 504 covers "upstream timeout" (api responded slowly enough
    #   to trip ``proxy_read_timeout``).
    # * 503 is DELIBERATELY NOT intercepted — the api uses 503 for
    #   real operator-actionable signals (demo-mode blocked write,
    #   factory-reset cooldown, /health/ready when DB is up but
    #   schema is behind). Replacing those with a generic page
    #   would mask the cause.
    # * 500 is also passed through — that's a real bug to fix, not
    #   a "still booting" condition.
    #
    # Status is PRESERVED (no ``=`` after the status list) — the
    # original 502/504 flows through to clients. The SPA's axios
    # layer types every /api/* response as JSON; overriding to 200
    # with an HTML body would make axios resolve "success" with a
    # string payload and crash downstream (review polish from #301).
    # Direct browser hits to ``/api/*`` URLs during a 502 window
    # still get the friendly HTML body (status 502 with HTML is
    # rendered by browsers identically to the body alone); the
    # status-preservation only matters for programmatic clients.
    error_page 502 504 @starting;

    # The error_page is inherited into every location below that talks
    # to an upstream — ``/api/*``, ``/health/*``, ``/metrics``. The SPA
    # fallback at ``/`` serves a static file and so can never 502 on its
    # own; it gets there via the ``auth_request`` boot gate further down
    # (#767). Note that gate also covers a direct GET /_starting.html
    # (it matches ``location /``): previewing the page against a live api
    # still serves it 200, but with the api down it comes back 503 — the
    # same body either way.

    location @starting {
        # Static file under root — Vite copies frontend/public/_starting.html
        # to /usr/share/nginx/html/_starting.html on every build, so the
        # page is part of the same image as the SPA. The ``internal``
        # directive would let us hide /_starting.html from external
        # requests, but leaving it externally accessible is useful for
        # operators previewing the look without a real upstream failure.
        default_type text/html;
        # Aggressive no-store: an operator hitting this page during a
        # boot window must NOT have it cached for the next visit.
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        # Surface what the upstream said so a curl debugger can tell
        # "upstream is unreachable" from "upstream timed out".
        add_header X-Upstream-Status $upstream_status always;
        # Re-emit security headers (SECURITY #400, L2) — a location
        # with its own add_header does NOT inherit the server-level set.
        add_header Content-Security-Policy $spatium_csp always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /_starting.html =503;
    }

    # JSON for JSON routes (#1083). The ``/api/`` locations send their
    # 502/504 here instead of to @starting: a client polling a JSON route
    # while the api Service has no ready endpoint (a CNPG failover empties
    # it -- /health/ready needs the database) gets a JSON body with the
    # status it can retry on, never the initialising page's HTML. A
    # ``return`` has no method to refuse, so a POST that trips the 60 s
    # proxy_read_timeout gets this too instead of the 405 nginx answers
    # when error_page redirects a POST to a static file (#1080). The
    # upstream status is preserved (502 = no ready endpoint / connect
    # refused, 504 = upstream timeout) the way @starting preserves it,
    # so the SPA's per-status handling holds.
    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Retry-After 2 always;
        add_header X-Upstream-Status $upstream_status always;
        add_header X-Content-Type-Options "nosniff" always;
        if ($upstream_status ~ "504") {
            return 504 '{"detail":"The api did not answer in time; retry shortly."}';
        }
        return 502 '{"detail":"The api is not reachable right now; retry shortly."}';
    }

    # Nginx-local healthcheck — answers without hitting any upstream,
    # so the frontend container's health reflects just nginx itself.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Operator Copilot streaming endpoint (issue #90). SSE responses
    # need three things nginx defaults get wrong:
    #   1. ``proxy_buffering off`` — otherwise nginx holds the entire
    #      response until upstream closes, defeating the point of SSE.
    #   2. ``proxy_http_version 1.1`` + cleared ``Connection`` header
    #      — nginx defaults to HTTP/1.0 to upstream, which doesn't
    #      support chunked transfer-encoding well and forces buffering.
    #   3. A long ``proxy_read_timeout`` — slow local LLMs (Ollama on a
    #      cold start, llama.cpp with a big model) easily take >60 s
    #      to first token. 10 minutes is plenty without being silly.
    # Must come before the broader /api/ location since nginx picks
    # the most specific prefix match.
    location /api/v1/ai/chat {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass            $api_upstream;
        proxy_set_header      Host $http_host;
        proxy_set_header      X-Real-IP $remote_addr;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version    1.1;
        proxy_set_header      Connection "";
        proxy_buffering       off;
        proxy_cache           off;
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;
        # Tell the X-Accel-Buffering: no header from upstream to win
        # in case it sneaks back on through a different path.
        proxy_set_header      X-Accel-Buffering no;
    }

    # Long-lived streams (#1868). The same three needs as the Copilot chat
    # above: no buffering, HTTP/1.1 to the upstream, and a read timeout
    # longer than the quietest gap in the stream, or the generic /api/ block's
    # 60 s closes a healthy stream. Covers the appliance cluster-health
    # stream, the container / workload log follow streams, and the nmap scan
    # progress stream. An outer proxy needs the same treatment; see
    # docs/deployment/REVERSE_PROXY.md. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.
    location ~ ^/api/v1/(appliance/cluster/health/stream|appliance/containers/.+/logs/stream|nmap/scans/[^/]+/stream)$ {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass            $api_upstream;
        proxy_set_header      Host $http_host;
        proxy_set_header      X-Real-IP $remote_addr;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version    1.1;
        proxy_set_header      Connection "";
        proxy_buffering       off;
        proxy_cache           off;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_set_header      X-Accel-Buffering no;
    }

    # Backup endpoints (issue #117). Three things nginx defaults
    # get wrong for these:
    #   1. ``client_max_body_size`` — backup archives can be
    #      hundreds of MB on real installs. 2 GB matches the
    #      backend's ``_MAX_UPLOAD_BYTES`` cap; anything past
    #      that is rejected at the FastAPI layer with a clean
    #      message instead of nginx's bare 413.
    #   2. ``proxy_request_buffering off`` — without this nginx
    #      buffers the entire upload to disk before forwarding,
    #      doubling the I/O. Streaming straight through is fine
    #      because FastAPI reads the body progressively.
    #   3. ``proxy_read_timeout`` — pg_dump + pg_restore on a
    #      hefty install can take several minutes. 30 minutes
    #      matches the backend's ``_PG_DUMP_TIMEOUT_SECONDS``.
    # Must come before the broader /api/ location since nginx
    # picks the most specific prefix match.
    location /api/v1/backup/ {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     2g;
        proxy_request_buffering  off;
        proxy_read_timeout       1800s;
        proxy_send_timeout       1800s;
    }

    # Appliance upgrade-image upload (air-gapped slot-image upload, e.g.
    # dns-technitium / dns-bind9 / dhcp-kea A/B slot images). Same shape
    # as the backup location above but sized to the backend's own
    # ``MAX_UPLOAD_BYTES`` cap (4 GiB, app/api/v1/appliance/
    # upgrade_images.py) — appliance slot images run ~1.8-2 GB, so the
    # 2g backup limit isn't enough. Without this override the request
    # falls through to the generic /api/ location below and nginx's
    # ~1 MB default silently 413s the upload before it ever reaches
    # FastAPI's own (more informative) size-check error.
    location /api/v1/appliance/upgrade-images {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     4g;
        proxy_request_buffering  off;
        proxy_read_timeout       1800s;
        proxy_send_timeout       1800s;
    }

    # Storage management actions (#1080). Two budgets sit behind this
    # route, both longer than the 60 s ``proxy_read_timeout`` the
    # generic ``/api/`` block below carries: the api waits up to 90 s
    # for the appliance's supervisor (appliance/supervisor.py, the
    # storage channel's ``timeout=90.0``) before its own 504, and the
    # supervisor waits 60 s for the host runner before reporting
    # ``ok=false "the host storage runner did not answer within 60s"``
    # -- a report that reaches the api a little AFTER nginx's 60 s
    # clock, which started before the supervisor's. Either way the
    # operator got nginx's generic did-not-answer JSON at 60.000 s and
    # never the message written to send them to
    # ``journalctl -u spatiumddi-storage-action``. An exact-path regex
    # (any appliance id) so no other /api/ route waits longer; sized
    # above the route's budget with margin, the way the backup and
    # upgrade-image blocks are sized to theirs. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.
    location ~ ^/api/v1/appliance/appliances/[^/]+/storage/action$ {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ReDoc (#1157) needs two things the server's policy refuses, on this
    # page only. Its search index runs in a Worker built from a ``blob:``
    # URL. Its "API docs by Redocly" footer loads a logo from cdn.redoc.ly,
    # and ReDoc hides the logo if that fails, so an air-gapped install loses
    # only the logo. Scripts stay ``'self'``: only a script already allowed
    # to run can create a blob: worker, and an image runs no script.
    # add_header here replaces the server-level set, so the rest of it is
    # re-emitted. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.
    location = /api/redoc {
        add_header Content-Security-Policy $spatium_redoc_csp always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;
    }

    # The API docs' own assets (#1157). /api/docs and /api/redoc load Swagger
    # UI and ReDoc from here, served by the api, so the pages run under this
    # server's ``script-src 'self'`` and need no CDN. ``^~`` is load-bearing:
    # without it the static-asset regex location further down wins for any
    # ``.js`` / ``.css`` path, looks for the file on this image's own disk,
    # and returns 404. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.
    location ^~ /api/docs/static/ {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;
    }


    # Large-body api routes (#3036): the DNS / DHCP / IPAM importers (a
    # file, or the preview posted back to commit), the DNS zone spreadsheet
    # import, the supervisor's pcap upload and the DNS agent's
    # ingested-records push. Each takes more than nginx's 1 MiB default, so
    # under the generic /api/ location below they were 413'd by nginx, as
    # an HTML page, before the api read them.
    #
    # One location per route family, each with ``client_max_body_size`` set
    # to EXACTLY the api's own limit for it (``ALLOWANCES`` in
    # backend/app/core/body_limit.py, which already carries the multipart
    # framing headroom). nginx is the one that refuses an over-limit body:
    # from its Content-Length before anything is proxied, or, for a chunked
    # body, the moment the count passes the limit, so the api never sees
    # more than it accepts. The api refusing instead does not work through
    # a streaming proxy: it answers 413 and closes before reading the body,
    # nginx's next write meets the closed socket (``writev() failed (104)``
    # / ``(32)``), and the client got a 502 about one time in three. The
    # 413 is answered as the api's own JSON (``/_api_body_too_large/``
    # below), not nginx's HTML page.
    #
    # ``proxy_request_buffering off`` is what keeps the raised limits to
    # these routes safe: a body within the limit streams to the api, whose
    # pre-body auth check runs before any of it is read, instead of nginx
    # spooling it to disk for an anonymous caller first. Every other /api/
    # route keeps the 1 MiB default. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.

    # DNS importers: 50 MiB + 1 MiB framing.
    location ~ ^/api/v1/dns/import/ {
        error_page 502 504 @api_unavailable;
        error_page 413 /_api_body_too_large/53477376;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     51m;
        proxy_request_buffering  off;
        proxy_read_timeout       60s;
    }

    # DHCP and IPAM importers: 25 MiB + 1 MiB framing.
    location ~ ^/api/v1/(dhcp|ipam)/import/ {
        error_page 502 504 @api_unavailable;
        error_page 413 /_api_body_too_large/27262976;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     26m;
        proxy_request_buffering  off;
        proxy_read_timeout       60s;
    }

    # DNS zone spreadsheet import: 10 MiB + 1 MiB framing.
    location ~ ^/api/v1/dns/groups/[^/]+/zones/[^/]+/import/spreadsheet/ {
        error_page 502 504 @api_unavailable;
        error_page 413 /_api_body_too_large/11534336;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     11m;
        proxy_request_buffering  off;
        proxy_read_timeout       60s;
    }

    # Supervisor pcap upload: 100 MiB capture + 16 MiB pcap framing + 1 MiB.
    location ~ ^/api/v1/appliance/supervisor/pcap/upload/ {
        error_page 502 504 @api_unavailable;
        error_page 413 /_api_body_too_large/122683392;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     117m;
        proxy_request_buffering  off;
        proxy_read_timeout       60s;
    }

    # DNS agent ingested-records push: 64 MiB.
    location ~ ^/api/v1/dns/agents/ingested-records$ {
        error_page 502 504 @api_unavailable;
        error_page 413 /_api_body_too_large/67108864;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass               $api_upstream;
        proxy_set_header         Host $http_host;
        proxy_set_header         X-Real-IP $remote_addr;
        proxy_set_header         X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header         X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version       1.1;
        proxy_set_header         Connection "";
        client_max_body_size     64m;
        proxy_request_buffering  off;
        proxy_read_timeout       60s;
    }

    # The 413 for the large-body locations above, in the api's own shape
    # (``body_limit.too_large_detail``: same status, same JSON body, same
    # byte count), so a client cannot tell which of the two refused it.
    # ``internal``: reachable only through their ``error_page 413``.
    # ``client_max_body_size 0`` is load-bearing: a chunked body refused
    # mid-stream arrives here with the count so far as its length, and
    # under the 1 MiB default this location would refuse it AGAIN, which
    # error_page does not follow, and the client got nginx's HTML page.
    location ~ ^/_api_body_too_large/(\d+)$ {
        internal;
        client_max_body_size 0;
        default_type application/json;
        return 413 '{"detail": "Request body is larger than this endpoint accepts ($1 bytes)."}';
    }

    # Proxy API calls to the backend. Using a variable for proxy_pass
    # forces nginx to re-resolve the upstream on each request via the
    # resolver above (instead of binding at config-load time).
    location /api/ {
        error_page 502 504 @api_unavailable;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;
    }

    # HELD (RFC 5985) — #972. Mounted at the application root rather than
    # under /api/ because a HELD client is configured with a whole URL and
    # the protocol names this path, so it needs its own location: without
    # one it falls through to the SPA ``location /`` below and a PBX asking
    # for a phone's location gets index.html with a 200.
    #
    # ``/held`` and ``/held/self`` both, via a prefix match.
    location /held {
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_read_timeout 60s;
    }

    # ACME http-01 challenge (#438). The TLS template (appliance) has always
    # proxied this; the plain template did not, so on Docker Compose and
    # Helm an http-01 order offered in the UI (#3061) got the SPA's
    # index.html with a 200 and failed. The api serves only key-authorizations
    # it published for a live order, and 404s everything else.
    location /.well-known/acme-challenge/ {
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass         $api_upstream;
        proxy_set_header   Host $http_host;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
    }

    # The console's own platform-health call (#2944): exact, so it wins over the
    # rate-limited regex below and a browser whose allowance another tab or a
    # script spent still gets its Platform Health card. Its worker ping is
    # TTL-cached and single-flight; the limit is for /health/ready's one
    # database connection. Same proxying as the location below, minus limit_req.
    location = /health/platform {
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
    }

    # Proxy health and metrics endpoints to api for admin probes.
    location ~ ^/(health|metrics) {
        # #2944 — see limit_req_zone at the top of this file. Everything but
        # /health/platform (exact location above): ready, live, startup, metrics.
        limit_req zone=spatium_health burst=20 nodelay;
        limit_req_status 429;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
    }

    # Boot gate for the SPA fallback (issue #767). ``location /``
    # resolves index.html straight off local disk, so it has no upstream
    # to fail on and the ``error_page`` above can never fire for it —
    # which meant an operator browsing a cold-booting appliance got the
    # SPA shell plus a wall of failing XHRs instead of the "still
    # initialising" page. A cheap auth_request sub-request gives this
    # location an upstream to fail on.
    #
    # Deliberately proxies to the api SERVICE, not a pod: an api that is
    # up but not READY (migrations still landing) is not in the Service's
    # endpoint set, so this reports "not serving yet" rather than the
    # weaker "process alive" that /health/live means on its own.
    location = /_api_up {
        internal;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass              $api_upstream/health/live;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        Host $http_host;
        # Short — this runs in front of every SPA page load, and a
        # wedged api should fall back to the starting page fast rather
        # than hang the browser for the default 60 s. resolver_timeout
        # is NOT covered by the proxy_* timeouts and defaults to 30 s;
        # without it an unreachable DNS server (rather than an
        # unreachable api) would stall every page load for half a
        # minute.
        resolver_timeout        2s;
        proxy_connect_timeout   2s;
        proxy_read_timeout      2s;
    }

    # #2895 — the About page's legal files: NOTICE, LICENSE and the npm
    # notice list. Signed-in callers only: someone probing the server from
    # outside must not learn which libraries and tools it runs. The files live
    # OUTSIDE the web root (/usr/share/spatiumddi/legal, see frontend/Dockerfile),
    # so no other location here can serve them, and this one asks the api
    # whether the caller has a session before it does. The SPA fetches them
    # with its Bearer token, which nginx passes to the sub-request with the rest
    # of the request headers. 401 / 403 from the api go straight back to the
    # browser; an api that cannot answer is a 503, never the file. ``^~`` so the
    # static-asset regex below cannot win for these paths. ``alias`` with no
    # ``try_files``, so a missing file is a plain 404, not index.html. Labelled
    # UTF-8 because NOTICE is not ASCII. No add_header, so the server-level
    # security headers still apply. Must not diverge from
    # charts/spatiumddi/templates/frontend-tls-config.yaml.
    location ^~ /legal/ {
        auth_request /_about_session;
        error_page 500 502 504 =503 @api_unavailable;
        alias /usr/share/spatiumddi/legal/;
        default_type text/plain;
        charset utf-8;
    }

    # The About files' gate: 204 for a signed-in caller, 401 / 403 otherwise.
    location = /_about_session {
        internal;
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass              $api_upstream/api/v1/about/session;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        Host $http_host;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $spatium_forwarded_proto;
        proxy_http_version      1.1;
        proxy_set_header        Connection "";
        resolver_timeout        2s;
        proxy_connect_timeout   2s;
        proxy_read_timeout      10s;
    }

    # SPA fallback — all other paths serve index.html
    location / {
        auth_request /_api_up;
        # auth_request collapses "upstream unreachable / timed out" into
        # a 500, so 500 has to be in this list. Location-scoped, so it
        # REPLACES the server-level error_page here only — a genuine 500
        # from /api/ elsewhere is untouched. Re-coded to 503: the control
        # plane isn't erroring, it just isn't up yet. Hashed assets match
        # the regex location below, which wins over this prefix location,
        # so they never pay for the sub-request.
        error_page 500 502 504 =503 @starting;
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets aggressively; let Vite's content hash bust them
    location ~* \.(js|css|woff2?|png|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Re-emit security headers (SECURITY #400, L2) — a location
        # with its own add_header does NOT inherit the server-level set.
        add_header Content-Security-Policy $spatium_csp always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    # Issue #862 — without this a shared cache between the appliance and a
    # client can serve a gzipped body to a client that never asked for one,
    # because nothing in the response says the entity varies by encoding.
    # It also matters for the agent /config long-poll, whose ETag is now a
    # weak validator deliberately shared by both encodings.
    gzip_vary on;
}
