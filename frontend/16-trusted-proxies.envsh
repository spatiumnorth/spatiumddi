#!/bin/sh
# Render TRUSTED_PROXY_CIDRS into the two nginx fragments the template
# interpolates (spatiumddi #1868):
#
#   * SPATIUM_REAL_IP_FROM   one ``set_real_ip_from <cidr>;`` per entry
#   * SPATIUM_TRUSTED_GEO    one ``<cidr> 1;`` per entry, for the ``geo``
#                            block that decides whether an X-Forwarded-Proto
#                            header may be believed
#
# envsubst can substitute a variable but cannot repeat a directive once per
# list element, so the lines are built here and handed over as two
# multi-line variables. This file is SOURCED by the nginx entrypoint (the
# .envsh suffix), so the exports reach the envsubst step that follows.
#
# TRUSTED_PROXY_CIDRS is the api's own setting (comma-separated CIDRs or
# addresses, ``*`` for any peer). UNSET or EMPTY means "trust no proxy" here,
# which is today's behaviour for a direct install: nginx overwrites
# X-Real-IP / X-Forwarded-Proto from its own TCP peer. This is deliberately
# NOT the api's private-range default. A LAN client that reaches this nginx
# directly sits in those ranges, and trusting it would let any such client
# choose the address the login throttle and audit rows record. Setting the
# variable is the operator saying "this peer is my proxy".
#
# The api needs the FRONTEND's address in the same list (it believes
# X-Real-IP only from a trusted peer), so a list narrowed to the outer proxy
# must still cover the container network. See docs/deployment/REVERSE_PROXY.md.

set -eu

_spatium_real_ip_from=""
_spatium_trusted_geo=""
_spatium_nl='
'

_cidrs="${TRUSTED_PROXY_CIDRS:-}"
# Entries are written into nginx config, so accept only what an address or
# CIDR can contain. Anything else fails the container start, the way the api
# refuses to boot on a bad entry, instead of rendering a config nginx would
# reject (or one that smuggles a directive in).
_old_ifs="$IFS"
set -f   # a bare * must reach the loop as a word, not as a glob
IFS=','
for _entry in $_cidrs; do
    IFS="$_old_ifs"
    # trim surrounding whitespace
    _entry=$(printf '%s' "$_entry" | tr -d ' \t')
    [ -n "$_entry" ] || { IFS=','; continue; }
    if [ "$_entry" = "*" ]; then
        _entries="0.0.0.0/0 ::/0"
    else
        case "$_entry" in
            *[!0-9a-fA-F:./]*)
                echo "16-trusted-proxies: TRUSTED_PROXY_CIDRS entry '$_entry' is not an address or CIDR" >&2
                exit 1
                ;;
        esac
        _entries="$_entry"
    fi
    for _e in $_entries; do
        _spatium_real_ip_from="${_spatium_real_ip_from}    set_real_ip_from ${_e};${_spatium_nl}"
        _spatium_trusted_geo="${_spatium_trusted_geo}    ${_e} 1;${_spatium_nl}"
    done
    IFS=','
done
IFS="$_old_ifs"
set +f

SPATIUM_REAL_IP_FROM="${_spatium_real_ip_from}"
SPATIUM_TRUSTED_GEO="${_spatium_trusted_geo}"
export SPATIUM_REAL_IP_FROM SPATIUM_TRUSTED_GEO
